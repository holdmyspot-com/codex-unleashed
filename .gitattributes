# Patch files are consumed by git apply and must remain byte-stable.
*.patch text eol=lf

# Keep build and patching scripts portable across hosted runners.
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Preserve the npm selector's executable shebang in packaged resources.
tooling/cli/src/main/resources/com/holdmyspot/codexunleashed/tooling/release/npm-launcher.js text eol=lf
