diff --git a/codex-rs/tui/tests/suite/gov_cloud_guidance_tests.rs b/codex-rs/tui/tests/suite/gov_cloud_guidance_tests.rs
index ee79c7ca5..00529fc04 100644
--- a/codex-rs/tui/tests/suite/gov_cloud_guidance_tests.rs
+++ b/codex-rs/tui/tests/suite/gov_cloud_guidance_tests.rs
@@ -30 +30 @@ fn gov_cloud_startup_persists_only_acknowledgment() -> Result<()> {
-        loop {
+        'interaction: loop {
@@ -32 +32,22 @@ fn gov_cloud_startup_persists_only_acknowledgment() -> Result<()> {
-            terminal.write_input(if action == "quit" { b"q" } else { b"\r" })?;
+            if let Err(error) = terminal.write_input(if action == "quit" { b"q" } else { b"\r" }) {
+                let closed_pty = error
+                    .downcast_ref::<std::io::Error>()
+                    .is_some_and(|error| error.raw_os_error() == Some(libc::EIO));
+                if action == "quit" && closed_pty {
+                    // Quitting can close the PTY before the next repeated key. Require the
+                    // child to exit successfully within the existing interaction deadline.
+                    loop {
+                        if let Some(status) = terminal.child.try_wait()? {
+                            ensure!(status.success(), "quit exited with {status}");
+                            break 'interaction;
+                        }
+                        if Instant::now() >= deadline {
+                            return Err(error.context(
+                                "quit closed the PTY but the child did not exit before the interaction deadline",
+                            ));
+                        }
+                        std::thread::sleep(Duration::from_millis(/*millis*/ 10));
+                    }
+                }
+                return Err(error);
+            }
