+fn conpty_diagnostic_processes() -> anyhow::Result<Vec<(u32, u32, String, OwnedHandle)>> {
+    use winapi::um::handleapi::INVALID_HANDLE_VALUE;
+    use winapi::um::tlhelp32::{
+        CreateToolhelp32Snapshot, PROCESSENTRY32W, Process32FirstW, Process32NextW,
+        TH32CS_SNAPPROCESS,
+    };
+
+    // SAFETY: the snapshot API returns a new owned handle or INVALID_HANDLE_VALUE.
+    let raw = unsafe { CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0) };
+    anyhow::ensure!(
+        raw != INVALID_HANDLE_VALUE,
+        "process snapshot: {}",
+        std::io::Error::last_os_error()
+    );
+    let snapshot = unsafe { OwnedHandle::from_raw_handle(raw.cast()) };
+    // SAFETY: PROCESSENTRY32W accepts zero initialization followed by dwSize.
+    let mut entry: PROCESSENTRY32W = unsafe { std::mem::zeroed() };
+    entry.dwSize = std::mem::size_of::<PROCESSENTRY32W>() as u32;
+    let mut entries = Vec::new();
+    let mut more = unsafe { Process32FirstW(snapshot.as_raw_handle().cast(), &mut entry) };
+    while more != 0 {
+        anyhow::ensure!(
+            entries.len() < 4096,
+            "process snapshot exceeds diagnostic limit"
+        );
+        let length = entry
+            .szExeFile
+            .iter()
+            .position(|value| *value == 0)
+            .unwrap_or(entry.szExeFile.len());
+        entries.push((
+            entry.th32ProcessID,
+            entry.th32ParentProcessID,
+            String::from_utf16_lossy(&entry.szExeFile[..length]),
+        ));
+        more = unsafe { Process32NextW(snapshot.as_raw_handle().cast(), &mut entry) };
+    }
+    anyhow::ensure!(
+        std::io::Error::last_os_error().raw_os_error()
+            == Some(winapi::shared::winerror::ERROR_NO_MORE_FILES as i32),
+        "process enumeration: {}",
+        std::io::Error::last_os_error()
+    );
+
+    let mut parents = vec![std::process::id()];
+    let mut processes = Vec::new();
+    loop {
+        let mut next = Vec::new();
+        for (pid, parent, name) in &entries {
+            if parents.contains(parent) {
+                let raw = unsafe { OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, 0, *pid) };
+                anyhow::ensure!(
+                    !raw.is_null(),
+                    "open diagnostic pid {pid}: {}",
+                    std::io::Error::last_os_error()
+                );
+                let handle = unsafe { OwnedHandle::from_raw_handle(raw.cast()) };
+                processes.push((*pid, *parent, name.clone(), handle));
+                next.push(*pid);
+            }
+        }
+        if next.is_empty() {
+            break;
+        }
+        parents = next;
+    }
+    eprintln!(
+        "conpty_diagnostic snapshot_process_count={} descendant_count={}",
+        entries.len(),
+        processes.len()
+    );
+    Ok(processes)
+}
+
+fn conpty_diagnostic_status(
+    stage: &str,
+    processes: &[(u32, u32, String, OwnedHandle)],
+    session: &crate::ProcessHandle,
+) {
+    eprintln!(
+        "conpty_diagnostic stage={stage} root_has_exited={} root_exit_code={:?}",
+        session.has_exited(),
+        session.exit_code()
+    );
+    for (pid, parent, name, handle) in processes {
+        let mut code = 0;
+        let result = unsafe {
+            winapi::um::processthreadsapi::GetExitCodeProcess(
+                handle.as_raw_handle().cast(),
+                &mut code,
+            )
+        };
+        eprintln!(
+            "conpty_diagnostic stage={stage} pid={pid} parent={parent} image={name:?} query_ok={} exit_code={code} last_error={:?}",
+            result != 0,
+            if result == 0 {
+                Some(std::io::Error::last_os_error())
+            } else {
+                None
+            }
+        );
+    }
+}
