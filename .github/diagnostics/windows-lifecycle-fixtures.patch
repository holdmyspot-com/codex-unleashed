+fn workload_temp_env(temp_dir: &Path) -> HashMap<String, String> {
+    let temp_dir = temp_dir.to_string_lossy().into_owned();
+    HashMap::from([
+        ("TEMP".to_string(), temp_dir.clone()),
+        ("TMP".to_string(), temp_dir),
+    ])
+}
+
 fn powershell_literal(path: &Path) -> String {
     path.to_string_lossy().replace('\'', "''")
 }

+fn publish_pid_command(path: &Path) -> String {
+    let pending = path.with_extension("pending");
+    format!(
+        "Set-Content -LiteralPath '{}' -Value $PID; Move-Item -LiteralPath '{}' -Destination '{}'",
+        powershell_literal(&pending),
+        powershell_literal(&pending),
+        powershell_literal(path),
+    )
+}
