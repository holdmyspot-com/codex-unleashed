+        std::process::id(),
+    );
+}
+
+fn read_child_pipe(
+    started: Instant,
+    stream: &str,
+    mut pipe: impl Read,
+) -> std::io::Result<Vec<u8>> {
+    record_phase(started, format!("child_pipe_read_begin stream={stream}"));
+    let mut output = Vec::new();
+    let mut chunk = [0_u8; 4096];
+    loop {
+        match pipe.read(&mut chunk) {
+            Ok(0) => {
+                record_phase(
+                    started,
+                    format!("child_pipe_eof stream={stream} bytes={}", output.len()),
+                );
+                return Ok(output);
+            }
+            Ok(count) => {
+                output.extend_from_slice(&chunk[..count]);
+                record_phase(
+                    started,
+                    format!(
+                        "child_pipe_chunk stream={stream} bytes={count} text={:?}",
+                        String::from_utf8_lossy(&chunk[..count])
+                    ),
+                );
+            }
+            Err(error) if error.kind() == std::io::ErrorKind::Interrupted => continue,
+            Err(error) => {
+                record_phase(
+                    started,
+                    format!("child_pipe_read_failed stream={stream} error={error}"),
+                );
+                return Err(error);
+            }
+        }
+    }
+}
