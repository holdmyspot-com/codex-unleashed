From a49bfe8d66d7bee38364569ab1268965070949d6 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Thu, 22 Oct 2026 07:13:47 +0000
Subject: [PATCH] Report credential export gate timing and subprocess progress

Diagnostic only: retain existing timeout and recovery assertions, record when the parent opens the fixture gate, and distinguish a shell still waiting from one that released credentials. Baseline Windows run 39735177936 fails two of five repetitions. Maintained just fmt and just fmt-check pass on the exact stable base. This instrumentation is not a repair or a shipping patch.
---
 codex-rs/model-provider/src/provider.rs | 18 ++++++++++++++----
 1 file changed, 14 insertions(+), 4 deletions(-)

diff --git a/codex-rs/model-provider/src/provider.rs b/codex-rs/model-provider/src/provider.rs
index f8f0790..d42ff60 100644
--- a/codex-rs/model-provider/src/provider.rs
+++ b/codex-rs/model-provider/src/provider.rs
@@ -980,13 +980,16 @@ mod tests {
         let fixture = tempfile::tempdir().expect("export fixture should be created");
         let export_counter = fixture.path().join("exports");
         let export_gate = fixture.path().join("release");
+        let export_phase = fixture.path().join("phase");
         #[cfg(unix)]
         let (command, mut args) = (
             "sh".to_string(),
             vec![
                 "-c".to_string(),
-                r#"printf '1\n' >> "$1"
+                r#"printf 'waiting\n' > "$3"
+printf '1\n' >> "$1"
 while [ ! -e "$2" ]; do :; done
+printf 'released\n' > "$3"
 printf '%s\n' '{"AccessKeyId":"exported","SecretAccessKey":"secret"}'
 "#
                 .to_string(),
@@ -999,8 +1002,9 @@ printf '%s\n' '{"AccessKeyId":"exported","SecretAccessKey":"secret"}'
             std::fs::write(
                 &script,
                 concat!(
-                    "@echo off\r\n>> \"%~1\" echo 1\r\n",
+                    "@echo off\r\n> \"%~3\" echo waiting\r\n>> \"%~1\" echo 1\r\n",
                     ":wait\r\nif not exist \"%~2\" goto wait\r\n",
+                    "> \"%~3\" echo released\r\n",
                     "echo {\"AccessKeyId\":\"exported\",\"SecretAccessKey\":\"secret\"}\r\n",
                 ),
             )
@@ -1016,7 +1020,8 @@ printf '%s\n' '{"AccessKeyId":"exported","SecretAccessKey":"secret"}'
             )
         };
         args.extend(
-            [&export_counter, &export_gate].map(|path| path.to_string_lossy().into_owned()),
+            [&export_counter, &export_gate, &export_phase]
+                .map(|path| path.to_string_lossy().into_owned()),
         );
         let provider_info =
             ModelProviderInfo::create_amazon_bedrock_provider(Some(ModelProviderAwsAuthInfo {
@@ -1032,6 +1037,7 @@ printf '%s\n' '{"AccessKeyId":"exported","SecretAccessKey":"secret"}'
         let second_export = create_model_provider(provider_info, /*auth_manager*/ None);
         let first_refresh = first_export.recover_from_unauthorized();
         let second_refresh = second_export.recover_from_unauthorized();
+        let export_started = std::time::Instant::now();
         tokio::pin!(first_refresh, second_refresh);
         tokio::time::timeout(std::time::Duration::from_secs(10), async {
             tokio::select! {
@@ -1050,9 +1056,13 @@ printf '%s\n' '{"AccessKeyId":"exported","SecretAccessKey":"secret"}'
             assert!(second_refresh.as_mut().poll(&mut context).is_pending());
         }
         std::fs::write(&export_gate, []).expect("export gate should open");
+        let gate_opened = export_started.elapsed();
         let (first_result, second_result) = tokio::join!(first_refresh, second_refresh);
         assert_eq!(
-            [first_result, second_result].map(|result| result.expect("provider should recover")),
+            [first_result, second_result].map(|result| result.unwrap_or_else(|error| {
+                panic!("provider should recover: {error:?}; gate opened after {gate_opened:?}; total {:?}; gate exists {}; phase {:?}",
+                    export_started.elapsed(), export_gate.exists(), std::fs::read_to_string(&export_phase))
+            })),
             [ProviderUnauthorizedRecovery::Recovered; 2]
         );
         assert_eq!(read_counter(), "111");
