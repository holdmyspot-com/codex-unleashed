+
+async fn approve_network_fetch_command(
+    test: &TestCodex,
+    environment_id: &str,
+    call_id: &str,
+) -> Result<()> {
+    let event = wait_for_event(&test.codex, |event| {
+        matches!(
+            event,
+            EventMsg::ExecApprovalRequest(_) | EventMsg::TurnComplete(_)
+        )
+    })
+    .await;
+    let EventMsg::ExecApprovalRequest(approval) = event else {
+        panic!("expected command approval before network access, got {event:?}");
+    };
+    assert_eq!(approval.kind, ExecApprovalKind::Command);
+    assert_eq!(approval.call_id, call_id);
+    assert_eq!(approval.environment_id.as_deref(), Some(environment_id));
+    assert_eq!(approval.network_approval_context, None);
+    let args = network_fetch_args(environment_id);
+    let command = args["cmd"].as_str().context("network fetch command")?;
+    let expected_command = if environment_id == LOCAL_ENVIRONMENT_ID {
+        get_shell(ShellType::Sh)
+            .context("expected local sh")?
+            .derive_exec_args(command, /*use_login_shell*/ false)
+    } else {
+        vec!["/bin/sh".to_string(), "-c".to_string(), command.to_string()]
+    };
+    assert_eq!(approval.command, expected_command);
