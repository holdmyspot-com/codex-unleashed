From fe3e9cf6b88782a5fd705a1ce825cdb3e882a00e Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Sun, 25 Oct 2026 04:55:54 +0000
Subject: [PATCH] build: keep argument lint diagnostics nonfatal for baseline

---
 tools/argument-comment-lint/lint_aspect.bzl | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/tools/argument-comment-lint/lint_aspect.bzl b/tools/argument-comment-lint/lint_aspect.bzl
index c20a79c..ff7d0ae 100644
--- a/tools/argument-comment-lint/lint_aspect.bzl
+++ b/tools/argument-comment-lint/lint_aspect.bzl
@@ -15,9 +15,9 @@ load(
     "find_toolchain",
 )
 
-_STRICT_LINT_FLAGS = [
-    "-Dargument-comment-mismatch",
-    "-Duncommented-anonymous-literal-argument",
+_LINT_FLAGS = [
+    "-Wargument-comment-mismatch",
+    "-Wuncommented-anonymous-literal-argument",
     "-Aunknown-lints",
 ]
 
@@ -129,7 +129,7 @@ def _rust_argument_comment_lint_aspect_impl(target, ctx):
         args.rustc_flags.add("--test")
 
     args.process_wrapper_flags.add("--touch-file", success_marker)
-    args.rustc_flags.add_all(_STRICT_LINT_FLAGS)
+    args.rustc_flags.add_all(_LINT_FLAGS)
     _set_driver_runtime_env(env, toolchain)
 
     driver_runfiles = ctx.attr._driver[DefaultInfo].default_runfiles.files
