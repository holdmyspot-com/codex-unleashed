Subject: [PATCH] test: probe legacy and elevated outside-root operations

---
--- a/codex-rs/windows-sandbox-rs/src/unified_exec/tests.rs
+++ b/codex-rs/windows-sandbox-rs/src/unified_exec/tests.rs
@@ -1137,3 +1137,297 @@
         assert!(stdout.contains("second"), "stdout={stdout:?}");
     });
 }
+
+// ---- scratch security probe: which outside-root operations the legacy and elevated sandboxes allow ----
+
+fn probe_run(program: &str, args: &[&str]) -> String {
+    match std::process::Command::new(program).args(args).output() {
+        Ok(o) => format!(
+            "{}{}",
+            String::from_utf8_lossy(&o.stdout),
+            String::from_utf8_lossy(&o.stderr)
+        ),
+        Err(e) => format!("failed to run {program}: {e}"),
+    }
+}
+
+fn probe_icacls(label: &str, p: &Path) {
+    let path = p.to_string_lossy().into_owned();
+    println!(
+        "--- icacls {label}: {}\n{}",
+        p.display(),
+        probe_run("icacls", &[path.as_str()])
+    );
+}
+
+fn probe_user_sid() -> String {
+    let out = probe_run("whoami", &["/user", "/fo", "csv", "/nh"]);
+    out.trim()
+        .split(',')
+        .nth(1)
+        .unwrap_or("")
+        .trim()
+        .trim_matches('"')
+        .to_string()
+}
+
+fn probe_restrict_with(p: &Path, grants: &[&str]) {
+    let sid = probe_user_sid();
+    let path = p.to_string_lossy().into_owned();
+    let grant_args: Vec<String> = grants
+        .iter()
+        .map(|g| g.replace("USER", &format!("*{sid}")))
+        .collect();
+    let mut args: Vec<&str> = vec![path.as_str(), "/inheritance:r"];
+    for g in &grant_args {
+        args.push("/grant:r");
+        args.push(g.as_str());
+    }
+    let out = probe_run("icacls", &args);
+    println!("restrict {}: {}", p.display(), out.trim());
+}
+
+#[derive(Clone, Copy, PartialEq)]
+enum ProbeRestrict {
+    Nothing,
+    Grants(&'static [&'static str]),
+}
+
+async fn probe_collect(
+    spawned: codex_utils_pty::SpawnedProcess,
+    codex_home: &Path,
+    timeout_duration: Duration,
+) -> (Vec<u8>, Vec<u8>, i32) {
+    let codex_utils_pty::SpawnedProcess {
+        session: _session,
+        mut stdout_rx,
+        mut stderr_rx,
+        exit_rx,
+    } = spawned;
+    let stdout_task = tokio::spawn(async move {
+        let mut out = Vec::new();
+        while let Some(chunk) = stdout_rx.recv().await {
+            out.extend(chunk);
+        }
+        out
+    });
+    let stderr_task = tokio::spawn(async move {
+        let mut out = Vec::new();
+        while let Some(chunk) = stderr_rx.recv().await {
+            out.extend(chunk);
+        }
+        out
+    });
+    let exit_code = timeout(timeout_duration, exit_rx)
+        .await
+        .unwrap_or_else(|_| panic!("timed out waiting for exit\n{}", sandbox_log(codex_home)))
+        .unwrap_or(-1);
+    let stdout = timeout(timeout_duration, stdout_task)
+        .await
+        .expect("stdout timeout")
+        .expect("stdout join");
+    let stderr = timeout(timeout_duration, stderr_task)
+        .await
+        .expect("stderr timeout")
+        .expect("stderr join");
+    (stdout, stderr, exit_code)
+}
+
+fn probe_squash(bytes: &[u8]) -> String {
+    let text = String::from_utf8_lossy(bytes).replace("\r\n", " / ").replace('\n', " / ");
+    text.chars().take(400).collect()
+}
+
+fn probe_scenario(label: &str, base: &Path, restrict: ProbeRestrict, elevated: bool) {
+    let backend = if elevated { "elevated" } else { "legacy" };
+    let runtime = current_thread_runtime();
+    runtime.block_on(async move {
+        fs::create_dir_all(base).expect("create probe base");
+        let test_root = TempDir::new_in(base).expect("create probe test root");
+        if let ProbeRestrict::Grants(grants) = restrict {
+            probe_restrict_with(test_root.path(), grants);
+        }
+        let codex_home = sandbox_home("probe-ops");
+        let workspace = test_root.path().join("workspace");
+        let temp_root = test_root.path().join("temp");
+        let tmp_root = test_root.path().join("tmp");
+        let out = test_root.path().join("outside");
+        for directory in [&workspace, &temp_root, &tmp_root, &out] {
+            fs::create_dir_all(directory).expect("create probe directory");
+        }
+        fs::write(workspace.join("ws-del.txt"), "ws").expect("seed");
+        fs::write(workspace.join("into.txt"), "into").expect("seed");
+        fs::write(workspace.join("x.txt"), "new").expect("seed");
+        fs::write(out.join("outside-delete.txt"), "outside").expect("seed");
+        fs::write(out.join("outside-append.txt"), "outside2").expect("seed");
+        fs::write(out.join("ren-src.txt"), "ren").expect("seed");
+        fs::write(out.join("move-out.txt"), "moveout").expect("seed");
+        fs::write(out.join("trunc.txt"), "truncate-me").expect("seed");
+        fs::write(out.join("overwrite.txt"), "orig").expect("seed");
+        fs::create_dir_all(out.join("emptydir")).expect("seed");
+        fs::create_dir_all(out.join("nonempty")).expect("seed");
+        fs::write(out.join("nonempty").join("f.txt"), "f").expect("seed");
+        if !elevated {
+            probe_icacls(&format!("{label} test_root"), test_root.path());
+            probe_icacls(&format!("{label} outside file"), &out.join("outside-delete.txt"));
+        }
+        let script = workspace.join("ops.cmd");
+        fs::write(
+            &script,
+            concat!(
+                "@echo off\r\n",
+                "del /f /q \"%WS%\\ws-del.txt\"\r\n",
+                "del /f /q \"%OUT%\\outside-delete.txt\"\r\n",
+                "echo created> \"%OUT%\\created.txt\"\r\n",
+                "echo appended>> \"%OUT%\\outside-append.txt\"\r\n",
+                "ren \"%OUT%\\ren-src.txt\" ren-dst.txt\r\n",
+                "move /y \"%OUT%\\move-out.txt\" \"%WS%\\moved-out.txt\"\r\n",
+                "move /y \"%WS%\\into.txt\" \"%OUT%\\into.txt\"\r\n",
+                "rmdir \"%OUT%\\emptydir\"\r\n",
+                "rmdir /s /q \"%OUT%\\nonempty\"\r\n",
+                "type nul > \"%OUT%\\trunc.txt\"\r\n",
+                "move /y \"%WS%\\x.txt\" \"%OUT%\\overwrite.txt\"\r\n",
+                "exit /b 0\r\n",
+            ),
+        )
+        .expect("write script");
+        let env_map = HashMap::from([
+            ("TEMP".to_string(), temp_root.to_string_lossy().into_owned()),
+            ("TMP".to_string(), tmp_root.to_string_lossy().into_owned()),
+            ("WS".to_string(), workspace.to_string_lossy().into_owned()),
+            ("OUT".to_string(), out.to_string_lossy().into_owned()),
+        ]);
+        let permission_profile = PermissionProfile::workspace_write();
+        let command = vec![
+            "C:\\Windows\\System32\\cmd.exe".to_string(),
+            "/d".to_string(),
+            "/c".to_string(),
+            script.display().to_string(),
+        ];
+        let spawned = if elevated {
+            spawn_windows_sandbox_session_elevated_for_permission_profile(
+                &permission_profile,
+                workspace_roots_for(workspace.as_path()).as_slice(),
+                codex_home.path(),
+                command,
+                workspace.as_path(),
+                env_map,
+                /*proxy_enforced*/ false,
+                /*network_proxy_restricting_sid*/ None,
+                Some(20_000),
+                /*read_roots_override*/ None,
+                /*read_roots_include_platform_defaults*/ true,
+                /*write_roots_override*/ None,
+                &[],
+                &[],
+                /*tty*/ false,
+                /*stdin_open*/ false,
+            )
+            .await
+        } else {
+            spawn_windows_sandbox_session_legacy(
+                &permission_profile,
+                workspace_roots_for(workspace.as_path()).as_slice(),
+                codex_home.path(),
+                command,
+                workspace.as_path(),
+                env_map,
+                Some(20_000),
+                &[],
+                &[],
+                /*tty*/ false,
+                /*stdin_open*/ false,
+            )
+            .await
+        };
+        let spawned = match spawned {
+            Ok(spawned) => spawned,
+            Err(err) => {
+                println!(
+                    "PROBE|{label}|{backend}|SPAWN-ERROR {err:#}\n{}",
+                    sandbox_log(codex_home.path())
+                );
+                return;
+            }
+        };
+        let (stdout, stderr, exit_code) =
+            probe_collect(spawned, codex_home.path(), Duration::from_secs(30)).await;
+        if exit_code != 0 {
+            println!("PROBE-LOG {label} {backend}\n{}", sandbox_log(codex_home.path()));
+        }
+        let read = |p: PathBuf| fs::read_to_string(p).ok();
+        println!(
+            "PROBE|{label}|{backend}|exit={exit_code}|ws_control_deleted={}|DEL={}|CREATE={}|APPEND={}|RENAME_IN_OUTSIDE={}|MOVE_OUT_TO_WS={}|MOVE_IN_NEW_NAME={}|RMDIR_EMPTY={}|RMDIR_TREE={}|TRUNCATE={}|OVERWRITE_BY_MOVE={}|stdout={}|stderr={}",
+            !workspace.join("ws-del.txt").exists(),
+            !out.join("outside-delete.txt").exists(),
+            out.join("created.txt").exists(),
+            read(out.join("outside-append.txt")).as_deref() != Some("outside2"),
+            out.join("ren-dst.txt").exists() && !out.join("ren-src.txt").exists(),
+            !out.join("move-out.txt").exists(),
+            out.join("into.txt").exists(),
+            !out.join("emptydir").exists(),
+            !out.join("nonempty").exists(),
+            read(out.join("trunc.txt")).as_deref() == Some(""),
+            read(out.join("overwrite.txt")).as_deref() == Some("new"),
+            probe_squash(&stdout),
+            probe_squash(&stderr),
+        );
+    });
+}
+
+#[test]
+fn probe_delete_variants() {
+    let _account_guard =
+        WindowsSandboxAccountTestGuard::acquire().expect("lock Windows sandbox test accounts");
+    let _guard = legacy_process_test_guard();
+    println!(
+        "PROBE-ENV arch={:?}\n{}\n{}",
+        std::env::var("PROCESSOR_ARCHITECTURE"),
+        probe_run("whoami", &["/user", "/fo", "list"]).trim(),
+        probe_run("whoami", &["/groups", "/fo", "list"]).trim()
+    );
+    let userprofile = PathBuf::from(std::env::var("USERPROFILE").expect("USERPROFILE"));
+    let variants: Vec<(&str, PathBuf, ProbeRestrict)> = vec![
+        ("checkout-default", sandbox_cwd(), ProbeRestrict::Nothing),
+        (
+            "checkout-restrictive-root",
+            sandbox_cwd(),
+            ProbeRestrict::Grants(&["*S-1-5-18:(OI)(CI)F", "*S-1-5-32-544:(OI)(CI)F", "USER:(OI)(CI)F"]),
+        ),
+        ("userprofile-default", userprofile.join("codex-probe"), ProbeRestrict::Nothing),
+        ("tempdir-default", std::env::temp_dir().join("codex-probe"), ProbeRestrict::Nothing),
+        ("c-root-default", PathBuf::from("C:\\codex-probe"), ProbeRestrict::Nothing),
+        (
+            "d-authusers-modify-only",
+            sandbox_cwd(),
+            ProbeRestrict::Grants(&["*S-1-5-18:(OI)(CI)F", "*S-1-5-32-544:(OI)(CI)F", "*S-1-5-11:(OI)(CI)M"]),
+        ),
+        (
+            "d-everyone-modify-only",
+            sandbox_cwd(),
+            ProbeRestrict::Grants(&["*S-1-5-18:(OI)(CI)F", "*S-1-5-32-544:(OI)(CI)F", "*S-1-1-0:(OI)(CI)M"]),
+        ),
+        (
+            "c-root-plus-explicit-user",
+            PathBuf::from("C:\\codex-probe"),
+            ProbeRestrict::Grants(&["*S-1-5-18:(OI)(CI)F", "*S-1-5-32-544:(OI)(CI)F", "*S-1-5-11:(OI)(CI)M", "USER:(OI)(CI)F"]),
+        ),
+    ];
+    let is_admin = probe_run("whoami", &["/groups", "/fo", "list"]).contains("S-1-5-32-544");
+    println!("PROBE-ENV is_admin={is_admin}");
+    for (label, base, restrict) in &variants {
+        for elevated in [false, true] {
+            if elevated && !is_admin {
+                println!("PROBE|{label}|elevated|SKIPPED (not an administrator; elevated setup would raise a UAC prompt)");
+                continue;
+            }
+            let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                probe_scenario(label, base, *restrict, elevated)
+            }));
+            if result.is_err() {
+                println!("PROBE|{label}|{}|PANIC", if elevated { "elevated" } else { "legacy" });
+            }
+        }
+    }
+    panic!("probe finished; this failure only forces nextest to print the output above");
+}
