From da24394a80df7e314187b9c2329f16e355d627e7 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Thu, 26 Nov 2026 13:33:51 -0500
Subject: [PATCH] DIAGNOSTIC: report pending network approval executions on
 timeout

---
 codex-rs/core/tests/suite/network_approval.rs | 19 +++++++++++++++----
 1 file changed, 15 insertions(+), 4 deletions(-)

diff --git a/codex-rs/core/tests/suite/network_approval.rs b/codex-rs/core/tests/suite/network_approval.rs
index fda399249a..89aec9e3c5 100644
--- a/codex-rs/core/tests/suite/network_approval.rs
+++ b/codex-rs/core/tests/suite/network_approval.rs
@@ -1210,9 +1210,12 @@ async fn user_network_approval_once_session_and_denial_semantics(
     // The first execution may finish before or after the next manual prompt arrives.
     let mut pending = HashSet::from(matching_calls);
     let mut granted_for_session = false;
-    tokio::time::timeout(Duration::from_secs(30), async {
+    let mut seen: Vec<String> = Vec::new();
+    let wait_result = tokio::time::timeout(Duration::from_secs(30), async {
         while !pending.is_empty() {
-            match test.codex.next_event().await?.msg {
+            let msg = test.codex.next_event().await?.msg;
+            seen.push(format!("{msg:?}").chars().take(300).collect());
+            match msg {
                 EventMsg::ExecApprovalRequest(approval) => {
                     assert!(!granted_for_session, "duplicate prompt after session grant");
                     assert_eq!(approval.command, ["network-access", NETWORK_TEST_TARGET]);
@@ -1246,8 +1249,16 @@ async fn user_network_approval_once_session_and_denial_semantics(
         }
         anyhow::Ok(())
     })
-    .await
-    .context("matching executions did not finish while port 81 was pending")??;
+    .await;
+    if !matches!(wait_result, Ok(Ok(()))) {
+        eprintln!(
+            "NETWORK-APPROVAL-DIAG result={wait_result:?} pending={pending:?} granted_for_session={granted_for_session}"
+        );
+        for event in &seen {
+            eprintln!("NETWORK-APPROVAL-DIAG event {event}");
+        }
+    }
+    wait_result.context("matching executions did not finish while port 81 was pending")??;
     assert!(granted_for_session);
     test.codex
         .submit(Op::ExecApproval {
-- 
2.43.0

