+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn explicit_shell_rejects_unsupported_type_without_launch_and_runs_supported_type()
+-> Result<()> {
+    skip_if_no_network!(Ok(()));
+
+    let harness = TestCodexHarness::with_builder(test_codex()).await?;
+    let supported_shell = match core_test_support::test_target_os() {
+        core_test_support::TestTargetOs::Windows => "cmd",
+        core_test_support::TestTargetOs::Linux | core_test_support::TestTargetOs::MacOs => "sh",
+    };
+    let supported_command = "echo executed > explicit-shell-supported-marker";
+    let unsupported_arguments = json!({
+        "cmd": "echo executed > explicit-shell-unsupported-marker",
+        "shell": "fish",
+    });
+    let supported_arguments = json!({
+        "cmd": supported_command,
+        "shell": supported_shell,
+        "login": false,
+    });
+    mount_sse_sequence(
+        harness.server(),
+        vec![
+            sse(vec![
+                ev_response_created("explicit-shell-response"),
+                ev_function_call(
+                    "explicit-shell-unsupported",
+                    "exec_command",
+                    &serde_json::to_string(&unsupported_arguments)?,
+                ),
+                ev_function_call(
+                    "explicit-shell-supported",
+                    "exec_command",
+                    &serde_json::to_string(&supported_arguments)?,
+                ),
+                ev_completed("explicit-shell-response"),
+            ]),
+            sse(vec![
+                ev_assistant_message("explicit-shell-done", "done"),
+                ev_completed("explicit-shell-done"),
+            ]),
+        ],
+    )
+    .await;
+
+    harness
+        .submit_with_permission_profile(
+            "run both explicit shell commands",
+            PermissionProfile::Disabled,
+        )
+        .await?;
+
+    let unsupported_output = harness
+        .function_call_stdout("explicit-shell-unsupported")
+        .await;
+    assert!(unsupported_output.contains("fish"), "{unsupported_output}");
+    assert!(
+        !unsupported_output.contains("echo executed"),
+        "command contents leaked into the shell-selection error: {unsupported_output}"
+    );
+    assert!(
+        !harness
+            .path_exists("explicit-shell-unsupported-marker")
+            .await?,
+        "unsupported explicit shell launched its command"
+    );
+
+    let supported_output = parse_unified_exec_output(
+        &harness
+            .function_call_stdout("explicit-shell-supported")
+            .await,
+    )?;
+    assert_eq!(supported_output.exit_code, Some(0));
+    assert!(
+        harness
+            .path_exists("explicit-shell-supported-marker")
+            .await?
+    );
+    Ok(())
+}
