+fn resolve_explicit_shell(
+    shell_path: &str,
+    shell_type: Option<ShellType>,
+    available_shell: Option<Shell>,
+) -> Result<Shell, String> {
+    let Some(shell_type) = shell_type else {
+        return Err(format!(
+            "The requested shell `{shell_path}` has an unsupported type. Use an installed supported shell or omit `shell` for default discovery."
+        ));
+    };
+
+    available_shell.ok_or_else(|| {
+        format!(
+            "The requested shell `{shell_path}` (type `{shell_type:?}`) is unavailable. Use an installed supported shell or omit `shell` for default discovery."
+        )
+    })
+}
