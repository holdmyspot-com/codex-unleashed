+#[test]
+fn test_get_command_rejects_unavailable_explicit_shell_type_from_lookup_result()
+-> anyhow::Result<()> {
+    let err = resolve_explicit_shell("powershell", Some(ShellType::PowerShell), None)
+        .expect_err("a recognized but unavailable shell type must be rejected");
+
+    assert!(err.contains("powershell"), "{err}");
+    assert!(err.contains("PowerShell"), "{err}");
+    assert!(err.contains("unavailable"), "{err}");
+    assert!(
+        !err.contains("command contents"),
+        "command contents leaked into shell-selection error: {err}"
+    );
+    Ok(())
+}
+
