 }
 
 #[test_case(false, None, &["-c", "true"]; "unmasked")]
+#[test_case(true, None, &["-c", "true"]; "masking_with_supported_startup")]
 #[test_case(true, Some("BASH_ENV"), &["-c", "true"]; "masking_with_startup_hook")]
 #[test_case(true, Some("SSH_CLIENT"), &["-c", "true"]; "masking_with_remote_shell_startup")]
 #[test_case(true, None, &["-c", "-l", "true"]; "masking_with_extra_login_option")]
 #[tokio::test]
-async fn native_request_handles_remote_proxy_config_for_platform(
+async fn native_request_handles_credential_masking_for_platform(
     credential_masking: bool,
     startup_env: Option<&str>,
     shell_args: &[&str],
@@ -566,20 +567,40 @@ async fn native_request_handles_remote_proxy_config_for_platform(
         env.insert(key.to_string(), "startup-hook".to_string());
     }
 
-    let prepared = prepare_exec_request(
+    let result = prepare_exec_request(
         &params,
         env.clone(),
         /*runtime_paths*/ None,
         /*network_policy_decider*/ None,
         /*network_policy_audit_observer*/ None,
     )
-    .await
-    .expect("prepare request with executor-local proxy");
+    .await;
+
+    let unsupported_startup = startup_env.is_some() || shell_args != ["-c", "true"];
+    if credential_masking && unsupported_startup {
+        let error = result
+            .err()
+            .expect("credential masking must reject unsupported startup before launch");
+        assert!(
+            error
+                .message
+                .to_ascii_lowercase()
+                .contains("credential masking")
+        );
+        return;
+    }
+    let prepared = result.expect("prepare request with executor-local proxy");
 
     assert_eq!(prepared.command, params.argv);
-    for key in ["PATH", "OPENAI_API_KEY"].into_iter().chain(startup_env) {
+    for key in ["PATH"].into_iter().chain(startup_env) {
         assert_eq!(prepared.env.get(key), env.get(key), "{key}");
     }
+    if !credential_masking {
+        assert_eq!(
+            prepared.env.get("OPENAI_API_KEY"),
+            env.get("OPENAI_API_KEY")
+        );
+    }
 
     if cfg!(target_os = "windows") {
         assert_eq!(prepared.env.get("HTTP_PROXY"), None);
@@ -670,6 +691,53 @@ async fn disabled_remote_proxy_config_is_rejected_before_exporting_ports() {
     );
 }
 
+#[cfg(not(target_os = "windows"))]
+#[tokio::test]
+async fn credential_masking_rejects_unsupported_shell_startup() {
+    let cwd: AbsolutePathBuf = std::env::current_dir()
+        .expect("current directory")
+        .try_into()
+        .expect("absolute cwd");
+    let mut proxy_config = RemoteNetworkProxyConfig::from_effective_config(&NetworkProxyConfig {
+        enabled: true,
+        ..NetworkProxyConfig::default()
+    })
+    .expect("supported remote proxy config");
+    proxy_config.enable_credential_masking(Default::default());
+    let params = ExecParams {
+        metadata: Default::default(),
+        process_id: ProcessId::from("process-credential-masking-unsupported-startup"),
+        argv: vec![
+            "/bin/bash".to_string(),
+            "-c".to_string(),
+            "true".to_string(),
+        ],
+        cwd: PathUri::from_abs_path(&cwd),
+        shell_snapshot: None,
+        env_policy: None,
+        env: HashMap::new(),
+        tty: false,
+        pipe_stdin: false,
+        arg0: None,
+        sandbox: None,
+        enforce_managed_network: false,
+        managed_network: None,
+        network_proxy: Some(RemoteNetworkProxyLaunchConfig::new(proxy_config)),
+    };
+    let env = HashMap::from([("BASH_ENV".to_string(), "startup-hook".to_string())]);
+
+    let error = prepare_exec_request(
+        &params, env, /*runtime_paths*/ None, /*network_policy_decider*/ None,
+        /*network_policy_audit_observer*/ None,
+    )
+    .await
+    .err()
+    .expect("credential masking must reject an unsupported startup before launch");
+
+    assert!(error.message.contains("Credential masking"));
+    assert!(error.message.contains("startup"));
+}
+
 #[cfg(windows)]
 #[test_case(WindowsSandboxLevel::RestrictedToken ; "unelevated is rejected")]
 #[test_case(WindowsSandboxLevel::Elevated ; "elevated is accepted")]
