+#[tokio::test]
+async fn static_manager_uses_default_when_no_model_is_requested_regardless_of_fallback_policy() {
+    let manager = static_manager_for_tests(ModelsResponse {
+        models: vec![
+            remote_model("provider-default", "Default", /*priority*/ 0),
+            remote_model("provider-supported", "Supported", /*priority*/ 1),
+        ],
+    });
+    let requested_model = None;
+
+    for allow_provider_model_fallback in [false, true] {
+        let model = manager
+            .get_default_model(
+                &requested_model,
+                allow_provider_model_fallback,
+                RefreshStrategy::Offline,
+                DEFAULT_HTTP_CLIENT_FACTORY,
+            )
+            .await;
+
+        assert_eq!(model, "provider-default");
+    }
+}
