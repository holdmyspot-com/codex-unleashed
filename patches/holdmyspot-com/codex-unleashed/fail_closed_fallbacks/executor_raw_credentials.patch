diff --git a/codex-rs/exec-server/src/process_sandbox_tests.rs b/codex-rs/exec-server/src/process_sandbox_tests.rs
index f69a262e33dac1d0f6f4ac62819c8561e94b5f22..a68371a1bd39aac59eb507ed2f77ef73effa0aed 100644
--- a/codex-rs/exec-server/src/process_sandbox_tests.rs
+++ b/codex-rs/exec-server/src/process_sandbox_tests.rs
@@ -640,6 +640,144 @@ async fn native_request_handles_credential_masking_for_platform(
         .expect("shut down executor proxy");
 }
 
+#[cfg(any(target_os = "linux", target_os = "macos"))]
+#[tokio::test]
+async fn native_request_rejects_recognized_raw_credentials() {
+    let cwd: AbsolutePathBuf = std::env::current_dir()
+        .expect("current directory")
+        .try_into()
+        .expect("absolute cwd");
+    let make_proxy_config = |credential_masking: bool| {
+        let mut config = NetworkProxyConfig {
+            enabled: true,
+            allow_local_binding: Some(true),
+            ..NetworkProxyConfig::default()
+        };
+        config.set_allowed_domains(vec!["allowed.example".to_string()]);
+        let mut proxy_config = RemoteNetworkProxyConfig::from_effective_config(&config)
+            .expect("supported remote proxy config");
+        if credential_masking {
+            proxy_config.enable_credential_masking(Default::default());
+        }
+        proxy_config
+    };
+    let make_params = |proxy_config| ExecParams {
+        metadata: Default::default(),
+        process_id: ProcessId::from("process-raw-credential-contract"),
+        argv: vec![
+            "/bin/bash".to_string(),
+            "-c".to_string(),
+            "true".to_string(),
+        ],
+        cwd: PathUri::from_abs_path(&cwd),
+        shell_snapshot: None,
+        env_policy: None,
+        env: HashMap::new(),
+        tty: false,
+        pipe_stdin: false,
+        arg0: None,
+        sandbox: None,
+        enforce_managed_network: false,
+        managed_network: None,
+        network_proxy: Some(
+            RemoteNetworkProxyLaunchConfig::new(proxy_config).for_execution(
+                "remote".to_string(),
+                "execution-raw-credentials".to_string(),
+            ),
+        ),
+    };
+    let raw_credential = "opaque-executor-credential";
+    let raw_env = HashMap::from([
+        (
+            "GH_ENTERPRISE_TOKEN".to_string(),
+            raw_credential.to_string(),
+        ),
+        (
+            "AUTH_HEADER".to_string(),
+            format!("Bearer {raw_credential}"),
+        ),
+    ]);
+
+    let error = prepare_exec_request(
+        &make_params(make_proxy_config(/*credential_masking*/ true)),
+        raw_env.clone(),
+        /*runtime_paths*/ None,
+        /*network_policy_decider*/ None,
+        /*network_policy_audit_observer*/ None,
+    )
+    .await
+    .err()
+    .expect("active credential masking must reject recognized raw credentials");
+
+    assert_eq!(error.code, -32602);
+    assert_eq!(
+        error.message,
+        "credential masking left an unmasked credential in the command environment"
+    );
+    assert!(!error.message.contains(raw_credential));
+    assert!(!error.message.contains("AUTH_HEADER"));
+    assert!(!error.message.contains("GH_ENTERPRISE_TOKEN"));
+
+    let github_token = "github_pat_11AA0bbCC_abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGH";
+    let raw_github_authorization = format!("Bearer {github_token}");
+    let mut prepared = prepare_exec_request(
+        &make_params(make_proxy_config(/*credential_masking*/ true)),
+        HashMap::from([
+            ("GH_TOKEN".to_string(), github_token.to_string()),
+            ("AUTH_HEADER".to_string(), raw_github_authorization.clone()),
+        ]),
+        /*runtime_paths*/ None,
+        /*network_policy_decider*/ None,
+        /*network_policy_audit_observer*/ None,
+    )
+    .await
+    .expect("bindable GitHub token must be masked");
+
+    let masked_github_token = prepared
+        .env
+        .get("GH_TOKEN")
+        .expect("masked GitHub token placeholder");
+    assert_ne!(masked_github_token, github_token);
+    assert!(masked_github_token.starts_with("github_pat_"));
+    assert_eq!(
+        prepared.env.get("AUTH_HEADER"),
+        Some(&format!("Bearer {masked_github_token}"))
+    );
+    prepared
+        .network_proxy_handle
+        .take()
+        .expect("running executor proxy")
+        .shutdown()
+        .await
+        .expect("shut down executor proxy");
+
+    let mut prepared = prepare_exec_request(
+        &make_params(make_proxy_config(/*credential_masking*/ false)),
+        raw_env,
+        /*runtime_paths*/ None,
+        /*network_policy_decider*/ None,
+        /*network_policy_audit_observer*/ None,
+    )
+    .await
+    .expect("explicitly disabled credential masking must preserve raw credentials");
+
+    assert_eq!(
+        prepared.env.get("GH_ENTERPRISE_TOKEN"),
+        Some(&raw_credential.to_string())
+    );
+    assert_eq!(
+        prepared.env.get("AUTH_HEADER"),
+        Some(&format!("Bearer {raw_credential}"))
+    );
+    prepared
+        .network_proxy_handle
+        .take()
+        .expect("running executor proxy")
+        .shutdown()
+        .await
+        .expect("shut down executor proxy");
+}
+
 #[cfg(not(target_os = "windows"))]
 #[tokio::test]
 async fn disabled_remote_proxy_config_is_rejected_before_exporting_ports() {
