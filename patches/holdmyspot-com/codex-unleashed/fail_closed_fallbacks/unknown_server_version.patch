+#[tokio::test]
+async fn unknown_server_version_notice_transitions_to_known_overview() {
+    let mut app = make_test_app().await;
+    app.app_server_target = AppServerTarget::Remote {
+        endpoint: crate::RemoteAppServerEndpoint::WebSocket {
+            websocket_url: "ws://127.0.0.1:4500".to_string(),
+            auth_token: None,
+        },
+    };
+    app.local_settings.tui.show_server_version_notice = true;
+
+    assert_eq!(
+        app.initialize_server_version_notice("0.153.0", None),
+        Some("The connected app-server did not provide a valid version. Its distribution and compatibility with this Codex CLI could not be verified.".to_string())
+    );
+    assert_eq!(
+        app.agents_overview
+            .view_state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .server_version_notice,
+        Some("The connected app-server did not provide a valid version. Its distribution and compatibility with this Codex CLI could not be verified.".to_string())
+    );
+    assert_eq!(
+        app.initialize_server_version_notice("0.153.0", Some("malformed server version")),
+        Some("The connected app-server did not provide a valid version. Its distribution and compatibility with this Codex CLI could not be verified.".to_string())
+    );
+    assert_eq!(
+        app.agents_overview
+            .view_state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .server_version_notice,
+        Some("The connected app-server did not provide a valid version. Its distribution and compatibility with this Codex CLI could not be verified.".to_string())
+    );
+
+    assert_eq!(
+        app.initialize_server_version_notice("0.153.0", Some("0.152.1")),
+        Some(
+            "A background Codex service is running v0.152.1, older than your Codex CLI v0.153.0."
+                .to_string()
+        )
+    );
+    assert_eq!(
+        app.agents_overview
+            .view_state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .server_version_notice,
+        Some("Service v0.152.1 < Codex CLI v0.153.0".to_string())
+    );
+}
