+#[test]
+fn unknown_server_version_notice_renders_without_echoing_malformed_input() {
+    let target = crate::AppServerTarget::Remote {
+        endpoint: crate::RemoteAppServerEndpoint::UnixSocket {
+            socket_path: AbsolutePathBuf::from_absolute_path(
+                std::env::temp_dir().join("codex.sock"),
+            )
+            .expect("absolute socket path"),
+        },
+    };
+    let settings = codex_config::types::Tui {
+        show_server_version_notice: true,
+        ..Default::default()
+    };
+    let malformed = "not a semantic version";
+    let (notice, _) = crate::status::remote_connection::pending_server_version_notice(
+        &settings,
+        &target,
+        /*server_home*/ None,
+        "0.160.0+39",
+        Some(malformed),
+        /*last_shown*/ None,
+    )
+    .expect("malformed remote version should have a warning");
+    let rendered =
+        render_lines(&new_server_version_warning(notice).transcript_lines(/*width*/ 160))
+            .join("\n");
+
+    assert!(
+        rendered.contains("The connected app-server did not provide a valid version."),
+        "{rendered}"
+    );
+    assert!(!rendered.contains(malformed), "{rendered}");
+}
