@@ -89,6 +91,64 @@ struct ShellSnapshot {
 // Keep a bounded metric label alongside the original RPC error.
 type CaptureResult = Result<ShellSnapshot, (&'static str, JSONRPCErrorError)>;
 
+#[derive(Debug)]
+enum SnapshotTransportFailure {
+    Materialization(std::io::Error),
+    BlockingTask(tokio::task::JoinError),
+}
+
+impl SnapshotTransportFailure {
+    fn kind(&self) -> &'static str {
+        match self {
+            Self::Materialization(error) => {
+                let _ = error.kind();
+                "materialization"
+            }
+            Self::BlockingTask(error) => {
+                let _ = error.is_cancelled();
+                "blocking_task"
+            }
+        }
+    }
+}
+
+enum SnapshotTransportDecision<T> {
+    Ready(T),
+    Fallback { failure: SnapshotTransportFailure },
+    Reject(SnapshotTransportFailure),
+}
+
+fn protected_snapshot_capture_result(
+    protected: bool,
+    result: CaptureResult,
+) -> Result<Result<ShellSnapshot, Instant>, JSONRPCErrorError> {
+    match result {
+        Err((_, error)) if protected => Err(error),
+        result => Ok(result.map_err(|_| Instant::now())),
+    }
+}
+
+fn snapshot_transport_decision<T>(
+    protected: bool,
+    result: Result<Result<T, std::io::Error>, tokio::task::JoinError>,
+) -> SnapshotTransportDecision<T> {
+    match result {
+        Ok(Ok(reader)) => SnapshotTransportDecision::Ready(reader),
+        Ok(Err(error)) if protected => {
+            SnapshotTransportDecision::Reject(SnapshotTransportFailure::Materialization(error))
+        }
+        Err(error) if protected => {
+            SnapshotTransportDecision::Reject(SnapshotTransportFailure::BlockingTask(error))
+        }
+        Ok(Err(error)) => SnapshotTransportDecision::Fallback {
+            failure: SnapshotTransportFailure::Materialization(error),
+        },
+        Err(error) => SnapshotTransportDecision::Fallback {
+            failure: SnapshotTransportFailure::BlockingTask(error),
+        },
+    }
+}
+
 #[derive(Clone, Copy, PartialEq, Eq)]
 pub(crate) enum CapturePurpose {
     Execution,
