+fn protected_snapshot_test_params(env: HashMap<String, String>) -> ExecParams {
+    ExecParams {
+        metadata: None,
+        process_id: ProcessId::from("protected-snapshot-test"),
+        argv: vec![
+            "/bin/zsh".to_string(),
+            "-lc".to_string(),
+            "true".to_string(),
+        ],
+        cwd: codex_utils_path_uri::PathUri::from_host_native_path(
+            std::env::current_dir().expect("current directory"),
+        )
+        .expect("current directory URI"),
+        env_policy: None,
+        shell_snapshot: None,
+        env,
+        tty: false,
+        pipe_stdin: false,
+        arg0: None,
+        sandbox: None,
+        enforce_managed_network: false,
+        managed_network: None,
+        network_proxy: None,
+    }
+}
+
+#[test]
+fn protected_snapshot_capture_failure_is_returned() {
+    for (reason, error) in [
+        (
+            "nonzero_exit",
+            JSONRPCErrorError {
+                code: -32001,
+                data: Some(serde_json::json!({"capture": "nonzero_exit"})),
+                message: "capture exited unsuccessfully".to_string(),
+            },
+        ),
+        (
+            "credential_snapshot",
+            JSONRPCErrorError {
+                code: -32603,
+                data: Some(serde_json::json!({"capture": "unsafe_state"})),
+                message: "unsafe captured credential state".to_string(),
+            },
+        ),
+        (
+            "spawn_failure",
+            JSONRPCErrorError {
+                code: -32002,
+                data: Some(serde_json::json!({"capture": "transient_transport"})),
+                message: "capture process transport failed".to_string(),
+            },
+        ),
+    ] {
+        let protected = protected_snapshot_capture_result(
+            /*protected*/ true,
+            Err((reason, error.clone())),
+        );
+        assert!(matches!(protected, Err(actual) if actual == error));
+
+        let unprotected =
+            protected_snapshot_capture_result(/*protected*/ false, Err((reason, error)));
+        assert!(matches!(unprotected, Ok(Err(_))));
+    }
+}
+
+async fn credential_snapshot_test_proxy() -> NetworkProxy {
+    let credential_brokers = codex_network_proxy::RemoteCredentialBrokerCache::default();
+    let mut remote = RemoteNetworkProxyConfig::from_effective_config(&NetworkProxyConfig {
+        enabled: true,
+        ..NetworkProxyConfig::default()
+    })
+    .expect("remote proxy config");
+    remote.enable_credential_masking(Default::default());
+    let state = NetworkProxyState::from_remote_launch_config(
+        RemoteNetworkProxyLaunchConfig::new(remote),
+        codex_utils_path_uri::Platform::native(),
+        &credential_brokers,
+        &HashMap::new(),
+    )
+    .expect("network proxy state");
+    NetworkProxy::builder()
+        .state(Arc::new(state))
+        .build()
+        .await
+        .expect("network proxy")
+}
+
+#[tokio::test]
+async fn protected_snapshot_rejects_recognized_raw_credentials() {
+    let proxy = credential_snapshot_test_proxy().await;
+    let credential_brokers = codex_network_proxy::RemoteCredentialBrokerCache::default();
+    let params = protected_snapshot_test_params(HashMap::new());
+    let raw = b"opaque-executor-credential";
+    let unbound_capture = [
+        b"# Snapshot file\n\0\0\0GH_ENTERPRISE_TOKEN=".as_slice(),
+        raw,
+        b"\0AUTH_HEADER=Bearer ".as_slice(),
+        raw,
+        b"\0".as_slice(),
+    ]
+    .concat();
+    let result = credentials::prepare(
+        &params,
+        &unbound_capture,
+        SnapshotReplay::Environment,
+        &proxy,
+        &credential_brokers,
+    )
+    .await;
+    let Err(error) = result else {
+        panic!("unbound recognized credential must be rejected");
+    };
+    assert_eq!(error.0, "credential_proxy");
+    assert_eq!(error.1.code, -32603);
+    assert!(
+        error
+            .1
+            .message
+            .contains("failed to prepare startup credentials")
+    );
+    assert!(!error.1.message.contains("opaque-executor-credential"));
+
+    let bound_capture = [
+        b"# Snapshot file\n\0\0\0GH_TOKEN=".as_slice(),
+        raw,
+        b"\0".as_slice(),
+    ]
+    .concat();
+    let snapshot = credentials::prepare(
+        &params,
+        &bound_capture,
+        SnapshotReplay::Environment,
+        &proxy,
+        &credential_brokers,
+    )
+    .await
+    .expect("bound credential should be safely virtualized");
+    let token = snapshot
+        .environment
+        .get("GH_TOKEN")
+        .expect("replayed token");
+    assert_ne!(token, "opaque-executor-credential");
+    assert!(token.contains("masked"));
+    assert!(
+        !snapshot
+            .environment
+            .values()
+            .any(|value| value.contains("opaque-executor-credential"))
+    );
+
+    let ordinary_capture = b"# Snapshot file\n\0\0\0ORDINARY=visible\0";
+    let snapshot = credentials::prepare(
+        &params,
+        ordinary_capture,
+        SnapshotReplay::Environment,
+        &proxy,
+        &credential_brokers,
+    )
+    .await
+    .expect("ordinary environment should remain valid");
+    assert_eq!(
+        snapshot.environment.get("ORDINARY"),
+        Some(&"visible".to_string())
+    );
+}
+
+#[tokio::test]
+async fn protected_snapshot_transport_failure_is_returned() {
+    let protected_success = snapshot_transport_decision(
+        /*protected*/ true,
+        Ok::<_, tokio::task::JoinError>(Ok::<_, std::io::Error>(7)),
+    );
+    assert!(matches!(
+        protected_success,
+        SnapshotTransportDecision::Ready(7)
+    ));
+
+    let protected_materialization = snapshot_transport_decision(
+        /*protected*/ true,
+        Ok::<Result<usize, std::io::Error>, tokio::task::JoinError>(Err(std::io::Error::other(
+            "test materialization failure",
+        ))),
+    );
+    assert!(
+        !matches!(
+            protected_materialization,
+            SnapshotTransportDecision::Fallback { .. }
+        ),
+        "protected materialization failure must reject instead of falling back"
+    );
+
+    let join_failure = tokio::spawn(async {
+        panic!("test blocking task failure");
+        #[allow(unreachable_code)]
+        Ok::<usize, std::io::Error>(7)
+    })
+    .await
+    .expect_err("blocking task should fail");
+    let protected_join_failure = snapshot_transport_decision(
+        /*protected*/ true,
+        Err::<Result<usize, std::io::Error>, tokio::task::JoinError>(join_failure),
+    );
+    assert!(
+        !matches!(
+            protected_join_failure,
+            SnapshotTransportDecision::Fallback { .. }
+        ),
+        "protected blocking-task failure must reject instead of falling back"
+    );
+
+    let unprotected = snapshot_transport_decision(
+        /*protected*/ false,
+        Ok::<Result<usize, std::io::Error>, tokio::task::JoinError>(Err(std::io::Error::other(
+            "test materialization failure",
+        ))),
+    );
+    assert!(matches!(
+        unprotected,
+        SnapshotTransportDecision::Fallback { .. }
+    ));
+}
 
