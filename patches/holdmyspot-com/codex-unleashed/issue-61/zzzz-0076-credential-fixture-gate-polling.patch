From 79152d03ec2dc8e5d1392d153196597f4608487d Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Thu, 22 Oct 2026 12:59:49 +0000
Subject: [PATCH] Bound Windows credential fixture concurrency without relaxing
 deadlines

The native Windows model-provider target fails 4/10 repeated runs with default Rust test threading and passes 10/10 with one Rust thread, holding five Bazel test actions fixed on the same runner (39775656235). Retain all tests and the 5000 ms export and ten-second coordination deadlines. Sleep between gate checks and serialize this test binary on Windows; other test binaries remain parallel.
---
 codex-rs/model-provider/BUILD.bazel     | 4 ++++
 codex-rs/model-provider/src/provider.rs | 2 +-
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/codex-rs/model-provider/BUILD.bazel b/codex-rs/model-provider/BUILD.bazel
index 7fd0b25..ee7259d 100644
--- a/codex-rs/model-provider/BUILD.bazel
+++ b/codex-rs/model-provider/BUILD.bazel
@@ -3,4 +3,8 @@ load("//:defs.bzl", "codex_rust_crate")
 codex_rust_crate(
     name = "model-provider",
     crate_name = "codex_model_provider",
+    unit_test_args = select({
+        "@platforms//os:windows": ["--test-threads=1"],
+        "//conditions:default": [],
+    }),
 )
diff --git a/codex-rs/model-provider/src/provider.rs b/codex-rs/model-provider/src/provider.rs
index f8f0790..9ce7d63 100644
--- a/codex-rs/model-provider/src/provider.rs
+++ b/codex-rs/model-provider/src/provider.rs
@@ -1038,7 +1038,7 @@ printf '%s\n' '{"AccessKeyId":"exported","SecretAccessKey":"secret"}'
                 result = &mut first_refresh => panic!("export should wait for its gate: {result:?}"),
                 () = async {
                     while !export_counter.exists() {
-                        tokio::task::yield_now().await;
+                        tokio::time::sleep(std::time::Duration::from_millis(10)).await;
                     }
                 } => {}
             }
--
