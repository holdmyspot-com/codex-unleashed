+load("@rules_cc//cc:cc_test.bzl", "cc_test")
+
+cc_test(
+    name = "lifetime_attribute_test",
+    size = "small",
+    srcs = ["lifetime_attribute_test.cc"],
+    deps = [
+        "@abseil-cpp//absl/container:btree",
+        "@abseil-cpp//absl/container:flat_hash_map",
