From a208157421f9cd6e0ae8faf0b3d4cf52b33abc3e Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Thu, 15 Oct 2026 21:22:45 -0400
Subject: [PATCH] Backport Abseil lifetime-capture attribute migration

Preserve compilation and runtime fixes without warning-only dependency changes.
---
 MODULE.bazel                                   |  1 +
 tools/build-warnings/abseil/BUILD.bazel        | 13 +++++++++++++
 .../abseil/lifetime_attribute_test.cc          | 18 ++++++++++++++++++
 3 files changed, 32 insertions(+)
 create mode 100644 tools/build-warnings/abseil/BUILD.bazel
 create mode 100644 tools/build-warnings/abseil/lifetime_attribute_test.cc

diff --git a/MODULE.bazel b/MODULE.bazel
index a7ff40feb..37ae61cd7 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -75,6 +75,7 @@ use_repo(windows_sdk, "windows_sdk")

 # Abseil picks a MinGW pthread TLS path that does not match our hermetic
 # windows-gnullvm toolchain; force it onto the portable C++11 thread-local path.
+bazel_dep(name = "abseil-cpp", version = "20250814.1")
 single_version_override(
     module_name = "abseil-cpp",
     patch_strip = 1,
diff --git a/tools/build-warnings/abseil/BUILD.bazel b/tools/build-warnings/abseil/BUILD.bazel
new file mode 100644
index 000000000..a29586d5a
--- /dev/null
+++ b/tools/build-warnings/abseil/BUILD.bazel
@@ -0,0 +1,13 @@
+load("@rules_cc//cc:cc_test.bzl", "cc_test")
+
+cc_test(
+    name = "lifetime_attribute_test",
+    size = "small",
+    srcs = ["lifetime_attribute_test.cc"],
+    deps = [
+        "@abseil-cpp//absl/container:btree",
+        "@abseil-cpp//absl/container:flat_hash_map",
+        "@abseil-cpp//absl/status:statusor",
+        "@abseil-cpp//absl/synchronization",
+    ],
+)
diff --git a/tools/build-warnings/abseil/lifetime_attribute_test.cc b/tools/build-warnings/abseil/lifetime_attribute_test.cc
new file mode 100644
index 000000000..8c5815ae9
--- /dev/null
+++ b/tools/build-warnings/abseil/lifetime_attribute_test.cc
@@ -0,0 +1,18 @@
+#include "absl/container/btree_map.h"
+#include "absl/container/flat_hash_map.h"
+#include "absl/status/statusor.h"
+#include "absl/synchronization/mutex.h"
+
+int main() {
+  absl::Mutex mutex;
+  {
+    absl::MutexLock lock(mutex);
+  }
+  {
+    absl::ReaderMutexLock lock(mutex);
+  }
+  {
+    absl::WriterMutexLock lock(mutex);
+  }
+  return 0;
+}
