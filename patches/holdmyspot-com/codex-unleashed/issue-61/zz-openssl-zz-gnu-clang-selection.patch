From 59be48172017a0529025d099f428f8534c7384cc Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Thu, 15 Oct 2026 21:30:56 -0400
Subject: [PATCH] Select OpenSSL Windows GNU Clang assembly configuration

Preserve functional changes without warning-only dependency patches.
---
 MODULE.bazel                                 |  2 +-
 patches/openssl_gnu_clang_selection.patch    | 63 ++++++++++++++++++++
 tools/build-warnings/openssl/BUILD.bazel     |  8 ++-
 tools/build-warnings/openssl/inputs_test.bzl | 13 ++++
 4 files changed, 84 insertions(+), 2 deletions(-)
 create mode 100644 patches/openssl_gnu_clang_selection.patch

diff --git a/MODULE.bazel b/MODULE.bazel
index 773748b17..df230a467 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -520,7 +520,7 @@ bazel_dep(name = "openssl", version = "4.0.1.bcr.0")
 single_version_override(
     module_name = "openssl",
     patch_strip = 1,
-    patches = [],
+    patches = ["//patches:openssl_gnu_clang_selection.patch"],
 )

 inject_repo(crate, "xz")
diff --git a/patches/openssl_gnu_clang_selection.patch b/patches/openssl_gnu_clang_selection.patch
new file mode 100644
index 000000000..0c83b53aa
--- /dev/null
+++ b/patches/openssl_gnu_clang_selection.patch
@@ -0,0 +1,63 @@
+From 127ac1bc4837ef927be316cd28fb8f4aa5c12e42 Mon Sep 17 00:00:00 2001
+From: Gili Tzabari <cowwoc2020@gmail.com>
+Date: Thu, 15 Oct 2026 06:02:59 +0000
+Subject: [PATCH] Select non-MSVC OpenSSL configuration for Windows GNU Clang
+
+---
+ BUILD.bazel         |  4 +++-
+ configs/BUILD.bazel | 13 +++++++------
+ 2 files changed, 10 insertions(+), 7 deletions(-)
+
+diff --git a/BUILD.bazel b/BUILD.bazel
+index 3896da5..43b42e3 100755
+--- a/BUILD.bazel
++++ b/BUILD.bazel
+@@ -340,4 +340,5 @@ PERLASM_TOOLS = glob(["crypto/perlasm/*.pl"])
+ perl_genrule(
+     name = "perlasm_genfiles",
++    visibility = ["@@//tools/build-warnings/openssl:__pkg__"],
+     additional_srcs = select({
+         "//configs:windows_msvc": PERLASM_TOOLS + ["crypto/ec/ecp_nistz256_table.c"],
+@@ -456,8 +457,9 @@ COMMON_LOCAL_DEFINES = select({
+         "WIN32_LEAN_AND_MEAN",
+     ],
+-    "//configs:windows_non_msvc": [
++    "//configs:windows_clang_cl": [
+         "_WINSOCKAPI_",
+         "WIN32_LEAN_AND_MEAN",
+     ],
++    "@platforms//os:windows": ["WIN32_LEAN_AND_MEAN"],
+     "//conditions:default": [],
+ })
+diff --git a/configs/BUILD.bazel b/configs/BUILD.bazel
+index 88b6413..23378be 100755
+--- a/configs/BUILD.bazel
++++ b/configs/BUILD.bazel
+@@ -150,4 +150,5 @@ selects.config_setting_group(
+     name = "windows_non_msvc",
+     match_any = [
++        ":windows_clang",
+         ":windows_clang_cl",
+         ":windows_mingw",
+@@ -158,7 +159,7 @@ selects.config_setting_group(
+ selects.config_setting_group(
+     name = "windows_x64_non_msvc",
+-    match_any = [
+-        ":windows_x64_clang_cl",
+-        ":windows_x64_mingw",
++    match_all = [
++        ":windows_x64",
++        ":windows_non_msvc",
+     ],
+     visibility = ["//visibility:public"],
+@@ -167,7 +168,7 @@ selects.config_setting_group(
+ selects.config_setting_group(
+     name = "windows_arm64_non_msvc",
+-    match_any = [
+-        ":windows_arm64_clang_cl",
+-        ":windows_arm64_mingw",
++    match_all = [
++        ":windows_arm64",
++        ":windows_non_msvc",
+     ],
+     visibility = ["//visibility:public"],
diff --git a/tools/build-warnings/openssl/BUILD.bazel b/tools/build-warnings/openssl/BUILD.bazel
index a9f0e11a7..4ce254dc4 100644
--- a/tools/build-warnings/openssl/BUILD.bazel
+++ b/tools/build-warnings/openssl/BUILD.bazel
@@ -1,6 +1,12 @@
 load("@rules_cc//cc:cc_test.bzl", "cc_test")
 load("@rules_rs//rs:rust_test.bzl", "rust_test")
-load(":inputs_test.bzl", "openssl_install_inputs_test")
+load(":inputs_test.bzl", "openssl_install_inputs_test", "openssl_windows_perlasm_test")
+
+openssl_windows_perlasm_test(
+    name = "windows_perlasm_test",
+    size = "small",
+    target_under_test = "@openssl//:perlasm_genfiles",
+)

 openssl_install_inputs_test(
     name = "rust_install_inputs_test",
diff --git a/tools/build-warnings/openssl/inputs_test.bzl b/tools/build-warnings/openssl/inputs_test.bzl
index 1d2e66334..593739923 100644
--- a/tools/build-warnings/openssl/inputs_test.bzl
+++ b/tools/build-warnings/openssl/inputs_test.bzl
@@ -18,3 +18,16 @@ openssl_install_inputs_test = analysistest.make(
     _openssl_install_inputs_test_impl,
     attrs = {"install": attr.label(default = "@openssl//:gen_dir")},
 )
+
+def _openssl_windows_perlasm_test_impl(ctx):
+    env = analysistest.begin(ctx)
+    actions = [action for action in analysistest.target_actions(env) if action.mnemonic == "OpenSSLPerlasm"]
+    asserts.true(env, len(actions) > 0, "OpenSSL must generate its Windows assembly")
+    for action in actions:
+        asserts.true(env, "mingw64" in action.argv, "Windows GNU Clang selects MinGW assembly: %s" % action.argv)
+    return analysistest.end(env)
+
+openssl_windows_perlasm_test = analysistest.make(
+    _openssl_windows_perlasm_test_impl,
+    config_settings = {"//command_line_option:platforms": str(Label("//:windows_x86_64_gnullvm"))},
+)
