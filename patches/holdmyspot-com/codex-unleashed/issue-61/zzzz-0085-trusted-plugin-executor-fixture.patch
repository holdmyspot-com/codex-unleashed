+    let environment = mcp.auto_env()?.environment();
+    let file_system = environment.get_filesystem();
+    let executor_cwd = &mcp.auto_env()?.selection().cwd;
+    let command_script_path = if environment.is_remote() {
+        let executor_script = executor_cwd
+            .join("plugins/cache/openai-api-curated/google-calendar/01234567/scripts/run.sh")?;
+        file_system
+            .create_directory(
+                &executor_script
