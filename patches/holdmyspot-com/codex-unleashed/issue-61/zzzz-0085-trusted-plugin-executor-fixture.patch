+                    .expect("script path should have parent"),
+                CreateDirectoryOptions {
+                    recursive: true,
+                    follow_symlinks: true,
+                },
+                /*sandbox*/ None,
+            )
+            .await?;
+        let script_bytes = std::fs::read(&script_path)?;
+        file_system
+            .write_file(
+                &executor_script,
+                script_bytes.clone(),
+                Default::default(),
+                /*sandbox*/ None,
+            )
+            .await?;
+        assert_eq!(
+            file_system
+                .read_file(&executor_script, Default::default(), /*sandbox*/ None)
+                .await?,
+            script_bytes
+        );
+        executor_script.to_path_buf()
+    } else {
+        script_path.clone()
+    };
+    let missing_cwd = if launch_failed {
+        let missing_cwd = executor_cwd.join("missing-work-directory")?;
+        assert_eq!(
+            file_system
+                .get_metadata(&missing_cwd, Default::default(), /*sandbox*/ None)
+                .await
+                .expect_err("launch failure cwd must be absent on the selected executor")
+                .kind(),
+            std::io::ErrorKind::NotFound
+        );
+        Some(missing_cwd.to_path_buf())
+    } else {
+        None
+    };
