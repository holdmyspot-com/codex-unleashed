From 9c1f2cc8029d224f0ab441c0f04542bc2ebb2808 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Fri, 16 Oct 2026 19:00:52 +0000
Subject: [PATCH] Expect stale updater ownership rejection before elevation
 checks

A stale predecessor is rejected before launching its replacement. The handoff regression must assert that earlier error rather than an elevation error while retaining both predecessor-record preservation assertions.

Native red: job 117096549128 fails failed_updater_handoff_preserves_predecessor_record. Maintained just fmt-check passes. Native green verification remains pending in the CI repair execution record.
---
 codex-rs/app-server-daemon/src/backend/pid_tests.rs | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/codex-rs/app-server-daemon/src/backend/pid_tests.rs b/codex-rs/app-server-daemon/src/backend/pid_tests.rs
index 72004bbc9..fcda8504f 100644
--- a/codex-rs/app-server-daemon/src/backend/pid_tests.rs
+++ b/codex-rs/app-server-daemon/src/backend/pid_tests.rs
@@ -787,7 +787,13 @@ async fn failed_updater_handoff_preserves_predecessor_record() {
             .await
             .unwrap();
         let error = backend.replace_current_updater().await.unwrap_err();
-        if elevated {
+        if record.process_start_time == "stale" {
+            assert!(
+                error
+                    .to_string()
+                    .contains("updater ownership changed before handoff")
+            );
+        } else if elevated {
             assert!(error.to_string().contains("non-elevated terminal"));
         } else {
             // Windows may reject breakaway before reporting the missing executable.
-- 
