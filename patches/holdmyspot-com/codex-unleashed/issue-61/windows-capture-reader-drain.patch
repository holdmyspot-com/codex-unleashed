-    struct NonOwningPipeHandle(HANDLE);
-
-    // SAFETY: Pipe handles are opaque process-wide tokens that may be used from
-    // any thread. This wrapper does not own the handle or extend its lifetime.
-    unsafe impl Send for NonOwningPipeHandle {}
-
-    impl NonOwningPipeHandle {
-        fn raw(&self) -> HANDLE {
-            self.0
+    fn read_capture_pipe(pipe: OwnedHandle, finished: Arc<AtomicBool>) -> Vec<u8> {
+        let mut output = Vec::new();
+        let mut buffer = [0u8; 8192];
+        let mut remaining = None;
+        loop {
+            let has_finished = finished.load(Ordering::Acquire);
+            let mut available = 0;
+            let ok = unsafe {
+                PeekNamedPipe(
+                    pipe.as_raw_handle() as _,
+                    ptr::null_mut(),
+                    0,
+                    ptr::null_mut(),
+                    &mut available,
+                    ptr::null_mut(),
+                )
+            };
+            if ok == 0 {
+                break;
+            }
+            if has_finished && remaining.is_none() {
+                // Descendants may keep writing after root exit. Drain only the
+                // bytes already pending when completion is first observed.
+                remaining = Some(available);
+            }
+            let to_read = available.min(remaining.unwrap_or(available));
+            if to_read == 0 {
+                if has_finished {
+                    break;
+                }
+                std::thread::sleep(Duration::from_millis(5));
+                continue;
+            }
+            let mut read_bytes = 0;
+            let ok = unsafe {
+                ReadFile(
+                    pipe.as_raw_handle() as _,
+                    buffer.as_mut_ptr(),
+                    to_read.min(buffer.len() as u32),
+                    &mut read_bytes,
+                    ptr::null_mut(),
+                )
+            };
+            if ok == 0 || read_bytes == 0 {
+                break;
+            }
+            output.extend_from_slice(&buffer[..read_bytes as usize]);
+            if let Some(remaining) = remaining.as_mut() {
+                *remaining -= read_bytes;
+            }
         }
+        output
     }

     enum WaitOutcome {
