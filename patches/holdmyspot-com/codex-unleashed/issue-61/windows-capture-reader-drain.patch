+        let t_out = std::thread::spawn(move || read_capture_pipe(out_r, stdout_finished));
+        let t_err = std::thread::spawn(move || read_capture_pipe(err_r, stderr_finished));

         let wait_outcome = wait_for_process(pi.hProcess, timeout_ms, cancellation.as_ref());
         let timed_out = matches!(wait_outcome, WaitOutcome::TimedOut);
