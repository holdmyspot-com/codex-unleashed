+fn publish_pid_command(path: &Path) -> String {
+    let pending = path.with_extension("pending");
+    format!(
+        "Set-Content -LiteralPath '{}' -Value $PID; Move-Item -LiteralPath '{}' -Destination '{}'",
+        powershell_literal(&pending),
+        powershell_literal(&pending),
