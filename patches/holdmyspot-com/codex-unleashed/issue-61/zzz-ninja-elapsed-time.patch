diff --git a/patches/ninja_elapsed_time.patch b/patches/ninja_elapsed_time.patch
new file mode 100644
index 000000000..438f0c99b
--- /dev/null
+++ b/patches/ninja_elapsed_time.patch
@@ -0,0 +1,83 @@
+From 3ba03383d6530f17623f23aacabe42fc9661f72a Mon Sep 17 00:00:00 2001
+From: Gili Tzabari <cowwoc2020@gmail.com>
+Date: Thu, 15 Oct 2026 10:49:54 +0000
+Subject: [PATCH] Preserve elapsed edge start times through completion
+
+Keep 64-bit elapsed milliseconds through edge completion. Expose the existing core sources as a library for a real Builder regression while preserving all original binary compiler flags and Windows definitions.
+---
+ BUILD.bazel | 31 ++++++++++++++++++++++++++-----
+ src/build.h |  2 +-
+ 2 files changed, 27 insertions(+), 6 deletions(-)
+
+diff --git a/BUILD.bazel b/BUILD.bazel
+index 34ca830..2f8c310 100644
+--- a/BUILD.bazel
++++ b/BUILD.bazel
+@@ -1,5 +1,6 @@
+ load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
++load("@rules_cc//cc:cc_library.bzl", "cc_library")
+
+ exports_files(["COPYING"])
+
+ SRCS = [
+@@ -36,13 +37,11 @@ SRCS = [
+ CC_SRCS = ["src/%s.cc" % (src,) for src in SRCS]
+
+ H_SRCS = ["src/%s.h" % (src,) for src in SRCS]
+
+-cc_binary(
+-    name = "ninja",
+-    srcs = [
+-        "src/ninja.cc",
+-    ] + CC_SRCS + H_SRCS + [
++cc_library(
++    name = "ninja_core",
++    srcs = CC_SRCS + H_SRCS + [
+         # Has no matching header, so it can't ride along in SRCS.
+         "src/real_command_runner.cc",
+         "src/browse.h",
+         "src/command_collector.h",
+@@ -91,6 +90,28 @@ cc_binary(
+     local_defines = select({
+         "@platforms//os:windows": ["NOMINMAX"],
+         "//conditions:default": [],
+     }),
++    includes = ["src"],
++    visibility = ["//visibility:public"],
++)
++
++cc_binary(
++    name = "ninja",
++    srcs = ["src/ninja.cc"],
++    copts = select({
++        "@platforms//os:freebsd": ["-DUSE_PPOLL"],
++        "@platforms//os:linux": ["-DUSE_PPOLL"],
++        "@platforms//os:openbsd": ["-DUSE_PPOLL"],
++        "//conditions:default": [],
++    }),
++    cxxopts = select({
++        "@rules_cc//cc/compiler:msvc-cl": ["/Zc:__cplusplus"],
++        "//conditions:default": [],
++    }),
++    local_defines = select({
++        "@platforms//os:windows": ["NOMINMAX"],
++        "//conditions:default": [],
++    }),
++    deps = [":ninja_core"],
+     visibility = ["//visibility:public"],
+ )
+diff --git a/src/build.h b/src/build.h
+index 0a4b9e2..35929cd 100644
+--- a/src/build.h
++++ b/src/build.h
+@@ -250,9 +250,9 @@ struct Builder {
+                    const std::string& deps_prefix,
+                    std::vector<Node*>* deps_nodes, std::string* err);
+
+   /// Map of running edge to time the edge started running.
+-  typedef std::map<const Edge*, int> RunningEdgeMap;
++  typedef std::map<const Edge*, int64_t> RunningEdgeMap;
+   RunningEdgeMap running_edges_;
+
+   /// Time the build started.
+   int64_t start_time_millis_;
