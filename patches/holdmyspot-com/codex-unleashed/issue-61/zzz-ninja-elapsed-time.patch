diff --git a/tools/build-warnings/ninja/elapsed_time_test.cc b/tools/build-warnings/ninja/elapsed_time_test.cc
new file mode 100644
index 000000000..ba6fd3a28
--- /dev/null
+++ b/tools/build-warnings/ninja/elapsed_time_test.cc
@@ -0,0 +1,79 @@
+#include <cstdio>
+#include <limits>
+#include <string>
+
+#include "build.h"
+#include "disk_interface.h"
+#include "manifest_parser.h"
+#include "metrics.h"
+#include "state.h"
+#include "status.h"
+#include "util.h"
+
+namespace {
+struct TimingStatus : Status {
+  int starts = 0;
+  int finishes = 0;
+  int64_t started_at = 0;
+  int64_t finished_start = 0;
+  int64_t finished_at = 0;
+
+  void EdgeAddedToPlan(const Edge*) override {}
+  void EdgeRemovedFromPlan(const Edge*) override {}
+  void BuildEdgeStarted(const Edge*, int64_t start) override {
+    ++starts;
+    started_at = start;
+  }
+  void BuildEdgeFinished(Edge*, int64_t start, int64_t end, ExitStatus,
+                         const std::string&) override {
+    ++finishes;
+    finished_start = start;
+    finished_at = end;
+  }
+  void BuildStarted() override {}
+  void BuildFinished() override {}
+  void SetExplanations(Explanations*) override {}
+  void Info(const char*, ...) override {}
+  void Warning(const char*, ...) override {}
+  void Error(const char*, ...) override {}
+};
+}  // namespace
+
+int main() {
+  const int64_t elapsed_times[] = {
+      0, static_cast<int64_t>((std::numeric_limits<int>::max)()) + 1};
+  for (int64_t elapsed : elapsed_times) {
+    State state;
+    RealDiskInterface disk;
+    ManifestParser parser(&state, &disk);
+    std::string error;
+    if (!parser.ParseTest("rule timing\n  command = unused\n"
+                          "build timing-output: timing\n", &error)) {
+      std::fprintf(stderr, "Cannot parse timing fixture: %s\n", error.c_str());
+      return 1;
+    }
+
+    BuildConfig config;
+    config.dry_run = true;
+    TimingStatus status;
+    Builder builder(&state, config, nullptr, nullptr, &disk, &status,
+                    GetTimeMillis() - elapsed);
+    if (!builder.AddTarget("timing-output", &error) ||
+        builder.Build(&error) != ExitSuccess) {
+      std::fprintf(stderr, "Cannot build timing fixture: %s\n", error.c_str());
+      return 1;
+    }
+    if (status.starts != 1 || status.finishes != 1 ||
+        status.started_at < elapsed ||
+        status.finished_start != status.started_at ||
+        status.finished_at < status.started_at) {
+      std::fprintf(stderr, "Edge timing changed between start and completion: "
+                   "%lld -> %lld (end %lld)\n",
+                   static_cast<long long>(status.started_at),
+                   static_cast<long long>(status.finished_start),
+                   static_cast<long long>(status.finished_at));
+      return 1;
+    }
+  }
+  return 0;
+}
