From 7d2c6ff04ef55b1fa467795f49222cf5d02995f3 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Wed, 14 Oct 2026 18:23:15 +0000
Subject: [PATCH] Omit inactive Darwin runtime selection while preserving
 Windows compiler-rt

Remove the C++ unwind selection from Rust links and remove compiler-rt selection only for Darwin, where Rust supplies explicit runtime archives with -nodefaultlibs. Windows GNU uses -nolibc and still requires compiler-rt selection for its builtin unwind pre-link argument. Keep compiler and linker warnings fatal.

Refs https://github.com/holdmyspot-com/codex-unleashed/issues/61
Base: rust-v0.162.1 (092d3acd6bec3e3a14bdc7e7a2810ab628ab759d)
Prerequisites: issue-60 toolchain patch and issue-61 LLVM driver fixtures.

Red: Darwin procedural-macro linking rejects unused -rtlib=compiler-rt under -Werror. Removing that option globally then makes the genuine Windows Rust binary probe reject unused --unwindlib=none.
Green: the target-specific selection links the Windows GNU probe and procedural macros for both Darwin architectures. All three Linux driver tests pass. Retain fresh emitted and hosted verification as separate gates.
---
 .../rules_rust_unwind_driver_selection.patch  |  7 ++++-
 tools/build-warnings/llvm-driver/BUILD.bazel  | 26 +++++++++++++++++++
 .../llvm-driver/linked_macro.rs               |  6 +++++
 .../llvm-driver/proc_macro_link_test.rs       |  4 +++
 .../llvm-driver/windows_gnullvm_link_probe.rs |  3 +++
 5 files changed, 45 insertions(+), 1 deletion(-)
 create mode 100644 tools/build-warnings/llvm-driver/linked_macro.rs
 create mode 100644 tools/build-warnings/llvm-driver/proc_macro_link_test.rs
 create mode 100644 tools/build-warnings/llvm-driver/windows_gnullvm_link_probe.rs

diff --git a/patches/rules_rust_unwind_driver_selection.patch b/patches/rules_rust_unwind_driver_selection.patch
index 6502f7130..59df3c67b 100644
--- a/patches/rules_rust_unwind_driver_selection.patch
+++ b/patches/rules_rust_unwind_driver_selection.patch
@@ -2,7 +2,7 @@ diff --git a/rust/private/rustc.bzl b/rust/private/rustc.bzl
 index 57b239f..e1c7f0a 100644
 --- a/rust/private/rustc.bzl
 +++ b/rust/private/rustc.bzl
-@@ -424,6 +424,10 @@ def get_linker_and_args(ctx, crate_type, toolchain, cc_toolchain, feature_config
+@@ -424,6 +424,15 @@ def get_linker_and_args(ctx, crate_type, toolchain, cc_toolchain, feature_config
              action_name = action_name,
              variables = link_variables,
          ))
@@ -10,6 +10,11 @@ index 57b239f..e1c7f0a 100644
 +        # Rust disables default libraries and supplies its unwind runtime.
 +        # C++ unwind selection is inert with -nodefaultlibs and makes Clang warn.
 +        link_args = [arg for arg in link_args if arg != "--unwindlib=none"]
++        # WORKAROUND: https://github.com/holdmyspot-com/codex-unleashed/issues/61
++        # Darwin Rust links supply their runtime archives with -nodefaultlibs.
++        # Windows GNU still needs compiler-rt selection with Rust's -nolibc.
++        if toolchain.target_os in ["darwin", "macos"]:
++            link_args = [arg for arg in link_args if arg != "-rtlib=compiler-rt"]
          link_env = cc_common.get_environment_variables(
              feature_configuration = feature_configuration,
              action_name = action_name,
diff --git a/tools/build-warnings/llvm-driver/BUILD.bazel b/tools/build-warnings/llvm-driver/BUILD.bazel
index 260dd6659..8ea1a0292 100644
--- a/tools/build-warnings/llvm-driver/BUILD.bazel
+++ b/tools/build-warnings/llvm-driver/BUILD.bazel
@@ -1,5 +1,31 @@
 load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
 load("@bazel_skylib//rules:write_file.bzl", "write_file")
+load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_proc_macro", "rust_test")
+
+rust_binary(
+    name = "windows_gnullvm_link_probe",
+    srcs = ["windows_gnullvm_link_probe.rs"],
+    edition = "2024",
+    tags = ["manual"],
+    target_compatible_with = [
+        "@llvm//constraints/windows/abi:gnullvm",
+        "@platforms//os:windows",
+    ],
+)
+
+rust_proc_macro(
+    name = "linked_macro",
+    srcs = ["linked_macro.rs"],
+    edition = "2024",
+)
+
+rust_test(
+    name = "proc_macro_link_test",
+    size = "small",
+    srcs = ["proc_macro_link_test.rs"],
+    edition = "2024",
+    proc_macro_deps = [":linked_macro"],
+)

 genrule(
     name = "windows_nolibc_link",
diff --git a/tools/build-warnings/llvm-driver/linked_macro.rs b/tools/build-warnings/llvm-driver/linked_macro.rs
new file mode 100644
index 000000000..d0dff9d6c
--- /dev/null
+++ b/tools/build-warnings/llvm-driver/linked_macro.rs
@@ -0,0 +1,6 @@
+use proc_macro::TokenStream;
+
+#[proc_macro]
+pub fn identity(input: TokenStream) -> TokenStream {
+    input
+}
diff --git a/tools/build-warnings/llvm-driver/proc_macro_link_test.rs b/tools/build-warnings/llvm-driver/proc_macro_link_test.rs
new file mode 100644
index 000000000..753f9b328
--- /dev/null
+++ b/tools/build-warnings/llvm-driver/proc_macro_link_test.rs
@@ -0,0 +1,4 @@
+#[test]
+fn loads_and_expands_linked_macro() {
+    assert_eq!(linked_macro::identity!(21 * 2), 42);
+}
diff --git a/tools/build-warnings/llvm-driver/windows_gnullvm_link_probe.rs b/tools/build-warnings/llvm-driver/windows_gnullvm_link_probe.rs
new file mode 100644
index 000000000..b1294b326
--- /dev/null
+++ b/tools/build-warnings/llvm-driver/windows_gnullvm_link_probe.rs
@@ -0,0 +1,3 @@
+fn main() {
+    assert_eq!(std::hint::black_box(21) * 2, 42);
+}
