From f16097f66ce3986bebe759141159bd4c40d8d2f4 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Fri, 16 Oct 2026 09:45:12 -0400
Subject: [PATCH] Run Windows test selection and batching in one PowerShell
 process

Avoid a second PowerShell startup after filtering and sharding the test
list. Preserve exact test arguments, the command-line batch limit, and
failure aggregation. Exercise filtering, shard coverage, long arguments,
and failing child status through a native Windows fixture in Bazel CI.

Base: rust-v0.163.0 (83086188ae0614bd882818ff1aa23f3194962012)
Prerequisites: preceding issue-61 queue through patch 0041.
Red: native run 38897557084 times out both V8 unit targets before libtest
starts; timing markers attribute about 34 seconds to the second startup.
Local: maintained just fmt-check and workflow actionlint pass.
Native acceptance: pending run 38904645599; this commit is a candidate.
Tracking: https://github.com/holdmyspot-com/codex-unleashed/issues/61
---
 .github/workflows/bazel.yml                   |  4 +
 .../windows-launcher/selected_tests.ps1       | 83 +++++++++++++++++++
 workspace_root_test_launcher.bat.tpl          | 14 +---
 3 files changed, 89 insertions(+), 12 deletions(-)
 create mode 100644 tools/build-warnings/windows-launcher/selected_tests.ps1

diff --git a/.github/workflows/bazel.yml b/.github/workflows/bazel.yml
index 58a9b7c41..02d8afcdb 100644
--- a/.github/workflows/bazel.yml
+++ b/.github/workflows/bazel.yml
@@ -284,6 +284,10 @@ jobs:
           target: x86_64-pc-windows-msvc
           cache-scope: bazel-${{ github.job }}
 
+      - name: Verify Windows test launcher selection and batching
+        shell: pwsh
+        run: ./tools/build-warnings/windows-launcher/selected_tests.ps1 -TempRoot '${{ runner.temp }}'
+
       - name: bazel test //...
         env:
           BUILDBUDDY_API_KEY: ${{ secrets.BUILDBUDDY_API_KEY }}
diff --git a/tools/build-warnings/windows-launcher/selected_tests.ps1 b/tools/build-warnings/windows-launcher/selected_tests.ps1
new file mode 100644
index 000000000..775ccb0c3
--- /dev/null
+++ b/tools/build-warnings/windows-launcher/selected_tests.ps1
@@ -0,0 +1,83 @@
+param([Parameter(Mandatory = $true)][string]$TempRoot)
+
+$ErrorActionPreference = 'Stop'
+$root = Join-Path $TempRoot ('selected-launcher-' + [Guid]::NewGuid())
+New-Item -ItemType Directory -Path $root | Out-Null
+try {
+    $source = Join-Path $root 'fixture.cs'
+    $binary = Join-Path $root 'fixture.exe'
+    [IO.File]::WriteAllText($source, @'
+using System;
+using System.IO;
+public static class Fixture {
+    public static int Main(string[] args) {
+        if (args.Length > 0 && args[0] == "--list") {
+            foreach (string name in File.ReadAllLines(Environment.GetEnvironmentVariable("FIXTURE_NAMES")))
+                Console.WriteLine(name + ": test");
+            return 0;
+        }
+        int result = 0;
+        foreach (string name in args) {
+            if (name == "--exact") continue;
+            File.AppendAllText(Environment.GetEnvironmentVariable("FIXTURE_OUTPUT"), name + Environment.NewLine);
+            if (name == "fixture::fails") result = 1;
+        }
+        return result;
+    }
+}
+'@)
+    $compiler = Join-Path $env:WINDIR 'Microsoft.NET/Framework64/v4.0.30319/csc.exe'
+    & $compiler /nologo /warnaserror /target:exe "/out:$binary" $source
+    if ($LASTEXITCODE -ne 0) { throw "Fixture compilation failed: $LASTEXITCODE" }
+
+    $runfiles = Join-Path $root 'runfiles'
+    New-Item -ItemType Directory -Path (Join-Path $runfiles 'probe/root') | Out-Null
+    [IO.File]::WriteAllText((Join-Path $runfiles 'probe/root/BUILD.bazel'), '')
+    Copy-Item -LiteralPath $binary -Destination (Join-Path $runfiles 'fixture.exe')
+    $template = [IO.File]::ReadAllText((Join-Path $PSScriptRoot '../../../workspace_root_test_launcher.bat.tpl'))
+    $template = $template.Replace('__WORKSPACE_ROOT_MARKER__', 'probe/root/BUILD.bazel').Replace('__TEST_BIN__', 'fixture.exe').Replace('__RUNFILE_ENV_EXPORTS__', '').Replace('__WORKSPACE_ROOT_SETUP__', '')
+    $launcher = Join-Path $root 'launcher.cmd'
+    [IO.File]::WriteAllText($launcher, $template.Replace("`r`n", "`n").Replace("`n", "`r`n"))
+    $env:RUNFILES_DIR = $runfiles
+    $env:TEST_SRCDIR = ''
+    $env:TEST_WORKSPACE = ''
+    $env:TESTBRIDGE_TEST_ONLY = ''
+    $env:RULES_RUST_TEST_TOTAL_SHARDS = ''
+    $env:RULES_RUST_TEST_SHARD_INDEX = ''
+    $env:TEST_SHARD_STATUS_FILE = ''
+    $env:TEST_TMPDIR = $root
+    $env:FIXTURE_NAMES = Join-Path $root 'names.txt'
+    $env:FIXTURE_OUTPUT = Join-Path $root 'output.txt'
+    $env:CODEX_BAZEL_TEST_SKIP_FILTERS = 'fixture::excluded'
+    $names = @('fixture::excluded', 'fixture::first', 'fixture::second')
+    $names += @(0..99 | ForEach-Object { 'fixture::long_' + ('x' * 100) + $_ })
+    [IO.File]::WriteAllLines($env:FIXTURE_NAMES, [string[]]$names)
+    $expected = @($names | Where-Object { $_ -ne 'fixture::excluded' } | Sort-Object)
+
+    foreach ($mode in @('unsharded', 'sharded')) {
+        $combined = @()
+        $shards = if ($mode -eq 'sharded') { 2 } else { 1 }
+        $env:TEST_TOTAL_SHARDS = if ($mode -eq 'sharded') { '2' } else { '' }
+        for ($index = 0; $index -lt $shards; $index++) {
+            $env:TEST_SHARD_INDEX = [string]$index
+            [IO.File]::WriteAllText($env:FIXTURE_OUTPUT, '')
+            & $env:ComSpec /d /c $launcher
+            if ($LASTEXITCODE -ne 0) { throw "$mode launcher failed: $LASTEXITCODE" }
+            $combined += [IO.File]::ReadAllLines($env:FIXTURE_OUTPUT)
+        }
+        if (Compare-Object $expected @($combined | Sort-Object)) {
+            throw "$mode launcher omitted, duplicated, or incorrectly selected tests"
+        }
+    }
+
+    $env:TEST_TOTAL_SHARDS = ''
+    [IO.File]::WriteAllLines($env:FIXTURE_NAMES, [string[]]@('fixture::fails'))
+    & $env:ComSpec /d /c $launcher
+    if ($LASTEXITCODE -eq 0) { throw 'Launcher discarded the failing test exit status' }
+    Write-Output 'Selected launcher preserves filtering, shard coverage, long argument batching, and failure status.'
+} finally {
+    Remove-Item -LiteralPath $root -Recurse -Force
+    if (Test-Path -LiteralPath $root) { throw "Fixture cleanup failed: $root" }
+}
+
+exit 0
diff --git a/workspace_root_test_launcher.bat.tpl b/workspace_root_test_launcher.bat.tpl
index fa18c301d..90fce07bc 100644
--- a/workspace_root_test_launcher.bat.tpl
+++ b/workspace_root_test_launcher.bat.tpl
@@ -66,7 +66,6 @@ set "TEMP_DIR=%TEMP_ROOT%\workspace_root_test_sharding_!RANDOM!_!RANDOM!_!RANDOM
 mkdir "!TEMP_DIR!" 2>nul
 if errorlevel 1 goto :CREATE_TEMP_DIR
 set "TEMP_LIST=!TEMP_DIR!\list.txt"
-set "TEMP_SHARD_LIST=!TEMP_DIR!\shard.txt"
 
 "%test_bin%" --list --format terse > "!TEMP_LIST!"
 if errorlevel 1 (
@@ -83,20 +82,11 @@ powershell.exe -NoProfile -ExecutionPolicy Bypass -Command ^
   "if (-not [string]::IsNullOrEmpty($env:CODEX_BAZEL_TEST_SKIP_FILTERS)) { $skipFilters = @($env:CODEX_BAZEL_TEST_SKIP_FILTERS -split ',' | Where-Object { $_ -ne '' }) };" ^
   "if ($hasShards) { $totalShards = [uint32]$env:TOTAL_SHARDS; $shardIndex = [uint32]$env:SHARD_INDEX };" ^
   "$fnvPrime = [uint64]16777619; $u32Mask = [uint64]4294967295;" ^
-  "foreach ($test in $tests) { $skip = $false; foreach ($filter in $skipFilters) { if ($test.Contains($filter)) { $skip = $true; break } }; if ($skip) { continue }; if ($hasShards) { $hash = [uint32]2166136261; foreach ($byte in [Text.Encoding]::UTF8.GetBytes($test)) { $hash = [uint32](([uint64]($hash -bxor $byte) * $fnvPrime) -band $u32Mask) }; if (($hash %% $totalShards) -eq $shardIndex) { $test } } else { $test } }" ^
-  > "!TEMP_SHARD_LIST!"
-if errorlevel 1 (
-  rmdir /s /q "!TEMP_DIR!" 2>nul
-  exit /b 1
-)
-
-powershell.exe -NoProfile -ExecutionPolicy Bypass -Command ^
-  "$ErrorActionPreference = 'Stop';" ^
+  "$selectedTests = @(foreach ($test in $tests) { $skip = $false; foreach ($filter in $skipFilters) { if ($test.Contains($filter)) { $skip = $true; break } }; if ($skip) { continue }; if ($hasShards) { $hash = [uint32]2166136261; foreach ($byte in [Text.Encoding]::UTF8.GetBytes($test)) { $hash = [uint32](([uint64]($hash -bxor $byte) * $fnvPrime) -band $u32Mask) }; if (($hash %% $totalShards) -eq $shardIndex) { $test } } else { $test } });" ^
   "$testBin = $env:test_bin;" ^
-  "$tests = @(Get-Content -LiteralPath $env:TEMP_SHARD_LIST);" ^
   "$failed = $false; $limit = 7000; $batch = @(); $batchChars = $testBin.Length + 8;" ^
   "function Invoke-TestBatch { if ($script:batch.Count -eq 0) { return }; & $script:testBin @script:batch '--exact'; if ($LASTEXITCODE -ne 0) { $script:failed = $true }; $script:batch = @(); $script:batchChars = $script:testBin.Length + 8 }" ^
-  "foreach ($test in $tests) { $argChars = $test.Length + 3; if (($batch.Count -gt 0) -and ($batchChars + $argChars -gt $limit)) { Invoke-TestBatch }; $batch += $test; $batchChars += $argChars }" ^
+  "foreach ($test in $selectedTests) { $argChars = $test.Length + 3; if (($batch.Count -gt 0) -and ($batchChars + $argChars -gt $limit)) { Invoke-TestBatch }; $batch += $test; $batchChars += $argChars }" ^
   "Invoke-TestBatch; if ($failed) { exit 1 }"
 set "TEST_EXIT=%ERRORLEVEL%"
 
