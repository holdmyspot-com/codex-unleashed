diff --git a/tools/build-warnings/test-timeouts/timeouts_test.bzl b/tools/build-warnings/test-timeouts/timeouts_test.bzl
new file mode 100644
index 000000000..64ee601a8
--- /dev/null
+++ b/tools/build-warnings/test-timeouts/timeouts_test.bzl
@@ -0,0 +1,22 @@
+"""Verify generated Rust test timeouts and explicit long-running overrides."""
+
+load("@bazel_skylib//lib:unittest.bzl", "analysistest", "asserts")
+
+_TestTimeoutInfo = provider(fields = ["timeout"])
+
+def _timeout_aspect_impl(target, ctx):
+    return [_TestTimeoutInfo(timeout = ctx.rule.attr.timeout)]
+
+_timeout_aspect = aspect(implementation = _timeout_aspect_impl)
+
+def _timeout_test_impl(ctx):
+    env = analysistest.begin(ctx)
+    target = analysistest.target_under_test(env)
+    asserts.equals(env, ctx.attr.expected_timeout, target[_TestTimeoutInfo].timeout)
+    return analysistest.end(env)
+
+timeout_test = analysistest.make(
+    _timeout_test_impl,
+    attrs = {"expected_timeout": attr.string(mandatory = True)},
+    extra_target_under_test_aspects = [_timeout_aspect],
+)
