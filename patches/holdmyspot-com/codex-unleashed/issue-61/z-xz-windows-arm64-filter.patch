diff --git a/tools/build-warnings/xz/arm64_filter_test.c b/tools/build-warnings/xz/arm64_filter_test.c
new file mode 100644
index 000000000..d3875223d
--- /dev/null
+++ b/tools/build-warnings/xz/arm64_filter_test.c
@@ -0,0 +1,46 @@
+#include <lzma.h>
+#include <stdint.h>
+#include <string.h>
+
+int main(void) {
+    const uint8_t input[] = {
+        0x00, 0x00, 0x00, 0x94, 0x00, 0x00, 0x00, 0x90,
+        0x04, 0x00, 0x00, 0x94, 0x20, 0x00, 0x00, 0x90,
+    };
+    if (!lzma_filter_encoder_is_supported(LZMA_FILTER_ARM64) ||
+        !lzma_filter_decoder_is_supported(LZMA_FILTER_ARM64)) {
+        return 1;
+    }
+
+    lzma_options_lzma options;
+    if (lzma_lzma_preset(&options, LZMA_PRESET_DEFAULT)) {
+        return 2;
+    }
+    lzma_filter filters[] = {
+        {LZMA_FILTER_ARM64, NULL},
+        {LZMA_FILTER_LZMA2, &options},
+        {LZMA_VLI_UNKNOWN, NULL},
+    };
+    uint8_t compressed[256];
+    size_t compressed_size = 0;
+    if (lzma_stream_buffer_encode(filters, LZMA_CHECK_CRC64, NULL,
+            input, sizeof(input), compressed, &compressed_size,
+            sizeof(compressed)) != LZMA_OK) {
+        return 3;
+    }
+
+    uint8_t decoded[sizeof(input)];
+    uint64_t memory_limit = UINT64_MAX;
+    size_t input_position = 0;
+    size_t output_position = 0;
+    if (lzma_stream_buffer_decode(&memory_limit, 0, NULL, compressed,
+            &input_position, compressed_size, decoded, &output_position,
+            sizeof(decoded)) != LZMA_OK) {
+        return 4;
+    }
+    if (input_position != compressed_size || output_position != sizeof(input) ||
+        memcmp(input, decoded, sizeof(input)) != 0) {
+        return 5;
+    }
+    return 0;
+}
