From 5b5f9bf8ea25fa9ff8f7fe83877c7b0a63b45e42 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Fri, 16 Oct 2026 06:24:24 +0000
Subject: [PATCH] Give TUI unit shards a moderate test deadline

Keep four shards to bound interactive test concurrency and retain all assertions.

The deadline regression fails with the original short timeout and passes
with moderate. The full local suite passes with one paste timing retry;
that independent flake remains recorded for investigation.
---
 codex-rs/tui/BUILD.bazel                       | 13 ++++++++++++-
 tools/build-warnings/test-timeouts/BUILD.bazel |  1 +
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/codex-rs/tui/BUILD.bazel b/codex-rs/tui/BUILD.bazel
index 8f4f27d44..727594806 100644
--- a/codex-rs/tui/BUILD.bazel
+++ b/codex-rs/tui/BUILD.bazel
@@ -1,4 +1,5 @@
 load("//:defs.bzl", "MACOS_WEBRTC_RUSTC_LINK_FLAGS", "codex_rust_crate")
+load("//tools/build-warnings/test-timeouts:timeouts_test.bzl", "timeout_test")

 codex_rust_crate(
     name = "tui",
@@ -18,8 +19,18 @@ codex_rust_crate(
         "tests/fixtures/**",
     ]),
     test_shard_counts = {
-        "tui-unit-tests": 8,
+        "tui-unit-tests": 4,
     },
     # The startup symlink test applies its own Seatbelt policy, which cannot be nested.
     test_tags = ["no-sandbox"],
+    # Keep shard concurrency bounded and allow the complete interactive test workload.
+    unit_test_timeout = "moderate",
+)
+
+timeout_test(
+    name = "unit_deadline_test",
+    size = "small",
+    expected_timeout = "moderate",
+    target_under_test = ":tui-unit-tests",
+    visibility = ["//tools/build-warnings/test-timeouts:__pkg__"],
 )
diff --git a/tools/build-warnings/test-timeouts/BUILD.bazel b/tools/build-warnings/test-timeouts/BUILD.bazel
index b5be2473a..0a7ffcb08 100644
--- a/tools/build-warnings/test-timeouts/BUILD.bazel
+++ b/tools/build-warnings/test-timeouts/BUILD.bazel
@@ -14,5 +14,6 @@ test_suite(
         "//codex-rs/exec-server:serialized_unit_timeout_test",
         "//codex-rs/exec-server:stable_compat_timeout_test",
         "//codex-rs/login:unit_override_test",
+        "//codex-rs/tui:unit_deadline_test",
     ],
 )
