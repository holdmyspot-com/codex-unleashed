From 6fc32b1eed7424785c3f64fd0a3d349586b5f430 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Thu, 15 Oct 2026 21:28:05 -0400
Subject: [PATCH] Backport OpenSSL unused-global fixes for LLVM 23

Preserve compilation and runtime fixes without warning-only dependency changes.
---
 MODULE.bazel                                 |  5 ++++
 tools/build-warnings/openssl/BUILD.bazel     |  8 ++++++
 tools/build-warnings/openssl/ssl_init_test.c | 29 ++++++++++++++++++++
 3 files changed, 42 insertions(+)
 create mode 100644 tools/build-warnings/openssl/BUILD.bazel
 create mode 100644 tools/build-warnings/openssl/ssl_init_test.c

diff --git a/MODULE.bazel b/MODULE.bazel
index 9edb04132..f88787134 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -474,6 +474,11 @@ crate.annotation(
 )

 bazel_dep(name = "openssl", version = "3.5.4.bcr.0")
+single_version_override(
+    module_name = "openssl",
+    patch_strip = 1,
+    patches = [],
+)

 inject_repo(crate, "xz")

diff --git a/tools/build-warnings/openssl/BUILD.bazel b/tools/build-warnings/openssl/BUILD.bazel
new file mode 100644
index 000000000..9980c7ba0
--- /dev/null
+++ b/tools/build-warnings/openssl/BUILD.bazel
@@ -0,0 +1,8 @@
+load("@rules_cc//cc:cc_test.bzl", "cc_test")
+
+cc_test(
+    name = "ssl_init_test",
+    size = "small",
+    srcs = ["ssl_init_test.c"],
+    deps = ["@openssl//:ssl"],
+)
diff --git a/tools/build-warnings/openssl/ssl_init_test.c b/tools/build-warnings/openssl/ssl_init_test.c
new file mode 100644
index 000000000..ff511526c
--- /dev/null
+++ b/tools/build-warnings/openssl/ssl_init_test.c
@@ -0,0 +1,29 @@
+#include <openssl/provider.h>
+#include <openssl/ssl.h>
+
+int main(void) {
+  if (OPENSSL_init_ssl(OPENSSL_INIT_NO_LOAD_CONFIG, NULL) != 1) {
+    return 1;
+  }
+  if (OPENSSL_init_ssl(OPENSSL_INIT_NO_LOAD_CONFIG, NULL) != 1) {
+    return 1;
+  }
+
+  OSSL_PROVIDER *base = OSSL_PROVIDER_load(NULL, "base");
+  if (base == NULL) {
+    return 1;
+  }
+  if (OSSL_PROVIDER_unload(base) != 1) {
+    return 1;
+  }
+
+  OSSL_PROVIDER *default_provider = OSSL_PROVIDER_load(NULL, "default");
+  if (default_provider == NULL) {
+    return 1;
+  }
+  if (OSSL_PROVIDER_unload(default_provider) != 1) {
+    return 1;
+  }
+
+  return TLS_method() == NULL;
+}
