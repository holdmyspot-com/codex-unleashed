From b52fbbb17d79aff14247e7cea50b655740f71c6c Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Sun, 18 Oct 2026 09:07:58 +0000
Subject: [PATCH] Keep Darwin libffi linker selection out of compile-only
 probes

Pass the native linker selector through libffi LDFLAGS and Libtool LTCC instead of CC. Autoconf compile-only checks retain fatal warnings, normal links select the native linker, and Libtool reload links retain their native -r implementation without depending on LDFLAGS.

Regression: test_libffi_darwin_linker_selection_preserves_compile_only_probes fails under Clang 23.1.2 with -Werror,-Wunused-command-line-argument against the preceding 128-patch queue. The repaired builder passes the compile/link/execution probe, native linker traces for normal and reload links, and all 23 native-builder tests. Maintained just fmt-check passes. These checks execute on Linux with the Darwin configuration branch; full native Darwin acceptance remains a hosted gate.

Base: rust-v0.162.1 (092d3acd6bec3e3a14bdc7e7a2810ab628ab759d), with the existing issue-61 queue prerequisites.
Tracking: https://github.com/holdmyspot-com/codex-unleashed/issues/61

Consolidate follow-up corrections while preserving the final implementation:
- zzzz-0017-libffi-compile-only-driver.patch

Original focused red/green records remain in the owning task evidence.
Fresh emitted-queue verification is a separate acceptance gate.
---
 third_party/voice/build_native.py      | 23 +++++++-
 third_party/voice/test_build_native.py | 74 ++++++++++++++++++++++++++
 2 files changed, 95 insertions(+), 2 deletions(-)

diff --git a/third_party/voice/build_native.py b/third_party/voice/build_native.py
index a881ba20e..551ae5e0a 100644
--- a/third_party/voice/build_native.py
+++ b/third_party/voice/build_native.py
@@ -464,9 +464,28 @@ class NativeBuild:
                 }
             )
         else:
+            ffi_flags = {name: list(flags) for name, flags in self.flags.items()}
             if self.args.target.endswith("apple-darwin"):
                 # Libtool's partial links need -r, which ld64.lld does not support.
-                environment["CC"] += " -fuse-ld=/usr/bin/ld"
+                ffi_flags["LDFLAGS"].append("-fuse-ld=/usr/bin/ld")
+                # LTCC also compiles feature probes, where linker flags are invalid.
+                # Its partial-link command omits LDFLAGS, so select the linker only
+                # when this driver is linking.
+                driver = ffi_build / "ltcc.sh"
+                if shlex.quote(str(driver)) != str(driver):
+                    raise ValueError("libffi driver path cannot require shell quoting")
+                compiler = shlex.quote(str(self.toolchain["cc"]))
+                driver.write_text(
+                    "#!/bin/sh\n"
+                    'for argument in "$@"; do\n'
+                    '  case "$argument" in\n'
+                    f'    -c|-E|-S|-fsyntax-only|-M|-MM) exec {compiler} "$@" ;;\n'
+                    "  esac\n"
+                    "done\n"
+                    f'exec {compiler} -fuse-ld=/usr/bin/ld "$@"\n'
+                )
+                driver.chmod(0o755)
+                environment["LTCC"] = str(driver)
             for name in ("ar", "ranlib"):
                 if name in self.toolchain:
                     path = str(self.toolchain[name])
@@ -477,7 +496,7 @@ class NativeBuild:
             # Response files preserve compiler arguments through Autoconf's word
             # splitting and Make/libtool's shell expansion without losing flags
             # added by configure (such as -fexceptions).
-            for name, flags in self.flags.items():
+            for name, flags in ffi_flags.items():
                 if any(
                     any(character.isspace() for character in flag) for flag in flags
                 ):
diff --git a/third_party/voice/test_build_native.py b/third_party/voice/test_build_native.py
index 4dd10bb77..5508e95d7 100644
--- a/third_party/voice/test_build_native.py
+++ b/third_party/voice/test_build_native.py
@@ -197,6 +197,80 @@ class NativeBuildTests(unittest.TestCase):
                         build.build()
                     setattr(self.args, name, None)
 
+    @unittest.skipIf(os.name == "nt", "Exercises Darwin's Unix linker selection")
+    def test_libffi_darwin_linker_selection_preserves_compile_only_probes(self):
+        compiler = shutil.which("clang")
+        if compiler is None:
+            self.skipTest("Requires Clang")
+        self.args.target = "aarch64-apple-darwin"
+        self.args.output = self.root / "libffi"
+        self.args.cc = Path(compiler)
+        self.args.c_flag = ["-Werror"]
+        self.args.link_flag = [
+            "-fuse-ld=lld",
+            "-Werror",
+            "-Wl,-rpath,declared-relative-path",
+        ]
+        with patch("build_native.validate_target"):
+            build = NativeBuild(self.args, self.environment)
+        with (
+            patch(
+                "build_native.prepare_sources",
+                side_effect=lambda *args: (build.output / "build").mkdir(),
+            ),
+            patch.object(build, "cmake"),
+            patch.object(build, "meson"),
+            patch.object(build, "run") as run,
+        ):
+            build.build()
+        environment = next(
+            call.kwargs["environment"]
+            for call in run.call_args_list
+            if call.args[0] == "libffi-configure"
+        )
+        (build.output / "probe.c").write_text("int main(void) { return 0; }\n")
+        for command in (
+            "$CC $CFLAGS -c probe.c -o probe.o",
+            "$LTCC $CFLAGS -c probe.c -o libtool-probe.o",
+            "$CC $LDFLAGS probe.o -o probe",
+        ):
+            result = subprocess.run(
+                ["/bin/sh", "-c", command],
+                cwd=build.output,
+                env=environment,
+                capture_output=True,
+                text=True,
+                check=False,
+            )
+            self.assertEqual(result.returncode, 0, result.stderr)
+        trace = subprocess.run(
+            ["/bin/sh", "-c", "$CC $LDFLAGS -### probe.o -o probe"],
+            cwd=build.output,
+            env=environment,
+            capture_output=True,
+            text=True,
+            check=False,
+        )
+        self.assertEqual(trace.returncode, 0, trace.stderr)
+        self.assertIn('"/usr/bin/ld"', trace.stderr)
+        self.assertIn("declared-relative-path", trace.stderr)
+        reload_trace = subprocess.run(
+            [
+                "/bin/sh",
+                "-c",
+                "$LTCC $CFLAGS -nostdlib -Wl,-r -### probe.o -o reload.o",
+            ],
+            cwd=build.output,
+            env=environment,
+            capture_output=True,
+            text=True,
+            check=False,
+        )
+        self.assertEqual(reload_trace.returncode, 0, reload_trace.stderr)
+        self.assertIn('"/usr/bin/ld"', reload_trace.stderr)
+        result = subprocess.run([build.output / "probe"], check=False)
+        self.assertEqual(result.returncode, 0)
+
     @unittest.skipIf(os.name == "nt", "Exercises Autoconf's Unix flag expansion")
     def test_libffi_compiler_receives_literal_defines_without_shell_quotes(self):
         compiler = shutil.which("cc")
