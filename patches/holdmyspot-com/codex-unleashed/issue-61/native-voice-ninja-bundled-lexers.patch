From 1ad550ceb8e99a115e62f2a52a10a4c096aaa348 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Wed, 14 Oct 2026 10:50:50 +0000
Subject: [PATCH] Select bundled Ninja lexers explicitly in native voice builds

Provide a pinned-source build option that retains regeneration by default
and validates bundled lexer files when regeneration is disabled. Native
voice bootstrap selects the bundled release files; diagnostic policy
remains strict. Include the source-mode workaround reference and removal
condition.

TDD: native-ninja-bundled-red.log rejects missing re2c and the unrecognized
build option. The final isolated probe builds and executes Ninja, rejects
missing bundled lexers, and retains the missing-generator warning when
regeneration is enabled. Native tooling (96 tests, 19 skips) and maintained
just fmt-check pass.
---
 third_party/voice/build_native.py          |   6 +-
 third_party/voice/prepare_sources.py       |  39 +++++++
 tools/build-warnings/check-native-ninja.py | 115 +++++++++++++++++++++
 3 files changed, 159 insertions(+), 1 deletion(-)
 create mode 100644 tools/build-warnings/check-native-ninja.py

diff --git a/third_party/voice/build_native.py b/third_party/voice/build_native.py
index 92c329705..dd7ad247a 100644
--- a/third_party/voice/build_native.py
+++ b/third_party/voice/build_native.py
@@ -393,7 +393,11 @@ class NativeBuild:
         self.record["python"] = sys.version
         self.run("cmake-version", [self.toolchain["cmake"], "--version"])
         self.run("pkg-config-version", [self.toolchain["pkg_config"], "--version"])
-        self.cmake("ninja", ["-DBUILD_TESTING=OFF"], bootstrap=True)
+        self.cmake(
+            "ninja",
+            ["-DBUILD_TESTING=OFF", "-DNINJA_REGENERATE_LEXERS=OFF"],
+            bootstrap=True,
+        )
         self.cmake(
             "zlib",
             [
diff --git a/third_party/voice/prepare_sources.py b/third_party/voice/prepare_sources.py
index 82d728f58..e1ea3baf7 100644
--- a/third_party/voice/prepare_sources.py
+++ b/third_party/voice/prepare_sources.py
@@ -83,6 +83,45 @@ def extract_source(source: Source, archives: Path, destination: Path) -> None:
             raise ValueError(f"Expanded source exceeds limits: {source.name}")
         archive.extractall(destination, members=members, filter="data")
 
+    if source.name == "ninja" and source.version == "1.13.2":
+        # WORKAROUND: the pinned Ninja lacks an explicit bundled-lexer mode.
+        # https://github.com/holdmyspot-com/codex-unleashed/issues/61
+        # Remove when the selected Ninja provides this build option upstream.
+        cmake = destination / source.root / "CMakeLists.txt"
+        contents = cmake.read_text(encoding="utf-8")
+        original = (
+            "set(RE2C_MAJOR_VERSION 0)\n"
+            "find_program(RE2C re2c)\n"
+            "if(RE2C)\n"
+            '\texecute_process(COMMAND "${RE2C}" --vernum OUTPUT_VARIABLE RE2C_RAW_VERSION)\n'
+            '\tmath(EXPR RE2C_MAJOR_VERSION "${RE2C_RAW_VERSION} / 10000")\n'
+            "endif()\n"
+            "if(${RE2C_MAJOR_VERSION} GREATER 1)\n"
+        )
+        replacement = (
+            'option(NINJA_REGENERATE_LEXERS "Regenerate lexer sources with re2c" ON)\n'
+            "set(RE2C_MAJOR_VERSION 0)\n"
+            "if(NINJA_REGENERATE_LEXERS)\n"
+            "\tfind_program(RE2C re2c)\n"
+            "\tif(RE2C)\n"
+            '\t\texecute_process(COMMAND "${RE2C}" --vernum OUTPUT_VARIABLE RE2C_RAW_VERSION)\n'
+            '\t\tmath(EXPR RE2C_MAJOR_VERSION "${RE2C_RAW_VERSION} / 10000")\n'
+            "\tendif()\n"
+            "endif()\n"
+            "if(NOT NINJA_REGENERATE_LEXERS)\n"
+            "\tforeach(lexer depfile_parser lexer)\n"
+            '\t\tif(NOT EXISTS "${PROJECT_SOURCE_DIR}/src/${lexer}.cc")\n'
+            '\t\t\tmessage(FATAL_ERROR "Missing bundled Ninja lexer: ${lexer}")\n'
+            "\t\tendif()\n"
+            "\tendforeach()\n"
+            '\tmessage(STATUS "Using bundled Ninja lexers; regeneration is disabled")\n'
+            "\tadd_library(libninja-re2c OBJECT src/depfile_parser.cc src/lexer.cc)\n"
+            "elseif(${RE2C_MAJOR_VERSION} GREATER 1)\n"
+        )
+        if contents.count(original) != 1:
+            raise ValueError("Pinned Ninja lexer configuration does not match")
+        cmake.write_text(contents.replace(original, replacement), encoding="utf-8")
+
     if source.name == "libffi" and source.version == "3.8.0":
         # WORKAROUND: libffi calls its deprecated public Java raw API internally.
         # https://github.com/holdmyspot-com/codex-unleashed/issues/61
diff --git a/tools/build-warnings/check-native-ninja.py b/tools/build-warnings/check-native-ninja.py
new file mode 100644
index 000000000..0c02c3400
--- /dev/null
+++ b/tools/build-warnings/check-native-ninja.py
@@ -0,0 +1,115 @@
+#!/usr/bin/env python3
+"""Build and execute the pinned Ninja using its bundled lexer sources."""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+from types import SimpleNamespace
+
+CHECKOUT = Path(__file__).resolve().parents[2]
+sys.dont_write_bytecode = True
+sys.path.insert(0, str(CHECKOUT / "third_party/voice"))
+from build_native import NativeBuild
+from prepare_sources import MANIFEST, extract_source, load_sources
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("configuration", type=Path)
+    parser.add_argument("execroot", type=Path)
+    arguments = parser.parse_args()
+    root = arguments.execroot.absolute()
+    configuration = json.loads(
+        arguments.configuration.read_text().replace("@VOICE_EXECROOT@", str(root))
+    )
+    archives = {Path(path).name: root / path for path in configuration.pop("archives")}
+    for name in ("prefix", "receipt"):
+        configuration.pop(name)
+    linker = root / configuration.pop("ld")
+    for name in ("cc", "cxx", "ar", "ranlib", "cmake", "make", "pkg_config", "shell"):
+        configuration[name] = root / configuration[name]
+
+    with tempfile.TemporaryDirectory(
+        prefix="native-ninja-probe-", dir=os.environ["TMPDIR"]
+    ) as temporary:
+        scratch = Path(temporary)
+        builder = NativeBuild(
+            SimpleNamespace(
+                **configuration,
+                archives=scratch,
+                output=scratch / "build",
+                bootstrap_make=None,
+            ),
+            os.environ,
+        )
+        builder.output.mkdir()
+        source = next(
+            source
+            for source in load_sources(MANIFEST.read_bytes())
+            if source.name == "ninja"
+        )
+        sources = scratch / "sources"
+        sources.mkdir()
+        extract_source(source, archives[source.archive].parent, sources)
+        builder.sources = {"ninja": sources / source.root}
+        builder.environment["LD"] = str(linker)
+        try:
+            builder.cmake(
+                "ninja",
+                ["-DBUILD_TESTING=OFF", "-DNINJA_REGENERATE_LEXERS=OFF"],
+                bootstrap=True,
+            )
+            (scratch / "build.ninja").write_text(
+                "rule write\n  command = printf generated > $out\nbuild result: write\n"
+            )
+            subprocess.run([builder.environment["NINJA"], "-C", scratch], check=True)
+            if (scratch / "result").read_text() != "generated":
+                raise RuntimeError("The bootstrapped Ninja did not execute its build")
+
+            builder.sources["regenerate"] = builder.sources["ninja"]
+            try:
+                builder.cmake(
+                    "regenerate",
+                    [
+                        "-DBUILD_TESTING=OFF",
+                        "-DNINJA_REGENERATE_LEXERS=ON",
+                        "-DRE2C=RE2C-NOTFOUND",
+                        "-DCMAKE_FIND_USE_SYSTEM_ENVIRONMENT_PATH=OFF",
+                        "-DCMAKE_FIND_USE_CMAKE_SYSTEM_PATH=OFF",
+                    ],
+                    bootstrap=True,
+                )
+            except RuntimeError as error:
+                if "re2c 2 or later was not found" not in str(error):
+                    raise
+            else:
+                raise RuntimeError("Missing re2c no longer warns in regeneration mode")
+
+            (builder.sources["ninja"] / "src/lexer.cc").unlink()
+            builder.sources["missing"] = builder.sources["ninja"]
+            try:
+                builder.cmake(
+                    "missing",
+                    ["-DBUILD_TESTING=OFF", "-DNINJA_REGENERATE_LEXERS=OFF"],
+                    bootstrap=True,
+                )
+            except subprocess.CalledProcessError:
+                if (
+                    "Missing bundled Ninja lexer: lexer"
+                    not in (builder.output / "missing-configure.log").read_text()
+                ):
+                    raise
+            else:
+                raise RuntimeError("Missing bundled lexer did not fail configuration")
+        finally:
+            for log in sorted(builder.output.glob("*.log")):
+                print(log.read_text(errors="replace"))
+    print("Native Ninja builds from bundled lexers and executes its build manifest.")
+
+
+if __name__ == "__main__":
+    main()
-- 
2.43.0

