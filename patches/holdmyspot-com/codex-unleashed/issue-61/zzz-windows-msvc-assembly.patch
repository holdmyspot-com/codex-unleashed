diff --git a/patches/rules_cc_masm_action_flags.patch b/patches/rules_cc_masm_action_flags.patch
new file mode 100644
index 000000000..b55ac375f
--- /dev/null
+++ b/patches/rules_cc_masm_action_flags.patch
@@ -0,0 +1,67 @@
+From 7bf802b767d85674b9362e896e80ab153316691e Mon Sep 17 00:00:00 2001
+From: Gili Tzabari <cowwoc2020@gmail.com>
+Date: Thu, 15 Oct 2026 09:55:20 +0000
+Subject: [PATCH] Keep Windows assembly options compatible with MASM
+
+---
+ .../toolchain/windows_cc_toolchain_config.bzl   | 17 +++++++++++------
+ 1 file changed, 11 insertions(+), 6 deletions(-)
+
+diff --git a/cc/private/toolchain/windows_cc_toolchain_config.bzl b/cc/private/toolchain/windows_cc_toolchain_config.bzl
+index 55b156d..02d061c 100644
+--- a/cc/private/toolchain/windows_cc_toolchain_config.bzl
++++ b/cc/private/toolchain/windows_cc_toolchain_config.bzl
+@@ -846,8 +846,6 @@ def _impl(ctx):
+             flag_sets = [
+                 flag_set(
+                     actions = [
+-                        ACTION_NAMES.assemble,
+-                        ACTION_NAMES.preprocess_assemble,
+                         ACTION_NAMES.linkstamp_compile,
+                         ACTION_NAMES.c_compile,
+                         ACTION_NAMES.cpp_compile,
+@@ -1008,7 +1006,6 @@ def _impl(ctx):
+             flag_sets = [
+                 flag_set(
+                     actions = [
+-                        ACTION_NAMES.preprocess_assemble,
+                         ACTION_NAMES.c_compile,
+                         ACTION_NAMES.linkstamp_compile,
+                         ACTION_NAMES.cpp_compile,
+@@ -1023,7 +1020,6 @@ def _impl(ctx):
+             env_sets = [
+                 env_set(
+                     actions = [
+-                        ACTION_NAMES.preprocess_assemble,
+                         ACTION_NAMES.c_compile,
+                         ACTION_NAMES.linkstamp_compile,
+                         ACTION_NAMES.cpp_compile,
+@@ -1054,7 +1050,7 @@ def _impl(ctx):
+             name = "treat_warnings_as_errors",
+             flag_sets = [
+                 flag_set(
+-                    actions = [ACTION_NAMES.c_compile, ACTION_NAMES.cpp_compile] + all_link_actions,
++                    actions = [ACTION_NAMES.assemble, ACTION_NAMES.preprocess_assemble, ACTION_NAMES.c_compile, ACTION_NAMES.cpp_compile] + all_link_actions,
+                     flag_groups = [flag_group(flags = ["/WX"])],
+                 ),
+             ],
+@@ -1103,9 +1099,18 @@ def _impl(ctx):
+         external_include_paths_feature = feature(
+             name = "external_include_paths",
+             flag_sets = [
++                flag_set(
++                    actions = [ACTION_NAMES.assemble, ACTION_NAMES.preprocess_assemble],
++                    flag_groups = [
++                        flag_group(
++                            flags = ["/I%{external_include_paths}"],
++                            iterate_over = "external_include_paths",
++                            expand_if_available = "external_include_paths",
++                        ),
++                    ],
++                ),
+                 flag_set(
+                     actions = [
+-                        ACTION_NAMES.preprocess_assemble,
+                         ACTION_NAMES.linkstamp_compile,
+                         ACTION_NAMES.c_compile,
+                         ACTION_NAMES.cpp_compile,
