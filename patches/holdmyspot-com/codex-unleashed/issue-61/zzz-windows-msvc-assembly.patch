 .../assembly/native/BUILD.bazel               | 78 +++++++++++++++++++
 .../assembly/native/fixture.asm               |  5 ++
 .../assembly/native/flags_test.bzl            | 40 ++++++++++
 .../assembly/native/preprocessed.S            |  5 ++
 .../build-warnings/assembly/preprocessed.asm  |  8 ++
 tools/build-warnings/assembly/raw.asm         |  5 ++
 9 files changed, 225 insertions(+), 5 deletions(-)
 create mode 100644 patches/rules_cc_masm_action_flags.patch
 create mode 100644 tools/build-warnings/assembly/native/BUILD.bazel
 create mode 100644 tools/build-warnings/assembly/native/fixture.asm
 create mode 100644 tools/build-warnings/assembly/native/flags_test.bzl
 create mode 100644 tools/build-warnings/assembly/native/preprocessed.S
 create mode 100644 tools/build-warnings/assembly/preprocessed.asm
 create mode 100644 tools/build-warnings/assembly/raw.asm

