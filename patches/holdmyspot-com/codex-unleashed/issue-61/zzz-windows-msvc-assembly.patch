diff --git a/tools/build-warnings/assembly/native/BUILD.bazel b/tools/build-warnings/assembly/native/BUILD.bazel
new file mode 100644
index 000000000..73e2fa6fb
--- /dev/null
+++ b/tools/build-warnings/assembly/native/BUILD.bazel
@@ -0,0 +1,78 @@
+load("@rules_cc//cc:cc_library.bzl", "cc_library")
+load("@rules_cc//cc/private/toolchain:windows_cc_toolchain_config.bzl", "cc_toolchain_config")
+load("@rules_cc//cc/toolchains:cc_toolchain.bzl", "cc_toolchain")
+load(":flags_test.bzl", "masm_flags_test")
+
+filegroup(name = "empty")
+
+cc_toolchain_config(
+    name = "config",
+    abi_libc_version = "local",
+    abi_version = "local",
+    compiler = "msvc-cl",
+    cpu = "x64_windows",
+    host_system_name = "local",
+    msvc_cl_path = "cl.exe",
+    msvc_lib_path = "lib.exe",
+    msvc_link_path = "link.exe",
+    msvc_ml_path = "ml64.exe",
+    supports_parse_showincludes = True,
+    target_libc = "msvcrt",
+    target_system_name = "windows",
+    tool_paths = {
+        "gcc": "cl.exe",
+        "ld": "link.exe",
+        "ar": "lib.exe",
+        "cpp": "cl.exe",
+        "gcov": "unused",
+        "nm": "unused",
+        "objdump": "unused",
+        "strip": "unused",
+    },
+    toolchain_identifier = "native-msvc-analysis",
+)
+
+cc_toolchain(
+    name = "cc_toolchain",
+    all_files = ":empty",
+    ar_files = ":empty",
+    as_files = ":empty",
+    compiler_files = ":empty",
+    dwp_files = ":empty",
+    linker_files = ":empty",
+    objcopy_files = ":empty",
+    strip_files = ":empty",
+    supports_param_files = 1,
+    toolchain_config = ":config",
+    toolchain_identifier = "native-msvc-analysis",
+)
+
+toolchain(
+    name = "analysis_toolchain",
+    target_compatible_with = [
+        "@platforms//os:windows",
+        "@platforms//cpu:x86_64",
+    ],
+    toolchain = ":cc_toolchain",
+    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
+)
+
+cc_library(
+    name = "assembly_inputs",
+    srcs = [
+        "fixture.asm",
+        "preprocessed.S",
+    ],
+    target_compatible_with = select({
+        "@rules_cc//cc/compiler:msvc-cl": [
+            "@platforms//os:windows",
+            "@platforms//cpu:x86_64",
+        ],
+        "//conditions:default": ["@platforms//:incompatible"],
+    }),
+)
+
+masm_flags_test(
+    name = "flags_test",
+    target_under_test = ":assembly_inputs",
+)
