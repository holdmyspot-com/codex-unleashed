diff --git a/tools/build-warnings/assembly/native/flags_test.bzl b/tools/build-warnings/assembly/native/flags_test.bzl
new file mode 100644
index 000000000..9e452fdc0
--- /dev/null
+++ b/tools/build-warnings/assembly/native/flags_test.bzl
@@ -0,0 +1,40 @@
+load("@bazel_skylib//lib:unittest.bzl", "analysistest", "asserts")
+
+def _masm_flags_test_impl(ctx):
+    env = analysistest.begin(ctx)
+    actions = [action for action in analysistest.target_actions(env) if action.mnemonic == "CppCompile" and any([arg.endswith("fixture.asm") or arg.endswith("preprocessed.S") for arg in action.argv])]
+    asserts.equals(env, 2, len(actions), "Both assembly input kinds generate native actions")
+    for action in actions:
+        asserts.true(env, action.argv[0].endswith("ml64.exe"), "Native assembly uses MASM")
+        incompatible = [arg for arg in action.argv if arg.startswith("/wd") or arg in ["/bigobj", "/Zm500", "/EHsc", "/showIncludes"]]
+        asserts.equals(env, [], incompatible, "MASM must not receive C/C++ compiler options")
+        asserts.true(env, "/WX" in action.argv, "MASM warnings are errors")
+    return analysistest.end(env)
+
+def _masm_fixture_selection_test_impl(ctx):
+    env = analysistest.begin(ctx)
+    actions = [action for action in analysistest.target_actions(env) if action.mnemonic == "CppCompile"]
+    sources = [arg.split("/")[-1] for action in actions for arg in action.argv if arg.endswith(".asm") or arg.endswith(".s") or arg.endswith(".S")]
+    asserts.equals(env, ["preprocessed.asm", "raw.asm"], sorted(sources), "Native MSVC selects MASM source fixtures")
+    c_actions = [action for action in actions if any([arg.endswith("frontend.c") for arg in action.argv])]
+    asserts.equals(env, 1, len(c_actions), "The fixture also exercises the C frontend")
+    for action in c_actions:
+        for required in ["/bigobj", "/EHsc", "/WX"]:
+            asserts.true(env, required in action.argv, "C compilation retains %s" % required)
+    return analysistest.end(env)
+
+_NATIVE_MSVC_CONFIG = {
+    "//command_line_option:platforms": str(Label("//:windows_x86_64_msvc")),
+    "//command_line_option:extra_toolchains": [str(Label(":analysis_toolchain"))],
+    "//command_line_option:features": ["treat_warnings_as_errors"],
+}
+
+masm_flags_test = analysistest.make(
+    _masm_flags_test_impl,
+    config_settings = _NATIVE_MSVC_CONFIG,
+)
+
+masm_fixture_selection_test = analysistest.make(
+    _masm_fixture_selection_test_impl,
+    config_settings = _NATIVE_MSVC_CONFIG,
+)
