From c99f8f1f299a5a9fd5925b6bd6d70e844d0b3b55 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Thu, 15 Oct 2026 17:28:45 +0000
Subject: [PATCH] Report the selected C++ standard to V8 on MSVC

MSVC retains its legacy __cplusplus value without /Zc:__cplusplus even when /std:c++20 is selected. Supply the language-version reporting flag for the pointer-format regression and V8 libraries on CL drivers.

Native red: job 116520488151 fails v8config.h with C++20 or later required. Focused action assertions fail before the flag and pass after it; just fmt-check, just bazel-lock-update, and just bazel-lock-check pass in the fresh verification checkout. Native positive remains pending.
---
 patches/v8_msvc_driver_flags.patch     | 8 ++++----
 tools/build-warnings/v8/flags_test.bzl | 1 +
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/patches/v8_msvc_driver_flags.patch b/patches/v8_msvc_driver_flags.patch
index 74644431e..0b9178fbe 100644
--- a/patches/v8_msvc_driver_flags.patch
+++ b/patches/v8_msvc_driver_flags.patch
@@ -20,8 +20,8 @@ index 39983b2..61dab3b 100644
      ],
 -    copts = ["-std=c++20"],
 +    copts = select({
-+        "@rules_cc//cc/compiler:msvc-cl": ["/std:c++20"],
-+        "@rules_cc//cc/compiler:clang-cl": ["/std:c++20"],
++        "@rules_cc//cc/compiler:msvc-cl": ["/std:c++20", "/Zc:__cplusplus"],
++        "@rules_cc//cc/compiler:clang-cl": ["/std:c++20", "/Zc:__cplusplus"],
 +        "//conditions:default": ["-std=c++20"],
 +    }),
 +    features = select({
@@ -91,8 +91,8 @@ index 42e9637..8aefdc4 100644
                  # ##__VA_ARGS__ when in standards-conforming mode.
                  "-std=gnu++2a",
              ],
-+            "@v8//bazel/config:is_windows_msvc": ["/std:c++20"],
-+            "@v8//bazel/config:is_windows_clang_cl": ["/std:c++20"],
++            "@v8//bazel/config:is_windows_msvc": ["/std:c++20", "/Zc:__cplusplus"],
++            "@v8//bazel/config:is_windows_clang_cl": ["/std:c++20", "/Zc:__cplusplus"],
              "@v8//bazel/config:is_windows": [
                  "-Wno-invalid-offsetof",
                  "-Wno-deprecated-this-capture",
diff --git a/tools/build-warnings/v8/flags_test.bzl b/tools/build-warnings/v8/flags_test.bzl
index f7fad417b..75841bf0a 100644
--- a/tools/build-warnings/v8/flags_test.bzl
+++ b/tools/build-warnings/v8/flags_test.bzl
@@ -11,6 +11,7 @@ def _windows_cpp_flags_test_impl(ctx):
     for action in actions:
         standard_flags = [arg for arg in action.argv if arg.startswith("/std:")]
         asserts.equals(env, ["/std:c++20"], standard_flags[-1:], "CL actions select C++20")
+        asserts.true(env, "/Zc:__cplusplus" in action.argv, "CL actions report the selected C++ language version")
         compiler = action.argv[0].replace("\\", "/").split("/")[-1]
         if compiler in ["clang-cl", "clang-cl.exe"]:
             for required in ["/EHsc", "/GR", "/GS"]:
