From 42c2f213639ec14d6faa01b1e410a8707fe556d5 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Wed, 14 Oct 2026 08:19:43 +0000
Subject: [PATCH] Remove GoogleTest's unused Windows separator string

Remove an unreferenced private constant from GoogleTest 1.17.0.bcr.2
without changing separator normalization or path splitting. Declare
the already-selected module directly for the focused regression.

Verification: bazel build @googletest//:gtest
--platforms=//:windows_x86_64_gnullvm
--output_groups=compilation_outputs --keep_going reproduces
-Wunused-const-variable before the fix and passes afterwards.
The included path_separator_test passes on Linux and includes
Windows separator expectations for Windows execution hosts.
Maintained just fmt-check and just bazel-lock-check pass.
Logs: googletest-separator-{red,green}.log,
googletest-path-runtime-green.log, and
googletest-{fmt,lock}-check.log in llvm-toolchain task evidence.
---
 MODULE.bazel                                      |  7 +++++++
 patches/googletest_unused_separator.patch         | 11 +++++++++++
 tools/build-warnings/googletest/BUILD.bazel       |  8 ++++++++
 .../googletest/path_separator_test.cc             | 15 +++++++++++++++
 4 files changed, 41 insertions(+)
 create mode 100644 patches/googletest_unused_separator.patch
 create mode 100644 tools/build-warnings/googletest/BUILD.bazel
 create mode 100644 tools/build-warnings/googletest/path_separator_test.cc

diff --git a/MODULE.bazel b/MODULE.bazel
index 3768f6289..0482599d6 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -80,6 +80,13 @@ use_repo(windows_sdk, "windows_sdk")
 # Abseil picks a MinGW pthread TLS path that does not match our hermetic
 # windows-gnullvm toolchain; force it onto the portable C++11 thread-local path.
 bazel_dep(name = "abseil-cpp", version = "20250814.1")
+bazel_dep(name = "googletest", version = "1.17.0.bcr.2")
+single_version_override(
+    module_name = "googletest",
+    patch_strip = 1,
+    patches = ["//patches:googletest_unused_separator.patch"],
+)
+
 single_version_override(
     module_name = "abseil-cpp",
     patch_strip = 1,
diff --git a/patches/googletest_unused_separator.patch b/patches/googletest_unused_separator.patch
new file mode 100644
index 000000000..980656d7d
--- /dev/null
+++ b/patches/googletest_unused_separator.patch
@@ -0,0 +1,11 @@
+diff --git a/googletest/src/gtest-filepath.cc b/googletest/src/gtest-filepath.cc
+--- a/googletest/src/gtest-filepath.cc
++++ b/googletest/src/gtest-filepath.cc
+@@ -72,7 +72,6 @@ namespace internal {
+ // of them.
+ const char kPathSeparator = '\\';
+ const char kAlternatePathSeparator = '/';
+-const char kAlternatePathSeparatorString[] = "/";
+ #ifdef GTEST_OS_WINDOWS_MOBILE
+ // Windows CE doesn't have a current directory. You should not use
+ // the current directory in tests on Windows CE, but this at least
diff --git a/tools/build-warnings/googletest/BUILD.bazel b/tools/build-warnings/googletest/BUILD.bazel
new file mode 100644
index 000000000..8920af2d4
--- /dev/null
+++ b/tools/build-warnings/googletest/BUILD.bazel
@@ -0,0 +1,8 @@
+load("@rules_cc//cc:cc_test.bzl", "cc_test")
+
+cc_test(
+    name = "path_separator_test",
+    size = "small",
+    srcs = ["path_separator_test.cc"],
+    deps = ["@googletest//:gtest_main"],
+)
diff --git a/tools/build-warnings/googletest/path_separator_test.cc b/tools/build-warnings/googletest/path_separator_test.cc
new file mode 100644
index 000000000..17685c6aa
--- /dev/null
+++ b/tools/build-warnings/googletest/path_separator_test.cc
@@ -0,0 +1,15 @@
+#include "gtest/gtest.h"
+#include "gtest/internal/gtest-filepath.h"
+
+TEST(FilePathWarningRegression, NormalizesAndSplitsSeparators) {
+#ifdef GTEST_OS_WINDOWS
+    const testing::internal::FilePath path("C:\\alpha//beta\\file.txt");
+    EXPECT_EQ(path.string(), "C:\\alpha\\beta\\file.txt");
+    EXPECT_EQ(path.RemoveFileName().string(), "C:\\alpha\\beta\\");
+#else
+    const testing::internal::FilePath path("alpha//beta/file.txt");
+    EXPECT_EQ(path.string(), "alpha/beta/file.txt");
+    EXPECT_EQ(path.RemoveFileName().string(), "alpha/beta/");
+#endif
+    EXPECT_EQ(path.RemoveDirectoryName().string(), "file.txt");
+}
-- 
