From d96b3f44abf3cce819ea22d9174e03ac7900ff8f Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Wed, 14 Oct 2026 07:42:07 +0000
Subject: [PATCH] Remove Prost's unused legacy C++ grep dependency

Backport rules_rust dd2b107baf21198f85c89989ce4a4d7c4004ba2e
(PR #4261) to retain compatibility with rules_cc 0.2.25.

The included generation and message round-trip test reproduces the
missing grep-includes target before the fix and passes after it.

Verification: bazel test //tools/build-warnings/prost:round_trip_test
--keep_going fails at missing grep-includes before the backport and
passes afterwards. Maintained just fmt-check and just bazel-lock-check
pass. Logs: prost-unused-grep-{red,green}.log, prost-fmt-check.log,
prost-lock-check.log in the task's llvm-toolchain evidence directory.
---
 MODULE.bazel                               |  1 +
 patches/rules_rust_prost_unused_grep.patch | 15 ++++++++++++++
 tools/build-warnings/prost/BUILD.bazel     | 24 ++++++++++++++++++++++
 tools/build-warnings/prost/probe.proto     |  7 +++++++
 tools/build-warnings/prost/round_trip.rs   | 14 +++++++++++++
 5 files changed, 61 insertions(+)
 create mode 100644 patches/rules_rust_prost_unused_grep.patch
 create mode 100644 tools/build-warnings/prost/BUILD.bazel
 create mode 100644 tools/build-warnings/prost/probe.proto
 create mode 100644 tools/build-warnings/prost/round_trip.rs

diff --git a/MODULE.bazel b/MODULE.bazel
index 0d5cdee65..89fa7a6d2 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -227,6 +227,7 @@ rules_rust.patch(
         "//patches:rules_rust_windows_execroot_separators.patch",
         "//patches:rules_rust_compiler_thp.patch",
         "//patches:rules_rust_unwind_driver_selection.patch",
+        "//patches:rules_rust_prost_unused_grep.patch",
     ],
     strip = 1,
 )
diff --git a/patches/rules_rust_prost_unused_grep.patch b/patches/rules_rust_prost_unused_grep.patch
new file mode 100644
index 000000000..91fa09937
--- /dev/null
+++ b/patches/rules_rust_prost_unused_grep.patch
@@ -0,0 +1,15 @@
+diff --git a/extensions/prost/private/prost.bzl b/extensions/prost/private/prost.bzl
+--- a/extensions/prost/private/prost.bzl
++++ b/extensions/prost/private/prost.bzl
+@@ -372,11 +372,6 @@ rust_prost_aspect = aspect(
+             executable = True,
+             cfg = "exec",
+         ),
+-        "_grep_includes": attr.label(
+-            allow_single_file = True,
+-            default = Label("@bazel_tools//tools/cpp:grep-includes"),
+-            cfg = "exec",
+-        ),
+     } | RUSTC_ATTRS | {
+         # Need to override this attribute to explicitly set the workspace.
+         "_always_enable_metadata_output_groups": attr.label(
diff --git a/tools/build-warnings/prost/BUILD.bazel b/tools/build-warnings/prost/BUILD.bazel
new file mode 100644
index 000000000..3f3d02060
--- /dev/null
+++ b/tools/build-warnings/prost/BUILD.bazel
@@ -0,0 +1,24 @@
+load("@com_google_protobuf//bazel:proto_library.bzl", "proto_library")
+load("@rules_rs//rs:rust_test.bzl", "rust_test")
+load("@rules_rust//extensions/prost:defs.bzl", "rust_prost_library")
+
+proto_library(
+    name = "probe_proto",
+    srcs = ["probe.proto"],
+)
+
+rust_prost_library(
+    name = "probe_proto_rust",
+    proto = ":probe_proto",
+)
+
+rust_test(
+    name = "round_trip_test",
+    size = "small",
+    srcs = ["round_trip.rs"],
+    edition = "2024",
+    deps = [
+        ":probe_proto_rust",
+        "@crates//:prost",
+    ],
+)
diff --git a/tools/build-warnings/prost/probe.proto b/tools/build-warnings/prost/probe.proto
new file mode 100644
index 000000000..ee9a4baaa
--- /dev/null
+++ b/tools/build-warnings/prost/probe.proto
@@ -0,0 +1,7 @@
+syntax = "proto3";
+
+package build_probe;
+
+message RoundTrip {
+  string value = 1;
+}
diff --git a/tools/build-warnings/prost/round_trip.rs b/tools/build-warnings/prost/round_trip.rs
new file mode 100644
index 000000000..c55847fe1
--- /dev/null
+++ b/tools/build-warnings/prost/round_trip.rs
@@ -0,0 +1,14 @@
+use probe_proto::build_probe::RoundTrip;
+use prost::Message;
+
+#[test]
+fn generated_messages_round_trip() {
+    let original = RoundTrip {
+        value: "generated by the maintained Prost toolchain".to_owned(),
+    };
+
+    let bytes = original.encode_to_vec();
+    let decoded = RoundTrip::decode(bytes.as_slice()).expect("decode the generated message");
+
+    assert_eq!(original, decoded);
+}
