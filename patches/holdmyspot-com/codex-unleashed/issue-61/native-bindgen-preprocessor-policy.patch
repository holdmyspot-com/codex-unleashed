new file mode 100644
index 000000000..d92ec7d6c
--- /dev/null
+++ b/patches/rules_rs_bindgen_preprocessor_policy.patch
@@ -0,0 +1,223 @@
+diff --git a/rs/private/BUILD.bazel b/rs/private/BUILD.bazel
+index ba3139e..6941e0b 100644
+--- a/rs/private/BUILD.bazel
++++ b/rs/private/BUILD.bazel
+@@ -53,6 +53,7 @@ bzl_library(
+     srcs = ["bindgen_test.bzl"],
+     deps = [
+         ":bindgen",
++        "@bazel_skylib//lib:partial",
+         "@bazel_skylib//lib:unittest",
+     ],
+ )
+diff --git a/rs/private/bindgen.bzl b/rs/private/bindgen.bzl
+index 158bfce..4b84e22 100644
+--- a/rs/private/bindgen.bzl
++++ b/rs/private/bindgen.bzl
+@@ -108,7 +108,68 @@ def normalize_msvc_compile_flags(compile_flags):
+                 result.extend(["-x", "c++"])
+             elif lowercase_flag in runtime_libraries:
+                 result.append("-fms-runtime-lib=" + runtime_libraries[lowercase_flag])
++            elif lowercase_flag == "/wx":
++                result.append("-Werror")
++            elif lowercase_flag == "/wx-":
++                result.append("-Wno-error")
+             else:
+                 result.append(flag)
+
+     return result
++
++def filter_bindgen_compile_flags(compile_flags, clang_flags):
++    """Keep compiler arguments that affect parsing headers for bindgen.
++
++    Args:
++      compile_flags: Compiler toolchain arguments, including preprocessing options.
++      clang_flags: Explicit bindgen caller options that remain supported.
++
++    Returns:
++      Clang driver arguments for parsing the target headers.
++    """
++    compile_flags = normalize_msvc_compile_flags(compile_flags)
++    clang_flags = normalize_msvc_compile_flags(clang_flags)
++
++    allowed_flag_prefixes = (
++        "-O",
++        "-W",
++        "-fms-runtime-lib=",
++        "-no-canonical-prefixes",
++        "-nostdinc",
++        "-nostdinc++",
++        "-nostdlibinc",
++        "-resource-dir=",
++        "-std=",
++        "--no-standard-includes",
++    )
++    xclang_flags_to_strip = (
++        "-fno-cxx-modules",
++        "-fexperimental-optimized-noescape",
++        "-fmodule-map-file-home-is-cwd",
++    )
++
++    result = []
++    copy_next = False
++    skip_next = False
++    for index, flag in enumerate(compile_flags):
++        if skip_next:
++            skip_next = False
++            continue
++        if copy_next:
++            result.append(flag)
++            copy_next = False
++            continue
++        if flag in clang_flags:
++            result.append(flag)
++            copy_next = flag in CLANG_PARAMETER_FLAGS
++            continue
++        if not flag.startswith(CLANG_PARAMETER_FLAGS + allowed_flag_prefixes):
++            continue
++        if flag == "-Xclang" and index + 1 < len(compile_flags) and compile_flags[index + 1] in xclang_flags_to_strip:
++            skip_next = True
++            continue
++
++        result.append(flag)
++        copy_next = flag in CLANG_PARAMETER_FLAGS
++
++    return result
+diff --git a/rs/private/bindgen_test.bzl b/rs/private/bindgen_test.bzl
+index 15f013b..4032b16 100644
+--- a/rs/private/bindgen_test.bzl
++++ b/rs/private/bindgen_test.bzl
+@@ -1,7 +1,8 @@
+ """Tests for bindgen helpers."""
+
+ load("@bazel_skylib//lib:unittest.bzl", "asserts", "unittest")
+-load(":bindgen.bzl", "normalize_msvc_compile_flags")
++load("@bazel_skylib//lib:partial.bzl", "partial")
++load(":bindgen.bzl", "filter_bindgen_compile_flags", "normalize_msvc_compile_flags")
+
+ def _normalize_msvc_compile_flags_impl(ctx):
+     env = unittest.begin(ctx)
+@@ -97,6 +98,40 @@ def _preserve_other_msvc_options_impl(ctx):
+
+     return unittest.end(env)
+
++def _preserve_preprocessor_policy_impl(ctx):
++    env = unittest.begin(ctx)
++    asserts.equals(
++        env,
++        ["-target", "x86_64-linux-gnu", "-O2", "-D_FORTIFY_SOURCE=1", "-Werror", "-Wno-builtin-macro-redefined", '-D__DATE__="redacted"'],
++        filter_bindgen_compile_flags(
++            ["-target", "x86_64-linux-gnu", "-O2", "-D_FORTIFY_SOURCE=1", "-Werror", "-Wno-builtin-macro-redefined", '-D__DATE__="redacted"', "-c", "unused.c"],
++            [],
++        ),
++    )
++    return unittest.end(env)
++
++def _normalize_msvc_warning_policy_impl(ctx):
++    env = unittest.begin(ctx)
++    asserts.equals(env, ["-Werror", "-D", "DEBUG"], filter_bindgen_compile_flags(["/WX", "/DDEBUG"], []))
++    asserts.equals(env, ["-Werror", "-Wno-error"], filter_bindgen_compile_flags(["/WX", "/WX-"], []))
++    return unittest.end(env)
++
++def _preserve_argument_boundaries_impl(ctx):
++    env = unittest.begin(ctx)
++    asserts.equals(
++        env,
++        ["-isystem", "/Users/SDK", "-I", "-option-like-directory", "-fparse-all-comments"],
++        filter_bindgen_compile_flags(
++            ["-isystem", "/Users/SDK", "-I", "-option-like-directory", "-Xclang", "-fno-cxx-modules", "-fparse-all-comments", "-fno-strict-aliasing"],
++            ["-fparse-all-comments"],
++        ),
++    )
++    return unittest.end(env)
++
++preserve_preprocessor_policy_test = unittest.make(_preserve_preprocessor_policy_impl)
++normalize_msvc_warning_policy_test = unittest.make(_normalize_msvc_warning_policy_impl)
++preserve_argument_boundaries_test = unittest.make(_preserve_argument_boundaries_impl)
++
+ normalize_msvc_compile_flags_test = unittest.make(_normalize_msvc_compile_flags_impl)
+ normalize_msvc_runtime_libraries_test = unittest.make(_normalize_msvc_runtime_libraries_impl)
+ preserve_other_msvc_options_test = unittest.make(_preserve_other_msvc_options_impl)
+@@ -104,7 +139,10 @@ preserve_other_msvc_options_test = unittest.make(_preserve_other_msvc_options_im
+ def bindgen_tests():
+     return unittest.suite(
+         "bindgen_tests",
+-        normalize_msvc_compile_flags_test,
+-        normalize_msvc_runtime_libraries_test,
+-        preserve_other_msvc_options_test,
++        partial.make(normalize_msvc_compile_flags_test, size = "small"),
++        partial.make(normalize_msvc_runtime_libraries_test, size = "small"),
++        partial.make(preserve_other_msvc_options_test, size = "small"),
++        partial.make(preserve_preprocessor_policy_test, size = "small"),
++        partial.make(normalize_msvc_warning_policy_test, size = "small"),
++        partial.make(preserve_argument_boundaries_test, size = "small"),
+     )
+diff --git a/rs/rules_rust_bindgen.bzl b/rs/rules_rust_bindgen.bzl
+index c6c0f72..2901d09 100644
+--- a/rs/rules_rust_bindgen.bzl
++++ b/rs/rules_rust_bindgen.bzl
+@@ -19,14 +19,13 @@ load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
+ load("@rules_cc//cc:find_cc_toolchain.bzl", "find_cc_toolchain", "use_cc_toolchain")
+ load("@rules_cc//cc/common:cc_common.bzl", "cc_common")
+ load("@rules_cc//cc/common:cc_info.bzl", "CcInfo")
+-load("//rs/private:bindgen.bzl", "CLANG_PARAMETER_FLAGS", "normalize_msvc_compile_flags")
++load("//rs/private:bindgen.bzl", "filter_bindgen_compile_flags")
+ load("//rs/toolchains:declare_bindgen_toolchains.bzl", "BINDGEN_PREBUILTS", "bindgen_binary_name")
+
+ _BINDGEN_TOOLCHAIN_TYPE = Label("//rs:bindgen_toolchain_type")
+
+ def _clang_compile_flags(ctx, cc_toolchain, feature_configuration):
+     compilation_context = ctx.attr.cc_lib[CcInfo].compilation_context
+-    clang_flags = normalize_msvc_compile_flags(ctx.attr.clang_flags)
+     compile_variables = cc_common.create_compile_variables(
+         cc_toolchain = cc_toolchain,
+         feature_configuration = feature_configuration,
+@@ -46,47 +45,8 @@ def _clang_compile_flags(ctx, cc_toolchain, feature_configuration):
+         action_name = C_COMPILE_ACTION_NAME,
+         variables = compile_variables,
+     )
+-    compile_flags = normalize_msvc_compile_flags(compile_flags)
+-
+-    allowed_flag_prefixes = (
+-        "-fms-runtime-lib=",
+-        "-no-canonical-prefixes",
+-        "-nostdinc",
+-        "-nostdinc++",
+-        "-nostdlibinc",
+-        "-resource-dir=",
+-        "-std=",
+-        "--no-standard-includes",
+-    )
+-    xclang_flags_to_strip = (
+-        "-fno-cxx-modules",
+-        "-fexperimental-optimized-noescape",
+-        "-fmodule-map-file-home-is-cwd",
+-    )
+
+-    result = []
+-    copy_next = False
+-    skip_next = False
+-    for index, flag in enumerate(compile_flags):
+-        if skip_next:
+-            skip_next = False
+-            continue
+-        if copy_next:
+-            result.append(flag)
+-            copy_next = False
+-            continue
+-        if flag in clang_flags:
+-            result.append(flag)
+-            copy_next = flag in CLANG_PARAMETER_FLAGS
+-            continue
+-        if not flag.startswith(CLANG_PARAMETER_FLAGS + allowed_flag_prefixes):
+-            continue
+-        if flag == "-Xclang" and index + 1 < len(compile_flags) and compile_flags[index + 1] in xclang_flags_to_strip:
+-            skip_next = True
+-            continue
+-
+-        result.append(flag)
+-        copy_next = flag in CLANG_PARAMETER_FLAGS
++    result = filter_bindgen_compile_flags(compile_flags, ctx.attr.clang_flags)
+
+     for define in compilation_context.defines.to_list():
+         result.append("-D" + define)
