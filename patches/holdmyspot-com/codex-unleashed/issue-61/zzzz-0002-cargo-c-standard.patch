+load(":flags_test.bzl", "cargo_c_flags_test")
+
+cargo_build_script(
+    name = "probe",
+    testonly = True,
+    srcs = ["build.rs"],
+    edition = "2024",
+)
+
+cargo_c_flags_test(
+    name = "flags_test",
+    target_under_test = ":probe",
+)
