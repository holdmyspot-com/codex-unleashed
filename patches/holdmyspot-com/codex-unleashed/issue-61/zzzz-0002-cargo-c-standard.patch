diff --git a/patches/rules_rust_cargo_c_standard.patch b/patches/rules_rust_cargo_c_standard.patch
new file mode 100644
index 000000000..a40e39c32
--- /dev/null
+++ b/patches/rules_rust_cargo_c_standard.patch
@@ -0,0 +1,34 @@
+From 6988b310d55f706469f22352551cbab33cc869e1 Mon Sep 17 00:00:00 2001
+From: Gili Tzabari <cowwoc2020@gmail.com>
+Date: Thu, 15 Oct 2026 19:32:06 -0400
+Subject: [PATCH] Leave the Cargo native C standard to the build script
+
+---
+ cargo/private/cargo_build_script.bzl | 11 ++++++++++-
+ 1 file changed, 10 insertions(+), 1 deletion(-)
+
+diff --git a/cargo/private/cargo_build_script.bzl b/cargo/private/cargo_build_script.bzl
+index 15577c9..3865418 100644
+--- a/cargo/private/cargo_build_script.bzl
++++ b/cargo/private/cargo_build_script.bzl
+@@ -538,8 +538,17 @@ def _cargo_build_script_impl(ctx):
+     env["CFLAGS"] = ""
+     env["CXXFLAGS"] = ""
+     if cc_toolchain:
++        # WORKAROUND: https://github.com/holdmyspot-com/codex-unleashed/issues/61
++        # Build scripts choose the C dialect; exporting a toolchain default
++        # adds a conflicting /std flag. Remove when rules_rust exports native
++        # build-script flags without the default C-standard feature.
++        _, compile_feature_configuration = find_cc_toolchain(
++            ctx,
++            extra_unsupported_features = ["default_c_std"],
++        )
++
+         # MSVC requires INCLUDE to be set
+-        cc_c_args, cc_cxx_args, cc_env = get_cc_compile_args_and_env(cc_toolchain, feature_configuration)
++        cc_c_args, cc_cxx_args, cc_env = get_cc_compile_args_and_env(cc_toolchain, compile_feature_configuration)
+         if cargo_release_profile:
+             # Preserve SDK, ABI, CRT and security options. User copts and crate
+             # build_script_env overrides retain precedence over these defaults.
+--
+2.43.0
diff --git a/tools/build-warnings/cargo-c-standard/BUILD.bazel b/tools/build-warnings/cargo-c-standard/BUILD.bazel
new file mode 100644
index 000000000..3c92a51fc
--- /dev/null
+++ b/tools/build-warnings/cargo-c-standard/BUILD.bazel
@@ -0,0 +1,14 @@
+load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
+load(":flags_test.bzl", "cargo_c_flags_test")
+
+cargo_build_script(
+    name = "probe",
+    testonly = True,
+    srcs = ["build.rs"],
+    edition = "2024",
+)
+
+cargo_c_flags_test(
+    name = "flags_test",
+    target_under_test = ":probe",
+)
diff --git a/tools/build-warnings/cargo-c-standard/build.rs b/tools/build-warnings/cargo-c-standard/build.rs
new file mode 100644
index 000000000..f328e4d9d
--- /dev/null
+++ b/tools/build-warnings/cargo-c-standard/build.rs
@@ -0,0 +1 @@
+fn main() {}
diff --git a/tools/build-warnings/cargo-c-standard/flags_test.bzl b/tools/build-warnings/cargo-c-standard/flags_test.bzl
new file mode 100644
index 000000000..720baf678
--- /dev/null
+++ b/tools/build-warnings/cargo-c-standard/flags_test.bzl
@@ -0,0 +1,24 @@
+load("@bazel_skylib//lib:unittest.bzl", "analysistest", "asserts")
+
+def _cargo_c_flags_test_impl(ctx):
+    env = analysistest.begin(ctx)
+    actions = [action for action in analysistest.target_actions(env) if action.mnemonic == "CargoBuildScriptRun"]
+    asserts.equals(env, 1, len(actions), "The fixture must run one Cargo build script")
+    for action in actions:
+        asserts.true(env, action.env["CC"].endswith("cl.exe"), "The fixture exports native MSVC flags")
+        flags = action.env["CFLAGS"].split(" ")
+        standards = [flag for flag in flags if flag.startswith("/std:")]
+        runtimes = [flag for flag in flags if flag in ["/MD", "/MDd", "/MT", "/MTd"]]
+        asserts.equals(env, [], standards, "Build scripts select their C standard without an injected default")
+        asserts.equals(env, ["/MT"], runtimes, "Build scripts inherit the selected static runtime exactly once")
+        asserts.true(env, "/WX" in flags, "Cargo native compilation retains fatal warnings")
+    return analysistest.end(env)
+
+cargo_c_flags_test = analysistest.make(
+    _cargo_c_flags_test_impl,
+    config_settings = {
+        "//command_line_option:platforms": str(Label("//:windows_x86_64_msvc")),
+        "//command_line_option:extra_toolchains": [str(Label("//tools/build-warnings/assembly/native:analysis_toolchain"))],
+        "//command_line_option:features": ["static_link_msvcrt", "-dynamic_link_msvcrt", "treat_warnings_as_errors"],
+    },
+)
