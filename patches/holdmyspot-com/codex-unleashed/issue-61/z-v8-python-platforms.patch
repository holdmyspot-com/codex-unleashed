diff --git a/patches/v8_inspector_python_runtime.patch b/patches/v8_inspector_python_runtime.patch
new file mode 100644
index 000000000..0b9cd3022
--- /dev/null
+++ b/patches/v8_inspector_python_runtime.patch
@@ -0,0 +1,84 @@
+From d9d54589eba9727ffddfd612db89da8b808062d2 Mon Sep 17 00:00:00 2001
+From: Gili Tzabari <cowwoc2020@gmail.com>
+Date: Thu, 15 Oct 2026 09:15:04 +0000
+Subject: [PATCH] Run inspector zipapp with declared execution-platform Python
+
+---
+ BUILD.bazel           | 17 +++++++++++++++--
+ bazel/exec_python.bzl | 18 ++++++++++++++++++
+ 2 files changed, 33 insertions(+), 2 deletions(-)
+ create mode 100644 bazel/exec_python.bzl
+
+diff --git a/orig/v8-15.0.245.2/BUILD.bazel b/mod/v8-15.0.245.2/BUILD.bazel
+index bbeb91a..39983b2 100644
+--- a/orig/v8-15.0.245.2/BUILD.bazel
++++ b/mod/v8-15.0.245.2/BUILD.bazel
+@@ -8,6 +8,7 @@ load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
+ load("@rules_cc//cc:cc_test.bzl", "cc_test")
+ load("@rules_python//python:defs.bzl", "py_binary", "py_test")
+ load("@rules_python//python/zipapp:py_zipapp_binary.bzl", "py_zipapp_binary")
++load(":bazel/exec_python.bzl", "exec_python_toolchain")
+ load("@v8_python_deps//:requirements.bzl", "requirement")
+ load(
+     "@v8//:bazel/defs.bzl",
+@@ -4447,6 +4448,16 @@ py_binary(
+ py_zipapp_binary(
+     name = "code_generator_zipapp",
+     binary = ":code_generator",
++    executable = False,
++)
++
++exec_python_toolchain(
++    name = "code_generator_python_runtime",
++)
++
++filegroup(
++    name = "code_generator_zipapp_file",
++    srcs = [":code_generator_zipapp"],
+ )
+
+ genrule(
+@@ -4490,15 +4501,17 @@ genrule(
+         "src/inspector/protocol/Schema.h",
+     ],
+     cmd = "INSPECTOR_PROTOCOL_DIR=$$(dirname $(execpath third_party/inspector_protocol/code_generator.py)); \
+-           $(execpath :code_generator_zipapp) --jinja_dir . \
++           $(PYTHON3) $(execpath :code_generator_zipapp_file) --jinja_dir . \
+            --inspector_protocol_dir $$INSPECTOR_PROTOCOL_DIR \
+            --config $(location :src/inspector/inspector_protocol_config.json) \
+            --config_value protocol.path=$(location :include/js_protocol.pdl) \
+            --config_value crdtp.dir=third_party/inspector_protocol/crdtp \
+            --output_base $(@D)/src/inspector",
+     message = "Generating inspector files",
++    toolchains = [":code_generator_python_runtime"],
+     tools = [
+-        ":code_generator_zipapp",
++        ":code_generator_python_runtime",
++        ":code_generator_zipapp_file",
+     ],
+ )
+
+diff --git a/orig/v8-15.0.245.2/bazel/exec_python.bzl b/mod/v8-15.0.245.2/bazel/exec_python.bzl
+new file mode 100644
+index 0000000..c62e370
+--- /dev/null
++++ b/mod/v8-15.0.245.2/bazel/exec_python.bzl
+@@ -0,0 +1,18 @@
++"""Make the execution platform's Python runtime available to genrules."""
++
++def _exec_python_toolchain_impl(ctx):
++    return [
++        ctx.attr._runtime[DefaultInfo],
++        ctx.attr._runtime[platform_common.TemplateVariableInfo],
++    ]
++
++exec_python_toolchain = rule(
++    implementation = _exec_python_toolchain_impl,
++    attrs = {
++        "_runtime": attr.label(
++            default = Label("@rules_python//python:current_py_toolchain"),
++            cfg = "exec",
++            providers = [platform_common.TemplateVariableInfo],
++        ),
++    },
++)
