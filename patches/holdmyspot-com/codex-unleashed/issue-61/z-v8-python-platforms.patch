diff --git a/patches/v8_python_execution_platforms.patch b/patches/v8_python_execution_platforms.patch
new file mode 100644
index 000000000..b0dd70fe9
--- /dev/null
+++ b/patches/v8_python_execution_platforms.patch
@@ -0,0 +1,25 @@
+From 4bda00b2315819f24b0973c0d95bcfe716b75b6f Mon Sep 17 00:00:00 2001
+From: Gili Tzabari <cowwoc2020@gmail.com>
+Date: Thu, 15 Oct 2026 09:02:45 +0000
+Subject: [PATCH] Provide V8 Python wheels for ARM remote execution and both
+ Macs
+
+---
+ MODULE.bazel | 3 +++
+ 1 file changed, 3 insertions(+)
+
+diff --git a/orig/v8-15.0.245.2/MODULE.bazel b/mod/v8-15.0.245.2/MODULE.bazel
+index 7eee9b7..fe6e8a5 100644
+--- a/orig/v8-15.0.245.2/MODULE.bazel
++++ b/mod/v8-15.0.245.2/MODULE.bazel
+@@ -75,7 +75,10 @@ pip.parse(
+     requirements_lock = "//:bazel/requirements.txt",
+     target_platforms = [
+         "{os}_{arch}",
++        "linux_aarch64",
+         "linux_x86_64",
++        "osx_aarch64",
++        "osx_x86_64",
+         "windows_x86_64",
+     ],
+     extra_pip_args = [
diff --git a/tools/build-warnings/v8/check-inspector-runtime.sh b/tools/build-warnings/v8/check-inspector-runtime.sh
new file mode 100755
index 000000000..d7618600b
--- /dev/null
+++ b/tools/build-warnings/v8/check-inspector-runtime.sh
@@ -0,0 +1,20 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)"
+cd -- "$repo_root"
+
+fixture_dir="$(mktemp -d -t v8-inspector-runtime.XXXXXX)"
+trap 'rm -r -- "$fixture_dir"' EXIT
+cat > "$fixture_dir/unzip" <<'EOF'
+#!/bin/sh
+echo "unzip is unavailable in the remote execution image" >&2
+exit 127
+EOF
+chmod +x "$fixture_dir/unzip"
+
+for platform in //:rbe //:windows_x86_64_gnullvm; do
+    bazel build "$@" "--platforms=$platform" \
+        "--action_env=PATH=$fixture_dir:/usr/bin:/bin" \
+        @v8//:generated_inspector_files
+done
diff --git a/tools/build-warnings/v8/check-python-platforms.sh b/tools/build-warnings/v8/check-python-platforms.sh
new file mode 100755
index 000000000..3e51fd6ff
--- /dev/null
+++ b/tools/build-warnings/v8/check-python-platforms.sh
@@ -0,0 +1,18 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)"
+cd -- "$repo_root"
+
+platforms=(
+    //:rbe
+    //:windows_x86_64_gnullvm
+    @rules_rs//rs/platforms:aarch64-unknown-linux-gnu
+    @rules_rs//rs/platforms:x86_64-apple-darwin
+    @rules_rs//rs/platforms:aarch64-apple-darwin
+)
+for platform in "${platforms[@]}"; do
+    bazel cquery "$@" "--platforms=$platform" @v8//:code_generator
+done
+
+bazel build "$@" @v8//:generated_inspector_files
