 patches/v8_bazel_rules.patch                  |  22 +-
 patches/v8_inspector_python_runtime.patch     |  84 ++++++
 patches/v8_module_deps.patch                  | 246 +++++++++++++++++-
 patches/v8_python_execution_platforms.patch   |  25 ++
 .../v8/check-inspector-runtime.sh             |  20 ++
 .../v8/check-python-platforms.sh              |  18 ++
 8 files changed, 560 insertions(+), 77 deletions(-)
 create mode 100644 patches/v8_inspector_python_runtime.patch
 create mode 100644 patches/v8_python_execution_platforms.patch
 create mode 100755 tools/build-warnings/v8/check-inspector-runtime.sh
 create mode 100755 tools/build-warnings/v8/check-python-platforms.sh

