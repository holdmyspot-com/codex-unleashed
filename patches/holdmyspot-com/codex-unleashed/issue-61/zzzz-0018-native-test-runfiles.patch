From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Thu, 15 Oct 2026 17:29:59 +0000
Subject: [PATCH] Resolve native test fixtures through Bazel runfiles

Use the maintained resource and binary resolvers for the published schema and Windows sandbox manifest tests. Preserve schema value checks and Windows manifest resource assertions.

The canonical schema patch owns its generated CLI test and the final schema dev-dependency registration, because scripts/apply-patches.sh applies schema after issue-61. Keep this patch independent of those later additions.

Native red: jobs 116473691446 and 116520488151 reproduce unresolved logical runfiles. Focused schema tests, maintained formatting, and lock gates pass with the final combined tree. Complete ordered queue verification is required.
---
 codex-rs/Cargo.lock                                  | 1 +
 codex-rs/config-schema/tests/published_schema.rs     | 5 +++--
 codex-rs/windows-sandbox-rs/tests/helper_manifest.rs | 7 ++-----
 3 files changed, 6 insertions(+), 7 deletions(-)

diff --git a/codex-rs/Cargo.lock b/codex-rs/Cargo.lock
index 2dce92f41..e7887f926 100644
--- a/codex-rs/Cargo.lock
+++ b/codex-rs/Cargo.lock
@@ -2875,6 +2875,7 @@ dependencies = [
  "anyhow",
  "clap",
  "codex-config",
+ "codex-utils-cargo-bin",
  "serde_json",
  "tempfile",
 ]
diff --git a/codex-rs/config-schema/tests/published_schema.rs b/codex-rs/config-schema/tests/published_schema.rs
index d14ac6a70..94092053e 100644
--- a/codex-rs/config-schema/tests/published_schema.rs
+++ b/codex-rs/config-schema/tests/published_schema.rs
@@ -1,8 +1,9 @@
-use std::path::Path;
+use codex_utils_cargo_bin::find_resource;
 
 #[test]
 fn published_schema_fixture_is_available() {
-    let fixture = Path::new(env!("CARGO_MANIFEST_DIR")).join("../core/config.schema.json");
+    let fixture = find_resource!("../core/config.schema.json")
+        .expect("resolve the published configuration schema");
     let bytes = std::fs::read(&fixture)
         .unwrap_or_else(|error| panic!("cannot read published schema {fixture:?}: {error}"));
     assert!(
diff --git a/codex-rs/windows-sandbox-rs/tests/helper_manifest.rs b/codex-rs/windows-sandbox-rs/tests/helper_manifest.rs
index f06810811..b59377a23 100644
--- a/codex-rs/windows-sandbox-rs/tests/helper_manifest.rs
+++ b/codex-rs/windows-sandbox-rs/tests/helper_manifest.rs
@@ -2,9 +2,9 @@
 
 use anyhow::Context;
 use anyhow::Result;
+use codex_utils_cargo_bin::cargo_bin;
 use std::io;
 use std::os::windows::ffi::OsStrExt;
-use std::path::PathBuf;
 use windows_sys::Win32::Foundation::FreeLibrary;
 use windows_sys::Win32::System::LibraryLoader::FindResourceW;
 use windows_sys::Win32::System::LibraryLoader::LOAD_LIBRARY_AS_DATAFILE;
@@ -19,10 +19,7 @@ use windows_sys::Win32::UI::WindowsAndMessaging::RT_MANIFEST;
 /// The setup executable must expose an asInvoker manifest through the Windows resource API.
 #[test]
 fn setup_helper_embeds_as_invoker_manifest() -> Result<()> {
-    let setup_executable = std::env::var_os("CARGO_BIN_EXE_codex-windows-sandbox-setup")
-        .or_else(|| std::env::var_os("CARGO_BIN_EXE_codex_windows_sandbox_setup"))
-        .map(PathBuf::from)
-        .or_else(|| option_env!("CARGO_BIN_EXE_codex-windows-sandbox-setup").map(PathBuf::from))
+    let setup_executable = cargo_bin("codex-windows-sandbox-setup")
         .context("locate the Windows sandbox setup executable")?;
     std::fs::metadata(&setup_executable)
         .with_context(|| format!("find setup helper {}", setup_executable.display()))?;
