From 9e31c7e27131590eaa9f93dfd00de8a521051569 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Wed, 14 Oct 2026 13:13:33 +0000
Subject: [PATCH] Guard optional GStreamer allocator performance category

Track native warning enforcement in #61. Apply after the documented native
voice prerequisites; keep all compiler and linker checks enabled.

Reproduction evidence: native-orc-mode-prefix-green.log. The actual native recipe reports the
missing outcome under LLVM 23. Runtime and fresh emitted-queue acceptance
are recorded separately; an internal authoring commit is not full CI acceptance.
---
 third_party/voice/prepare_sources.py          | 35 +++++++++++++++++++
 tools/build-warnings/gstreamer/BUILD.bazel    |  1 +
 .../gstreamer/allocator_type_test.c           | 12 +++++++
 3 files changed, 48 insertions(+)
 create mode 100644 tools/build-warnings/gstreamer/allocator_type_test.c

diff --git a/third_party/voice/prepare_sources.py b/third_party/voice/prepare_sources.py
index 89c14fa4a..44d810775 100644
--- a/third_party/voice/prepare_sources.py
+++ b/third_party/voice/prepare_sources.py
@@ -208,6 +208,41 @@ def extract_source(source: Source, archives: Path, destination: Path) -> None:
             raise ValueError("Pinned GStreamer Orc fallback diagnostic does not match")
         meson.write_text(contents.replace(original, replacement), encoding="utf-8")
 
+    if source.name == "gst-plugins-base" and source.version == "1.28.6":
+        # WORKAROUND: performance logging shares the optional Linux allocator guard.
+        # https://github.com/holdmyspot-com/codex-unleashed/issues/61
+        # Remove when GStreamer guards this category with its only user.
+        allocator = (
+            destination / source.root / "gst-libs/gst/allocators/gstudmabufallocator.c"
+        )
+        contents = allocator.read_text(encoding="utf-8")
+        condition = "#if defined(HAVE_MEMFD_CREATE) && defined(HAVE_LINUX_UDMABUF_H)"
+        for original, replacement in (
+            (
+                "GST_DEBUG_CATEGORY_STATIC (GST_CAT_PERFORMANCE);",
+                condition
+                + "\nGST_DEBUG_CATEGORY_STATIC (GST_CAT_PERFORMANCE);\n#endif",
+            ),
+            (
+                "#define parent_class gst_udmabuf_allocator_parent_class",
+                "static void\n"
+                "gst_udmabuf_allocator_init_performance_category (void)\n"
+                "{\n"
+                + condition
+                + '\n  GST_DEBUG_CATEGORY_GET (GST_CAT_PERFORMANCE, "GST_PERFORMANCE");\n'
+                "#endif\n}\n\n"
+                "#define parent_class gst_udmabuf_allocator_parent_class",
+            ),
+            (
+                '    GST_DEBUG_CATEGORY_GET (GST_CAT_PERFORMANCE, "GST_PERFORMANCE");',
+                "    gst_udmabuf_allocator_init_performance_category ();",
+            ),
+        ):
+            if contents.count(original) != 1:
+                raise ValueError("Pinned GStreamer allocator category does not match")
+            contents = contents.replace(original, replacement)
+        allocator.write_text(contents, encoding="utf-8")
+
     if source.name == "gstreamer" and source.version == "1.28.6":
         # WORKAROUND: these pad quarks are interned but their storage is unused.
         # https://github.com/holdmyspot-com/codex-unleashed/issues/61
diff --git a/tools/build-warnings/gstreamer/BUILD.bazel b/tools/build-warnings/gstreamer/BUILD.bazel
index 191f97912..a492b8264 100644
--- a/tools/build-warnings/gstreamer/BUILD.bazel
+++ b/tools/build-warnings/gstreamer/BUILD.bazel
@@ -12,6 +12,7 @@ NATIVE_INCLUDES = [
 ]
 
 TEST_NAMES = [
+    "allocator_type_test",
     "pad_quarks_test",
 ]
 
diff --git a/tools/build-warnings/gstreamer/allocator_type_test.c b/tools/build-warnings/gstreamer/allocator_type_test.c
new file mode 100644
index 000000000..113467c9a
--- /dev/null
+++ b/tools/build-warnings/gstreamer/allocator_type_test.c
@@ -0,0 +1,12 @@
+#include <gst/allocators/gstudmabufallocator.h>
+
+int main(void) {
+  gst_init(NULL, NULL);
+  gpointer klass = g_type_class_ref(GST_TYPE_UDMABUF_ALLOCATOR);
+  int status = klass == NULL ||
+               !g_type_is_a(GST_TYPE_UDMABUF_ALLOCATOR, GST_TYPE_ALLOCATOR);
+  if (klass != NULL)
+    g_type_class_unref(klass);
+  gst_deinit();
+  return status;
+}
