From 8584916dffe8f09005cc3bb0c73d3b181b8f22fe Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Sun, 18 Oct 2026 09:07:44 +0000
Subject: [PATCH] Preserve LLVM link resources in the native Meson recipe

Normalize C and C++ resource-directory flags to the declared merged linker resource tree for Meson, whose link commands append compilation flags. Keep other arguments and resource-free toolchains unchanged.

Regression: the actual declared LLVM 23 configuration fails the miniature C/C++ Meson link at its missing builtins archive before the change. The patched recipe compiles, links, and executes the standard-library fixture without warning diagnostics.

Validation: just fmt-check and the maintained native voice unit suite pass (91 tests, 19 skips). The complete native voice prefix and fresh emitted integration gates remain separate.

Consolidate follow-up corrections while preserving the final implementation:
- zzzz-0035-native-meson-darwin-linker.patch

Original focused red/green records remain in the owning task evidence.
Fresh emitted-queue verification is a separate acceptance gate.
---
 third_party/voice/build_native.py          | 19 +++++-
 third_party/voice/test_build_native.py     | 26 +++++++++
 tools/build-warnings/check-native-meson.py | 67 ++++++++++++++++++++++
 3 files changed, 111 insertions(+), 1 deletion(-)
 create mode 100644 tools/build-warnings/check-native-meson.py

diff --git a/third_party/voice/build_native.py b/third_party/voice/build_native.py
index da2872ab2..8df9b9d23 100644
--- a/third_party/voice/build_native.py
+++ b/third_party/voice/build_native.py
@@ -303,10 +303,27 @@ class NativeBuild:
         )
         if self.args.target.endswith("unknown-linux-gnu"):
             link[-1] = "-Wl,-rpath,$ORIGIN:$ORIGIN/.."
+
+        meson_flags = {name: list(flags) for name, flags in self.flags.items()}
+        if self.args.target.endswith("apple-darwin"):
+            meson_flags["LDFLAGS"].append("-fuse-ld=/usr/bin/ld")
+        resource_prefix = "-resource-dir="
+        link_resources = [
+            flag for flag in self.flags["LDFLAGS"] if flag.startswith(resource_prefix)
+        ]
+        if link_resources:
+            # Meson appends compilation flags to its link command. Preserve the
+            # declared linker resource tree, which includes headers and runtimes.
+            for variable in ("CFLAGS", "CXXFLAGS"):
+                meson_flags[variable] = [
+                    link_resources[-1] if flag.startswith(resource_prefix) else flag
+                    for flag in meson_flags[variable]
+                ]
+
         self.environment.update(
             {
                 name: self.quote([*flags, *(link if name == "LDFLAGS" else [include])])
-                for name, flags in self.flags.items()
+                for name, flags in meson_flags.items()
             }
         )
         if self.args.target.endswith("apple-darwin"):
