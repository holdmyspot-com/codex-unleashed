@@ -407,6 +412,27 @@ class NativeBuildTests(unittest.TestCase):
                 ],
             )
 
+    def test_meson_native_linker_selection_matches_target(self):
+        for suffix, expected in (
+            ("apple-darwin", "-fuse-ld=/usr/bin/ld"),
+            ("unknown-linux-gnu", "-fuse-ld=lld"),
+        ):
+            with self.subTest(target=suffix):
+                self.args.target = "x86_64-" + suffix
+                self.args.link_flag = ["-fuse-ld=lld", "-Wl,-fatal_warnings"]
+                with patch("build_native.validate_target"):
+                    build = NativeBuild(self.args, self.environment)
+                build.sources = {"meson": self.root, "probe": self.root}
+                with patch.object(build, "run"):
+                    build.meson("probe", [])
+                link = shlex.split(build.environment["LDFLAGS"])
+                selectors = [flag for flag in link if flag.startswith("-fuse-ld=")]
+                self.assertEqual(selectors[-1], expected)
+                self.assertIn("-Wl,-fatal_warnings", link)
+                self.assertEqual(build.flags["LDFLAGS"], self.args.link_flag)
+                for variable in ("CFLAGS", "CXXFLAGS"):
+                    self.assertNotIn(expected, shlex.split(build.environment[variable]))
+
     def test_windows_paths_use_cygpath_and_propagate_failure(self):
         build = NativeBuild(self.args, self.environment)
         build.windows = True
diff --git a/tools/build-warnings/check-native-meson.py b/tools/build-warnings/check-native-meson.py
new file mode 100644
index 000000000..f1fae251d
--- /dev/null
+++ b/tools/build-warnings/check-native-meson.py
@@ -0,0 +1,67 @@
+#!/usr/bin/env python3
+"""Exercise the native voice Meson recipe with its declared C/C++ toolchain."""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+from types import SimpleNamespace
+
+CHECKOUT = Path(__file__).resolve().parents[2]
+sys.dont_write_bytecode = True
+sys.path.insert(0, str(CHECKOUT / "third_party/voice"))
+from build_native import NativeBuild
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("configuration", type=Path)
+    parser.add_argument("execroot", type=Path)
+    parser.add_argument("meson_source", type=Path)
+    parser.add_argument("ninja", type=Path)
+    arguments = parser.parse_args()
+    root = arguments.execroot.absolute()
+    configuration = json.loads(
+        arguments.configuration.read_text().replace("@VOICE_EXECROOT@", str(root))
+    )
+    for name in ("archives", "prefix", "receipt"):
+        configuration.pop(name)
+    linker = root / configuration.pop("ld")
+    for name in ("cc", "cxx", "ar", "ranlib", "cmake", "make", "pkg_config", "shell"):
+        configuration[name] = root / configuration[name]
+
+    with tempfile.TemporaryDirectory(
+        prefix="native-meson-probe-", dir=os.environ["TMPDIR"]
+    ) as temporary:
+        scratch = Path(temporary)
+        builder = NativeBuild(
+            SimpleNamespace(
+                **configuration,
+                archives=scratch,
+                output=scratch / "build",
+                bootstrap_make=None,
+            ),
+            os.environ,
+        )
+        builder.output.mkdir()
+        (builder.tools / "bin").mkdir(parents=True)
+        (builder.tools / "bin/ninja").symlink_to(arguments.ninja.absolute())
+        source = scratch / "sources"
+        shutil.copytree(CHECKOUT / "tools/build-warnings/meson", source)
+        builder.sources = {"meson": arguments.meson_source.absolute(), "probe": source}
+        builder.environment["LD"] = str(linker)
+        try:
+            builder.meson("probe", [])
+            subprocess.run([builder.output / "build/probe/resource-probe"], check=True)
+        finally:
+            for log in sorted(builder.output.glob("*.log")):
+                print(log.read_text(errors="replace"))
+    print("Native voice Meson compiles, links, and executes its C/C++ resource probe.")
+
+
+if __name__ == "__main__":
+    main()
