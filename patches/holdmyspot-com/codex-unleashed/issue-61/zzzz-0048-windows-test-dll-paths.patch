diff --git a/tools/build-warnings/windows-launcher/dynamic_libraries_test.bzl b/tools/build-warnings/windows-launcher/dynamic_libraries_test.bzl
new file mode 100644
index 000000000..1b04d3702
--- /dev/null
+++ b/tools/build-warnings/windows-launcher/dynamic_libraries_test.bzl
@@ -0,0 +1,30 @@
+"""Verify the Windows loader receives only declared DLL search directories."""
+
+load("@bazel_skylib//lib:unittest.bzl", "asserts", "unittest")
+load("//:defs.bzl", "windows_dynamic_library_path_exports")
+
+def _dll_directories_test_impl(ctx):
+    env = unittest.begin(ctx)
+    exports = windows_dynamic_library_path_exports([
+        struct(extension = "dll", dirname = "voice/bin", short_path = "voice/bin/glib.dll"),
+        struct(extension = "dll", dirname = "voice/bin", short_path = "voice/bin/gstreamer.dll"),
+        struct(extension = "dll", dirname = "other/bin", short_path = "other/bin/codec.dll"),
+        struct(extension = "exe", dirname = "unrelated/bin", short_path = "unrelated/bin/tool.exe"),
+    ])
+    resolutions = [line for line in exports if line.startswith("call :resolve_runfile ")]
+    path_exports = [line for line in exports if 'set "PATH=' in line]
+    asserts.equals(env, 2, len(resolutions))
+    asserts.equals(env, 2, len(path_exports))
+    asserts.true(env, all([";!PATH!" in line for line in path_exports]))
+    asserts.false(env, any(["unrelated/bin" in line for line in exports]))
+    return unittest.end(env)
+
+def _no_dlls_test_impl(ctx):
+    env = unittest.begin(ctx)
+    asserts.equals(env, [], windows_dynamic_library_path_exports([
+        struct(extension = "lib", dirname = "sdk", short_path = "sdk/import.lib"),
+    ]))
+    return unittest.end(env)
+
+dll_directories_test = unittest.make(_dll_directories_test_impl)
+no_dlls_test = unittest.make(_no_dlls_test_impl)
