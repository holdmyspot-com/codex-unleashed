From 121898a09e730349bef2415aae3cb5598b36bd9a Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Wed, 14 Oct 2026 13:13:33 +0000
Subject: [PATCH] Distinguish disabled documentation from failed tool discovery

Track native warning enforcement in #61. Apply after the documented native
voice prerequisites; keep all compiler and linker checks enabled.

Reproduction evidence: native-doc-choice-red.log. The actual native recipe reports the
missing outcome under LLVM 23. Runtime and fresh emitted-queue acceptance
are recorded separately; an internal authoring commit is not full CI acceptance.
---
 third_party/voice/prepare_sources.py          |  23 ++++
 .../build-warnings/check-native-doc-choice.py | 114 ++++++++++++++++++
 2 files changed, 137 insertions(+)
 create mode 100644 tools/build-warnings/check-native-doc-choice.py

diff --git a/third_party/voice/prepare_sources.py b/third_party/voice/prepare_sources.py
index 3dd136fa1..863a72733 100644
--- a/third_party/voice/prepare_sources.py
+++ b/third_party/voice/prepare_sources.py
@@ -328,6 +328,29 @@ def extract_source(source: Source, archives: Path, destination: Path) -> None:
             contents = contents.replace(original, "")
         converter.write_text(contents, encoding="utf-8")
 
+    if source.name == "gst-plugins-good" and source.version == "1.28.6":
+        # WORKAROUND: disabled documentation does not require a cache generator.
+        # https://github.com/holdmyspot-com/codex-unleashed/issues/61
+        # Remove when GStreamer distinguishes this choice from failed discovery.
+        documentation = destination / source.root / "docs/meson.build"
+        contents = documentation.read_text(encoding="utf-8")
+        original = (
+            "else\n"
+            "    warning('GStreamer plugin inspector for documentation not found, "
+            "can\\'t update the cache')\n"
+            "endif"
+        )
+        replacement = (
+            "elif get_option('doc').disabled()\n"
+            "    message('Documentation disabled; not updating plugin cache')\n"
+            + original
+        )
+        if contents.count(original) != 1:
+            raise ValueError("Pinned GStreamer documentation diagnostic does not match")
+        documentation.write_text(
+            contents.replace(original, replacement), encoding="utf-8"
+        )
+
     if source.name == "gstreamer" and source.version == "1.28.6":
         # WORKAROUND: these pad quarks are interned but their storage is unused.
         # https://github.com/holdmyspot-com/codex-unleashed/issues/61
diff --git a/tools/build-warnings/check-native-doc-choice.py b/tools/build-warnings/check-native-doc-choice.py
new file mode 100644
index 000000000..13f113c7c
--- /dev/null
+++ b/tools/build-warnings/check-native-doc-choice.py
@@ -0,0 +1,114 @@
+#!/usr/bin/env python3
+"""Exercise the pinned GStreamer documentation diagnostic with the native Meson recipe."""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import sys
+import tempfile
+from types import SimpleNamespace
+
+CHECKOUT = Path(__file__).resolve().parents[2]
+sys.dont_write_bytecode = True
+sys.path.insert(0, str(CHECKOUT / "third_party/voice"))
+from build_native import NativeBuild
+from prepare_sources import extract_source, load_sources
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("configuration", type=Path)
+    parser.add_argument("execroot", type=Path)
+    parser.add_argument("meson_source", type=Path)
+    parser.add_argument("ninja", type=Path)
+    arguments = parser.parse_args()
+    root = arguments.execroot.absolute()
+    configuration = json.loads(
+        arguments.configuration.read_text().replace("@VOICE_EXECROOT@", str(root))
+    )
+    archives = configuration.pop("archives")
+    for name in ("prefix", "receipt"):
+        configuration.pop(name)
+    linker = root / configuration.pop("ld")
+    for name in ("cc", "cxx", "ar", "ranlib", "cmake", "make", "pkg_config", "shell"):
+        configuration[name] = root / configuration[name]
+    manifest = (CHECKOUT / "third_party/voice/sources.json").read_bytes()
+    source = next(
+        item for item in load_sources(manifest) if item.name == "gst-plugins-good"
+    )
+    archive = next(
+        root / item for item in archives if Path(item).name == source.archive
+    )
+    with tempfile.TemporaryDirectory(prefix="native-doc-choice-") as temporary:
+        scratch = Path(temporary)
+        extracted = scratch / "sources"
+        extracted.mkdir()
+        extract_source(source, archive.parent, extracted)
+        contents = (extracted / source.root / "docs/meson.build").read_text()
+        start = "if gst_dep.type_name() == 'internal'\n"
+        end = "\nif get_option('doc').disabled()\n"
+        if contents.count(start) != 1 or contents.count(end) != 1:
+            raise ValueError("Pinned documentation cache block does not match")
+        fragment = start + contents.split(start, 1)[1].split(end, 1)[0]
+        project = scratch / "project"
+        project.mkdir()
+        (project / "meson.build").write_text(
+            "project('doc-choice', 'c', meson_version: '>=1.1')\n"
+            "api_version = '1.0'\ngst_dep = dependency('gstreamer-1.0', method: 'pkg-config')\n"
+            "plugins = ['unbuilt-test-plugin']\n" + fragment
+        )
+        (project / "meson.options").write_text("option('doc', type: 'feature')\n")
+        pkgconfig = scratch / "pkgconfig"
+        pkgconfig.mkdir()
+        (pkgconfig / "gstreamer-1.0.pc").write_text(
+            f"prefix={scratch / 'unavailable-doc-tools'}\n"
+            "libexecdir=${prefix}/libexec\n"
+            "Name: GStreamer documentation probe\n"
+            "Description: Metadata for the documentation dependency check\n"
+            "Version: 1.28.6\n"
+        )
+        for mode in ("disabled", "auto"):
+            builder = NativeBuild(
+                SimpleNamespace(
+                    **configuration,
+                    archives=scratch,
+                    output=scratch / mode,
+                    bootstrap_make=None,
+                ),
+                os.environ,
+            )
+            builder.output.mkdir()
+            (builder.tools / "bin").mkdir(parents=True)
+            (builder.tools / "bin/ninja").symlink_to(arguments.ninja.absolute())
+            builder.sources = {
+                "meson": arguments.meson_source.absolute(),
+                "probe": project,
+            }
+            builder.environment["LD"] = str(linker)
+            builder.environment["PKG_CONFIG_LIBDIR"] = str(pkgconfig)
+            try:
+                try:
+                    builder.meson("probe", [f"-Ddoc={mode}", "-Dauto_features=auto"])
+                except RuntimeError as error:
+                    if (
+                        mode != "auto"
+                        or "plugin inspector for documentation not found"
+                        not in str(error)
+                    ):
+                        raise
+                else:
+                    if mode == "auto":
+                        raise AssertionError(
+                            "Automatic missing-documentation-tool warning is not fatal"
+                        )
+            finally:
+                for log in sorted(builder.output.glob("*.log")):
+                    print(log.read_text(errors="replace"))
+    print(
+        "Disabled documentation succeeds; automatic missing-tool warning remains fatal"
+    )
+
+
+if __name__ == "__main__":
+    main()
