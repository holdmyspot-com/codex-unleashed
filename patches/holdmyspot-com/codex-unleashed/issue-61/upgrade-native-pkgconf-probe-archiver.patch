From 02fb9f33e551a97957601342f79242d33ac68e61 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Wed, 14 Oct 2026 18:07:03 +0000
Subject: [PATCH] Declare the Meson resource probe's LLVM archiver

Supply llvm-ar as a build input and an absolute AR path so the Meson
regression probe can create its static library without a host archiver.
The existing probe compiles C and C++, archives probe.c, links the program,
and executes it through the resource_directory_probe target.

Refs https://github.com/holdmyspot-com/codex-unleashed/issues/61
Base: rust-v0.162.1 (092d3acd6bec3e3a14bdc7e7a2810ab628ab759d)
Prerequisite: upgrade-native-pkgconf-bootstrap.patch and its LLVM prerequisites.

Red: hosted Linux GNU and musl test jobs fail at Meson project setup with
Unknown linker(s): llvm-ar-23, llvm-ar, ar, gar. The runner has no host AR.
Green: sandboxed Bazel resource_directory_probe passes locally, and its
build script and Meson log identify the declared LLVM 23.1.2 llvm-ar.
Fresh emitted verification is recorded in meson-archiver-verification.json.
---
 tools/build-warnings/meson/BUILD.bazel | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/tools/build-warnings/meson/BUILD.bazel b/tools/build-warnings/meson/BUILD.bazel
index 7b14ac1ab..ca883e722 100644
--- a/tools/build-warnings/meson/BUILD.bazel
+++ b/tools/build-warnings/meson/BUILD.bazel
@@ -21,8 +21,10 @@ foreign_cc_rule_variant(
         "@llvm//runtimes/libcxx:libcxx.static",
         "@llvm//runtimes/libcxx:libcxxabi.static",
         "@llvm//runtimes/libunwind:libunwind.static",
+        "@llvm//tools:llvm-ar",
     ],
     env = {
+        "AR": "$$EXT_BUILD_ROOT$$/$(execpath @llvm//tools:llvm-ar)",
         "LDFLAGS": "$$EXT_BUILD_ROOT$$/$(execpath @llvm//runtimes/libcxx:libcxx.static) $$EXT_BUILD_ROOT$$/$(execpath @llvm//runtimes/libcxx:libcxxabi.static) $$EXT_BUILD_ROOT$$/$(execpath @llvm//runtimes/libunwind:libunwind.static)",
     },
     lib_source = ":sources",
