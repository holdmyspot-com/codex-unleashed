From a79a23faf42c984bac693f661945726a62c86bae Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Fri, 16 Oct 2026 19:01:35 +0000
Subject: [PATCH] Retain MSVC host tools in Windows GNU analysis transitions

Clearing extra_toolchains in GNU analysis transitions lets the Windows LLVM helper resolve its own case-insensitive VFS generator through a toolchain cycle. Retain the analysis-only MSVC toolchain for host tools and constrain its target ABI so it cannot replace the GNU target compiler.

Native red: job 117096549128 reports cycles in XZ GNU and OpenSSL perlasm analysis. Maintained run-bazel-ci.sh test passes xz:msvc_flags_test, xz:gnu_flags_test and openssl:windows_perlasm_test locally. Native host verification remains pending in the CI repair execution record.
---
 tools/build-warnings/assembly/native/BUILD.bazel | 1 +
 tools/build-warnings/openssl/inputs_test.bzl     | 2 +-
 tools/build-warnings/xz/driver_flags_test.bzl    | 2 +-
 3 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/tools/build-warnings/assembly/native/BUILD.bazel b/tools/build-warnings/assembly/native/BUILD.bazel
index e05c01e03..3726e00fb 100644
--- a/tools/build-warnings/assembly/native/BUILD.bazel
+++ b/tools/build-warnings/assembly/native/BUILD.bazel
@@ -52,6 +52,7 @@ toolchain(
     target_compatible_with = [
         "@platforms//os:windows",
         "@platforms//cpu:x86_64",
+        "@llvm//constraints/windows/abi:msvc",
     ],
     toolchain = ":cc_toolchain",
     toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
diff --git a/tools/build-warnings/openssl/inputs_test.bzl b/tools/build-warnings/openssl/inputs_test.bzl
index a31d1d83d..7fa9a714e 100644
--- a/tools/build-warnings/openssl/inputs_test.bzl
+++ b/tools/build-warnings/openssl/inputs_test.bzl
@@ -31,6 +31,6 @@ openssl_windows_perlasm_test = analysistest.make(
     _openssl_windows_perlasm_test_impl,
     config_settings = {
         "//command_line_option:platforms": str(Label("//:windows_x86_64_gnullvm")),
-        "//command_line_option:extra_toolchains": [],
+        "//command_line_option:extra_toolchains": [str(Label("//tools/build-warnings/assembly/native:analysis_toolchain"))],
     },
 )
diff --git a/tools/build-warnings/xz/driver_flags_test.bzl b/tools/build-warnings/xz/driver_flags_test.bzl
index fa19af1a0..cf50e0d44 100644
--- a/tools/build-warnings/xz/driver_flags_test.bzl
+++ b/tools/build-warnings/xz/driver_flags_test.bzl
@@ -36,7 +36,7 @@ xz_gnu_flags_test = analysistest.make(
     _xz_gnu_flags_test_impl,
     config_settings = {
         "//command_line_option:platforms": str(Label("//:windows_x86_64_gnullvm")),
-        "//command_line_option:extra_toolchains": [],
+        "//command_line_option:extra_toolchains": [str(Label("//tools/build-warnings/assembly/native:analysis_toolchain"))],
         "//command_line_option:features": ["-static_link_msvcrt", "treat_warnings_as_errors"],
     },
 )
