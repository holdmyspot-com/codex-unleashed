++ #endif
++
+++/* WORKAROUND: https://github.com/holdmyspot-com/codex-unleashed/issues/61
+++ * MinGW LLVM 23 ABI aliases: upstream b43f781b916e8170b66bc4c6784123e53b283f8a.
+++ * Remove this backport when the pinned MinGW release includes the fix. */
+++#if (defined(__GNUC__) && __GNUC__ >= 8) || \
+++    (defined(__clang_major__) && __clang_major__ >= 23)
+++#define PRAGMA_DIAGNOSTIC_IGNORED_ATTRIBUTE_ALIAS_BEGIN     \
+++    _Pragma("GCC diagnostic push")                          \
+++    _Pragma("GCC diagnostic ignored \"-Wattribute-alias\"")
+++#define PRAGMA_DIAGNOSTIC_IGNORED_ATTRIBUTE_ALIAS_END       \
+++    _Pragma ("GCC diagnostic pop")
+++#else
+++#define PRAGMA_DIAGNOSTIC_IGNORED_ATTRIBUTE_ALIAS_BEGIN
+++#define PRAGMA_DIAGNOSTIC_IGNORED_ATTRIBUTE_ALIAS_END
+++#endif
+++
++ #ifdef __cplusplus
++ }
