--- /dev/null
+++ b/tools/build-warnings/mingw/attribute_alias_warning.c
@@ -0,0 +1,5 @@
+struct original { int value; };
+struct different { int value; };
+int expected_attribute_alias_warning(struct original *value) { return value->value; }
+int incompatible_alias(struct different *value)
+    __attribute__((alias("expected_attribute_alias_warning")));
diff --git a/tools/build-warnings/mingw/check.sh b/tools/build-warnings/mingw/check.sh
new file mode 100755
index 0000000..4b3bb36
--- /dev/null
+++ b/tools/build-warnings/mingw/check.sh
@@ -0,0 +1,20 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+probe_dir="$(mktemp -d "${TMPDIR:?TMPDIR must identify owned temporary storage}/codex-mingw-alias-XXXXXX")"
+trap 'rm -rf -- "${probe_dir}"' EXIT
+
+if ! bazel build @llvm//runtimes/mingw:mingwex @llvm//runtimes/mingw:msvcrt_extra --output_groups=compilation_outputs "$@" > "${probe_dir}/runtime.log" 2>&1; then
+    cat "${probe_dir}/runtime.log" >&2
+    exit 1
+fi
+cat "${probe_dir}/runtime.log"
+
+if bazel build //tools/build-warnings/mingw:attribute_alias_warning "$@" --platforms=//:local_linux > "${probe_dir}/negative.log" 2>&1; then
+    cat "${probe_dir}/negative.log" >&2
+    echo 'Expected the unrelated alias mismatch to fail compilation.' >&2
+    exit 1
+fi
+grep -F 'expected_attribute_alias_warning' "${probe_dir}/negative.log" > /dev/null
+grep -F '[-Werror,-Wattribute-alias]' "${probe_dir}/negative.log" > /dev/null
+echo 'MinGW runtime compiles; unrelated alias warnings remain fatal.'
