From 9c62f7dc0604594021670484430e02e6fab66f53 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Thu, 15 Oct 2026 21:21:03 -0400
Subject: [PATCH] Preserve libffi configure context in Bazel failures

Exercise failed command status with warning output. Successful warning-only commands retain their status and are covered by the visibility regression.
---
 third_party/voice/bazel_native.py      | 10 +++-
 third_party/voice/test_build_native.py | 75 ++++++++++++++++++++++++++
 2 files changed, 84 insertions(+), 1 deletion(-)

diff --git a/third_party/voice/bazel_native.py b/third_party/voice/bazel_native.py
index 584ff7037..602694852 100644
--- a/third_party/voice/bazel_native.py
+++ b/third_party/voice/bazel_native.py
@@ -57,9 +57,17 @@ def main():
         except Exception:
             # Preserve the failing upstream diagnostic in the Bazel action log.
             if builder.record["steps"]:
-                log = builder.output / (builder.record["steps"][-1]["name"] + ".log")
+                step_name = builder.record["steps"][-1]["name"]
+                log = builder.output / (step_name + ".log")
                 if log.is_file():
                     print(log.read_text(errors="replace"), file=sys.stderr)
+                if step_name.startswith("libffi-"):
+                    configure_log = builder.output / "build/libffi/config.log"
+                    if configure_log.is_file():
+                        print("libffi config.log:", file=sys.stderr)
+                        print(
+                            configure_log.read_text(errors="replace"), file=sys.stderr
+                        )
             raise
         with tarfile.open(prefix, "w") as archive:
             archive.add(builder.prefix, arcname=".")
diff --git a/third_party/voice/test_build_native.py b/third_party/voice/test_build_native.py
index f52fd13f6..b133aee9a 100644
--- a/third_party/voice/test_build_native.py
+++ b/third_party/voice/test_build_native.py
@@ -1,5 +1,7 @@
 """Check native build preconditions and subprocess failure propagation."""

+from contextlib import redirect_stderr
+import io
 import json
 import os
 from pathlib import Path
@@ -13,6 +15,7 @@ from types import SimpleNamespace
 import unittest
 from unittest.mock import patch

+import bazel_native
 from build_native import NativeBuild, validate_target


@@ -605,6 +608,78 @@ class NativeBuildTests(unittest.TestCase):
         )
         self.assertFalse((build.output / "built.json").exists())

+    def test_bazel_failure_preserves_libffi_configure_context_and_original_error(self):
+        for index, (name, status, detail) in enumerate(
+            (
+                ("libffi-configure", 23, "configure failed"),
+                ("libffi-build", 23, "warning: no debug symbols"),
+                ("libffi-install", 23, "install failed"),
+                ("other-build", 23, "other failed"),
+                ("libffi-configure", 23, None),
+            )
+        ):
+            with self.subTest(name=name, status=status, detail=detail):
+                self.args.output = self.root / f"failure-context-{index}"
+                build = NativeBuild(self.args, self.environment)
+                config = self.root / "bazel-config.json"
+                config.write_text(
+                    json.dumps(
+                        {
+                            "archives": [],
+                            "prefix": str(self.root / "prefix.tar"),
+                            "receipt": str(self.root / "built.json"),
+                            "ld": sys.executable,
+                            **{
+                                tool: str(path)
+                                for tool, path in build.toolchain.items()
+                            },
+                            **{
+                                tool: sys.executable
+                                for tool in ("ar", "ranlib", "nm", "readelf")
+                            },
+                        }
+                    )
+                )
+
+                def fail():
+                    build.output.mkdir()
+                    directory = build.output / "build/libffi"
+                    directory.mkdir(parents=True)
+                    if detail is not None:
+                        (directory / "config.log").write_text(
+                            "force_load probe: native linker detail\n"
+                        )
+                    build.run(
+                        name,
+                        [
+                            sys.executable,
+                            "-c",
+                            "import sys; print(sys.argv[1]); raise SystemExit(int(sys.argv[2]))",
+                            detail or "configure failed before log creation",
+                            str(status),
+                        ],
+                    )
+
+                stderr = io.StringIO()
+                exception = subprocess.CalledProcessError if status else RuntimeError
+                with (
+                    patch("bazel_native.sys.argv", ["bazel_native.py", str(config)]),
+                    patch("bazel_native.NativeBuild", return_value=build),
+                    patch.object(build, "build", side_effect=fail),
+                    redirect_stderr(stderr),
+                    self.assertRaises(exception) as error,
+                ):
+                    bazel_native.main()
+                if status:
+                    self.assertEqual(error.exception.returncode, status)
+                self.assertIn(detail or "configure failed", stderr.getvalue())
+                self.assertEqual(
+                    "force_load probe: native linker detail" in stderr.getvalue(),
+                    name.startswith("libffi-") and detail is not None,
+                )
+                self.assertFalse((self.root / "prefix.tar").exists())
+                self.assertFalse((self.root / "built.json").exists())
+
     def test_ambient_native_discovery_variables_are_not_inherited(self):
         inherited = {
             **self.environment,
