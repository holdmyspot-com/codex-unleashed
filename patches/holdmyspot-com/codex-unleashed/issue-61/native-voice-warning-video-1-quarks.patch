From f8cd28b4607298d2f1a08ad0ffc5cd6e4116cc5e Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Wed, 14 Oct 2026 13:13:33 +0000
Subject: [PATCH] Remove unused GStreamer audio and video metadata quark caches

Track native warning enforcement in #61. Apply after the documented native
voice prerequisites; keep all compiler and linker checks enabled.

Reproduction evidence: native-udmabuf-guard-green.log and native-video-compatibility-final-green.log. The actual native recipe reports the
missing outcome under LLVM 23. Runtime and fresh emitted-queue acceptance
are recorded separately; an internal authoring commit is not full CI acceptance.
---
 third_party/voice/prepare_sources.py          | 26 +++++++++++++++++++
 tools/build-warnings/gstreamer/BUILD.bazel    |  1 +
 .../gstreamer/video_quarks_test.c             | 26 +++++++++++++++++++
 3 files changed, 53 insertions(+)
 create mode 100644 tools/build-warnings/gstreamer/video_quarks_test.c

diff --git a/third_party/voice/prepare_sources.py b/third_party/voice/prepare_sources.py
index 44d810775..45bf642e7 100644
--- a/third_party/voice/prepare_sources.py
+++ b/third_party/voice/prepare_sources.py
@@ -243,6 +243,32 @@ def extract_source(source: Source, archives: Path, destination: Path) -> None:
             contents = contents.replace(original, replacement)
         allocator.write_text(contents, encoding="utf-8")
 
+        # WORKAROUND: these media metadata quark caches have no remaining users.
+        # https://github.com/holdmyspot-com/codex-unleashed/issues/61
+        # Remove when GStreamer removes the unused caches upstream.
+        for media in ("audio", "video"):
+            tag = media.upper()
+            for role in ("decoder", "encoder"):
+                name = f"gst{media}{role}.c"
+                implementation = (
+                    destination / source.root / "gst-libs/gst" / media / name
+                )
+                contents = implementation.read_text(encoding="utf-8")
+                for original, replacement in (
+                    (f"#define META_TAG_{tag} meta_tag_{media}_quark\n", ""),
+                    (f"static GQuark meta_tag_{media}_quark;\n", ""),
+                    (
+                        f"meta_tag_{media}_quark = g_quark_from_static_string (GST_META_TAG_{tag}_STR);",
+                        f"(void) g_quark_from_static_string (GST_META_TAG_{tag}_STR);",
+                    ),
+                ):
+                    if contents.count(original) != 1:
+                        raise ValueError(
+                            f"Pinned GStreamer metadata quark does not match: {name}"
+                        )
+                    contents = contents.replace(original, replacement)
+                implementation.write_text(contents, encoding="utf-8")
+
     if source.name == "gstreamer" and source.version == "1.28.6":
         # WORKAROUND: these pad quarks are interned but their storage is unused.
         # https://github.com/holdmyspot-com/codex-unleashed/issues/61
diff --git a/tools/build-warnings/gstreamer/BUILD.bazel b/tools/build-warnings/gstreamer/BUILD.bazel
index a492b8264..5ffc394e3 100644
--- a/tools/build-warnings/gstreamer/BUILD.bazel
+++ b/tools/build-warnings/gstreamer/BUILD.bazel
@@ -14,6 +14,7 @@ NATIVE_INCLUDES = [
 TEST_NAMES = [
     "allocator_type_test",
     "pad_quarks_test",
+    "video_quarks_test",
 ]
 
 [
diff --git a/tools/build-warnings/gstreamer/video_quarks_test.c b/tools/build-warnings/gstreamer/video_quarks_test.c
new file mode 100644
index 000000000..b79a4cba2
--- /dev/null
+++ b/tools/build-warnings/gstreamer/video_quarks_test.c
@@ -0,0 +1,26 @@
+#include <gst/audio/gstaudiodecoder.h>
+#include <gst/audio/gstaudioencoder.h>
+#include <gst/video/gstvideodecoder.h>
+#include <gst/video/gstvideoencoder.h>
+
+int main(void) {
+  gst_init(NULL, NULL);
+  gpointer decoder = g_type_class_ref(GST_TYPE_VIDEO_DECODER);
+  gpointer encoder = g_type_class_ref(GST_TYPE_VIDEO_ENCODER);
+  gpointer audio_decoder = g_type_class_ref(GST_TYPE_AUDIO_DECODER);
+  gpointer audio_encoder = g_type_class_ref(GST_TYPE_AUDIO_ENCODER);
+  int status = decoder == NULL || encoder == NULL ||
+               audio_decoder == NULL || audio_encoder == NULL ||
+               g_quark_try_string(GST_META_TAG_VIDEO_STR) == 0 ||
+               g_quark_try_string(GST_META_TAG_AUDIO_STR) == 0;
+  if (audio_encoder != NULL)
+    g_type_class_unref(audio_encoder);
+  if (audio_decoder != NULL)
+    g_type_class_unref(audio_decoder);
+  if (encoder != NULL)
+    g_type_class_unref(encoder);
+  if (decoder != NULL)
+    g_type_class_unref(decoder);
+  gst_deinit();
+  return status;
+}
