diff --git a/patches/rules_foreign_cc_meson_resource_directory.patch b/patches/rules_foreign_cc_meson_resource_directory.patch
new file mode 100644
index 000000000..89e81b39e
--- /dev/null
+++ b/patches/rules_foreign_cc_meson_resource_directory.patch
@@ -0,0 +1,31 @@
+diff --git a/foreign_cc/meson.bzl b/foreign_cc/meson.bzl
+index ed7ba72..59b2de0 100644
+--- a/foreign_cc/meson.bzl
++++ b/foreign_cc/meson.bzl
+@@ -82,8 +82,8 @@ def _create_meson_script(configureParameters):
+     if " " not in tools.cxx:
+         script.append("##export_var## CXX {}".format(_absolutize(ctx.workspace_name, tools.cxx)))
+
+-    copts = flags.cc
+-    cxxopts = flags.cxx
++    copts = _with_link_resource_directory(flags.cc, flags.cxx_linker_executable)
++    cxxopts = _with_link_resource_directory(flags.cxx, flags.cxx_linker_executable)
+     if copts:
+         script.append("##export_var## CFLAGS \"{} ${{CFLAGS:-}}\"".format(_join_flags_list(ctx.workspace_name, copts).replace("\"", "'")))
+     if cxxopts:
+@@ -300,3 +300,15 @@ def _absolutize(workspace_name, text, force = False):
+
+ def _join_flags_list(workspace_name, flags):
+     return " ".join([_absolutize(workspace_name, flag) for flag in flags])
++
++
++def _with_link_resource_directory(compile_flags, link_flags):
++    # Meson also passes compilation flags to the linker. LLVM supplies merged
++    # headers and runtime libraries in its link resource directory. Keep that
++    # directory when compilation flags follow link flags in the command.
++    prefix = "-resource-dir="
++    link_directories = [flag for flag in link_flags if flag.startswith(prefix)]
++    if not link_directories:
++        return compile_flags
++
++    return [link_directories[-1] if flag.startswith(prefix) else flag for flag in compile_flags]
diff --git a/third_party/voice/BUILD.bazel b/third_party/voice/BUILD.bazel
index 94adba1b5..5c6e4e349 100644
--- a/third_party/voice/BUILD.bazel
+++ b/third_party/voice/BUILD.bazel
@@ -72,45 +72,55 @@ alias(
     }),
 )

-# Keep the pinned pkg-config sources, but explicitly use LLVM archive tools.
-# The upstream bootstrap otherwise selects host ar/ranlib on macOS.
+native_tool_toolchain(
+    name = "pkg_config_bootstrap_tool",
+    path = "codex-pkg-config-bootstrap-disabled",
+)
+
+toolchain(
+    name = "pkg_config_bootstrap_toolchain",
+    toolchain = ":pkg_config_bootstrap_tool",
+    toolchain_type = "@rules_foreign_cc//toolchains:pkgconfig_toolchain",
+    visibility = ["//tools/build-warnings/meson:__pkg__"],
+)
+
+# Build pkgconf with the declared LLVM archive tools on every Unix host.
 pkg_config(
     name = "pkg_config_unix",
+    # WORKAROUND: rules_foreign_cc 0.15.1 overwrites target_args["compile"].
+    # https://github.com/holdmyspot-com/codex-unleashed/issues/61
+    # Use target_args when that override preserves explicitly supplied arguments.
+    build_args = ["pkgconf:executable"],
     build_data = [
         ":pkg_config_linker",
         "@llvm//tools:llvm-ar",
         "@llvm//tools:llvm-ranlib",
     ],
-    # foreign_cc normalizes copied source timestamps, preserving the release
-    # configure files when remote execution materializes inputs in a new order.
-    configure_in_place = True,
-    configure_options = [
-        "--with-internal-glib",
-        "--disable-shared",
-        "--enable-define-prefix",
-    ],
-    copts = ["-Wno-int-conversion"],
     env = {
         "AR": "$(execpath @llvm//tools:llvm-ar)",
         "LD": "$(execpath :pkg_config_linker)",
-        "PKG_CONFIG": "/bin/false",
         "RANLIB": "$(execpath @llvm//tools:llvm-ranlib)",
     },
-    lib_source = "@pkgconfig_src//:all_srcs",
+    lib_source = "@pkgconf_src//:all_srcs",
+    options = {
+        "default_library": "static",
+        "with-system-includedir": "/usr/include",
+        "with-system-libdir": "/usr/lib:/lib",
+    },
     # foreign_cc rewrites *-config files as text. Keep the executable out of
     # that transformation, which otherwise corrupts its native code signature.
     out_binaries = ["pkg-config-tool"],
     out_include_dir = "",
     out_static_libs = [],
-    postfix_script = 'mv "$$INSTALLDIR/bin/pkg-config" "$$INSTALLDIR/bin/pkg-config-tool"',
+    postfix_script = 'mkdir -p "$$INSTALLDIR/bin"; cp "$$BUILD_TMPDIR/pkgconf" "$$INSTALLDIR/bin/pkg-config-tool"',
     tags = ["manual"],
     target_compatible_with = select({
         "@platforms//os:windows": ["@platforms//:incompatible"],
         "//conditions:default": [],
     }),
-    # Internal GLib needs no pkg-config. Avoid bootstrapping another copy first;
-    # the explicit failing command above forbids falling back to a host copy.
-    toolchain = "@rules_foreign_cc//toolchains:preinstalled_pkgconfig_toolchain",
+    targets = ["compile"],
+    # pkgconf has no pkg-config dependency. Avoid bootstrapping another copy.
+    toolchain = "//third_party/voice:pkg_config_bootstrap_toolchain",
     visibility = ["//visibility:public"],
 )

diff --git a/third_party/voice/pkg_config.bzl b/third_party/voice/pkg_config.bzl
index 4b87d36a3..df1911e77 100644
--- a/third_party/voice/pkg_config.bzl
+++ b/third_party/voice/pkg_config.bzl
@@ -1,12 +1,14 @@
-"""Build the pinned pkg-config with native Mac configure checks."""
+"""Build the pinned pkgconf with native Mac configuration checks."""

-load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make_variant")
+load("@rules_foreign_cc//foreign_cc:defs.bzl", "meson")
+load("@rules_foreign_cc//foreign_cc/private:transitions.bzl", "foreign_cc_rule_variant")

 def pkg_config(name, **kwargs):
     """Keep Linux remote builds and select native Mac producers by OS and CPU."""
     tags = kwargs.pop("tags", [])
-    configure_make_variant(
+    foreign_cc_rule_variant(
         name = name + "_default",
+        rule = meson,
         tags = tags,
         **kwargs
     )
@@ -15,8 +17,9 @@ def pkg_config(name, **kwargs):
             name = name + "_macos_" + arch,
             constraint_values = ["@platforms//os:macos", "@platforms//cpu:" + arch],
         )
-        configure_make_variant(
+        foreign_cc_rule_variant(
             name = name + "_native_macos_" + arch,
+            rule = meson,
             exec_compatible_with = ["@platforms//os:macos", "@platforms//cpu:" + arch],
             tags = tags + ["no-remote-exec"],
             **kwargs
diff --git a/tools/build-warnings/meson/BUILD.bazel b/tools/build-warnings/meson/BUILD.bazel
new file mode 100644
index 000000000..7b14ac1ab
--- /dev/null
+++ b/tools/build-warnings/meson/BUILD.bazel
@@ -0,0 +1,48 @@
+load("@rules_foreign_cc//foreign_cc:defs.bzl", "meson")
+load("@rules_foreign_cc//foreign_cc/private:transitions.bzl", "foreign_cc_rule_variant")
+
+filegroup(
+    name = "sources",
+    srcs = [
+        "main.cc",
+        "meson.build",
+        "probe.c",
+        "probe.h",
+    ],
+)
+
+foreign_cc_rule_variant(
+    name = "resource_probe",
+    # WORKAROUND: rules_foreign_cc 0.15.1 overwrites target_args["compile"].
+    # https://github.com/holdmyspot-com/codex-unleashed/issues/61
+    # Use target_args when the override preserves explicit compile arguments.
+    build_args = ["resource-probe:executable"],
+    build_data = [
+        "@llvm//runtimes/libcxx:libcxx.static",
+        "@llvm//runtimes/libcxx:libcxxabi.static",
+        "@llvm//runtimes/libunwind:libunwind.static",
+    ],
+    env = {
+        "LDFLAGS": "$$EXT_BUILD_ROOT$$/$(execpath @llvm//runtimes/libcxx:libcxx.static) $$EXT_BUILD_ROOT$$/$(execpath @llvm//runtimes/libcxx:libcxxabi.static) $$EXT_BUILD_ROOT$$/$(execpath @llvm//runtimes/libunwind:libunwind.static)",
+    },
+    lib_source = ":sources",
+    options = {"werror": "true"},
+    out_binaries = ["resource-probe"],
+    out_include_dir = "",
+    out_static_libs = [],
+    postfix_script = 'mkdir -p "$$INSTALLDIR/bin"; cp "$$BUILD_TMPDIR/resource-probe" "$$INSTALLDIR/bin/resource-probe"',
+    rule = meson,
+    targets = ["compile"],
+    toolchain = "//third_party/voice:pkg_config_bootstrap_toolchain",
+)
+
+genrule(
+    name = "resource_directory_probe",
+    outs = ["result.txt"],
+    cmd = '"$(location :resource_probe)" && printf "%s\\n" "C and C++ resource directories link correctly." > "$@"',
+    target_compatible_with = select({
+        "@platforms//os:windows": ["@platforms//:incompatible"],
+        "//conditions:default": [],
+    }),
+    tools = [":resource_probe"],
+)
