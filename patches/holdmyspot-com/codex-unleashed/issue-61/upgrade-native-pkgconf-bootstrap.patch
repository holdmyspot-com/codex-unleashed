diff --git a/tools/build-warnings/pkg-config/BUILD.bazel b/tools/build-warnings/pkg-config/BUILD.bazel
new file mode 100644
index 000000000..955b0dccc
--- /dev/null
+++ b/tools/build-warnings/pkg-config/BUILD.bazel
@@ -0,0 +1,24 @@
+genrule(
+    name = "metadata_probe",
+    srcs = [
+        "probe.pc",
+        "private.pc",
+    ],
+    outs = ["metadata.txt"],
+    cmd = """
+export PKG_CONFIG_LIBDIR="$$(dirname "$(location probe.pc)")"
+export PKG_CONFIG_PATH=
+tool="$(location //third_party/voice:pkg_config_unix)"
+test "$$("$$tool" --modversion probe)" = 1.2.3
+test "$$("$$tool" --variable=prefix probe)" = /codex-probe
+test "$$("$$tool" --libs probe)" = '-L/codex-probe/lib -lprobe'
+test "$$("$$tool" --libs --static probe)" = '-L/codex-probe/lib -lprobe -lprivate'
+test "$$("$$tool" --cflags probe)" = '-I/codex-probe/include -DPROBE_ENABLED=1'
+"$$tool" --version > "$@"
+""",
+    target_compatible_with = select({
+        "@platforms//os:windows": ["@platforms//:incompatible"],
+        "//conditions:default": [],
+    }),
+    tools = ["//third_party/voice:pkg_config_unix"],
+)
