@@ -0,0 +1,6 @@
+#include <openssl/opensslconf.h>
+#include <openssl/crypto.h>
+
+int main(void) {
+  return OPENSSL_init_crypto(0, NULL) == 1 ? 0 : 1;
+}
diff --git a/tools/build-warnings/openssl/rust_bindings_test.rs b/tools/build-warnings/openssl/rust_bindings_test.rs
new file mode 100644
index 000000000..63293778a
--- /dev/null
+++ b/tools/build-warnings/openssl/rust_bindings_test.rs
@@ -0,0 +1,17 @@
+#[test]
+fn bundled_openssl_supports_rust_crypto_and_tls() {
+    assert!(openssl::version::version().starts_with("OpenSSL 4."));
+
+    let digest = openssl::sha::sha256(b"abc");
+    assert_eq!(
+        digest,
+        [
+            0xba, 0x78, 0x16, 0xbf, 0x8f, 0x01, 0xcf, 0xea, 0x41, 0x41, 0x40, 0xde, 0x5d, 0xae,
+            0x22, 0x23, 0xb0, 0x03, 0x61, 0xa3, 0x96, 0x17, 0x7a, 0x9c, 0xb4, 0x10, 0xff, 0x61,
+            0xf2, 0x00, 0x15, 0xad,
+        ]
+    );
+
+    let connector = openssl::ssl::SslConnector::builder(openssl::ssl::SslMethod::tls()).unwrap();
+    connector.build().configure().unwrap();
+}
