From 1a4f8252d60f7ec431156bbd33dd627799da4f31 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Sat, 17 Oct 2026 07:43:12 +0000
Subject: [PATCH] fix(ci): retain Bazel timeout test logs

Recognize TIMEOUT summaries alongside FAIL records when locating test logs. Preserve configured fallback roots, CRLF reported retry paths, and original Bazel exit status. The new fixture fails against parent4876ace because no timeout log is printed; all four scenarios pass with this change. Maintained run-local-rust just fmt-check and bash syntax checks pass. Fresh emitted patch verification remains pending.
---
 .github/scripts/run-bazel-ci.sh                     |  7 ++++---
 .../bazel-ci-logs/check-failed-logs.sh              | 13 +++++++++++--
 2 files changed, 15 insertions(+), 5 deletions(-)

diff --git a/.github/scripts/run-bazel-ci.sh b/.github/scripts/run-bazel-ci.sh
index eb3ddb300..0a7146712 100755
--- a/.github/scripts/run-bazel-ci.sh
+++ b/.github/scripts/run-bazel-ci.sh
@@ -123,8 +123,8 @@ print_bazel_test_log_tails() {
   while IFS= read -r target; do
     failed_targets+=("$target")
   done < <(
-    grep -E '^(FAIL: //|ERROR: .* Testing //)' "$console_log" \
-      | sed -E 's#^FAIL: (//[^ ]+).*#\1#; s#^ERROR: .* Testing (//[^ ]+).* failed:.*#\1#' \
+    grep -E '^((FAIL|TIMEOUT): //|ERROR: .* Testing //)' "$console_log" \
+      | sed -E 's#^(FAIL|TIMEOUT): (//[^ ]+).*#\2#; s#^ERROR: .* Testing (//[^ ]+).* failed:.*#\1#' \
       | sort -u
   )
 
@@ -141,7 +141,8 @@ print_bazel_test_log_tails() {
     while IFS= read -r test_log; do
       test_logs+=("${test_log//\\//}")
     done < <(
-      grep -F "FAIL: ${target} " "$console_log" \
+      grep -E '^(FAIL|TIMEOUT): ' "$console_log" \
+        | grep -F "${target} " \
         | sed -nE 's#.* \(see (.*[\\/](test|attempt_[0-9]+)\.log)\).*#\1#p' \
         | sort -u
     )
diff --git a/tools/build-warnings/bazel-ci-logs/check-failed-logs.sh b/tools/build-warnings/bazel-ci-logs/check-failed-logs.sh
index 8a3d88b1d..06117c7ed 100644
--- a/tools/build-warnings/bazel-ci-logs/check-failed-logs.sh
+++ b/tools/build-warnings/bazel-ci-logs/check-failed-logs.sh
@@ -38,6 +38,15 @@ case " $* " in
     exit 0
     ;;
 esac
+if [[ "$FAILURE_MODE" == timeout-reported ]]; then
+  printf 'TIMEOUT: //fixture:test (shard 1 of 2) (see %s/attempt_1.log)\r\n' "$FIXTURE_ROOT"
+  printf 'TIMEOUT: //fixture:test (shard 1 of 2) (see %s/attempt_2.log)\r\n' "$FIXTURE_ROOT"
+  exit 3
+fi
+if [[ "$FAILURE_MODE" == timeout ]]; then
+  printf 'TIMEOUT: //fixture:test (Summary)\n'
+  exit 3
+fi
 if [[ "$FAILURE_MODE" == reported ]]; then
   printf 'FAIL: //fixture:test (shard 1 of 2) (Exit 1) (see %s/attempt_1.log)\r\n' "$FIXTURE_ROOT"
   printf 'FAIL: //fixture:test (shard 1 of 2) (Exit 1) (see %s/attempt_2.log)\r\n' "$FIXTURE_ROOT"
@@ -48,7 +57,7 @@ MOCK
 chmod +x "$FIXTURE_ROOT/run-bazel-with-buildbuddy.sh"
 ln -s run-bazel-with-buildbuddy.sh "$FIXTURE_ROOT/run_bazel_with_buildbuddy.py"
 
-for mode in reported fallback; do
+for mode in reported fallback timeout timeout-reported; do
   if RUNNER_OS=Linux BUILDBUDDY_API_KEY=fixture FAILURE_MODE="$mode" \
     BAZEL_OUTPUT_USER_ROOT='' BAZEL_REPO_CONTENTS_CACHE='' BAZEL_REPOSITORY_CACHE='' \
     CODEX_BAZEL_EXECUTION_LOG_COMPACT_DIR='' bash "$FIXTURE_ROOT/run-bazel-ci.sh" \
@@ -63,7 +72,7 @@ for mode in reported fallback; do
     echo "Expected Bazel failure status 3; got $status" >&2
     exit 1
   fi
-  if [[ "$mode" == reported ]]; then
+  if [[ "$mode" == reported || "$mode" == timeout-reported ]]; then
     grep -Fq FIRST_FAILURE_SENTINEL "$task_work/output"
     grep -Fq SECOND_FAILURE_SENTINEL "$task_work/output"
   else
-- 
