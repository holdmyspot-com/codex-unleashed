From f14b079854ede659118961196bf5caffab2976b4 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Thu, 15 Oct 2026 17:10:02 -0400
Subject: [PATCH] Give sharded exec integration tests a moderate deadline

The native macOS exec integration shard completes in 60.34 seconds, exceeding the short 60-second limit. Use the moderate deadline for exec integration targets while preserving unit-test defaults.

Regression: the new integration_deadline_test fails on the previous queue with expected moderate, got short (Bazel exit 3); all 12 timeout analysis tests pass after the change. Maintained just fmt-check and just bazel-lock-check pass. Native diagnostic run 38804102502 verifies all eight exec shards finish under the moderate allowance.
---
 codex-rs/exec/BUILD.bazel                      | 10 ++++++++++
 tools/build-warnings/test-timeouts/BUILD.bazel |  1 +
 2 files changed, 11 insertions(+)

diff --git a/codex-rs/exec/BUILD.bazel b/codex-rs/exec/BUILD.bazel
index 6aec3e0b7..da10abcbc 100644
--- a/codex-rs/exec/BUILD.bazel
+++ b/codex-rs/exec/BUILD.bazel
@@ -1,10 +1,20 @@
 load("//:defs.bzl", "codex_rust_crate")
+load("//tools/build-warnings/test-timeouts:timeouts_test.bzl", "timeout_test")
 
 codex_rust_crate(
     name = "exec",
     crate_name = "codex_exec",
+    integration_test_timeout = "moderate",
     test_shard_counts = {
         "exec-all-test": 8,
     },
     test_tags = ["no-sandbox"],
 )
+
+timeout_test(
+    name = "integration_deadline_test",
+    size = "small",
+    expected_timeout = "moderate",
+    target_under_test = ":exec-all-test",
+    visibility = ["//tools/build-warnings/test-timeouts:__pkg__"],
+)
diff --git a/tools/build-warnings/test-timeouts/BUILD.bazel b/tools/build-warnings/test-timeouts/BUILD.bazel
index c23867589..3b3dcb0c4 100644
--- a/tools/build-warnings/test-timeouts/BUILD.bazel
+++ b/tools/build-warnings/test-timeouts/BUILD.bazel
@@ -7,6 +7,7 @@ test_suite(
         "//codex-rs/app-server:integration_override_test",
         "//codex-rs/app-server:wine_override_test",
         "//codex-rs/app-server-transport:retry_unit_timeout_test",
+        "//codex-rs/exec:integration_deadline_test",
         "//codex-rs/exec-server:current_compat_timeout_test",
         "//codex-rs/exec-server:minimum_compat_timeout_test",
         "//codex-rs/exec-server:serialized_unit_timeout_test",
-- 
