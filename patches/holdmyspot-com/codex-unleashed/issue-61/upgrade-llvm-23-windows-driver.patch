diff --git a/tools/build-warnings/llvm-driver/BUILD.bazel b/tools/build-warnings/llvm-driver/BUILD.bazel
new file mode 100644
index 000000000..260dd6659
--- /dev/null
+++ b/tools/build-warnings/llvm-driver/BUILD.bazel
@@ -0,0 +1,67 @@
+load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
+load("@bazel_skylib//rules:write_file.bzl", "write_file")
+
+genrule(
+    name = "windows_nolibc_link",
+    srcs = ["entry.c"],
+    outs = ["windows-driver.txt"],
+    cmd = """
+        "$(location @llvm//tools:clang)" --target=x86_64-w64-windows-gnu -Wall -Werror -c "$(location entry.c)" -o "$(@D)/entry.obj"
+        "$(location @llvm//tools:clang)" --target=x86_64-w64-windows-gnu --ld-path="$(location @llvm//tools:ld.lld)" -nostdlib -nolibc -Werror -Wl,--fatal-warnings -Wl,-e,entry "$(@D)/entry.obj" -o "$(@D)/entry.exe"
+        printf '%s\n' 'windows-driver-ok' > "$@"
+    """,
+    target_compatible_with = ["@platforms//os:linux"],
+    tools = [
+        "@llvm//tools:clang",
+        "@llvm//tools:ld.lld",
+    ],
+)
+
+write_file(
+    name = "expected",
+    out = "expected.txt",
+    content = [
+        "windows-driver-ok",
+        "",
+    ],
+)
+
+diff_test(
+    name = "windows_nolibc_driver_test",
+    size = "small",
+    file1 = ":windows-driver.txt",
+    file2 = ":expected.txt",
+    target_compatible_with = ["@platforms//os:linux"],
+)
+
+genrule(
+    name = "msvc_link_warning_policy",
+    srcs = ["entry.c"],
+    outs = ["msvc-link-policy.txt"],
+    cmd = """
+        "$(location @llvm//tools:clang)" --target=x86_64-pc-windows-msvc -Wall -Werror -c "$(location entry.c)" -o "$(@D)/msvc-entry.obj"
+        export LIB=__hermetic_llvm_empty_lib__
+        "$(location @llvm//tools:clang-cl)" -fuse-ld=lld /WX "$(@D)/msvc-entry.obj" /link /subsystem:console /entry:entry /nodefaultlib /align:16 /out:"$(@D)/msvc-warning.exe" > "$(@D)/warning.log" 2>&1 || { cat "$(@D)/warning.log" >&2; exit 1; }
+        grep -F 'warning: /align specified without /driver' "$(@D)/warning.log" > /dev/null
+        if "$(location @llvm//tools:clang-cl)" -fuse-ld=lld /WX /clang:-Wl,/WX "$(@D)/msvc-entry.obj" /link /subsystem:console /entry:entry /nodefaultlib /align:16 /out:"$(@D)/msvc-fatal.exe" > "$(@D)/fatal.log" 2>&1; then
+            cat "$(@D)/fatal.log" >&2
+            exit 1
+        fi
+        grep -F 'error: /align specified without /driver' "$(@D)/fatal.log" > /dev/null
+        printf '%s\n' 'windows-driver-ok' > "$@"
+    """,
+    target_compatible_with = ["@platforms//os:linux"],
+    tools = [
+        "@llvm//tools:clang",
+        "@llvm//tools:clang-cl",
+        "@llvm//tools:lld-link",
+    ],
+)
+
+diff_test(
+    name = "msvc_link_warning_policy_test",
+    size = "small",
+    file1 = ":msvc-link-policy.txt",
+    file2 = ":expected.txt",
+    target_compatible_with = ["@platforms//os:linux"],
+)
