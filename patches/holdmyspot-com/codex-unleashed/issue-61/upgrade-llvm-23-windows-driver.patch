 MODULE.bazel.lock                             | 36 ++++++----
 patches/llvm_resource_directory_headers.patch | 21 ++++++
 patches/llvm_rusty_v8_custom_libcxx.patch     | 65 +++++++-----------
 patches/llvm_warnings_as_errors.patch         | 42 +++++++++---
 patches/llvm_windows_arm64_powl.patch         | 25 ++++---
 ...rules_foreign_cc_make_warning_phases.patch | 34 ++++++++--
 tools/build-warnings/llvm-driver/BUILD.bazel  | 67 +++++++++++++++++++
 tools/build-warnings/llvm-driver/entry.c      |  1 +
 9 files changed, 217 insertions(+), 85 deletions(-)
 create mode 100644 patches/llvm_resource_directory_headers.patch
 create mode 100644 tools/build-warnings/llvm-driver/BUILD.bazel
 create mode 100644 tools/build-warnings/llvm-driver/entry.c

