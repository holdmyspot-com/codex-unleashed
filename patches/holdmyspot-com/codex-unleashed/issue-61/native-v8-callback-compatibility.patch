From bf55da3f900bf3e9bd0b17ea2f73bd53902fb823 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Wed, 14 Oct 2026 03:06:15 -0400
Subject: [PATCH] Scope V8 legacy callback compatibility diagnostics

Keep the pinned Rust callback ABI while V8's transition constructors invoke
its deprecated internal converters. Scope V8's diagnostic push/pop macros
to the named and indexed compatibility constructor sections. Preserve the
conversion logic, callback types, flags, and all other diagnostic checks.
Add WORKAROUND comments linking the callback-retirement issue and the
coordinated Rusty V8 migration, with the removal condition.

Include a check that compiles the real binding and requires an unrelated
deprecated call in an independent translation unit to fail. Keep the
negative target manual so ordinary wildcard builds never select it.

Base: rust-v0.162.1 (092d3acd6bec3e3a14bdc7e7a2810ab628ab759d)
with the native warning policy, LLVM 23, simdutf, and Abseil prerequisites.
Red: tools/build-warnings/v8/check.sh --keep_going
--output_groups=compilation_outputs reproduces four legacy-converter errors.
Green: the same command passes both compilation and diagnostic enforcement;
just fmt-check, just bazel-lock-check, and bash -n on the script pass.
Evidence: v8-binding-compilation-red.log,
v8-template-warning-boundary-green.log, v8-compatibility-fmt-check.log,
and v8-compatibility-lock-check.log in llvm-toolchain-Rkha0k.

Wrapper-level pragmas do not control diagnostics in the template definition.
The negative fixture must not inherit binding.cc's existing upstream pragma.
Neither exploratory fixture is part of the emitted patch.

Upstream: https://crbug.com/348660658
Upstream migration: https://github.com/denoland/rusty_v8/pull/2037
---
 MODULE.bazel                                 |  1 +
 patches/v8_callback_compatibility.patch      | 43 ++++++++++++++++++++
 third_party/v8/BUILD.bazel                   |  8 ++++
 third_party/v8/callback_deprecation_probe.cc |  8 ++++
 tools/build-warnings/v8/check.sh             | 31 ++++++++++++++
 5 files changed, 91 insertions(+)
 create mode 100644 patches/v8_callback_compatibility.patch
 create mode 100644 third_party/v8/callback_deprecation_probe.cc
 create mode 100755 tools/build-warnings/v8/check.sh

diff --git a/MODULE.bazel b/MODULE.bazel
index 69fcd3105..0d5cdee65 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -818,6 +818,7 @@ archive_override(
         "//patches:v8_bazel_rules.patch",
         "//patches:v8_source_portability.patch",
         "//patches:v8_icu_mutex_annotations.patch",
+        "//patches:v8_callback_compatibility.patch",
         "//patches:v8_simdutf_constexpr.patch",
     ],
     strip_prefix = "v8-15.0.245.2",
diff --git a/patches/v8_callback_compatibility.patch b/patches/v8_callback_compatibility.patch
new file mode 100644
index 000000000..e0dcfaab0
--- /dev/null
+++ b/patches/v8_callback_compatibility.patch
@@ -0,0 +1,43 @@
+diff --git a/mod/v8-15.0.245.2/include/v8-template.h b/mod/v8-15.0.245.2/include/v8-template.h
+--- a/mod/v8-15.0.245.2/include/v8-template.h
++++ b/mod/v8-15.0.245.2/include/v8-template.h
+@@ -776,6 +776,10 @@ struct NamedPropertyHandlerConfiguration {
+   }
+ 
+  public:
++  // WORKAROUND: https://crbug.com/348660658 tracks legacy callback retirement.
++  // Remove this guard when the pinned Rust callbacks migrate with V8:
++  // https://github.com/denoland/rusty_v8/pull/2037.
++  START_ALLOW_USE_DEPRECATED()
+   // TODO(https://crbug.com/348660658): cleanup once migration to
+   // NamedPropertySetterCallbackV2/NamedPropertyDefinerCallbackV2 is done.
+   template <typename TSetter = std::nullptr_t,
+@@ -859,6 +863,8 @@ struct NamedPropertyHandlerConfiguration {
+         data(data),
+         flags(flags) {}
+ 
++  END_ALLOW_USE_DEPRECATED()
++
+   NamedPropertyGetterCallback getter;
+   NamedPropertySetterCallbackV2 setter;
+   NamedPropertyQueryCallback query;
+@@ -907,6 +913,10 @@ struct IndexedPropertyHandlerConfiguration {
+   }
+ 
+  public:
++  // WORKAROUND: https://crbug.com/348660658 tracks legacy callback retirement.
++  // Remove this guard when the pinned Rust callbacks migrate with V8:
++  // https://github.com/denoland/rusty_v8/pull/2037.
++  START_ALLOW_USE_DEPRECATED()
+   // TODO(https://crbug.com/348660658): cleanup once migration to
+   // IndexedPropertySetterCallback/IndexedPropertyDefinerCallback is done.
+   template <typename TSetter = std::nullptr_t,
+@@ -1022,6 +1032,8 @@ struct IndexedPropertyHandlerConfiguration {
+         data(data),
+         flags(flags) {}
+ 
++  END_ALLOW_USE_DEPRECATED()
++
+   IndexedPropertyGetterCallback getter;
+   IndexedPropertySetterCallback setter;
+   IndexedPropertyQueryCallback query;
diff --git a/third_party/v8/BUILD.bazel b/third_party/v8/BUILD.bazel
index 31c110dd4..6125d71fc 100644
--- a/third_party/v8/BUILD.bazel
+++ b/third_party/v8/BUILD.bazel
@@ -304,6 +304,14 @@ cc_library(
     }),
 )
 
+cc_library(
+    name = "binding_deprecation_boundary_probe",
+    srcs = ["callback_deprecation_probe.cc"],
+    copts = V8_COPTS + V8_CUSTOM_LIBCXX_COPTS,
+    tags = ["manual"],
+    deps = [":v8_150_4_0_binding"],
+)
+
 cc_static_library(
     name = "v8_150_4_0_aarch64_apple_darwin_bazel",
     features = V8_STATIC_LIBRARY_FEATURES,
diff --git a/third_party/v8/callback_deprecation_probe.cc b/third_party/v8/callback_deprecation_probe.cc
new file mode 100644
index 000000000..cd57cd2da
--- /dev/null
+++ b/third_party/v8/callback_deprecation_probe.cc
@@ -0,0 +1,8 @@
+#include "v8.h"
+
+[[deprecated("codex_v8_deprecation_boundary_probe")]]
+void codex_v8_deprecation_boundary_probe() {}
+
+void codex_v8_call_deprecated_probe() {
+  codex_v8_deprecation_boundary_probe();
+}
diff --git a/tools/build-warnings/v8/check.sh b/tools/build-warnings/v8/check.sh
new file mode 100755
index 000000000..e2a4347e0
--- /dev/null
+++ b/tools/build-warnings/v8/check.sh
@@ -0,0 +1,31 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)"
+cd -- "$repo_root"
+probe_dir="$(mktemp -d "${TMPDIR:?TMPDIR must identify owned temporary storage}/codex-v8-warning-boundary-XXXXXX")"
+trap 'rm -r -- "$probe_dir"' EXIT
+
+if ! bazel build "$@" //third_party/v8:v8_150_4_0_binding >"$probe_dir/binding.log" 2>&1; then
+    cat -- "$probe_dir/binding.log"
+    exit 1
+fi
+
+if bazel build "$@" //third_party/v8:binding_deprecation_boundary_probe >"$probe_dir/probe.log" 2>&1; then
+    cat -- "$probe_dir/probe.log"
+    echo "Deprecated calls outside the V8 compatibility boundary must fail compilation." >&2
+    exit 1
+fi
+
+if grep -Eq 'error.*codex_v8_deprecation_boundary_probe|codex_v8_deprecation_boundary_probe.*error' "$probe_dir/probe.log"; then
+    :
+elif grep -q 'error C2220:' "$probe_dir/probe.log" &&
+    grep -Eq 'warning C4996:.*codex_v8_deprecation_boundary_probe' "$probe_dir/probe.log"; then
+    :
+else
+    cat -- "$probe_dir/probe.log"
+    echo "The V8 warning probe failed without its expected deprecation error." >&2
+    exit 1
+fi
+
+echo "V8 bindings compile and deprecations outside the compatibility boundary remain fatal."
-- 
