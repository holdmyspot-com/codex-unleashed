     use codex_utils_absolute_path::test_support::PathBufExt;
     use codex_utils_absolute_path::test_support::test_path_buf;

+    #[cfg(unix)]
+    #[tokio::test]
+    #[allow(deprecated)]
+    async fn host_hook_cwd_does_not_use_remote_tool_cwd() {
+        let (session, mut turn) = make_session_and_context().await;
+        let host_cwd = turn.cwd.clone();
+        let remote_cwd = host_cwd.join("remote-only-workspace");
+        turn.cwd = remote_cwd.clone();
+        let mut remote_only = turn.initial_environments.clone();
+        let crate::environment_selection::TurnEnvironmentState::Ready(environment) =
+            &mut remote_only.environments[0]
+        else {
+            panic!("fixture should have a ready environment");
+        };
+        environment.selection.cwd = codex_utils_path_uri::PathUri::from_abs_path(&remote_cwd);
+        environment.selection.environment_id = codex_exec_server::REMOTE_ENVIRONMENT_ID.to_string();
+        environment.environment = Arc::new(
+            codex_exec_server::Environment::create_for_tests(Some(
+                "ws://127.0.0.1:8765".to_string(),
+            ))
+            .expect("remote environment"),
+        );
+
+        let hook_config = serde_json::from_value(serde_json::json!({
+            "hooks": {
+                "PostToolUse": [{
+                    "hooks": [{
+                        "type": "command",
+                        "command": "printf '%s' '{\"decision\":\"block\",\"reason\":\"host hook executed\"}'"
+                    }]
+                }]
+            }
+        }))
+        .expect("hook config");
+        let hooks = session.hooks().reconfigured(codex_hooks::HooksConfig {
+            feature_enabled: true,
+            bypass_hook_trust: true,
+            config_layer_stack: Some(
+                turn.config
+                    .config_layer_stack
+                    .with_user_config(&turn.config.codex_home.join("config.toml"), hook_config)
+                    .expect("hook config layer"),
+            ),
+            shell_program: Some("/bin/sh".to_string()),
+            shell_args: vec!["-c".to_string()],
+            ..Default::default()
+        });
+        let outcome = hooks
+            .run_post_tool_use(codex_hooks::PostToolUseRequest {
+                session_id: session.session_id().into(),
+                turn_id: turn.sub_id.clone(),
+                subagent: None,
+                cwd: super::host_hook_cwd(&remote_only, &turn),
+                transcript_path: None,
+                model: "test-model".to_string(),
+                permission_mode: "default".to_string(),
+                tool_name: "request_user_input".to_string(),
+                matcher_aliases: Vec::new(),
+                tool_use_id: "test-call".to_string(),
+                tool_input: serde_json::json!({}),
+                tool_response: serde_json::json!({}),
+            })
+            .await;
+        assert!(outcome.should_block, "hook should execute: {outcome:?}");
+        assert_eq!(
+            outcome.feedback_message.as_deref(),
+            Some("host hook executed")
+        );
+
+        assert_eq!(super::host_hook_cwd(&remote_only, &turn), host_cwd);
+        assert_eq!(turn.cwd, remote_cwd);
+    }
+
+    #[tokio::test]
+    #[allow(deprecated)]
+    async fn host_hook_cwd_prefers_selected_local_environment() {
+        let (_session, mut turn) = make_session_and_context().await;
+        let mut selected_local = turn.initial_environments.clone();
+        let selected_local_cwd = turn.cwd.join("selected-local-workspace");
+        let crate::environment_selection::TurnEnvironmentState::Ready(environment) =
+            &mut selected_local.environments[0]
+        else {
+            panic!("fixture should have a ready local environment");
+        };
+        environment.selection.cwd =
+            codex_utils_path_uri::PathUri::from_abs_path(&selected_local_cwd);
+        let remote_cwd = turn.cwd.join("remote-only-workspace");
+        turn.cwd = remote_cwd.clone();
+
+        assert_eq!(
+            super::host_hook_cwd(&selected_local, &turn),
+            selected_local_cwd
+        );
+        assert_eq!(turn.cwd, remote_cwd);
+    }
