     def test_development_alias_is_materialized_and_escape_is_rejected(self):
         alias = self.prefix / "lib/libfixture.dylib"
         try:
diff --git a/tools/build-warnings/check-native-sdk-relocation.py b/tools/build-warnings/check-native-sdk-relocation.py
new file mode 100644
index 000000000..a63f99df8
--- /dev/null
+++ b/tools/build-warnings/check-native-sdk-relocation.py
@@ -0,0 +1,97 @@
+#!/usr/bin/env python3
+"""Query moved pkg-config metadata from the checksum-pinned native templates."""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import shlex
+import subprocess
+import sys
+import tempfile
+
+CHECKOUT = Path(__file__).resolve().parents[2]
+sys.dont_write_bytecode = True
+sys.path.insert(0, str(CHECKOUT / "third_party/voice"))
+from prepare_sources import extract_source, load_sources
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("configuration", type=Path)
+    parser.add_argument("execroot", type=Path)
+    arguments = parser.parse_args()
+    root = arguments.execroot.absolute()
+    configuration = json.loads(arguments.configuration.read_text())
+    sources = load_sources((CHECKOUT / "third_party/voice/sources.json").read_bytes())
+    with tempfile.TemporaryDirectory(prefix="native-sdk-relocation-") as temporary:
+        scratch = Path(temporary)
+        extracted = scratch / "sources"
+        extracted.mkdir()
+        metadata = scratch / "sdk/lib/pkgconfig"
+        metadata.mkdir(parents=True)
+        variables = {
+            "prefix": "/deleted/build/prefix",
+            "exec_prefix": "${prefix}",
+            "libdir": "${exec_prefix}/lib",
+            "toolexeclibdir": "${libdir}",
+            "includedir": "${prefix}/include",
+            "PACKAGE_NAME": "libffi",
+            "PACKAGE_VERSION": "1.0",
+            "CMAKE_INSTALL_PREFIX": "/deleted/build/prefix",
+            "CMAKE_INSTALL_LIBDIR": "lib",
+            "CMAKE_INSTALL_INCLUDEDIR": "include",
+            "zlib_VERSION": "1.0",
+        }
+        cache = scratch / "configure.cmake"
+        cache.write_text(
+            "".join(f"set({key} [=[{value}]=])\n" for key, value in variables.items())
+        )
+        for package, template, module in (
+            ("libffi", "libffi.pc.in", "libffi"),
+            ("pcre2", "libpcre2-8.pc.in", "libpcre2-8"),
+            ("zlib", "zlib.pc.cmakein", "zlib"),
+        ):
+            source = next(item for item in sources if item.name == package)
+            archive = next(
+                root / item
+                for item in configuration["archives"]
+                if Path(item).name == source.archive
+            )
+            extract_source(source, archive.parent, extracted)
+            script = scratch / f"{package}.cmake"
+            script.write_text(
+                f"include([=[{cache}]=])\n"
+                f"configure_file([=[{extracted / source.root / template}]=] "
+                f"[=[{metadata / (module + '.pc')}]=] @ONLY)\n"
+            )
+            subprocess.run([root / configuration["cmake"], "-P", script], check=True)
+        moved = scratch / "moved SDK"
+        (scratch / "sdk").rename(moved)
+        for module in ("libffi", "libpcre2-8", "zlib"):
+            output = subprocess.check_output(
+                [root / configuration["pkg_config"], "--cflags", "--libs", module],
+                env={
+                    **os.environ,
+                    "PKG_CONFIG_PATH": "",
+                    "PKG_CONFIG_LIBDIR": str(moved / "lib/pkgconfig"),
+                },
+                text=True,
+            )
+            flags = shlex.split(output)
+            directories = set()
+            for flag in flags:
+                if flag.startswith(("-I", "-L")):
+                    directory = Path(flag[2:]).resolve()
+                    if not directory.is_relative_to(moved):
+                        raise AssertionError(f"{module} retains a foreign path: {flag}")
+                    directories.add((flag[:2], directory))
+            if not {("-I", moved / "include"), ("-L", moved / "lib")} <= directories:
+                raise AssertionError(
+                    f"{module} omits its moved SDK directories: {flags}"
+                )
+            print(f"{module}: moved SDK include and library paths resolve correctly")
+
+
+if __name__ == "__main__":
+    main()
