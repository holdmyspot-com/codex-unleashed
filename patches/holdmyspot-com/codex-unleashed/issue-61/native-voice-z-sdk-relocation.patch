From fddfca89ca477af9483be2cdc5324c8462a0841c Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Thu, 15 Oct 2026 22:01:32 -0400
Subject: [PATCH] Relocate transitive native SDK metadata

Keep moved SDK metadata valid without warning-only dependency fixes.
---
 third_party/voice/prepare_sources.py          | 33 ++++++-
 third_party/voice/sdk.py                      |  9 +-
 third_party/voice/test_sdk.py                 |  9 ++
 .../check-native-sdk-relocation.py            | 97 +++++++++++++++++++
 4 files changed, 144 insertions(+), 4 deletions(-)
 create mode 100644 tools/build-warnings/check-native-sdk-relocation.py

diff --git a/third_party/voice/prepare_sources.py b/third_party/voice/prepare_sources.py
index 23f1d805d..2699d1826 100644
--- a/third_party/voice/prepare_sources.py
+++ b/third_party/voice/prepare_sources.py
@@ -83,6 +83,38 @@ def extract_source(source: Source, archives: Path, destination: Path) -> None:
             raise ValueError(f"Expanded source exceeds limits: {source.name}")
         archive.extractall(destination, members=members, filter="data")

+    metadata_templates = {
+        ("libffi", "3.8.0"): ("libffi.pc.in", "@prefix@"),
+        ("pcre2", "10.47"): ("libpcre2-8.pc.in", "@prefix@"),
+        ("zlib", "1.3.2"): ("zlib.pc.cmakein", "@CMAKE_INSTALL_PREFIX@"),
+    }
+    if (source.name, source.version) in metadata_templates:
+        # WORKAROUND: these pinned dependencies embed the temporary install prefix.
+        # https://github.com/holdmyspot-com/codex-unleashed/issues/61
+        # Remove when all three producers emit relocatable pkg-config metadata.
+        relative_path, prefix_variable = metadata_templates[
+            (source.name, source.version)
+        ]
+        metadata = destination / source.root / relative_path
+        contents = metadata.read_text(encoding="utf-8")
+        replacements = [(f"prefix={prefix_variable}", "prefix=${pcfiledir}/../..")]
+        if source.name == "zlib":
+            replacements.append(
+                ("exec_prefix=@CMAKE_INSTALL_PREFIX@", "exec_prefix=${prefix}")
+            )
+        for original, replacement in replacements:
+            contents, count = re.subn(
+                "^" + re.escape(original) + "$",
+                replacement,
+                contents,
+                flags=re.MULTILINE,
+            )
+            if count != 1:
+                raise ValueError(
+                    f"Pinned pkg-config template does not match: {source.name}"
+                )
+        metadata.write_text(contents, encoding="utf-8")
+
     if source.name == "gst-plugins-base" and source.version == "1.28.6":
         # WORKAROUND: glib-mkenums parses enum expressions one line at a time.
         # https://github.com/holdmyspot-com/codex-unleashed/issues/61
@@ -128,7 +160,6 @@ def extract_source(source: Source, archives: Path, destination: Path) -> None:
             )


-
 def prepare_sources(archives: Path, output: Path, manifest: bytes) -> None:
     sources = load_sources(manifest)
     # Claim a new directory exclusively; never reuse or overwrite an earlier build.
diff --git a/third_party/voice/sdk.py b/third_party/voice/sdk.py
index 8819ce731..f484a7ddd 100644
--- a/third_party/voice/sdk.py
+++ b/third_party/voice/sdk.py
@@ -106,10 +106,13 @@ def export_sdk(prefix: Path, receipts: Path, target: str, output: Path):
         selected.append((name, source, expected))
     for module in MODULES:
         path = prefix / f"lib/pkgconfig/{module}.pc"
-        if path.relative_to(prefix).as_posix().casefold() not in names or not re.search(
-            r"^prefix=\$\{pcfiledir\}/\.\./\.\.$", path.read_text(), re.MULTILINE
+        if path.relative_to(prefix).as_posix().casefold() not in names:
+            raise ValueError("SDK is missing required pkg-config metadata")
+    for name, source, _ in selected:
+        if name.startswith("lib/pkgconfig/") and not re.search(
+            r"^prefix=\$\{pcfiledir\}/\.\./\.\.$", source.read_text(), re.MULTILINE
         ):
-            raise ValueError("rebuild the SDK with relocatable Meson pkg-config files")
+            raise ValueError("rebuild the SDK with relocatable pkg-config files")
     if "lib/glib-2.0/include/glibconfig.h" not in names:
         raise ValueError("SDK is missing the target's GLib configuration header")
     output.mkdir()
diff --git a/third_party/voice/test_sdk.py b/third_party/voice/test_sdk.py
index d499a9e91..6c1c9b632 100644
--- a/third_party/voice/test_sdk.py
+++ b/third_party/voice/test_sdk.py
@@ -115,6 +115,15 @@ class SdkTests(unittest.TestCase):
             export_sdk(self.prefix, self.receipts, self.target, self.output)
         self.assertFalse(self.output.exists())

+    def test_transitive_dependency_metadata_must_be_relocatable(self):
