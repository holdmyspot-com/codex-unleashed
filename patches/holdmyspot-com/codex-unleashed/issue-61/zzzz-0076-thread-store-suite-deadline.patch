From 712865def9eb2ccfd903f2b21b3f595893e5043e Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Sun, 18 Oct 2026 05:58:20 +0000
Subject: [PATCH] Preserve the upstream deadline for thread-store unit tests

Restore the medium-suite 300-second budget after patch0013 shortened it to60 seconds. Native Windows can exceed that deadline; retain all268 tests across four shards and verify the configured timeout with an analysis regression.

Base: rust-v0.163.0 (83086188ae0614bd882818ff1aa23f3194962012), with the maintained queue through0075. TDD: test-only analysis exits3 with Expected moderate, got short; native Windows39097177711/job117592510971 passes all268 tests at300 seconds. Authoring just fmt-check, just bazel-lock-check, and the configured analysis regression pass. Fresh emitted-patch checks and full native CI remain acceptance gates.
---
 codex-rs/thread-store/BUILD.bazel | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/codex-rs/thread-store/BUILD.bazel b/codex-rs/thread-store/BUILD.bazel
index 5d800f51f..878e43344 100644
--- a/codex-rs/thread-store/BUILD.bazel
+++ b/codex-rs/thread-store/BUILD.bazel
@@ -1,6 +1,16 @@
 load("//:defs.bzl", "codex_rust_crate")
+load("//tools/build-warnings/test-timeouts:timeouts_test.bzl", "timeout_test")
 
 codex_rust_crate(
     name = "thread-store",
     crate_name = "codex_thread_store",
+    # Preserve upstream's medium-suite budget for the full sharded suite.
+    unit_test_timeout = "moderate",
+)
+
+timeout_test(
+    name = "whole_suite_deadline_test",
+    size = "small",
+    expected_timeout = "moderate",
+    target_under_test = ":thread-store-unit-tests",
 )
