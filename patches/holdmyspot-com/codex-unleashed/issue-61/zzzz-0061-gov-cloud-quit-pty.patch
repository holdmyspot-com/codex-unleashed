From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Sat, 17 Oct 2026 01:49:05 +0000
Subject: [PATCH] Handle normal PTY closure while quitting GovCloud guidance

Accept a closed PTY only in the quit scenario, and require the child to
exit successfully before the original interaction deadline. Preserve
other input failures, timeout context, and acknowledgment/config/restart
assertions.

Red: unpatched rust-v0.163.0 at
83086188ae0614bd882818ff1aa23f3194962012 reproduces EIO in the existing
GovCloud test in one of five Intel macOS suite runs (38990057860).
Diagnostic run 38981130926 identifies the failed operation as PTY input.
Green: local nextest passes the focused test (2.825 seconds); native
candidate run 38988440935 passes all 24 enabled TUI tests.
Fresh emitted-patch and repeated native verification remain required.
---
 .../tests/suite/gov_cloud_guidance_tests.rs   | 25 +++++++++++++++++--
 1 file changed, 23 insertions(+), 2 deletions(-)

diff --git a/codex-rs/tui/tests/suite/gov_cloud_guidance_tests.rs b/codex-rs/tui/tests/suite/gov_cloud_guidance_tests.rs
index ee79c7ca5..00529fc04 100644
--- a/codex-rs/tui/tests/suite/gov_cloud_guidance_tests.rs
+++ b/codex-rs/tui/tests/suite/gov_cloud_guidance_tests.rs
@@ -27,9 +27,30 @@ fn gov_cloud_startup_persists_only_acknowledgment() -> Result<()> {
         terminal.wait_for_screen("Using Codex with AWS GovCloud")?;
         let original = std::fs::read_to_string(&path)?;
         let deadline = Instant::now() + STARTUP_TIMEOUT;
-        loop {
+        'interaction: loop {
             // Startup drains pending keys after drawing the guidance; retry until it handles one.
-            terminal.write_input(if action == "quit" { b"q" } else { b"\r" })?;
+            if let Err(error) = terminal.write_input(if action == "quit" { b"q" } else { b"\r" }) {
+                let closed_pty = error
+                    .downcast_ref::<std::io::Error>()
+                    .is_some_and(|error| error.raw_os_error() == Some(libc::EIO));
+                if action == "quit" && closed_pty {
+                    // Quitting can close the PTY before the next repeated key. Require the
+                    // child to exit successfully within the existing interaction deadline.
+                    loop {
+                        if let Some(status) = terminal.child.try_wait()? {
+                            ensure!(status.success(), "quit exited with {status}");
+                            break 'interaction;
+                        }
+                        if Instant::now() >= deadline {
+                            return Err(error.context(
+                                "quit closed the PTY but the child did not exit before the interaction deadline",
+                            ));
+                        }
+                        std::thread::sleep(Duration::from_millis(/*millis*/ 10));
+                    }
+                }
+                return Err(error);
+            }
             terminal.read_output(Duration::from_millis(/*millis*/ 50))?;
             if action == "quit" {
