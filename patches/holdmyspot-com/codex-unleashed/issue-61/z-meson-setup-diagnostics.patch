@@ -0,0 +1,26 @@
+From dd3f095c7c9c941b3ee5fd79e6539b0946608833 Mon Sep 17 00:00:00 2001
+From: Gili Tzabari <cowwoc2020@gmail.com>
+Date: Thu, 15 Oct 2026 01:52:01 +0000
+Subject: [PATCH] Print Meson setup diagnostics before returning its failure
+
+---
+ foreign_cc/meson.bzl | 10 +++++++++-
+ 1 file changed, 9 insertions(+), 1 deletion(-)
+
+diff --git a/foreign_cc/meson.bzl b/foreign_cc/meson.bzl
+index 2cfb974..0be7cf2 100644
+--- a/foreign_cc/meson.bzl
++++ b/foreign_cc/meson.bzl
+@@ -168,3 +168,11 @@ def _create_meson_script(configureParameters):
+
+-    script.append("{meson} setup --prefix={install_dir} {setup_args} {options} {source_dir}".format(
++    script.append("""if {meson} setup --prefix={install_dir} {setup_args} {options} {source_dir}; then
++    :
++else
++    status=$?
++    if test -f meson-logs/meson-log.txt; then
++        cat meson-logs/meson-log.txt || :
++    fi
++    exit "$status"
++fi""".format(
+         meson = meson_path,
diff --git a/third_party/voice/bazel_native.py b/third_party/voice/bazel_native.py
index 584ff7037..4d5be012a 100644
--- a/third_party/voice/bazel_native.py
+++ b/third_party/voice/bazel_native.py
@@ -57,9 +57,26 @@ def main():
         except Exception:
             # Preserve the failing upstream diagnostic in the Bazel action log.
             if builder.record["steps"]:
-                log = builder.output / (builder.record["steps"][-1]["name"] + ".log")
+                step_name = builder.record["steps"][-1]["name"]
+                log = builder.output / (step_name + ".log")
                 if log.is_file():
                     print(log.read_text(errors="replace"), file=sys.stderr)
+                if step_name.startswith("libffi-"):
+                    configure_log = builder.output / "build/libffi/config.log"
+                    if configure_log.is_file():
+                        print("libffi config.log:", file=sys.stderr)
+                        print(
+                            configure_log.read_text(errors="replace"), file=sys.stderr
+                        )
+                meson_log = (
+                    builder.output
+                    / "build"
+                    / step_name.rsplit("-", 1)[0]
+                    / "meson-logs/meson-log.txt"
+                )
+                if meson_log.is_file():
+                    print(f"{step_name} meson-log.txt:", file=sys.stderr)
+                    print(meson_log.read_text(errors="replace"), file=sys.stderr)
             raise
         with tarfile.open(prefix, "w") as archive:
             archive.add(builder.prefix, arcname=".")
diff --git a/third_party/voice/test_build_native.py b/third_party/voice/test_build_native.py
index 091c8a4df..4dd10bb77 100644
--- a/third_party/voice/test_build_native.py
+++ b/third_party/voice/test_build_native.py
@@ -1,5 +1,7 @@
 """Check native build preconditions and subprocess failure propagation."""
 
+from contextlib import redirect_stderr
+import io
 import json
 import os
 from pathlib import Path
@@ -13,6 +15,7 @@ from types import SimpleNamespace
 import unittest
 from unittest.mock import patch
 
+import bazel_native
 from build_native import NativeBuild, validate_target
 
 
@@ -447,6 +450,96 @@ class NativeBuildTests(unittest.TestCase):
         )
         self.assertFalse((build.output / "built.json").exists())
 
+    def test_bazel_failure_preserves_configure_context_and_original_error(self):
+        for index, (name, status, detail, context) in enumerate(
+            (
+                ("libffi-configure", 23, "configure failed", "libffi/config.log"),
+                ("libffi-build", 23, "warning: no debug symbols", "libffi/config.log"),
+                ("libffi-install", 23, "install failed", "libffi/config.log"),
+                ("other-build", 23, "other failed", "libffi/config.log"),
+                ("libffi-configure", 23, None, "libffi/config.log"),
+                (
+                    "proxy-libintl-configure",
+                    23,
+                    "compiler failed",
+                    "proxy-libintl/meson-logs/meson-log.txt",
+                ),
+                ("glib-build", 23, "compile failed", "glib/meson-logs/meson-log.txt"),
+                (
+                    "gstreamer-install",
+                    23,
+                    "warning: Meson install diagnostic",
+                    "gstreamer/meson-logs/meson-log.txt",
+                ),
+                (
+                    "proxy-libintl-configure",
+                    23,
+                    None,
+                    "proxy-libintl/meson-logs/meson-log.txt",
+                ),
+            )
+        ):
+            with self.subTest(name=name, status=status, detail=detail):
+                self.args.output = self.root / f"failure-context-{index}"
+                build = NativeBuild(self.args, self.environment)
+                config = self.root / "bazel-config.json"
+                config.write_text(
+                    json.dumps(
+                        {
+                            "archives": [],
+                            "prefix": str(self.root / "prefix.tar"),
+                            "receipt": str(self.root / "built.json"),
+                            "ld": sys.executable,
+                            **{
+                                tool: str(path)
+                                for tool, path in build.toolchain.items()
+                            },
+                            **{
+                                tool: sys.executable
+                                for tool in ("ar", "ranlib", "nm", "readelf")
+                            },
+                        }
+                    )
+                )
+
+                def fail():
+                    build.output.mkdir()
+                    if detail is not None:
+                        log = build.output / "build" / context
+                        log.parent.mkdir(parents=True)
+                        log.write_text("native configure probe detail\n")
+                    build.run(
+                        name,
+                        [
+                            sys.executable,
+                            "-c",
+                            "import sys; print(sys.argv[1]); raise SystemExit(int(sys.argv[2]))",
+                            detail or "configure failed before log creation",
+                            str(status),
+                        ],
+                    )
+
+                stderr = io.StringIO()
+                exception = subprocess.CalledProcessError if status else RuntimeError
+                with (
+                    patch("bazel_native.sys.argv", ["bazel_native.py", str(config)]),
+                    patch("bazel_native.NativeBuild", return_value=build),
+                    patch.object(build, "build", side_effect=fail),
+                    redirect_stderr(stderr),
+                    self.assertRaises(exception) as error,
+                ):
+                    bazel_native.main()
+                if status:
+                    self.assertEqual(error.exception.returncode, status)
+                self.assertIn(detail or "configure failed", stderr.getvalue())
+                self.assertEqual(
+                    "native configure probe detail" in stderr.getvalue(),
+                    Path(context).parts[0] == name.rsplit("-", 1)[0]
+                    and detail is not None,
+                )
+                self.assertFalse((self.root / "prefix.tar").exists())
+                self.assertFalse((self.root / "built.json").exists())
+
     def test_ambient_native_discovery_variables_are_not_inherited(self):
         inherited = {
             **self.environment,
diff --git a/tools/build-warnings/check.sh b/tools/build-warnings/check.sh
index 0ce2f42cc..e0d599d9a 100644
--- a/tools/build-warnings/check.sh
+++ b/tools/build-warnings/check.sh
@@ -30,6 +30,18 @@ if ! bazel build "$@" //tools/build-warnings:dependency_warning >"$probe_dir/dep
 fi
 cat -- "$probe_dir/dependency-warning.log"
 
+if bazel build "$@" //tools/build-warnings/meson-diagnostics:setup_failure >"$probe_dir/meson.log" 2>&1; then
+    cat -- "$probe_dir/meson.log"
+    echo "Meson setup unexpectedly succeeded" >&2
+    exit 1
+fi
+if ! grep -q 'CODEX_MESON_LOG_DETAIL' "$probe_dir/meson.log" ||
+    ! grep -q 'CODEX_MESON_SETUP_EXPECTED_FAILURE' "$probe_dir/meson.log"; then
+    cat -- "$probe_dir/meson.log"
+    echo "Meson setup did not print its detailed failure log" >&2
+    exit 1
+fi
+
 if bazel build "$@" //tools/build-warnings:compiler_warning >"$probe_dir/warning.log" 2>&1; then
     cat -- "$probe_dir/warning.log"
     echo "The C compiler accepts warnings; warnings must fail the build." >&2
