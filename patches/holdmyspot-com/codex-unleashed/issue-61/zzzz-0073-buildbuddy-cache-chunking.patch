From 0c7c8023b23a33e796569d66d0a370fb4c68c431 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Sun, 18 Oct 2026 09:08:34 +0000
Subject: [PATCH] perf(ci): reuse BuildBuddy cache chunks for nearby artifacts

Enable content-defined chunking only for the generic BuildBuddy cache. Retain compression, minimal CI downloads and the managed disk-cache policy, including the Windows exception.

A manual deterministic 16 MiB fixture changes only its eight-byte header. The hosted cold chunked read transfers 16.78 MB (e0d8ebed-cf35-4c59-8618-af65564eab21); the changed warm read transfers 1.338 MB (cf9763c9-56ea-4641-94bd-42a980dc6db1). Full byte and unchanged-body comparisons pass. These measurements are fixture-specific, not a full-suite savings estimate.
---
 .bazelrc | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/.bazelrc b/.bazelrc
index cfdc52577..0fa910a8e 100644
--- a/.bazelrc
+++ b/.bazelrc
@@ -94,6 +94,9 @@ common --grpc_keepalive_time=30s
 common:buildbuddy-generic --bes_backend=grpcs://remote.buildbuddy.io
 common:buildbuddy-generic --bes_results_url=https://app.buildbuddy.io/invocation/
 common:buildbuddy-generic --remote_cache=grpcs://remote.buildbuddy.io
+# Reuse unchanged chunks of large artifacts across nearby builds.
+# https://www.buildbuddy.io/changelog/bazel-remote-cache-cdc/
+common:buildbuddy-generic --experimental_remote_cache_chunking
 common:buildbuddy-generic --experimental_remote_downloader=grpcs://remote.buildbuddy.io
 
 # Add remote execution on the generic host.
