From c25886ac802adef88b23d84c8fb3daad7951e290 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Thu, 15 Oct 2026 21:28:05 -0400
Subject: [PATCH] Backport OpenSSL command-line unused-state fixes

Preserve compilation and runtime fixes without warning-only dependency changes.
---
 tools/build-warnings/openssl/BUILD.bazel | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/tools/build-warnings/openssl/BUILD.bazel b/tools/build-warnings/openssl/BUILD.bazel
index 9980c7ba0..fc2f72933 100644
--- a/tools/build-warnings/openssl/BUILD.bazel
+++ b/tools/build-warnings/openssl/BUILD.bazel
@@ -6,3 +6,11 @@ cc_test(
     srcs = ["ssl_init_test.c"],
     deps = ["@openssl//:ssl"],
 )
+
+genrule(
+    name = "cli_probe",
+    outs = ["cli_version_and_help.txt"],
+    cmd = "$(location @openssl//:openssl) version > \"$@\" && " +
+          "$(location @openssl//:openssl) s_server -help >> \"$@\" 2>&1",
+    tools = ["@openssl"],
+)
