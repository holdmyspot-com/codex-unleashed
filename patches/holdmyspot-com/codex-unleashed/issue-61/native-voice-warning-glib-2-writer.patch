From 471b1913115c23dddfb0e07197db5c240046015c Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Wed, 14 Oct 2026 13:13:32 +0000
Subject: [PATCH] Backport GLib log-writer data cleanup

Track native warning enforcement in #61. Apply after the documented native
voice prerequisites; keep all compiler and linker checks enabled.

Reproduction evidence: native-glib-writer-red.log. The actual native recipe reports the
missing outcome under LLVM 23. Runtime and fresh emitted-queue acceptance
are recorded separately; an internal authoring commit is not full CI acceptance.
---
 third_party/voice/prepare_sources.py        | 18 ++++++++++++
 tools/build-warnings/glib/BUILD.bazel       | 13 +++++++++
 tools/build-warnings/glib/log_writer_test.c | 31 +++++++++++++++++++++
 3 files changed, 62 insertions(+)
 create mode 100644 tools/build-warnings/glib/log_writer_test.c

diff --git a/third_party/voice/prepare_sources.py b/third_party/voice/prepare_sources.py
index 436435a20..75cfab0c4 100644
--- a/third_party/voice/prepare_sources.py
+++ b/third_party/voice/prepare_sources.py
@@ -115,6 +115,24 @@ def extract_source(source: Source, archives: Path, destination: Path) -> None:
             contents = contents.replace(original, replacement)
         printf.write_text(contents, encoding="utf-8")
 
+        # WORKAROUND: backport GLib's log-writer data cleanup.
+        # https://github.com/GNOME/glib/commit/e7592a3c4ed4f3ef97f9efb804ad9637a3d4ca1c
+        # Remove when the selected GLib release includes this commit.
+        messages = destination / source.root / "glib/gmessages.c"
+        contents = messages.read_text(encoding="utf-8")
+        original = (
+            "  log_writer_func = func;\n"
+            "  log_writer_user_data = user_data;\n"
+            "  log_writer_user_data_free = user_data_free;"
+        )
+        replacement = (
+            "  if (log_writer_user_data_free != NULL && log_writer_user_data != NULL)\n"
+            "    log_writer_user_data_free (log_writer_user_data);\n\n" + original
+        )
+        if contents.count(original) != 1:
+            raise ValueError("Pinned GLib log-writer implementation does not match")
+        messages.write_text(contents.replace(original, replacement), encoding="utf-8")
+
     if source.name == "ninja" and source.version == "1.13.2":
         # WORKAROUND: the pinned Ninja lacks an explicit bundled-lexer mode.
         # https://github.com/holdmyspot-com/codex-unleashed/issues/61
diff --git a/tools/build-warnings/glib/BUILD.bazel b/tools/build-warnings/glib/BUILD.bazel
index 08b8b821e..889c05223 100644
--- a/tools/build-warnings/glib/BUILD.bazel
+++ b/tools/build-warnings/glib/BUILD.bazel
@@ -12,3 +12,16 @@ cc_test(
     tags = ["manual"],
     deps = ["//third_party/voice:native_link"],
 )
+
+cc_test(
+    name = "log_writer_test",
+    size = "small",
+    srcs = ["log_writer_test.c"],
+    additional_compiler_inputs = ["//third_party/voice:native_sdk"],
+    copts = [
+        "-I$(execpath //third_party/voice:native_sdk)/include/glib-2.0",
+        "-I$(execpath //third_party/voice:native_sdk)/lib/glib-2.0/include",
+    ],
+    tags = ["manual"],
+    deps = ["//third_party/voice:native_link"],
+)
diff --git a/tools/build-warnings/glib/log_writer_test.c b/tools/build-warnings/glib/log_writer_test.c
new file mode 100644
index 000000000..17b3bf969
--- /dev/null
+++ b/tools/build-warnings/glib/log_writer_test.c
@@ -0,0 +1,31 @@
+#include <glib.h>
+#include <string.h>
+
+struct WriterState {
+  int calls;
+  int destroys;
+  int valid;
+};
+
+static void destroy(void *data) {
+  struct WriterState *state = data;
+  ++state->destroys;
+}
+
+static GLogWriterOutput writer(GLogLevelFlags level, const GLogField *fields,
+                               gsize count, void *data) {
+  struct WriterState *state = data;
+  ++state->calls;
+  state->valid = level == G_LOG_LEVEL_MESSAGE && count == 1 &&
+                 strcmp(fields[0].key, "MESSAGE") == 0 &&
+                 strcmp(fields[0].value, "native-writer") == 0;
+  return G_LOG_WRITER_HANDLED;
+}
+
+int main(void) {
+  struct WriterState state = {0, 0, 0};
+  g_log_set_writer_func(writer, &state, destroy);
+  const GLogField field = {"MESSAGE", "native-writer", -1};
+  g_log_structured_array(G_LOG_LEVEL_MESSAGE, &field, 1);
+  return state.calls == 1 && state.destroys == 0 && state.valid ? 0 : 1;
+}
