From 490729d1afa3a17e1e6b2629f606140ec34fa2e0 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Sun, 18 Oct 2026 06:33:41 +0000
Subject: [PATCH] Scope unit-suite deadlines to the native platforms that need
 them

Keep the five-minute thread-store budget on Windows and image budget on
Intel macOS while retaining short deadlines elsewhere. The original suite
labels run one compatible launcher and preserve the compiled binaries,
arguments, assertions, and shard counts.

Base: rust-v0.163.0 (83086188ae0614bd882818ff1aa23f3194962012), with the
maintained queue through 0076. Tracks holdmyspot-com/codex-unleashed#61.

TDD: both Linux timeout regressions fail with expected short/got moderate
before the implementation and pass after it. Maintained just fmt-check,
just bazel-lock-check, and all 24 timeout analysis regressions pass. A
separate Bazel composition probe verifies that the original suite label
executes exactly one compatible test in both configurations. Fresh emitted
patch replay and full native payload validation remain separate gates.
---
 codex-rs/thread-store/BUILD.bazel | 14 ++++++++++----
 codex-rs/utils/image/BUILD.bazel  | 22 +++++++++++++++++----
 defs.bzl                          | 32 +++++++++++++++++++++++++++++--
 3 files changed, 58 insertions(+), 10 deletions(-)

diff --git a/codex-rs/thread-store/BUILD.bazel b/codex-rs/thread-store/BUILD.bazel
index 878e43344..57c711034 100644
--- a/codex-rs/thread-store/BUILD.bazel
+++ b/codex-rs/thread-store/BUILD.bazel
@@ -4,13 +4,19 @@ load("//tools/build-warnings/test-timeouts:timeouts_test.bzl", "timeout_test")
 codex_rust_crate(
     name = "thread-store",
     crate_name = "codex_thread_store",
-    # Preserve upstream's medium-suite budget for the full sharded suite.
-    unit_test_timeout = "moderate",
+    # Preserve the native Windows budget without extending fast-platform runs.
+    unit_test_platform_timeouts = {"@platforms//os:windows": "moderate"},
 )
 
 timeout_test(
     name = "whole_suite_deadline_test",
     size = "small",
-    expected_timeout = "moderate",
-    target_under_test = ":thread-store-unit-tests",
+    expected_timeout = select({
+        "@platforms//os:windows": "moderate",
+        "//conditions:default": "short",
+    }),
+    target_under_test = select({
+        "@platforms//os:windows": ":moderate-thread-store-unit-tests",
+        "//conditions:default": ":short-thread-store-unit-tests",
+    }),
 )
diff --git a/codex-rs/utils/image/BUILD.bazel b/codex-rs/utils/image/BUILD.bazel
index 6228ee13c..7d41e1f8c 100644
--- a/codex-rs/utils/image/BUILD.bazel
+++ b/codex-rs/utils/image/BUILD.bazel
@@ -4,13 +4,27 @@ load("//tools/build-warnings/test-timeouts:timeouts_test.bzl", "timeout_test")
 codex_rust_crate(
     name = "image",
     crate_name = "codex_utils_image",
-    # Preserve the upstream medium-suite budget for large image fixtures.
-    unit_test_timeout = "moderate",
+    # Preserve the Intel macOS budget without extending fast-platform runs.
+    unit_test_platform_timeouts = {":intel_macos": "moderate"},
+)
+
+config_setting(
+    name = "intel_macos",
+    constraint_values = [
+        "@platforms//cpu:x86_64",
+        "@platforms//os:macos",
+    ],
 )
 
 timeout_test(
     name = "whole_suite_deadline_test",
     size = "small",
-    expected_timeout = "moderate",
-    target_under_test = ":image-unit-tests",
+    expected_timeout = select({
+        ":intel_macos": "moderate",
+        "//conditions:default": "short",
+    }),
+    target_under_test = select({
+        ":intel_macos": ":moderate-image-unit-tests",
+        "//conditions:default": ":short-image-unit-tests",
+    }),
 )
diff --git a/defs.bzl b/defs.bzl
index 85504a3d9..cac8d0361 100644
--- a/defs.bzl
+++ b/defs.bzl
@@ -172,6 +172,28 @@ def _windows_workspace_root_setup(ctx):
     return """set "INSTA_WORKSPACE_ROOT=%workspace_root%"
 cd /d "%workspace_root%" || exit /b 1"""
 
+def _platform_unit_tests(name, unit_test_platform_timeouts, **kwargs):
+    """Preserve the unit-suite label while running one compatible timeout variant."""
+    if not unit_test_platform_timeouts:
+        workspace_root_test(name = name, **kwargs)
+        return
+
+    timeouts = {"//conditions:default": kwargs.get("timeout", "moderate")} | unit_test_platform_timeouts
+    variants = {timeout: True for timeout in timeouts.values()}
+    tests = []
+    for timeout in sorted(variants):
+        variant_name = timeout + "-" + name
+        variant_kwargs = dict(kwargs)
+        variant_kwargs["timeout"] = timeout
+        variant_kwargs["target_compatible_with"] = select({
+            condition: [] if selected_timeout == timeout else ["@platforms//:incompatible"]
+            for condition, selected_timeout in timeouts.items()
+        })
+        workspace_root_test(name = variant_name, **variant_kwargs)
+        tests.append(":" + variant_name)
+
+    native.test_suite(name = name, tests = tests, tags = kwargs.get("tags", []))
+
 workspace_root_test = rule(
     implementation = _workspace_root_test_impl,
     test = True,
@@ -267,7 +289,8 @@ def codex_rust_crate(
         unit_test_timeout = "short",
         extra_binaries = [],
         extra_binaries_non_windows = [],
-        run_tests_with_wine_exec = False):
+        run_tests_with_wine_exec = False,
+        unit_test_platform_timeouts = {}):
     """Defines a Rust crate with library, binaries, and tests wired for Bazel + Cargo parity.
 
     The macro mirrors Cargo conventions: it builds a library when `src/` exists,
@@ -341,6 +364,10 @@ def codex_rust_crate(
         run_tests_with_wine_exec: Boolean, defaults to False. Whether to emit a
             Wine-exec variant for each integration test. Variants inherit the
             native test's timeout, tags, and shard count.
+        unit_test_platform_timeouts: Mapping from select conditions to unit-suite
+            timeout strings. The fallback is unit_test_timeout, unless the map
+            supplies //conditions:default. Compatible variants share one compiled
+            test binary and the original label runs them through a test suite.
     """
     test_env = {
         # The launcher resolves an absolute workspace root at runtime so
@@ -453,8 +480,9 @@ def codex_rust_crate(
             unit_test_kwargs["shard_count"] = unit_test_shard_count
             unit_test_kwargs["flaky"] = True
 
-        workspace_root_test(
+        _platform_unit_tests(
             name = unit_test_name,
+            unit_test_platform_timeouts = unit_test_platform_timeouts,
             env = test_env,
             runfile_env = {
                 binary: "CARGO_BIN_EXE_" + Label(binary).name
