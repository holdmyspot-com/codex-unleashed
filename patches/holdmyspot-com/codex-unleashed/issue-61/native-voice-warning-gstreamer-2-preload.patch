From 4d80ab1994690002e40b942d786d0ecde2e68fcf Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Wed, 14 Oct 2026 13:13:33 +0000
Subject: [PATCH] Guard the GStreamer option-parsing preload callback

Track native warning enforcement in #61. Apply after the documented native
voice prerequisites; keep all compiler and linker checks enabled.

Reproduction evidence: native-gstreamer-quarks-green.log. The actual native recipe reports the
missing outcome under LLVM 23. Runtime and fresh emitted-queue acceptance
are recorded separately; an internal authoring commit is not full CI acceptance.
---
 third_party/voice/prepare_sources.py | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/third_party/voice/prepare_sources.py b/third_party/voice/prepare_sources.py
index a5cc136f8..708f595e1 100644
--- a/third_party/voice/prepare_sources.py
+++ b/third_party/voice/prepare_sources.py
@@ -204,6 +204,26 @@ def extract_source(source: Source, archives: Path, destination: Path) -> None:
             contents = contents.replace(assignment, "(void) g_quark_from_static_string")
         pad.write_text(contents, encoding="utf-8")
 
+        # WORKAROUND: the preload callback shares its caller's feature guard.
+        # https://github.com/holdmyspot-com/codex-unleashed/issues/61
+        # Remove when GStreamer guards this option-parsing-only implementation.
+        registry = destination / source.root / "gst/gstregistry.c"
+        contents = registry.read_text(encoding="utf-8")
+        for original, replacement in (
+            (
+                "static void\nload_plugin_func (",
+                "#ifndef GST_DISABLE_OPTION_PARSING\nstatic void\nload_plugin_func (",
+            ),
+            (
+                "}\n\nchar *\npriv_gst_get_relocated_libgstreamer",
+                "}\n#endif\n\nchar *\npriv_gst_get_relocated_libgstreamer",
+            ),
+        ):
+            if contents.count(original) != 1:
+                raise ValueError("Pinned GStreamer preload callback does not match")
+            contents = contents.replace(original, replacement)
+        registry.write_text(contents, encoding="utf-8")
+
     if source.name == "ninja" and source.version == "1.13.2":
         # WORKAROUND: the pinned Ninja lacks an explicit bundled-lexer mode.
         # https://github.com/holdmyspot-com/codex-unleashed/issues/61
