From bc11f7bf4d3104f73469bc6e6097791938b88d93 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Fri, 16 Oct 2026 12:19:46 -0400
Subject: [PATCH] Resolve build-info test executables through Cargo/Bazel
 runfiles

Native Windows job 117012089532 reproduces NotFound for the compile-time rlocation path. Use the maintained cargo_bin resolver without changing the version or provider assertions. Focused local build_info test: 2 passed. Native Windows and fresh emitted queue acceptance remain required; see native-ci-batch-gZETbn/ownership.json.
---
 codex-rs/cli/tests/build_info.rs | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/codex-rs/cli/tests/build_info.rs b/codex-rs/cli/tests/build_info.rs
index 721910c06..4b2aeaf46 100644
--- a/codex-rs/cli/tests/build_info.rs
+++ b/codex-rs/cli/tests/build_info.rs
@@ -1,8 +1,10 @@
 use std::process::Command;
 
+use codex_utils_cargo_bin::cargo_bin;
+
 #[test]
 fn version_identifies_codex_unleashed_build() {
-    let output = Command::new(env!("CARGO_BIN_EXE_codex"))
+    let output = Command::new(cargo_bin("codex").expect("resolve codex executable"))
         .arg("--version")
         .output()
         .expect("run codex --version");
@@ -22,7 +24,7 @@ fn version_identifies_codex_unleashed_build() {
 
 #[test]
 fn build_info_reports_upstream_and_provider() {
-    let output = Command::new(env!("CARGO_BIN_EXE_codex"))
+    let output = Command::new(cargo_bin("codex").expect("resolve codex executable"))
         .arg("--build-info")
         .output()
         .expect("run codex --build-info");
-- 
