From fa7b0b8394309a6a37b1bc362890f8cbda162557 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Thu, 15 Oct 2026 21:40:51 -0400
Subject: [PATCH] Keep bundled Opus library search paths valid during

Preserve compilation fixes without warning-only source backports.
---
 MODULE.bazel                                 |  4 ++++
 patches/BUILD.bazel                          |  1 +
 patches/opusic_sys_library_directories.patch | 21 ++++++++++++++++++++
 3 files changed, 26 insertions(+)
 create mode 100644 patches/opusic_sys_library_directories.patch

diff --git a/MODULE.bazel b/MODULE.bazel
index 58560000c..6cc37c270 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -705,6 +705,10 @@ crate.annotation(
         "@rules_foreign_cc//toolchains:current_cmake_toolchain",
     ],
     crate = "opusic-sys",
+    patch_args = ["-p1"],
+    # WORKAROUND: https://github.com/holdmyspot-com/codex-unleashed/issues/61
+    # Remove when opusic-sys emits only installed library search directories.
+    patches = ["//patches:opusic_sys_library_directories.patch"],
 )

 # The musl CLI's allocator needs declared native tools and consistent header flags.
diff --git a/patches/BUILD.bazel b/patches/BUILD.bazel
index 30ef25eb7..41865e317 100644
--- a/patches/BUILD.bazel
+++ b/patches/BUILD.bazel
@@ -1,4 +1,5 @@
 exports_files([
+    "opusic_sys_library_directories.patch",
     "make_getopt_prototypes.patch",
     "make_compiler_warnings.patch",
     "rules_foreign_cc_meson_runfiles.patch",
diff --git a/patches/opusic_sys_library_directories.patch b/patches/opusic_sys_library_directories.patch
new file mode 100644
index 000000000..3f5620395
--- /dev/null
+++ b/patches/opusic_sys_library_directories.patch
@@ -0,0 +1,21 @@
+From 41fe6b2a890c1c276f4c7116d22ec33220da1f1f Mon Sep 17 00:00:00 2001
+From: Gili Tzabari <cowwoc2020@gmail.com>
+Date: Wed, 14 Oct 2026 23:58:06 +0000
+Subject: [PATCH] Emit the optional Opus lib64 directory only when installed
+
+A Linux build-script executor can target Darwin. Its host cfg currently emits a missing lib64 directory even though CMake installs to lib, and Darwin fatal linker diagnostics reject that path. Preserve installed lib64 compatibility without emitting nonexistent directories.
+---
+ build.rs | 4 +++-
+ 1 file changed, 3 insertions(+), 1 deletion(-)
+
+diff --git a/build.rs b/build.rs
+index 6e6cae4..77e43af 100644
+--- a/build.rs
++++ b/build.rs
+@@ -248,3 +248,5 @@ fn build() {
+         out_dir.push("lib64");
+-        println!("cargo:rustc-link-search=native={}", out_dir.display());
++        if out_dir.is_dir() {
++            println!("cargo:rustc-link-search=native={}", out_dir.display());
++        }
+     }
