From acae43cdebfe0536ead78180e3191a558e0f5e69 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Thu, 15 Oct 2026 08:36:29 -0400
Subject: [PATCH] Select the GNU Make C dialect without a conflicting default

The native MSVC action test reproduces both /std:c17 and /std:c11 before the fix and passes with exactly /std:c11 and /WX after it. Reuse the AWS-LC native C-standard assertion fixture from the preceding patch.
---
 MODULE.bazel                          |  1 +
 patches/BUILD.bazel                   |  1 +
 patches/make_c_standard.patch         | 26 ++++++++++++++++++++++++++
 tools/build-warnings/make/BUILD.bazel |  6 ++++++
 4 files changed, 34 insertions(+)
 create mode 100644 patches/make_c_standard.patch
 create mode 100644 tools/build-warnings/make/BUILD.bazel

diff --git a/MODULE.bazel b/MODULE.bazel
index 97703d27f..2becee37f 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -219,8 +219,9 @@ single_version_override(
     patches = [
         "//patches:make_compiler_warnings.patch",
         "//patches:make_source_warnings.patch",
         "//patches:make_getopt_prototypes.patch",
+        "//patches:make_c_standard.patch",
     ],
 )

 bazel_dep(name = "rules_python", version = "2.4.2")
diff --git a/patches/BUILD.bazel b/patches/BUILD.bazel
index e53bd694e..1a29d72de 100644
--- a/patches/BUILD.bazel
+++ b/patches/BUILD.bazel
@@ -1,5 +1,6 @@
 exports_files([
+    "make_c_standard.patch",
     "rules_rust_wrapper_parameter_files.patch",
     "aws_lc_c_standard.patch",
     "rules_rust_cargo_c_standard.patch",
     "xz_windows_driver_flags.patch",
diff --git a/patches/make_c_standard.patch b/patches/make_c_standard.patch
new file mode 100644
index 000000000..aacf4ac29
--- /dev/null
+++ b/patches/make_c_standard.patch
@@ -0,0 +1,26 @@
+From d41e04d6df10713e1b87a78a874ca5cf68c55174 Mon Sep 17 00:00:00 2001
+From: Gili Tzabari <cowwoc2020@gmail.com>
+Date: Thu, 15 Oct 2026 12:31:16 +0000
+Subject: [PATCH] Select the GNU Make C dialect exactly once
+
+---
+ BUILD.bazel | 4 ++++
+ 1 file changed, 4 insertions(+)
+
+diff --git a/BUILD.bazel b/BUILD.bazel
+index 28c1222..d6de7dc 100755
+--- a/BUILD.bazel
++++ b/BUILD.bazel
+@@ -569,8 +569,12 @@ cc_binary(
+         ],
+         "//conditions:default": ["src/posixos.c"] + POSIX_LIB_SRCS + POSIX_LIB_HDRS,
+     }),
+     copts = _COPTS,
++    # WORKAROUND: https://github.com/holdmyspot-com/codex-unleashed/issues/61
++    # Make selects its C11 dialect explicitly. Remove when the BCR overlay
++    # also disables the toolchain's conflicting default C-standard feature.
++    features = ["-default_c_std"],
+     includes = [
+         "lib",
+         "src",
+     ] + select({
diff --git a/tools/build-warnings/make/BUILD.bazel b/tools/build-warnings/make/BUILD.bazel
new file mode 100644
index 000000000..e86dcdb5d
--- /dev/null
+++ b/tools/build-warnings/make/BUILD.bazel
@@ -0,0 +1,6 @@
+load("//tools/build-warnings/aws-lc:standard_flags_test.bzl", "native_c_standard_test")
+
+native_c_standard_test(
+    name = "standard_test",
+    target_under_test = "@make//:make",
+)
