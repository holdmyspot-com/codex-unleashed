From c828c8961a48251ab1d7f8277b79600e17c11445 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Thu, 15 Oct 2026 21:16:55 -0400
Subject: [PATCH] Resolve V8 Python dependencies for every execution platform

Preserve functional changes without warning-only dependency patches.
---
 MODULE.bazel                                  |  1 +
 patches/v8_python_execution_platforms.patch   | 25 +++++++++++++++++++
 .../v8/check-python-platforms.sh              |  9 ++++++-
 3 files changed, 34 insertions(+), 1 deletion(-)
 create mode 100644 patches/v8_python_execution_platforms.patch

diff --git a/MODULE.bazel b/MODULE.bazel
index 440d6bf2c..90087cb37 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -922,2 +922,3 @@ archive_override(
         "//patches:v8_module_deps.patch",
+        "//patches:v8_python_execution_platforms.patch",
         "//patches:v8_bazel_rules.patch",
diff --git a/patches/v8_python_execution_platforms.patch b/patches/v8_python_execution_platforms.patch
new file mode 100644
index 000000000..b0dd70fe9
--- /dev/null
+++ b/patches/v8_python_execution_platforms.patch
@@ -0,0 +1,25 @@
+From 4bda00b2315819f24b0973c0d95bcfe716b75b6f Mon Sep 17 00:00:00 2001
+From: Gili Tzabari <cowwoc2020@gmail.com>
+Date: Thu, 15 Oct 2026 09:02:45 +0000
+Subject: [PATCH] Provide V8 Python wheels for ARM remote execution and both
+ Macs
+
+---
+ MODULE.bazel | 3 +++
+ 1 file changed, 3 insertions(+)
+
+diff --git a/orig/v8-15.0.245.2/MODULE.bazel b/mod/v8-15.0.245.2/MODULE.bazel
+index 7eee9b7..fe6e8a5 100644
+--- a/orig/v8-15.0.245.2/MODULE.bazel
++++ b/mod/v8-15.0.245.2/MODULE.bazel
+@@ -75,7 +75,10 @@ pip.parse(
+     requirements_lock = "//:bazel/requirements.txt",
+     target_platforms = [
+         "{os}_{arch}",
++        "linux_aarch64",
+         "linux_x86_64",
++        "osx_aarch64",
++        "osx_x86_64",
+         "windows_x86_64",
+     ],
+     extra_pip_args = [
diff --git a/tools/build-warnings/v8/check-python-platforms.sh b/tools/build-warnings/v8/check-python-platforms.sh
index 2826737ae..3e51fd6ff 100755
--- a/tools/build-warnings/v8/check-python-platforms.sh
+++ b/tools/build-warnings/v8/check-python-platforms.sh
@@ -6,3 +6,10 @@ cd -- "$repo_root"

-for platform in //:rbe //:windows_x86_64_gnullvm; do
+platforms=(
+    //:rbe
+    //:windows_x86_64_gnullvm
+    @rules_rs//rs/platforms:aarch64-unknown-linux-gnu
+    @rules_rs//rs/platforms:x86_64-apple-darwin
+    @rules_rs//rs/platforms:aarch64-apple-darwin
+)
+for platform in "${platforms[@]}"; do
     bazel cquery "$@" "--platforms=$platform" @v8//:code_generator
