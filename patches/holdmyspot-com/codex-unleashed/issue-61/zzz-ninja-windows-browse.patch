From 848893976c9ff1817e64a10b37ec8fd87d64296f Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Thu, 15 Oct 2026 10:27:55 +0000
Subject: [PATCH] Keep Ninja Unix browse probes off Windows targets

The pinned Ninja browse implementation requires fork and pipe. Stop configuration probes at the Windows platform boundary instead of diagnosing the expected absence of Unix capabilities as a warning.

Regression: executing the pinned browse function through source preparation fails when a Windows target invokes a Unix probe. It passes with the platform guard, preserves Unix browse support, and retains the warning for missing Unix capabilities. All six source-preparation tests pass with CMake 4.4.4. Native Windows compilation remains a separate hosted gate.
---
 third_party/voice/prepare_sources.py          | 16 ++++++
 third_party/voice/test_prepare_sources.py     | 50 +++++++++++++++++++
 third_party/voice/testdata/ninja-browse.cmake | 43 ++++++++++++++++
 3 files changed, 109 insertions(+)
 create mode 100644 third_party/voice/testdata/ninja-browse.cmake

diff --git a/third_party/voice/prepare_sources.py b/third_party/voice/prepare_sources.py
index 6075c3e51..8f43f1602 100644
--- a/third_party/voice/prepare_sources.py
+++ b/third_party/voice/prepare_sources.py
@@ -456,8 +456,24 @@ def extract_source(source: Source, archives: Path, destination: Path) -> None:
         if contents.count(original) != 1:
             raise ValueError("Pinned Ninja lexer configuration does not match")
         cmake.write_text(contents.replace(original, replacement), encoding="utf-8")

+        # WORKAROUND: Ninja's browse implementation requires Unix process APIs.
+        # https://github.com/holdmyspot-com/codex-unleashed/issues/61
+        # Remove when Ninja excludes Windows from its Unix browse probes.
+        contents = cmake.read_text(encoding="utf-8")
+        original = "function(check_platform_supports_browse_mode RESULT)\n"
+        replacement = (
+            original
+            + "\tif(WIN32)\n"
+            + '\t\tset(${RESULT} "0" PARENT_SCOPE)\n'
+            + "\t\treturn()\n"
+            + "\tendif()\n"
+        )
+        if contents.count(original) != 1:
+            raise ValueError("Pinned Ninja browse configuration does not match")
+        cmake.write_text(contents.replace(original, replacement), encoding="utf-8")
+
     if source.name == "libffi" and source.version == "3.8.0":
         # WORKAROUND: libffi calls its deprecated public Java raw API internally.
         # https://github.com/holdmyspot-com/codex-unleashed/issues/61
         # Remove when libffi uses internal helpers for these entry points.
diff --git a/third_party/voice/test_prepare_sources.py b/third_party/voice/test_prepare_sources.py
index 60edb72ba..e86131c6a 100644
--- a/third_party/voice/test_prepare_sources.py
+++ b/third_party/voice/test_prepare_sources.py
@@ -3,8 +3,10 @@
 import hashlib
 import io
 import json
 from pathlib import Path
+import shutil
+import subprocess
 import tarfile
 import tempfile
 import unittest
 from unittest.mock import patch
@@ -120,4 +122,52 @@ class PreparationTests(unittest.TestCase):
         self.assertEqual(
             {p.name: p.read_text() for p in self.output.iterdir()},
             {"keep": "unchanged"},
         )
+
+    def test_ninja_browse_probes_only_run_for_unix_targets(self):
+        cmake = shutil.which("cmake")
+        if cmake is None:
+            self.skipTest("Requires CMake")
+        fixture = Path(__file__).with_name("testdata") / "ninja-browse.cmake"
+        source = self.source(
+            [("fixture-1/CMakeLists.txt", tarfile.REGTYPE, fixture.read_bytes())]
+        )
+        source.update(name="ninja", version="1.13.2")
+        self.prepare(source)
+        contents = (self.output / source["root"] / "CMakeLists.txt").read_text()
+        start = contents.index("function(check_platform_supports_browse_mode RESULT)")
+        end = contents.index("endfunction()", start) + len("endfunction()")
+        browse_function = contents[start:end]
+        for windows, symbols, expected, warning in (
+            ("TRUE", "FALSE", "0", False),
+            ("FALSE", "TRUE", "1", False),
+            ("FALSE", "FALSE", "0", True),
+        ):
+            with self.subTest(windows=windows, symbols=symbols):
+                script = self.root / f"browse-{windows}.cmake"
+                script.write_text(
+                    "cmake_minimum_required(VERSION 3.15)\n"
+                    f"set(WIN32 {windows})\n"
+                    "function(execute_process)\n"
+                    "  if(WIN32)\n"
+                    '    message(FATAL_ERROR "Unix browse probe ran for Windows")\n'
+                    "  endif()\n"
+                    '  set(inline_result "0" PARENT_SCOPE)\nendfunction()\n'
+                    "function(check_symbol_exists symbol header result)\n"
+                    "  if(WIN32)\n"
+                    '    message(FATAL_ERROR "Unix symbol probe ran for Windows")\n'
+                    "  endif()\n"
+                    f'  set(${{result}} "{symbols}" PARENT_SCOPE)\nendfunction()\n'
+                    + browse_function
+                    + "\ncheck_platform_supports_browse_mode(browse)\n"
+                    + f'if(NOT browse STREQUAL "{expected}")\n'
+                    + '  message(FATAL_ERROR "Unexpected browse support: ${browse}")\nendif()\n'
+                )
+                result = subprocess.run(
+                    [cmake, "-P", script],
+                    capture_output=True,
+                    text=True,
+                    check=False,
+                )
+                self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+                self.assertEqual("Warning" in result.stderr, warning, result.stderr)
diff --git a/third_party/voice/testdata/ninja-browse.cmake b/third_party/voice/testdata/ninja-browse.cmake
new file mode 100644
index 000000000..f0c61818a
--- /dev/null
+++ b/third_party/voice/testdata/ninja-browse.cmake
@@ -0,0 +1,43 @@
+# Fixture from ninja-build/ninja commit 3441b633c2fe2c494e958780ba0f4227b1327634.
+set(RE2C_MAJOR_VERSION 0)
+find_program(RE2C re2c)
+if(RE2C)
+	execute_process(COMMAND "${RE2C}" --vernum OUTPUT_VARIABLE RE2C_RAW_VERSION)
+	math(EXPR RE2C_MAJOR_VERSION "${RE2C_RAW_VERSION} / 10000")
+endif()
+if(${RE2C_MAJOR_VERSION} GREATER 1)
+endif()
+
+function(check_platform_supports_browse_mode RESULT)
+	# Make sure the inline.sh script works on this platform.
+	# It uses the shell commands such as 'od', which may not be available.
+
+	execute_process(
+		COMMAND sh -c "echo 'TEST' | src/inline.sh var"
+		WORKING_DIRECTORY ${PROJECT_SOURCE_DIR}
+		RESULT_VARIABLE inline_result
+		OUTPUT_QUIET
+		ERROR_QUIET
+	)
+	if(NOT inline_result EQUAL "0")
+		# The inline script failed, so browse mode is not supported.
+		set(${RESULT} "0" PARENT_SCOPE)
+		if(NOT WIN32)
+			message(WARNING "browse feature omitted due to inline script failure")
+		endif()
+		return()
+	endif()
+
+	# Now check availability of the unistd header
+	check_symbol_exists(fork "unistd.h" HAVE_FORK)
+	check_symbol_exists(pipe "unistd.h" HAVE_PIPE)
+	set(browse_supported 0)
+	if (HAVE_FORK AND HAVE_PIPE)
+		set(browse_supported 1)
+	endif ()
+	set(${RESULT} "${browse_supported}" PARENT_SCOPE)
+	if(NOT browse_supported)
+		message(WARNING "browse feature omitted due to missing `fork` and `pipe` functions")
+	endif()
+
+endfunction()
