diff --git a/tools/build-warnings/v8/flags_test.bzl b/tools/build-warnings/v8/flags_test.bzl
new file mode 100644
index 000000000..f7fad417b
--- /dev/null
+++ b/tools/build-warnings/v8/flags_test.bzl
@@ -0,0 +1,30 @@
+load("@bazel_skylib//lib:unittest.bzl", "analysistest", "asserts")
+
+def _windows_cpp_flags_test_impl(ctx):
+    env = analysistest.begin(ctx)
+    actions = [
+        action
+        for action in analysistest.target_actions(env)
+        if action.mnemonic == "CppCompile" and any([arg.endswith(".cc") for arg in action.argv])
+    ]
+    asserts.true(env, len(actions) > 0, "The fixture must compile C++ sources")
+    for action in actions:
+        standard_flags = [arg for arg in action.argv if arg.startswith("/std:")]
+        asserts.equals(env, ["/std:c++20"], standard_flags[-1:], "CL actions select C++20")
+        compiler = action.argv[0].replace("\\", "/").split("/")[-1]
+        if compiler in ["clang-cl", "clang-cl.exe"]:
+            for required in ["/EHsc", "/GR", "/GS"]:
+                asserts.true(env, required in action.argv, "clang-cl retains %s" % required)
+        else:
+            asserts.equals(env, ["/std:c++20"], standard_flags, "MSVC selects its standard once")
+        incompatible_flags = [arg for arg in action.argv if arg.startswith("-std=") or arg.startswith("-Wno-")]
+        asserts.equals(env, [], incompatible_flags, "CL compile actions must use CL flag syntax")
+    return analysistest.end(env)
+
+windows_cpp_flags_test = analysistest.make(
+    _windows_cpp_flags_test_impl,
+    config_settings = {
+        "//command_line_option:platforms": str(Label("//:windows_x86_64_msvc")),
+        "//command_line_option:features": ["static_link_msvcrt", "-dynamic_link_msvcrt"],
+    },
+)
