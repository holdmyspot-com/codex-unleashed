From f42f1d6d854bc687c2e0cf922d54f4dc48cc010d Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Thu, 15 Oct 2026 18:04:56 -0400
Subject: [PATCH] Make the native GLib positional printf probe warning-free

The checksum-pinned GLib configure probe contains invalid C dollar escapes and uses sprintf, which is deprecated on Darwin. Use snprintf with the buffer bound and standard positional format spelling. A focused probe extracts and executes the actual configure source; it fails on the baseline unknown escape diagnostics and passes after preparation with GCC fatal warnings. The public GLib printf test also requires positional output 2 3 1. Full native-prefix platform builds remain acceptance gates.
---
 third_party/voice/prepare_sources.py          | 11 ++++++
 .../build-warnings/glib/printf_probe_test.py  | 35 +++++++++++++++++++
 tools/build-warnings/glib/printf_test.c       |  4 +++
 3 files changed, 50 insertions(+)
 create mode 100644 tools/build-warnings/glib/printf_probe_test.py

diff --git a/third_party/voice/prepare_sources.py b/third_party/voice/prepare_sources.py
index 39d8e23a7..e700d33f3 100644
--- a/third_party/voice/prepare_sources.py
+++ b/third_party/voice/prepare_sources.py
@@ -144,6 +144,17 @@ def extract_source(source: Source, archives: Path, destination: Path) -> None:
         compiler.write_text(contents, encoding="utf-8")

     if source.name == "glib" and source.version == "2.88.3":
+        # WORKAROUND: https://github.com/holdmyspot-com/codex-unleashed/issues/61
+        # Invalid C escapes and deprecated sprintf break the positional printf probe.
+        # Remove when GLib's probe compiles with warnings treated as errors.
+        meson = destination / source.root / "meson.build"
+        contents = meson.read_text(encoding="utf-8")
+        original = r'  sprintf (buffer, "%2\$d %3\$d %1\$d", 1, 2, 3);'
+        replacement = '  snprintf (buffer, sizeof buffer, "%2$d %3$d %1$d", 1, 2, 3);'
+        if contents.count(original) != 1:
+            raise ValueError("Pinned GLib positional printf probe does not match")
+        meson.write_text(contents.replace(original, replacement), encoding="utf-8")
+
         # WORKAROUND: GLib's bundled gnulib has incomplete warning portability.
         # https://github.com/holdmyspot-com/codex-unleashed/issues/61
         # Remove when its printf fallback uses the portable annotation and casts.
diff --git a/tools/build-warnings/glib/printf_probe_test.py b/tools/build-warnings/glib/printf_probe_test.py
new file mode 100644
index 000000000..2489ea5d4
--- /dev/null
+++ b/tools/build-warnings/glib/printf_probe_test.py
@@ -0,0 +1,35 @@
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+
+parser = argparse.ArgumentParser(
+    description="Compile and run the prepared GLib positional printf probe."
+)
+parser.add_argument("source", type=Path, help="Prepared GLib source directory")
+parser.add_argument("compiler", help="Native C compiler")
+arguments = parser.parse_args()
+
+meson = (arguments.source / "meson.build").read_text(encoding="utf-8")
+start = meson.index("  printf_unix98_test_code = '''")
+start = meson.index("'''", start) + 3
+end = meson.index("'''", start)
+
+with tempfile.TemporaryDirectory(prefix="glib-printf-probe-") as directory:
+    source = Path(directory) / "probe.c"
+    executable = Path(directory) / "probe.exe"
+    source.write_text(meson[start:end], encoding="utf-8")
+    subprocess.run(
+        [
+            arguments.compiler,
+            "-Wall",
+            "-Wextra",
+            "-Werror",
+            str(source),
+            "-o",
+            str(executable),
+        ],
+        check=True,
+    )
+    subprocess.run([str(executable)], check=True)
diff --git a/tools/build-warnings/glib/printf_test.c b/tools/build-warnings/glib/printf_test.c
index c1434879c..fa5b91700 100644
--- a/tools/build-warnings/glib/printf_test.c
+++ b/tools/build-warnings/glib/printf_test.c
@@ -18,5 +18,9 @@ int main(void) {
   }
   valid = valid && strcmp(result + 4099, "tail") == 0;
   g_free(result);
+
+  result = g_strdup_printf("%2$d %3$d %1$d", 1, 2, 3);
+  valid = valid && strcmp(result, "2 3 1") == 0;
+  g_free(result);
   return valid ? 0 : 1;
 }
--
2.43.0
