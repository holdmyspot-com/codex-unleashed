diff --git a/patches/rules_rust_cargo_runtime_flags.patch b/patches/rules_rust_cargo_runtime_flags.patch
new file mode 100644
index 000000000..94a202ce0
--- /dev/null
+++ b/patches/rules_rust_cargo_runtime_flags.patch
@@ -0,0 +1,69 @@
+From d345752def8f4e25f05978930844afc2ad3a058b Mon Sep 17 00:00:00 2001
+From: Gili Tzabari <cowwoc2020@gmail.com>
+Date: Thu, 15 Oct 2026 19:45:06 -0400
+Subject: [PATCH] Query Cargo target features with configured Rust runtime
+ flags
+
+---
+ cargo/private/cargo_build_script.bzl          |  4 ++-
+ .../private/cargo_build_script_runner/bin.rs  | 27 ++++++++++++++-----
+ 2 files changed, 24 insertions(+), 7 deletions(-)
+
+diff --git a/cargo/private/cargo_build_script.bzl b/cargo/private/cargo_build_script.bzl
+index 3865418..ad1007b 100644
+--- a/cargo/private/cargo_build_script.bzl
++++ b/cargo/private/cargo_build_script.bzl
+@@ -603,10 +603,12 @@ def _cargo_build_script_impl(ctx):
+
+     # Inform build scripts of rustc flags
+     # https://github.com/rust-lang/cargo/issues/9600
++    # WORKAROUND: https://github.com/holdmyspot-com/codex-unleashed/issues/61
++    # Remove when build-script flags include the toolchain's target runtime.
+     env["CARGO_ENCODED_RUSTFLAGS"] = "\\x1f".join([
+         # Allow build scripts to locate the generated sysroot
+         "--sysroot=${{pwd}}/{}".format(toolchain.sysroot),
+-    ] + ctx.attr.rustc_flags)
++    ] + (toolchain.extra_exec_rustc_flags if is_exec_configuration(ctx) else toolchain.extra_rustc_flags) + ctx.attr.rustc_flags)
+
+     for f in ctx.attr.crate_features:
+         env["CARGO_FEATURE_" + f.upper().replace("-", "_")] = "1"
+diff --git a/cargo/private/cargo_build_script_runner/bin.rs b/cargo/private/cargo_build_script_runner/bin.rs
+index 140f535..a235b88 100644
+--- a/cargo/private/cargo_build_script_runner/bin.rs
++++ b/cargo/private/cargo_build_script_runner/bin.rs
+@@ -472,12 +472,27 @@ impl Args {
+
+ fn get_target_env_vars<P: AsRef<Path>>(rustc: &P) -> Result<BTreeMap<String, String>, String> {
+     // As done by Cargo when constructing a cargo::core::compiler::build_context::target_info::TargetInfo.
+-    let output = Command::new(rustc.as_ref())
+-        .arg("--print=cfg")
+-        .arg(format!(
+-            "--target={}",
+-            env::var("TARGET").expect("missing TARGET")
+-        ))
++    let mut command = Command::new(rustc.as_ref());
++    command.arg("--print=cfg").arg(format!(
++        "--target={}",
++        env::var("TARGET").expect("missing TARGET")
++    ));
++
++    // WORKAROUND: https://github.com/holdmyspot-com/codex-unleashed/issues/61
++    // Remove when the runner queries cfg with the configured Rust flags.
++    // Native build scripts use crt-static to select the matching C runtime.
++    if let Ok(encoded_flags) = env::var("CARGO_ENCODED_RUSTFLAGS") {
++        if !encoded_flags.is_empty() {
++            let exec_root = env::current_dir()
++                .map_err(|err| format!("Error resolving Rust flag paths: {err}"))?;
++            let flags = encoded_flags
++                .replace("\\x1f", "\x1f")
++                .replace("${pwd}", &exec_root.to_string_lossy());
++            command.args(flags.split('\x1f'));
++        }
++    }
++
++    let output = command
+         .output()
+         .map_err(|err| format!("Error running rustc to get target information: {err}"))?;
+     if !output.status.success() {
+--
+2.43.0
diff --git a/tools/build-warnings/cargo-runtime/BUILD.bazel b/tools/build-warnings/cargo-runtime/BUILD.bazel
new file mode 100644
index 000000000..7d8dbc9be
--- /dev/null
+++ b/tools/build-warnings/cargo-runtime/BUILD.bazel
@@ -0,0 +1,57 @@
+load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
+load("@rules_rust//rust:defs.bzl", "rust_test")
+load(":flags_test.bzl", "runtime_flags_test")
+
+runtime_flags_test(
+    name = "toolchain_flags_test",
+    size = "small",
+    target_under_test = ":toolchain_probe",
+)
+
+cargo_build_script(
+    name = "toolchain_probe",
+    testonly = True,
+    srcs = ["empty.rs"],
+    edition = "2024",
+)
+
+[
+    cargo_build_script(
+        name = mode + "_build_script",
+        testonly = True,
+        srcs = ["build.rs"],
+        build_script_env = {
+            "CARGO_ENCODED_RUSTFLAGS": "-C\\x1ftarget-feature=" + feature + "crt-static",
+            "EXPECT_CRT_STATIC": expected,
+        },
+        edition = "2024",
+        target_compatible_with = select({
+            "@platforms//os:linux": [],
+            "@platforms//os:windows": [],
+            "//conditions:default": ["@platforms//:incompatible"],
+        }),
+    )
+    for mode, expected, feature in [
+        ("static", "true", "+"),
+        ("dynamic", "false", "-"),
+    ]
+]
+
+[
+    rust_test(
+        name = mode + "_runtime_test",
+        size = "small",
+        srcs = ["runtime.rs"],
+        edition = "2024",
+        target_compatible_with = select({
+            "@platforms//os:linux": [],
+            "@platforms//os:windows": [],
+            "//conditions:default": ["@platforms//:incompatible"],
+        }),
+        deps = [":" + mode + "_build_script"],
+    )
+    for mode in [
+        "static",
+        "dynamic",
+    ]
+]
diff --git a/tools/build-warnings/cargo-runtime/build.rs b/tools/build-warnings/cargo-runtime/build.rs
new file mode 100644
index 000000000..ae1b41f40
--- /dev/null
+++ b/tools/build-warnings/cargo-runtime/build.rs
@@ -0,0 +1,10 @@
+fn main() {
+    let expected: bool = std::env::var("EXPECT_CRT_STATIC").unwrap().parse().unwrap();
+    let features = std::env::var("CARGO_CFG_TARGET_FEATURE").unwrap();
+    let actual = features.split(',').any(|feature| feature == "crt-static");
+    assert_eq!(
+        actual, expected,
+        "build-script target features must match configured Rust flags"
+    );
+    println!("cargo:rustc-env=RUNTIME_FEATURE_VERIFIED=true");
+}
