diff --git a/tools/build-warnings/cargo-runtime/flags_test.bzl b/tools/build-warnings/cargo-runtime/flags_test.bzl
new file mode 100644
index 000000000..2b7a0b4df
--- /dev/null
+++ b/tools/build-warnings/cargo-runtime/flags_test.bzl
@@ -0,0 +1,18 @@
+load("@bazel_skylib//lib:unittest.bzl", "analysistest", "asserts")
+
+def _runtime_flags_test_impl(ctx):
+    env = analysistest.begin(ctx)
+    actions = [action for action in analysistest.target_actions(env) if action.mnemonic == "CargoBuildScriptRun"]
+    asserts.equals(env, 1, len(actions), "The fixture runs one Cargo build script")
+    for action in actions:
+        flags = action.env["CARGO_ENCODED_RUSTFLAGS"].split("\\x1f")
+        asserts.true(env, "-Ctarget-feature=+crt-static" in flags, "Build scripts receive the configured MSVC toolchain runtime flag")
+    return analysistest.end(env)
+
+runtime_flags_test = analysistest.make(
+    _runtime_flags_test_impl,
+    config_settings = {
+        "//command_line_option:platforms": str(Label("//:windows_x86_64_msvc")),
+        "//command_line_option:extra_toolchains": [str(Label("//tools/build-warnings/assembly/native:analysis_toolchain"))],
+    },
+)
diff --git a/tools/build-warnings/cargo-runtime/runtime.rs b/tools/build-warnings/cargo-runtime/runtime.rs
new file mode 100644
index 000000000..e4f97487f
--- /dev/null
+++ b/tools/build-warnings/cargo-runtime/runtime.rs
@@ -0,0 +1,4 @@
+#[test]
+fn build_script_verifies_runtime_feature() {
+    assert_eq!(env!("RUNTIME_FEATURE_VERIFIED"), "true");
+}
