From 8847305f43885af46ff18db79eb6fac18e43ba5a Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Sat, 17 Oct 2026 06:14:02 -0400
Subject: [PATCH] fix(ci): recheck shared repository cache before SDK saves

Apply the existing late-producer policy to the SDK workflow. Preserve saves
on cache misses and lookup failures, and skip archives another job created
while the SDK tests ran. Run the maintained cache policy regression in SDK CI.

Red: test-bazel-cache-save.sh .github/workflows/sdk.yml rejects the original
producer for its missing lookup and miss guard. Green: the same check verifies
one SDK producer; the existing Bazel check still verifies four producers.
Maintained just fmt-check passes. Source actionlint retains its pre-existing
SC2086 on upstream's unquoted COMMIT_SHA argument; the hosted mirror has that
argument quoted and passes actionlint. Full hosted acceptance remains pending.
---
 .github/workflows/sdk.yml | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/sdk.yml b/.github/workflows/sdk.yml
index 3f91dd18f..eac7676fd 100644
--- a/.github/workflows/sdk.yml
+++ b/.github/workflows/sdk.yml
@@ -74,6 +74,10 @@ jobs:
           target: x86_64-unknown-linux-gnu
           cache-scope: sdk
 
+      - name: Check Bazel repository cache save policy
+        shell: bash
+        run: bash .github/scripts/test-bazel-cache-save.sh .github/workflows/sdk.yml
+
       - name: Build codex and the code-mode host with Bazel
         id: build_bazel
         env:
@@ -148,9 +152,19 @@ jobs:
           uv run --only-group dev --frozen --no-sync ruff format --check .
           uv run --only-group dev --frozen --no-sync pytest
 
-      - name: Save bazel repository cache
+      - name: Recheck Bazel repository cache before saving
+        id: repository_cache_before_save
         if: always() && !cancelled() && steps.build_bazel.outcome == 'success' && steps.setup_bazel.outputs.repository-cache-hit != 'true'
         continue-on-error: true
+        uses: actions/cache/restore@668228422ae6a00e4ad889ee87cd7109ec5666a7 # v5.0.4
+        with:
+          path: ${{ steps.setup_bazel.outputs.repository-cache-path }}
+          key: ${{ steps.setup_bazel.outputs.repository-cache-key }}
+          lookup-only: true
+
+      - name: Save Bazel repository cache
+        if: always() && !cancelled() && steps.build_bazel.outcome == 'success' && steps.setup_bazel.outputs.repository-cache-hit != 'true' && steps.repository_cache_before_save.outputs.cache-hit != 'true'
+        continue-on-error: true
         uses: actions/cache/save@668228422ae6a00e4ad889ee87cd7109ec5666a7 # v5.0.4
         with:
           path: ${{ steps.setup_bazel.outputs.repository-cache-path }}
-- 
