diff --git a/patches/aws_lc_c_standard.patch b/patches/aws_lc_c_standard.patch
new file mode 100644
index 0000000..daecb1d
--- /dev/null
+++ b/patches/aws_lc_c_standard.patch
@@ -0,0 +1,100 @@
+From d3abf6cfb864e40db761d83587531c623f3655d3 Mon Sep 17 00:00:00 2001
+From: Gili Tzabari <cowwoc2020@gmail.com>
+Date: Sat, 24 Oct 2026 16:30:07 +0000
+Subject: [PATCH] config: avoid conflicting C standards in AWS-LC actions
+
+AWS-LC selects C11 explicitly, while modern MSVC toolchains also enable
+their default C17 feature. Exclude that default for targets owning a C11
+selection, retaining their other features and C++ options.
+---
+ BUILD.bazel | 14 +++++++++++++-
+ 1 file changed, 13 insertions(+), 1 deletion(-)
+
+diff --git a/BUILD.bazel b/BUILD.bazel
+index 58cac9f..202fd2c 100755
+--- a/BUILD.bazel
++++ b/BUILD.bazel
+@@ -31,6 +31,10 @@ BORINGSSL_CONLYOPTS = select({
+     "//conditions:default": ["-std=c11"],
+ })
+
++# Explicit C11 targets exclude the toolchain default, such as MSVC C17,
++# so each C compilation receives one standard flag.
++BORINGSSL_C_FEATURES = ["-default_c_std"]
++
+ BORINGSSL_CXXOPTS = select({
+     "@platforms//os:windows": [],
+     "//conditions:default": [
+@@ -228,7 +232,7 @@ cc_library(
+         ],
+     }) + BORINGSSL_COPTS,
+     cxxopts = BORINGSSL_CXXOPTS,
+-    features = ["-opt"],
++    features = ["-opt"] + BORINGSSL_C_FEATURES,
+     includes = [
+         "include",
+         "third_party/jitterentropy/jitterentropy-library",
+@@ -504,6 +508,7 @@ cc_library(
+     conlyopts = BORINGSSL_CONLYOPTS,
+     copts = COMMON_COPTS + BORINGSSL_COPTS,
+     cxxopts = BORINGSSL_CXXOPTS,
++    features = BORINGSSL_C_FEATURES,
+     implementation_deps = [
+         ":jitterentropy",
+     ],
+@@ -567,6 +572,7 @@ cc_library(
+     conlyopts = BORINGSSL_CONLYOPTS,
+     copts = COMMON_COPTS + BORINGSSL_COPTS,
+     cxxopts = BORINGSSL_CXXOPTS,
++    features = BORINGSSL_C_FEATURES,
+     includes = ["include"],
+     visibility = ["//visibility:public"],
+     deps = [
+@@ -587,6 +593,7 @@ cc_binary(
+     conlyopts = BORINGSSL_CONLYOPTS,
+     copts = COMMON_COPTS + BORINGSSL_COPTS,
+     cxxopts = BORINGSSL_CXXOPTS,
++    features = BORINGSSL_C_FEATURES,
+     includes = [
+         "include",
+         "tool",
+@@ -615,6 +622,7 @@ cc_library(
+     conlyopts = BORINGSSL_CONLYOPTS,
+     copts = TEST_COPTS + BORINGSSL_COPTS,
+     cxxopts = BORINGSSL_CXXOPTS,
++    features = BORINGSSL_C_FEATURES,
+     includes = ["include"],
+     local_defines = ["BORINGSSL_USE_BAZEL_RUNFILES"],
+     deps = [
+@@ -637,6 +645,7 @@ cc_library(
+     conlyopts = BORINGSSL_CONLYOPTS,
+     copts = TEST_COPTS + BORINGSSL_COPTS,
+     cxxopts = BORINGSSL_CXXOPTS,
++    features = BORINGSSL_C_FEATURES,
+     includes = ["crypto/test"],
+     deps = [
+         ":crypto_test_support",
+@@ -764,6 +773,7 @@ cc_test(
+     conlyopts = BORINGSSL_CONLYOPTS,
+     copts = TEST_COPTS + ["-DAWS_LC_TEST_ENV"] + BORINGSSL_COPTS,
+     cxxopts = BORINGSSL_CXXOPTS,
++    features = BORINGSSL_C_FEATURES,
+     data = CRYPTO_TEST_DATA,
+     linkstatic = True,
+     shard_count = 30,
+@@ -782,6 +792,7 @@ cc_test(
+     conlyopts = BORINGSSL_CONLYOPTS,
+     copts = TEST_COPTS + BORINGSSL_COPTS,
+     cxxopts = BORINGSSL_CXXOPTS,
++    features = BORINGSSL_C_FEATURES,
+     data = CRYPTO_TEST_DATA,
+     deps = [
+         ":crypto",
+@@ -813,6 +824,7 @@ cc_test(
+     conlyopts = BORINGSSL_CONLYOPTS,
+     copts = TEST_COPTS + BORINGSSL_COPTS,
+     cxxopts = BORINGSSL_CXXOPTS,
++    features = BORINGSSL_C_FEATURES,
+     data = CRYPTO_TEST_DATA,
+     linkstatic = True,
+     deps = [
diff --git a/tools/aws-lc-standard/BUILD.bazel b/tools/aws-lc-standard/BUILD.bazel
new file mode 100644
index 0000000..958b7b6
--- /dev/null
+++ b/tools/aws-lc-standard/BUILD.bazel
@@ -0,0 +1,91 @@
+load("@rules_cc//cc:cc_library.bzl", "cc_library")
+load("@rules_cc//cc/private/toolchain:windows_cc_toolchain_config.bzl", "cc_toolchain_config")
+load("@rules_cc//cc/toolchains:cc_toolchain.bzl", "cc_toolchain")
+load(":standard_test.bzl", "native_c_standard_test", "toolchain_default_test")
+
+filegroup(name = "empty")
+
+cc_toolchain_config(
+    name = "config",
+    abi_libc_version = "local",
+    abi_version = "local",
+    compiler = "msvc-cl",
+    cpu = "x64_windows",
+    host_system_name = "local",
+    msvc_cl_path = "cl.exe",
+    msvc_lib_path = "lib.exe",
+    msvc_link_path = "link.exe",
+    msvc_ml_path = "ml64.exe",
+    supports_parse_showincludes = True,
+    target_libc = "msvcrt",
+    target_system_name = "windows",
+    tool_paths = {
+        "gcc": "cl.exe",
+        "ld": "link.exe",
+        "ar": "lib.exe",
+        "cpp": "cl.exe",
+        "gcov": "unused",
+        "nm": "unused",
+        "objdump": "unused",
+        "strip": "unused",
+    },
+    toolchain_identifier = "native-msvc-analysis",
+)
+
+cc_toolchain(
+    name = "cc_toolchain",
+    all_files = ":empty",
+    ar_files = ":empty",
+    as_files = ":empty",
+    compiler_files = ":empty",
+    dwp_files = ":empty",
+    linker_files = ":empty",
+    objcopy_files = ":empty",
+    strip_files = ":empty",
+    supports_param_files = 1,
+    toolchain_config = ":config",
+    toolchain_identifier = "native-msvc-analysis",
+)
+
+toolchain(
+    name = "analysis_toolchain",
+    target_compatible_with = [
+        "@platforms//os:windows",
+        "@platforms//cpu:x86_64",
+        "@llvm//constraints/windows/abi:msvc",
+    ],
+    toolchain = ":cc_toolchain",
+    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
+)
+
+cc_library(
+    name = "toolchain_default",
+    srcs = ["default.c"],
+)
+
+toolchain_default_test(
+    name = "toolchain_default_test",
+    size = "small",
+    target_under_test = ":toolchain_default",
+)
+
+native_c_standard_test(
+    name = "crypto_standard_test",
+    size = "small",
+    target_under_test = "@aws-lc//:crypto",
+)
+
+native_c_standard_test(
+    name = "ssl_standard_test",
+    size = "small",
+    target_under_test = "@aws-lc//:ssl",
+)
+
+test_suite(
+    name = "standard_tests",
+    tests = [
+        ":crypto_standard_test",
+        ":ssl_standard_test",
+        ":toolchain_default_test",
+    ],
+)
