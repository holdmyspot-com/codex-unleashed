From 74b55c72f42ca130e908b2f2896bc7df44451686 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Thu, 15 Oct 2026 04:07:52 -0400
Subject: [PATCH] Align the direct strum dependency with its current derive
 macros

Upgrade the workspace strum dependency from 0.27.2 to stable 0.28.0, matching the already selected strum_macros 0.28.0. Cargo removes the older strum and strum_macros versions without adding or upgrading other external packages.

Regression: tools/build-warnings/check-enum-dependencies.sh with RUSTUP_TOOLCHAIN=stable fails with ambiguous strum versions on the prepared preceding queue (exit 101) and passes after the direct upgrade (exit 0). Maintained just fmt-check and just bazel-lock-check pass; protocol and state Bazel unit tests pass. Eight TUI failures reproduce identically in the preceding baseline; they remain local fixture/environment follow-up and are not claimed passing.

Base: rust-v0.162.1 (092d3acd6bec3e3a14bdc7e7a2810ab628ab759d), with preceding issue-61 dependency updates. Tracking: https://github.com/holdmyspot-com/codex-unleashed/issues/61
---
 MODULE.bazel.lock                             |  2 -
 codex-rs/Cargo.lock                           | 41 +++++--------------
 codex-rs/Cargo.toml                           |  2 +-
 .../build-warnings/check-enum-dependencies.sh |  7 ++++
 4 files changed, 18 insertions(+), 34 deletions(-)
 create mode 100755 tools/build-warnings/check-enum-dependencies.sh

diff --git a/MODULE.bazel.lock b/MODULE.bazel.lock
index 7e7381c86..7144c15a8 100644
--- a/MODULE.bazel.lock
+++ b/MODULE.bazel.lock
@@ -2265,5 +2265,3 @@
       "strsim_0.11.1": "{\"dependencies\":[],\"features\":{}}",
-      "strum_0.27.2": "{\"dependencies\":[{\"features\":[\"macros\"],\"name\":\"phf\",\"optional\":true,\"req\":\"^0.12\"},{\"name\":\"strum_macros\",\"optional\":true,\"req\":\"^0.27\"}],\"features\":{\"default\":[\"std\"],\"derive\":[\"strum_macros\"],\"std\":[]}}",
       "strum_0.28.0": "{\"dependencies\":[{\"features\":[\"macros\"],\"name\":\"phf\",\"optional\":true,\"req\":\"^0.13\"},{\"name\":\"strum_macros\",\"optional\":true,\"req\":\"^0.28\"}],\"features\":{\"default\":[\"std\"],\"derive\":[\"strum_macros\"],\"std\":[]}}",
-      "strum_macros_0.27.2": "{\"dependencies\":[{\"name\":\"heck\",\"req\":\"^0.5.0\"},{\"name\":\"proc-macro2\",\"req\":\"^1.0\"},{\"name\":\"quote\",\"req\":\"^1.0\"},{\"features\":[\"parsing\"],\"name\":\"syn\",\"req\":\"^2.0\"}],\"features\":{}}",
       "strum_macros_0.28.0": "{\"dependencies\":[{\"name\":\"heck\",\"req\":\"^0.5.0\"},{\"name\":\"proc-macro2\",\"req\":\"^1.0\"},{\"name\":\"quote\",\"req\":\"^1.0\"},{\"features\":[\"parsing\"],\"name\":\"syn\",\"req\":\"^2.0\"}],\"features\":{}}",
