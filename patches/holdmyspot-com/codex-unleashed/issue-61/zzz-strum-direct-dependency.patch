index 000000000..86aa1059d
--- /dev/null
+++ b/tools/build-warnings/check-enum-dependencies.sh
@@ -0,0 +1,7 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
+cd -- "$repo_root/codex-rs"
+cargo tree --locked --workspace --invert strum
+cargo tree --locked --workspace --invert strum_macros
