From ff4fd7f90f7fa52d5d18772be8d671f80c94ba69 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Thu, 15 Oct 2026 03:19:02 +0000
Subject: [PATCH] Temporarily trace Meson native compiler invocations

Diagnostic branch experiment only; print the pre-Meson LIBRARY_PATH and enable verbose compiler output without weakening warnings or changing runtime dependencies.
---
 ...s_foreign_cc_meson_setup_diagnostics.patch | 52 ++++++++++++++++---
 1 file changed, 44 insertions(+), 8 deletions(-)

diff --git a/patches/rules_foreign_cc_meson_setup_diagnostics.patch b/patches/rules_foreign_cc_meson_setup_diagnostics.patch
index 33863de94..a70a8a1b6 100644
--- a/patches/rules_foreign_cc_meson_setup_diagnostics.patch
+++ b/patches/rules_foreign_cc_meson_setup_diagnostics.patch
@@ -1,20 +1,54 @@
-From dd3f095c7c9c941b3ee5fd79e6539b0946608833 Mon Sep 17 00:00:00 2001
+From d54b6b180bffc28735bf617bd32bbcd771244580 Mon Sep 17 00:00:00 2001
 From: Gili Tzabari <cowwoc2020@gmail.com>
-Date: Thu, 15 Oct 2026 01:52:01 +0000
-Subject: [PATCH] Print Meson setup diagnostics before returning its failure
+Date: Thu, 15 Oct 2026 03:51:32 +0000
+Subject: [PATCH] Trace Ninja launch before and inside Meson

 ---
- foreign_cc/meson.bzl | 10 +++++++++-
- 1 file changed, 9 insertions(+), 1 deletion(-)
+ foreign_cc/built_tools/meson_tool_wrapper.py |  8 ++++++++
+ foreign_cc/meson.bzl                         | 16 +++++++++++++++-
+ 2 files changed, 23 insertions(+), 1 deletion(-)
+
+diff --git a/foreign_cc/built_tools/meson_tool_wrapper.py b/foreign_cc/built_tools/meson_tool_wrapper.py
+index 6e13f07..120b222 100644
+--- a/foreign_cc/built_tools/meson_tool_wrapper.py
++++ b/foreign_cc/built_tools/meson_tool_wrapper.py
+@@ -1,5 +1,6 @@
+ import os
+ import runpy
++import subprocess
+ import sys
+
+ from python.runfiles import runfiles
+@@ -50,6 +51,13 @@ def main():
+         )
+
+     meson_main = _find_meson_main()
++    print("NINJA_INSIDE_MESON=" + os.environ.get("NINJA", ""), flush=True)
++    for name in ("RUNFILES_DIR", "RUNFILES_MANIFEST_FILE", "PYTHONPATH", "LIBRARY_PATH"):
++        print(name + "=" + os.environ.get(name, ""), flush=True)
++    result = subprocess.run([os.environ["NINJA"], "--version"], capture_output=True, text=True)
++    print("NINJA_INSIDE_MESON_STATUS=" + str(result.returncode), flush=True)
++    print(result.stdout, end="", flush=True)
++    print(result.stderr, end="", file=sys.stderr, flush=True)
+     sys.argv[0] = meson_main
+     runpy.run_path(meson_main, run_name="__main__")

 diff --git a/foreign_cc/meson.bzl b/foreign_cc/meson.bzl
-index 2cfb974..0be7cf2 100644
+index 2cfb974..138adef 100644
 --- a/foreign_cc/meson.bzl
 +++ b/foreign_cc/meson.bzl
-@@ -168,3 +168,11 @@ def _create_meson_script(configureParameters):
+@@ -166,7 +166,21 @@ def _create_meson_script(configureParameters):
+     # Expand options
+     build_options = expand_locations_and_make_variables(ctx, build_options, "options", data)

 -    script.append("{meson} setup --prefix={install_dir} {setup_args} {options} {source_dir}".format(
-+    script.append("""if {meson} setup --prefix={install_dir} {setup_args} {options} {source_dir}; then
++    script.append("""printf 'NINJA_BEFORE_MESON=%s\\n' "$NINJA"
++if "$NINJA" --version; then
++    printf 'NINJA_BEFORE_MESON_STATUS=0\\n'
++else
++    printf 'NINJA_BEFORE_MESON_STATUS=%s\\n' "$?"
++fi
++if {meson} setup --prefix={install_dir} {setup_args} {options} {source_dir}; then
 +    :
 +else
 +    status=$?
@@ -24,3 +58,5 @@ index 2cfb974..0be7cf2 100644
 +    exit "$status"
 +fi""".format(
          meson = meson_path,
+         install_dir = "$$INSTALLDIR$$",
+         setup_args = " ".join(target_args.get("setup", [])),
