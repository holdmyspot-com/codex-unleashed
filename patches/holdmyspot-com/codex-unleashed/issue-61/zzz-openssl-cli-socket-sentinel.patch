From 8e0340a0f53429e04d778bd4a8b01db04a0e9018 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Thu, 15 Oct 2026 04:47:25 -0400
Subject: [PATCH] Complete the OpenSSL CLI Windows socket sentinel fix

The Windows GNU CLI regression fails with four Wconstant-conversion errors before this change. Convert the invalid sentinel explicitly at the existing int ABI, including the SCTP error branch. The focused regression builds the actual Windows CLI with fatal warnings.
---
 MODULE.bazel                              |  1 +
 patches/openssl_cli_socket_sentinel.patch | 58 +++++++++++++++++++++++
 tools/build-warnings/check-openssl-cli.sh |  6 +++
 3 files changed, 65 insertions(+)
 create mode 100644 patches/openssl_cli_socket_sentinel.patch
 create mode 100755 tools/build-warnings/check-openssl-cli.sh

diff --git a/MODULE.bazel b/MODULE.bazel
index 42f3e7df0..5a9444282 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -519,6 +519,7 @@ single_version_override(
         "//patches:openssl_unused_globals.patch",
         "//patches:openssl_windows_compiler_types.patch",
         "//patches:openssl_socket_sentinel.patch",
+        "//patches:openssl_cli_socket_sentinel.patch",
         "//patches:openssl_assembly_defines.patch",
         "//patches:openssl_gnu_clang_selection.patch",
         "//patches:openssl_rio_cloexec_guard.patch",
diff --git a/patches/openssl_cli_socket_sentinel.patch b/patches/openssl_cli_socket_sentinel.patch
new file mode 100644
index 000000000..6d90232b8
--- /dev/null
+++ b/patches/openssl_cli_socket_sentinel.patch
@@ -0,0 +1,58 @@
+From 67e68d70ab84097498df5477077a72552ce841e6 Mon Sep 17 00:00:00 2001
+From: Gili Tzabari <cowwoc2020@gmail.com>
+Date: Thu, 15 Oct 2026 04:46:56 -0400
+Subject: [PATCH] Preserve the int socket sentinel in OpenSSL CLI error paths
+
+---
+ apps/lib/s_socket.c | 10 +++++-----
+ 1 file changed, 5 insertions(+), 5 deletions(-)
+
+diff --git a/apps/lib/s_socket.c b/apps/lib/s_socket.c
+index d8e67d6..5bbfdaf 100644
+--- a/apps/lib/s_socket.c
++++ b/apps/lib/s_socket.c
+@@ -138,7 +138,7 @@ int init_client(int *sock, const char *host, const char *port,
+             if (!BIO_bind(*sock, BIO_ADDRINFO_address(bi),
+                     BIO_SOCK_REUSEADDR)) {
+                 BIO_closesocket(*sock);
+-                *sock = INVALID_SOCKET;
++                *sock = (int)INVALID_SOCKET;
+                 continue;
+             }
+         }
+@@ -155,7 +155,7 @@ int init_client(int *sock, const char *host, const char *port,
+
+             if (tmpbio == NULL) {
+                 BIO_closesocket(*sock);
+-                *sock = INVALID_SOCKET;
++                *sock = (int)INVALID_SOCKET;
+                 continue;
+             }
+             BIO_free(tmpbio);
+@@ -169,7 +169,7 @@ int init_client(int *sock, const char *host, const char *port,
+
+         if (doconn && !BIO_connect(*sock, BIO_ADDRINFO_address(ai), options)) {
+             BIO_closesocket(*sock);
+-            *sock = INVALID_SOCKET;
++            *sock = (int)INVALID_SOCKET;
+             continue;
+         }
+
+@@ -178,7 +178,7 @@ int init_client(int *sock, const char *host, const char *port,
+             if (ba_ret == NULL) {
+                 BIO_puts(bio_err, "Internal error\n");
+                 BIO_closesocket(*sock);
+-                *sock = INVALID_SOCKET;
++                *sock = (int)INVALID_SOCKET;
+                 goto out;
+             }
+
+@@ -465,7 +465,7 @@ int do_server(int *accept_sock, const char *host, const char *port,
+
+         if (i < 0 || naccept == 0) {
+             BIO_closesocket(asock);
+-            asock = INVALID_SOCKET;
++            asock = (int)INVALID_SOCKET;
+             ret = i;
+             break;
+         }
diff --git a/tools/build-warnings/check-openssl-cli.sh b/tools/build-warnings/check-openssl-cli.sh
new file mode 100755
index 000000000..47dd35121
--- /dev/null
+++ b/tools/build-warnings/check-openssl-cli.sh
@@ -0,0 +1,6 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
+cd -- "$repo_root"
+bazel build "$@" --platforms=@rules_rs//rs/platforms:x86_64-pc-windows-gnullvm @openssl//:openssl
