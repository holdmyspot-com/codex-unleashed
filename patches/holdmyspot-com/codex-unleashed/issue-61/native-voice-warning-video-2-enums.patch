From c05a862535c6aa156b4ec753f9200d246635be4f Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Sun, 18 Oct 2026 08:45:44 +0000
Subject: [PATCH] Keep generated GStreamer enum values complete

Preserve functional changes without warning-only dependency patches.
---
 third_party/voice/prepare_sources.py          | 45 +++++++++++++++++++
 tools/build-warnings/gstreamer/BUILD.bazel    | 33 ++++++++++++++
 .../gstreamer/enum_values_test.c              | 20 +++++++++
 3 files changed, 98 insertions(+)
 create mode 100644 tools/build-warnings/gstreamer/BUILD.bazel
 create mode 100644 tools/build-warnings/gstreamer/enum_values_test.c

diff --git a/third_party/voice/prepare_sources.py b/third_party/voice/prepare_sources.py
index 247d1d3e7..23f1d805d 100644
--- a/third_party/voice/prepare_sources.py
+++ b/third_party/voice/prepare_sources.py
@@ -83,6 +83,51 @@ def extract_source(source: Source, archives: Path, destination: Path) -> None:
             raise ValueError(f"Expanded source exceeds limits: {source.name}")
         archive.extractall(destination, members=members, filter="data")
 
+    if source.name == "gst-plugins-base" and source.version == "1.28.6":
+        # WORKAROUND: glib-mkenums parses enum expressions one line at a time.
+        # https://github.com/holdmyspot-com/codex-unleashed/issues/61
+        # Remove when the pinned generator accepts these multiline expressions.
+        enum_values = (
+            (
+                "rtp/gstrtphdrext.h",
+                "GST_RTP_HEADER_EXTENSION_DIRECTION_SENDRECV = (\n"
+                "    GST_RTP_HEADER_EXTENSION_DIRECTION_SENDONLY |\n"
+                "    GST_RTP_HEADER_EXTENSION_DIRECTION_RECVONLY),",
+            ),
+            (
+                "video/navigation.h",
+                "GST_NAVIGATION_MODIFIER_MASK = (\n"
+                "    GST_NAVIGATION_MODIFIER_NONE          |\n"
+                "    GST_NAVIGATION_MODIFIER_SHIFT_MASK    |\n"
+                "    GST_NAVIGATION_MODIFIER_LOCK_MASK     |\n"
+                "    GST_NAVIGATION_MODIFIER_CONTROL_MASK  |\n"
+                "    GST_NAVIGATION_MODIFIER_MOD1_MASK      |\n"
+                "    GST_NAVIGATION_MODIFIER_MOD2_MASK      |\n"
+                "    GST_NAVIGATION_MODIFIER_MOD3_MASK      |\n"
+                "    GST_NAVIGATION_MODIFIER_MOD4_MASK      |\n"
+                "    GST_NAVIGATION_MODIFIER_MOD5_MASK      |\n"
+                "    GST_NAVIGATION_MODIFIER_BUTTON1_MASK  |\n"
+                "    GST_NAVIGATION_MODIFIER_BUTTON2_MASK  |\n"
+                "    GST_NAVIGATION_MODIFIER_BUTTON3_MASK  |\n"
+                "    GST_NAVIGATION_MODIFIER_BUTTON4_MASK  |\n"
+                "    GST_NAVIGATION_MODIFIER_BUTTON5_MASK  |\n"
+                "    GST_NAVIGATION_MODIFIER_SUPER_MASK    |\n"
+                "    GST_NAVIGATION_MODIFIER_HYPER_MASK    |\n"
+                "    GST_NAVIGATION_MODIFIER_META_MASK\n  )",
+            ),
+        )
+        for relative_path, original in enum_values:
+            header = destination / source.root / "gst-libs/gst" / relative_path
+            contents = header.read_text(encoding="utf-8")
+            if contents.count(original) != 1:
+                raise ValueError(
+                    f"Pinned GStreamer enum does not match: {relative_path}"
+                )
+            header.write_text(
+                contents.replace(original, " ".join(original.split())), encoding="utf-8"
+            )
+
+
 
 def prepare_sources(archives: Path, output: Path, manifest: bytes) -> None:
     sources = load_sources(manifest)
diff --git a/tools/build-warnings/gstreamer/BUILD.bazel b/tools/build-warnings/gstreamer/BUILD.bazel
new file mode 100644
index 000000000..9d990ce00
--- /dev/null
+++ b/tools/build-warnings/gstreamer/BUILD.bazel
@@ -0,0 +1,33 @@
+load("@rules_cc//cc:cc_test.bzl", "cc_test")
+
+NATIVE_SDK = "//third_party/voice:native_sdk"
+
+NATIVE_INCLUDES = [
+    "-I$(execpath %s)/%s" % (NATIVE_SDK, include)
+    for include in [
+        "include/gstreamer-1.0",
+        "include/glib-2.0",
+        "lib/glib-2.0/include",
+    ]
+]
+
+TEST_NAMES = [
+    "enum_values_test",
+]
+
+[
+    cc_test(
+        name = name,
+        size = "small",
+        srcs = [name + ".c"],
+        additional_compiler_inputs = [NATIVE_SDK],
+        copts = NATIVE_INCLUDES,
+        tags = ["manual"],
+        target_compatible_with = select({
+            "@platforms//os:linux": [],
+            "//conditions:default": ["@platforms//:incompatible"],
+        }) if name == "allocator_type_test" else [],
+        deps = ["//third_party/voice:native_link"],
+    )
+    for name in TEST_NAMES
+]
diff --git a/tools/build-warnings/gstreamer/enum_values_test.c b/tools/build-warnings/gstreamer/enum_values_test.c
new file mode 100644
index 000000000..2cbe79ca6
--- /dev/null
+++ b/tools/build-warnings/gstreamer/enum_values_test.c
@@ -0,0 +1,20 @@
+#include <gst/rtp/gstrtphdrext.h>
+#include <gst/rtp/gstrtp-enumtypes.h>
+#include <gst/video/navigation.h>
+#include <gst/video/video-enumtypes.h>
+
+int main(void) {
+  gst_init(NULL, NULL);
+  GFlagsClass *rtp = g_type_class_ref(gst_rtp_header_extension_direction_get_type());
+  GFlagsClass *navigation = g_type_class_ref(gst_navigation_modifier_type_get_type());
+  GFlagsValue *sendrecv = g_flags_get_value_by_name(
+      rtp, "GST_RTP_HEADER_EXTENSION_DIRECTION_SENDRECV");
+  GFlagsValue *mask = g_flags_get_value_by_name(navigation, "GST_NAVIGATION_MODIFIER_MASK");
+  int status = sendrecv == NULL || mask == NULL ||
+               sendrecv->value != GST_RTP_HEADER_EXTENSION_DIRECTION_SENDRECV ||
+               mask->value != GST_NAVIGATION_MODIFIER_MASK;
+  g_type_class_unref(navigation);
+  g_type_class_unref(rtp);
+  gst_deinit();
+  return status;
+}
