diff --git a/third_party/v8/icu_mutex_analysis_test.cc b/third_party/v8/icu_mutex_analysis_test.cc
new file mode 100644
index 000000000..ea44f8301
--- /dev/null
+++ b/third_party/v8/icu_mutex_analysis_test.cc
@@ -0,0 +1,44 @@
+#include "mutex.h"
+
+#if defined(__clang__)
+#define ICU_TEST_GUARDED_BY(mutex) __attribute__((guarded_by(mutex)))
+#else
+#define ICU_TEST_GUARDED_BY(mutex)
+#endif
+
+using U_NAMESPACE_QUALIFIER Mutex;
+using U_NAMESPACE_QUALIFIER UMutex;
+using U_NAMESPACE_QUALIFIER umtx_lock;
+using U_NAMESPACE_QUALIFIER umtx_unlock;
+
+static UMutex analysis_mutex;
+static int analysis_value ICU_TEST_GUARDED_BY(analysis_mutex);
+static int global_analysis_value ICU_TEST_GUARDED_BY(UMutex::getGlobalMutex());
+
+int main() {
+#if defined(CODEX_ICU_EXPECT_ANALYSIS_ERROR)
+    analysis_value = 1;
+    global_analysis_value = 1;
+#else
+    analysis_mutex.lock();
+    analysis_value = 1;
+    analysis_mutex.unlock();
+
+    umtx_lock(&analysis_mutex);
+    analysis_value = 2;
+    umtx_unlock(&analysis_mutex);
+
+    {
+        Mutex lock(&analysis_mutex);
+        analysis_value = 3;
+    }
+    {
+        Mutex lock;
+        global_analysis_value = 1;
+    }
+    {
+        Mutex lock(nullptr);
+    }
+#endif
+    return 0;
+}
