From 42a514e3336692c34664fe6f3b6387ccce9bee2a Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Fri, 16 Oct 2026 03:36:44 +0000
Subject: [PATCH] Release the ICU currency cache lock on allocation failure

Keep the existing allocation-failure unlock without warning-only mutex annotations, lock refactoring, or analysis fixtures. Dependency warnings remain visible and nonfatal.

Scope verification retains the original allocation-failure hunk byte for byte. The narrowed 151-patch queue applies strictly to rust-v0.163.0 (83086188ae0614bd882818ff1aa23f3194962012). Nested application and maintained formatting/build gates are recorded in the owning execution receipt. Runtime fault injection is not established by patch application.
---
 MODULE.bazel                           |  1 +
 patches/BUILD.bazel                    |  1 +
 patches/v8_icu_mutex_annotations.patch | 32 ++++++++++++++++++++++++++
 3 files changed, 34 insertions(+)
 create mode 100644 patches/v8_icu_mutex_annotations.patch

diff --git a/MODULE.bazel b/MODULE.bazel
index b7f1c4905..a7ff40feb 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -809,6 +809,7 @@ archive_override(
         "//patches:v8_module_deps.patch",
         "//patches:v8_bazel_rules.patch",
         "//patches:v8_source_portability.patch",
+        "//patches:v8_icu_mutex_annotations.patch",
     ],
     strip_prefix = "v8-15.0.245.2",
     urls = ["https://github.com/v8/v8/archive/refs/tags/15.0.245.2.tar.gz"],
diff --git a/patches/BUILD.bazel b/patches/BUILD.bazel
index afff7bc4c..4cfe5e30c 100644
--- a/patches/BUILD.bazel
+++ b/patches/BUILD.bazel
@@ -28,6 +28,7 @@ exports_files([
     "tikv-jemalloc-sys_dependency_flags.patch",
     "v8_bazel_rules.patch",
     "v8_module_deps.patch",
+    "v8_icu_mutex_annotations.patch",
     "v8_source_portability.patch",
     "webrtc-sys_hermetic_darwin_sysroot.patch",
     "windows-link.patch",
diff --git a/patches/v8_icu_mutex_annotations.patch b/patches/v8_icu_mutex_annotations.patch
new file mode 100644
index 000000000..0d283d793
--- /dev/null
+++ b/patches/v8_icu_mutex_annotations.patch
@@ -0,0 +1,32 @@
+diff --git a/mod/v8-15.0.245.2/MODULE.bazel b/mod/v8-15.0.245.2/MODULE.bazel
+index 573f463..7a40699 100644
+--- a/mod/v8-15.0.245.2/MODULE.bazel
++++ b/mod/v8-15.0.245.2/MODULE.bazel
+@@ -26,8 +26,10 @@ git_repository(
+     name = "icu",
+     build_file = "@v8//:bazel/BUILD.icu",
+     commit = "a86a32e67b8d1384b33f8fa48c83a6079b86f8cd",
++    patch_args = ["-p1"],
+     patch_cmds = ["find source -name BUILD.bazel | xargs rm"],
+     patch_cmds_win = ["Get-ChildItem -Path source -File -Include BUILD.bazel -Recurse | Remove-Item"],
++    patches = ["@v8//:bazel/icu_mutex_annotations.patch"],
+     remote = "https://chromium.googlesource.com/chromium/deps/icu.git",
+ )
+
+diff --git a/mod/v8-15.0.245.2/bazel/icu_mutex_annotations.patch b/mod/v8-15.0.245.2/bazel/icu_mutex_annotations.patch
+new file mode 100644
+--- /dev/null
++++ b/mod/v8-15.0.245.2/bazel/icu_mutex_annotations.patch
+@@ -0,0 +1,12 @@
++diff --git a/source/common/ucurr.cpp b/source/common/ucurr.cpp
++index cccf113..558cdc0 100644
++--- a/source/common/ucurr.cpp
+++++ b/source/common/ucurr.cpp
++@@ -1483,6 +1483,7 @@ getCacheEntry(const char* locale, UErrorCode& ec) {
++                 deleteCurrencyNames(currencyNames, total_currency_name_count);
++                 deleteCurrencyNames(currencySymbols, total_currency_symbol_count);
++                 ec = U_MEMORY_ALLOCATION_ERROR;
+++                umtx_unlock(&gCurrencyCacheMutex);
++                 return nullptr;
++             }
++             currCache[currentCacheEntryIndex] = cacheEntry;
