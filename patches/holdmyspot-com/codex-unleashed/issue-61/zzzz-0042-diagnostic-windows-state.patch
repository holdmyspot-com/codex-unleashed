diff --git a/codex-rs/windows-sandbox-rs/src/token.rs b/codex-rs/windows-sandbox-rs/src/token.rs
index f09dabd6f..0b4643b8d 100644
--- a/codex-rs/windows-sandbox-rs/src/token.rs
+++ b/codex-rs/windows-sandbox-rs/src/token.rs
@@ -524,6 +524,45 @@ unsafe fn create_token_with_caps_from(
     Ok(new_token)
 }
 
+#[cfg(test)]
+pub(crate) unsafe fn query_restricted_sids_for_diagnostics(token: HANDLE) -> Result<Vec<String>> {
+    use windows_sys::Win32::Security::TokenRestrictedSids;
+
+    let mut needed = 0;
+    GetTokenInformation(
+        token,
+        TokenRestrictedSids,
+        std::ptr::null_mut(),
+        0,
+        &mut needed,
+    );
+    ensure!(needed > 0, "invalid restricted SID buffer size");
+    let mut buffer = vec![0u8; needed as usize];
+    if GetTokenInformation(
+        token,
+        TokenRestrictedSids,
+        buffer.as_mut_ptr().cast(),
+        needed,
+        &mut needed,
+    ) == 0
+    {
+        return Err(anyhow!(
+            "GetTokenInformation(TokenRestrictedSids): {}",
+            GetLastError()
+        ));
+    }
+    ensure!(
+        needed as usize <= buffer.len(),
+        "invalid restricted SID result size"
+    );
+    decode_token_groups(&buffer[..needed as usize])?
+        .into_iter()
+        .map(|group| {
+            crate::winutil::string_from_sid_bytes(&group.sid).map_err(|error| anyhow!(error))
+        })
+        .collect()
+}
+
 #[cfg(test)]
 #[path = "token_tests.rs"]
 mod tests;
