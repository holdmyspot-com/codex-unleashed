@@ -107,6 +107,52 @@ fn spawn_legacy_process(
             logs_base_dir,
         )?,
     };
+
+    #[cfg(test)]
+    if env_map.contains_key("OUTSIDE_DELETE") {
+        eprintln!("CODEX_SANDBOX cwd={cwd:?} command={command:?}");
+        eprintln!("CODEX_SANDBOX restricted_sids={:?}", unsafe {
+            crate::token::query_restricted_sids_for_diagnostics(h_token)
+        });
+        eprintln!("CODEX_SANDBOX token_user={:?}", unsafe {
+            crate::token::get_user_sid_bytes(h_token)
+                .map(|sid| crate::winutil::string_from_sid_bytes(&sid))
+        });
+        for capability in &security.write_root_sids {
+            eprintln!(
+                "CODEX_SANDBOX write_root={:?} sid={}",
+                capability.root, capability.sid_str
+            );
+        }
+        for key in [
+            "OUTSIDE_DELETE",
+            "WORKSPACE_DELETE",
+            "PROTECTED_GIT_DIR",
+            "TEMP",
+            "TMP",
+        ] {
+            if let Some(path) = env_map.get(key) {
+                let parent = Path::new(path).parent();
+                for target in std::iter::once(Path::new(path)).chain(parent) {
+                    let acl = std::process::Command::new("icacls.exe")
+                        .arg(target)
+                        .output();
+                    match acl {
+                        Ok(output) => eprintln!(
+                            "CODEX_SANDBOX acl key={key} path={target:?} status={} stdout={} stderr={}",
+                            output.status,
+                            String::from_utf8_lossy(&output.stdout),
+                            String::from_utf8_lossy(&output.stderr)
+                        ),
+                        Err(error) => {
+                            eprintln!("CODEX_SANDBOX acl key={key} path={target:?}: {error}")
+                        }
+                    }
+                }
+            }
+        }
+    }
