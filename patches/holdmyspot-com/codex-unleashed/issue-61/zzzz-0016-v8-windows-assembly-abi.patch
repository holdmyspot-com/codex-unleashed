new file mode 100644
index 000000000..f02acb82b
--- /dev/null
+++ b/tools/build-warnings/v8-assembly/assembly_test.bzl
@@ -0,0 +1,32 @@
+"""Check that each Windows ABI compiles its corresponding assembly source."""
+
+load("@bazel_skylib//lib:unittest.bzl", "analysistest", "asserts")
+
+def _assembly_test_impl(ctx):
+    env = analysistest.begin(ctx)
+    assembly_sources = [
+        artifact.basename
+        for action in analysistest.target_actions(env)
+        if action.mnemonic == "CppCompile"
+        for artifact in action.inputs.to_list()
+        if artifact.basename.startswith("push_registers_")
+    ]
+    asserts.equals(env, [ctx.attr.expected_source], assembly_sources)
+    return analysistest.end(env)
+
+windows_gnu_assembly_test = analysistest.make(
+    _assembly_test_impl,
+    attrs = {"expected_source": attr.string(mandatory = True)},
+    config_settings = {
+        "//command_line_option:platforms": str(Label("//:windows_x86_64_gnullvm")),
+    },
+)
+
+windows_msvc_assembly_test = analysistest.make(
+    _assembly_test_impl,
+    attrs = {"expected_source": attr.string(mandatory = True)},
+    config_settings = {
+        "//command_line_option:platforms": str(Label("//:windows_x86_64_msvc")),
+        "//command_line_option:features": ["static_link_msvcrt", "-dynamic_link_msvcrt"],
+    },
+)
