From dfe007147514a20f8e4a81e7f3f67cf1683ef8c7 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Fri, 16 Oct 2026 18:13:49 +0000
Subject: [PATCH] Give prewarmed guardian test connections independent mock
 listeners

Native macOS job 117012089820 times out in two routing regressions because the scripted mock accepts its second connection only after serving the first, while prewarm waits for both. Use independent listeners and aggregate their request logs without changing the routing assertions.

Use method references when combining connection logs, satisfying the configured Clippy method-call lint. Red: hosted jobs 117096549027 and 117096549391 reject the original three closures. Green: four routing tests pass with the maintained CI stack setting; focused Bazel guardian Clippy and maintained just fmt-check pass. The local Clippy sandbox requires writable /dev/null under the enclosing execution sandbox; no hosted sandbox setting changes.
---
 .../src/async_scorer/sampler_routing_tests.rs | 29 ++++++++++++++-----
 1 file changed, 22 insertions(+), 7 deletions(-)

diff --git a/codex-rs/ext/guardian-v2/src/async_scorer/sampler_routing_tests.rs b/codex-rs/ext/guardian-v2/src/async_scorer/sampler_routing_tests.rs
index 5a94aed3e..49a946e52 100644
--- a/codex-rs/ext/guardian-v2/src/async_scorer/sampler_routing_tests.rs
+++ b/codex-rs/ext/guardian-v2/src/async_scorer/sampler_routing_tests.rs
@@ -40,8 +40,11 @@ impl WorkspaceRoutingResolver for UnavailableRouting {
 async fn failed_routing_blocks_a_prewarmed_classifier_connection() -> Result<()> {
     core_test_support::skip_if_no_network!(Ok(()));
     let response = vec![vec![ev_assistant_message("r1", "low"), ev_completed("r1")]];
-    let server = responses::start_websocket_server(vec![response.clone(), response]).await;
-    let base_url = proxy_websocket_servers(&[&server, &server])
+    let servers = [
+        responses::start_websocket_server(vec![response.clone()]).await,
+        responses::start_websocket_server(vec![response]).await,
+    ];
+    let base_url = proxy_websocket_servers(&[&servers[0], &servers[1]])
         .await?
         .replace("/v1", "/backend-api/codex");
     let auth =
@@ -59,7 +62,12 @@ async fn failed_routing_blocks_a_prewarmed_classifier_connection() -> Result<()>
         error.to_string().contains("discovery unavailable"),
         "{error}"
     );
-    assert!(server.connections().iter().all(Vec::is_empty));
+    assert!(
+        servers
+            .iter()
+            .flat_map(core_test_support::responses::WebSocketTestServer::connections)
+            .all(|requests| requests.is_empty())
+    );
     Ok(())
 }
 
@@ -243,7 +251,10 @@ async fn account_switch_cancels_request_opening_and_first_token_waits() -> Resul
             accept_delay: None,
             close_after_requests: false,
         };
-        let websocket = responses::start_websocket_server_with_headers(vec![stalled; 2]).await;
+        let websockets = [
+            responses::start_websocket_server_with_headers(vec![stalled.clone()]).await,
+            responses::start_websocket_server_with_headers(vec![stalled]).await,
+        ];
         let changes = Arc::new(AuthAfterRouting {
             initial: CodexAuth::from_external_chatgpt_tokens(
                 token,
@@ -266,7 +277,7 @@ async fn account_switch_cancels_request_opening_and_first_token_waits() -> Resul
         let base_url = if transport == "http" {
             format!("{}/v1", http.uri())
         } else {
-            proxy_websocket_servers(&[&websocket, &websocket]).await?
+            proxy_websocket_servers(&[&websockets[0], &websockets[1]]).await?
         };
         let mut config = sampler_config(base_url);
         config.provider = create_model_provider(config.provider.info().clone(), Some(auth.clone()));
@@ -279,7 +290,7 @@ async fn account_switch_cancels_request_opening_and_first_token_waits() -> Resul
         tokio::pin!(sample);
         tokio::time::timeout(Duration::from_secs(/*secs*/ 10), async {
             loop {
-                if !opening.requests().is_empty() || websocket.connections().iter().any(|requests| !requests.is_empty()) {
+                if !opening.requests().is_empty() || websockets.iter().flat_map(core_test_support::responses::WebSocketTestServer::connections).any(|requests| !requests.is_empty()) {
                     break Ok::<(), anyhow::Error>(());
                 }
                 tokio::select! {
@@ -299,7 +310,11 @@ async fn account_switch_cancels_request_opening_and_first_token_waits() -> Resul
         );
         assert_eq!(opening.requests().len(), usize::from(transport == "http"));
         assert_eq!(
-            websocket.connections().iter().map(Vec::len).sum::<usize>(),
+            websockets
+                .iter()
+                .flat_map(core_test_support::responses::WebSocketTestServer::connections)
+                .map(|requests| requests.len())
+                .sum::<usize>(),
             usize::from(transport == "websocket")
         );
     }
