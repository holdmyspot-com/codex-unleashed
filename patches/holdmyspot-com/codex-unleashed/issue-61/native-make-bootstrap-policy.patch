From 8d11de45c76271bf29bf586449eb1d304ebae341 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Wed, 14 Oct 2026 04:56:56 +0000
Subject: [PATCH] Apply strict GNU Make warnings after configure probes

Run Autoconf feature probes without the global -Werror promotion, following its documented contract, then restore strict compiler and linker flags for build.sh and make install. Preserve all other toolchain flags and fatal-linker diagnostics. Backport GNU Make commit 63961d5d0905f69c59b44652fd33ac932f7d1c23 to remove pointer comparisons from string equality macros. Include a maintained test that builds the real bootstrap tool and runs a Makefile.

Red: the maintained Bazel workspace gate fails BootstrapGNUMake because configure misdetects const and libc functions. Isolated configure comparison reproduces and corrects those detections; strict compilation then reproduces the upstream string-comparison diagnostics. Green: bazel test //tools/build-warnings/make-bootstrap:make_bootstrap_test //tools/build-warnings/aws-lc:thread_test exits 0, with 1291 action cache hits and both tests passing. The successful bootstrap log has no warning/error diagnostics. Evidence: .cat/work/temp/final-queue-verification-z5VhEx/native-bootstrap-focused-second.log and .cat/work/temp/build-caches/strict-native-inputs/make-bootstrap-jMETHA.
---
 MODULE.bazel                                  |   1 +
 patches/BUILD.bazel                           |   1 +
 ...rules_foreign_cc_make_warning_phases.patch | 111 ++++++++++++++++++
 .../build-warnings/make-bootstrap/BUILD.bazel |  28 +++++
 tools/build-warnings/make-bootstrap/probe.mk  |   3 +
 5 files changed, 144 insertions(+)
 create mode 100644 patches/rules_foreign_cc_make_warning_phases.patch
 create mode 100644 tools/build-warnings/make-bootstrap/BUILD.bazel
 create mode 100644 tools/build-warnings/make-bootstrap/probe.mk

diff --git a/MODULE.bazel b/MODULE.bazel
index 92a7daaa1..b43195301 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -174,6 +174,7 @@ single_version_override(
         "//patches:rules_foreign_cc_make_cppflags.patch",
         "//patches:rules_foreign_cc_make_xcompile.patch",
         "//patches:rules_foreign_cc_make_msvc_stdint.patch",
+        "//patches:rules_foreign_cc_make_warning_phases.patch",
     ],
     version = "0.15.1",
 )
diff --git a/patches/BUILD.bazel b/patches/BUILD.bazel
index c4be10752..7625ceac4 100644
--- a/patches/BUILD.bazel
+++ b/patches/BUILD.bazel
@@ -18,6 +18,7 @@ exports_files([
     "rules_foreign_cc_make_cppflags.patch",
     "rules_foreign_cc_make_xcompile.patch",
     "rules_foreign_cc_make_msvc_stdint.patch",
+    "rules_foreign_cc_make_warning_phases.patch",
     "rules_rs_build_script_deps_annotation.patch",
     "rules_rs_bindgen_preprocessor_policy.patch",
     "rules_rs_rust_debug_modes.patch",
diff --git a/patches/rules_foreign_cc_make_warning_phases.patch b/patches/rules_foreign_cc_make_warning_phases.patch
new file mode 100644
index 000000000..2e72234dd
--- /dev/null
+++ b/patches/rules_foreign_cc_make_warning_phases.patch
@@ -0,0 +1,111 @@
+diff --git a/foreign_cc/built_tools/make_build.bzl b/foreign_cc/built_tools/make_build.bzl
+index 8c553fa..572cd42 100644
+--- a/foreign_cc/built_tools/make_build.bzl
++++ b/foreign_cc/built_tools/make_build.bzl
+@@ -100,7 +100,7 @@ def _make_tool_impl(ctx):
+             "--prefix=\"$$INSTALLDIR$$\"",
+         ]
+
+-        install_cmd = ["./make install"]
++        install_cmd = ['./make CFLAGS="$CFLAGS" CPPFLAGS="$CPPFLAGS" LDFLAGS="$LDFLAGS" install']
+
+         xcompile_options = detect_xcompile(ctx)
+         if xcompile_options:
+@@ -112,25 +112,44 @@ def _make_tool_impl(ctx):
+                 "cp -p make \"$$INSTALLDIR$$/bin/make\"",
+             ]
+
++        # Autoconf probes use intentionally warning-producing programs. Its
++        # documented contract requires warning promotion after configuration:
++        # https://lists.gnu.org/archive/html/autoconf/2020-12/msg00002.html
++        configure_cflags = [flag for flag in non_sysroot_cflags if flag != "-Werror"]
++        configure_ldflags = [flag for flag in non_sysroot_ldflags if flag != "-Werror"]
++
++        restore_warning_flags = []
++        for variable, flags in [
++            ("CFLAGS", non_sysroot_cflags),
++            ("CPPFLAGS", non_sysroot_cflags),
++            ("LDFLAGS", non_sysroot_ldflags),
++        ]:
++            if "-Werror" in flags:
++                restore_warning_flags.append(
++                    "printf '%s\\n' '" + variable + "=\"$" + variable + " -Werror\"' >> build.cfg",
++                )
++
+         env.update({
+             "AR": absolute_ar,
+             "ARFLAGS": _join_flags_list(ctx.workspace_name, arflags),
+             "CC": absolute_cc,
+-            "CFLAGS": _join_flags_list(ctx.workspace_name, non_sysroot_cflags),
++            "CFLAGS": _join_flags_list(ctx.workspace_name, configure_cflags),
+             # Configure's preprocessor checks need the declared header paths too.
+             "CPPFLAGS": " ".join([
+                 "$${CPPFLAGS:-}$$",
+-                _join_flags_list(ctx.workspace_name, non_sysroot_cflags),
++                _join_flags_list(ctx.workspace_name, configure_cflags),
+             ]).strip(),
+             "LD": absolute_ld,
+-            "LDFLAGS": _join_flags_list(ctx.workspace_name, non_sysroot_ldflags),
++            "LDFLAGS": _join_flags_list(ctx.workspace_name, configure_ldflags),
+         })
+
+         configure_env = " ".join(["%s=\"%s\"" % (key, value) for key, value in env.items()])
+         script = [
+             "%s ./configure %s" % (configure_env, " ".join(configure_options)),
++        ] + restore_warning_flags + [
+             "cat build.cfg",
+             "./build.sh",
++            ". ./build.cfg",
+         ] + install_cmd
+
+     return built_tool_rule_impl(
+diff --git a/toolchains/built_toolchains.bzl b/toolchains/built_toolchains.bzl
+index e9f2b8b..cb2815a 100644
+--- a/toolchains/built_toolchains.bzl
++++ b/toolchains/built_toolchains.bzl
+@@ -89,6 +89,8 @@ def _make_toolchain(version, register_toolchains):
+             build_file_content = _ALL_CONTENT,
+             sha256 = "dd16fb1d67bfab79a72f5e8390735c49e3e8e70b4945a15ab1f81ddb78658fb3",
+             strip_prefix = "make-4.4.1",
++            patch_args = ["-p1"],
++            patches = [Label("//toolchains/patches:make-string-comparison.patch")],
+             urls = [
+                 "https://mirror.bazel.build/ftpmirror.gnu.org/gnu/make/make-4.4.1.tar.gz",
+                 "http://ftpmirror.gnu.org/gnu/make/make-4.4.1.tar.gz",
+diff --git a/toolchains/patches/BUILD.bazel b/toolchains/patches/BUILD.bazel
+index e69de29..154cb81 100644
+--- a/toolchains/patches/BUILD.bazel
++++ b/toolchains/patches/BUILD.bazel
+@@ -0,0 +1 @@
++exports_files(["make-string-comparison.patch"])
+diff --git a/toolchains/patches/make-string-comparison.patch b/toolchains/patches/make-string-comparison.patch
+new file mode 100644
+index 0000000..42f15bf
+--- /dev/null
++++ b/toolchains/patches/make-string-comparison.patch
+@@ -0,0 +1,25 @@
++diff --git a/src/makeint.h b/src/makeint.h
++index 61c7822..120fc91 100644
++--- a/src/makeint.h
+++++ b/src/makeint.h
++@@ -320,18 +320,13 @@
++ #define ISDIGIT(c) ((unsigned) (c) - '0' <= 9)
++
++ /* Test if two strings are equal. Is this worthwhile?  Should be profiled.  */
++-#define streq(a, b) \
++-   ((a) == (b) || \
++-    (*(a) == *(b) && (*(a) == '\0' || !strcmp ((a) + 1, (b) + 1))))
+++#define streq(a, b) (*(a) == *(b) && (*(a) == '\0' || !strcmp ((a) + 1, (b) + 1)))
++
++ /* Test if two strings are equal, but match case-insensitively on systems
++    which have case-insensitive filesystems.  Should only be used for
++    filenames!  */
++ #ifdef HAVE_CASE_INSENSITIVE_FS
++-# define patheq(a, b) \
++-    ((a) == (b) \
++-     || (tolower((unsigned char)*(a)) == tolower((unsigned char)*(b)) \
++-         && (*(a) == '\0' || !strcasecmp ((a) + 1, (b) + 1))))
+++# define patheq(a, b) (strcasecmp ((a), (b)) == 0)
++ #else
++ # define patheq(a, b) streq(a, b)
++ #endif
diff --git a/tools/build-warnings/make-bootstrap/BUILD.bazel b/tools/build-warnings/make-bootstrap/BUILD.bazel
new file mode 100644
index 000000000..063b4d595
--- /dev/null
+++ b/tools/build-warnings/make-bootstrap/BUILD.bazel
@@ -0,0 +1,28 @@
+load("@bazel_lib//lib:diff_test.bzl", "diff_test")
+load("@bazel_skylib//rules:write_file.bzl", "write_file")
+
+genrule(
+    name = "make_bootstrap_result",
+    srcs = ["probe.mk"],
+    outs = ["make_bootstrap_result.txt"],
+    cmd = "$(execpath @rules_foreign_cc//toolchains/private:make_tool)/bin/" + select({
+        "@platforms//os:windows": "make.exe",
+        "//conditions:default": "make",
+    }) + " --no-print-directory -f $(execpath probe.mk) > $@",
+    tools = ["@rules_foreign_cc//toolchains/private:make_tool"],
+)
+
+write_file(
+    name = "expected",
+    out = "expected.txt",
+    content = [
+        "bootstrap-ok",
+        "",
+    ],
+)
+
+diff_test(
+    name = "make_bootstrap_test",
+    file1 = ":make_bootstrap_result",
+    file2 = ":expected",
+)
diff --git a/tools/build-warnings/make-bootstrap/probe.mk b/tools/build-warnings/make-bootstrap/probe.mk
new file mode 100644
index 000000000..4ecf9d2a4
--- /dev/null
+++ b/tools/build-warnings/make-bootstrap/probe.mk
@@ -0,0 +1,3 @@
+.PHONY: check
+check:
+	@printf 'bootstrap-ok\n'
