From 22967b2cfee18a25aac4fe204b8006fbc475d315 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Wed, 14 Oct 2026 03:01:02 +0000
Subject: [PATCH] Define libc++ availability and libc selection explicitly

Set the two undefined configuration values to their existing preprocessor value, zero. This preserves the selected runtime branches while removing Wundef diagnostics. Add a native config test to keep both values explicit.

TDD: Clang 22.1.8 with -std=c++23 -Wall -Wextra -Wundef -Werror -fsyntax-only config_test.cc fails for both missing identifiers before the definitions (exit 1), then passes after them (exit 0). Logs: emitted-native-policy-bvz375/libcxx-config-{red,green}.log in the fork execution record. Maintained Bazel verification remains required.

Refs holdmyspot-com/codex-unleashed#61
---
 third_party/v8/libcxx_config/BUILD.bazel    | 8 ++++++++
 third_party/v8/libcxx_config/__config_site  | 2 ++
 third_party/v8/libcxx_config/config_test.cc | 6 ++++++
 3 files changed, 16 insertions(+)
 create mode 100644 third_party/v8/libcxx_config/config_test.cc

diff --git a/third_party/v8/libcxx_config/BUILD.bazel b/third_party/v8/libcxx_config/BUILD.bazel
index e4a3ee6a8..4c3c1a6f8 100644
--- a/third_party/v8/libcxx_config/BUILD.bazel
+++ b/third_party/v8/libcxx_config/BUILD.bazel
@@ -1,3 +1,4 @@
+load("@rules_cc//cc:cc_test.bzl", "cc_test")
 load("@rules_cc//cc:defs.bzl", "cc_library")

 package(default_visibility = ["//visibility:public"])
@@ -10,3 +11,10 @@ cc_library(
     ],
     includes = ["."],
 )
+
+cc_test(
+    name = "config_test",
+    size = "small",
+    srcs = ["config_test.cc"],
+    deps = [":headers"],
+)
diff --git a/third_party/v8/libcxx_config/__config_site b/third_party/v8/libcxx_config/__config_site
index 1053f9fe4..d74792b04 100644
--- a/third_party/v8/libcxx_config/__config_site
+++ b/third_party/v8/libcxx_config/__config_site
@@ -27,6 +27,7 @@
 #endif

 #define _LIBCPP_HAS_VENDOR_AVAILABILITY_ANNOTATIONS 0
+#define _LIBCPP_AVAILABILITY_MINIMUM_HEADER_VERSION 0
 #define _LIBCPP_HAS_FILESYSTEM 1
 #define _LIBCPP_HAS_RANDOM_DEVICE 1
 #define _LIBCPP_HAS_LOCALIZATION 1
@@ -45,6 +46,7 @@

 #define _LIBCPP_LIBC_PICOLIBC 0
 #define _LIBCPP_LIBC_NEWLIB 0
+#define _LIBCPP_LIBC_LLVM_LIBC 0

 #define _LIBCPP_NO_AUTO_LINK
 #define _LIBCPP_REMOVE_TRANSITIVE_INCLUDES
diff --git a/third_party/v8/libcxx_config/config_test.cc b/third_party/v8/libcxx_config/config_test.cc
new file mode 100644
index 000000000..4cb49b32b
--- /dev/null
+++ b/third_party/v8/libcxx_config/config_test.cc
@@ -0,0 +1,6 @@
+#include "__config_site"
+
+static_assert(_LIBCPP_AVAILABILITY_MINIMUM_HEADER_VERSION == 0);
+static_assert(_LIBCPP_LIBC_LLVM_LIBC == 0);
+
+int main() { return 0; }
-- 
