         /*cancellation*/ Some(cancellation),
     )
@@ -959,13 +967,14 @@ async fn assert_legacy_tty_descendant_lifecycle(
     lifecycle: LegacyTtyDescendantLifecycle,
 ) {
     let cwd = sandbox_cwd();
+    let workload_temp = tempfile::tempdir_in(&cwd).expect("create PowerShell workload tempdir");
     let codex_home = sandbox_home(match lifecycle {
