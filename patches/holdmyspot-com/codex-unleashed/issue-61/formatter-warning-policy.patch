       - name: Rust benchmark smoke test
diff --git a/scripts/format.py b/scripts/format.py
index 9b408e1c7..5cc9ba6c9 100644
--- a/scripts/format.py
+++ b/scripts/format.py
@@ -14,2 +14,9 @@ from pathlib import Path
 REPO_ROOT = Path(__file__).resolve().parents[1]
+# WORKAROUND: https://github.com/rust-lang/rustfmt/issues/4991
+# Stable rustfmt ignores upstream's import-splitting option. Remove this exact
+# warning exception when the option is stable.
+STABLE_RUSTFMT_IMPORTS_WARNING = (
+    "Warning: can't set `imports_granularity = Item`, "
+    "unstable features are only available in nightly channel."
+)

@@ -136,3 +143,3 @@ def formatter_groups(*, check: bool) -> tuple[FormatterGroup, ...]:
 def run_formatter_group(group: FormatterGroup) -> FormatterResult:
-    """Run one formatter group sequentially and return its buffered output."""
+    """Run formatters sequentially, treating warning diagnostics as failures."""
     for command in group.commands:
@@ -143,3 +150,3 @@ def run_formatter_group(group: FormatterGroup) -> FormatterResult:
                 stdout=subprocess.PIPE,
-                stderr=subprocess.STDOUT,
+                stderr=subprocess.PIPE,
                 text=True,
@@ -151,7 +158,18 @@ def run_formatter_group(group: FormatterGroup) -> FormatterResult:

-        if process.returncode != 0:
-            output = f"$ {shlex.join(command.args)}\n{process.stdout}"
-            if process.stdout and not process.stdout.endswith("\n"):
+        stderr = "".join(
+            line
+            for line in (process.stderr or "").splitlines(keepends=True)
+            if not (
+                group.name == "Rust"
+                and line.removesuffix("\n") == STABLE_RUSTFMT_IMPORTS_WARNING
+            )
+        )
+        has_warning = any(
+            line.lstrip().lower().startswith("warning:") for line in stderr.splitlines()
+        )
+        if process.returncode != 0 or has_warning:
+            output = f"$ {shlex.join(command.args)}\n{process.stdout}{stderr}"
+            if not output.endswith("\n"):
                 output += "\n"
-            return FormatterResult(group.name, output, process.returncode)
+            return FormatterResult(group.name, output, process.returncode or 1)

