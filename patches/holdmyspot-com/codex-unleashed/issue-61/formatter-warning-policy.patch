--- a/.github/workflows/repo-checks.yml
+++ b/.github/workflows/repo-checks.yml
@@ -69,2 +69,5 @@ jobs:

+      - name: Test formatter warning enforcement
+        run: python3 -m unittest discover -s .github/scripts -p 'test_format.py'
+
       - name: Check formatting (run `just fmt` to fix)
