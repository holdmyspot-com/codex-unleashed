+index 9dea86b..e86d204 100644
+--- a/toolchain/cc_toolchain.bzl
++++ b/toolchain/cc_toolchain.bzl
+@@ -10,0 +11 @@ def cc_toolchain(name, tool_map, module_map = None, extra_args = []):
++            "@llvm//toolchain/features:treat_warnings_as_errors",
+diff --git a/toolchain/features/BUILD.bazel b/toolchain/features/BUILD.bazel
+index a6514ff..b306a69 100644
+--- a/toolchain/features/BUILD.bazel
++++ b/toolchain/features/BUILD.bazel
+@@ -6,0 +7,24 @@ package(default_visibility = ["//visibility:public"])
++cc_args(
++    name = "warnings_as_errors_compile_flags",
++    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
++    args = ["-Werror"],
++)
++
++cc_args(
++    name = "warnings_as_errors_link_flags",
++    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
++    args = select({
++        "@platforms//os:macos": ["-Werror", "-Wl,-fatal_warnings"],
++        "//conditions:default": ["-Werror", "-Wl,--fatal-warnings"],
++    }),
++)
++
++cc_feature(
++    name = "treat_warnings_as_errors",
++    feature_name = "treat_warnings_as_errors",
++    args = [
++        ":warnings_as_errors_compile_flags",
