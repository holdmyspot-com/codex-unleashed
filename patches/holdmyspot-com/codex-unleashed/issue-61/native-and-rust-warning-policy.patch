diff --git a/tools/build-warnings/check.sh b/tools/build-warnings/check.sh
new file mode 100644
index 000000000..1d8567daa
--- /dev/null
+++ b/tools/build-warnings/check.sh
@@ -0,0 +1,32 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
+cd -- "$repo_root"
+probe_dir="$(mktemp -d "${TMPDIR:?TMPDIR must identify owned temporary storage}/codex-build-warnings-XXXXXX")"
+trap 'rm -r -- "$probe_dir"' EXIT
+
+# A clean build distinguishes policy enforcement from an unavailable compiler.
+if ! bazel build "$@" //tools/build-warnings:clean >"$probe_dir/clean.log" 2>&1; then
+    cat -- "$probe_dir/clean.log"
+    exit 1
+fi
+
+if bazel build "$@" //tools/build-warnings:compiler_warning >"$probe_dir/warning.log" 2>&1; then
+    cat -- "$probe_dir/warning.log"
+    echo "The C compiler accepts warnings; warnings must fail the build." >&2
+    exit 1
+fi
+
+if grep -Eq 'error.*codex_build_warning_probe|codex_build_warning_probe.*error' "$probe_dir/warning.log"; then
+    :
+elif grep -q 'error C2220:' "$probe_dir/warning.log" &&
+    grep -Eq 'warning C4996:.*codex_build_warning_probe' "$probe_dir/warning.log"; then
+    :
+else
+    cat -- "$probe_dir/warning.log"
+    echo "The warning probe failed without its expected compiler error." >&2
+    exit 1
+fi
+
+echo "Native compiler warning enforcement passes."
