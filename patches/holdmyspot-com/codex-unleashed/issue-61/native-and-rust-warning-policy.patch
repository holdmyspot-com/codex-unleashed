diff --git a/tools/build-warnings/dependencies/flags_test.bzl b/tools/build-warnings/dependencies/flags_test.bzl
new file mode 100644
index 000000000..a1ebc0d33
--- /dev/null
+++ b/tools/build-warnings/dependencies/flags_test.bzl
@@ -0,0 +1,15 @@
+load("@bazel_skylib//lib:unittest.bzl", "analysistest", "asserts")
+
+def _dependency_warning_flags_test_impl(ctx):
+    env = analysistest.begin(ctx)
+    actions = [action for action in analysistest.target_actions(env) if action.mnemonic == "CppCompile"]
+    asserts.true(env, len(actions) > 0, "The dependency fixture must compile C++ sources")
+    for action in actions:
+        asserts.false(env, "-Werror" in action.argv, "Dependency warnings remain nonfatal")
+        asserts.true(env, "-Wextra" in action.argv, "Dependency warning diagnostics remain enabled")
+    return analysistest.end(env)
+
+dependency_warning_flags_test = analysistest.make(
+    _dependency_warning_flags_test_impl,
+    config_settings = {"//command_line_option:platforms": str(Label("//:rbe"))},
+)
