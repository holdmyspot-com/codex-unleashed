+From 89795f82a00454b26bdb53ef16468f165b4fe5c7 Mon Sep 17 00:00:00 2001
+From: Gili Tzabari <cowwoc2020@gmail.com>
+Date: Fri, 16 Oct 2026 01:13:01 -0400
+Subject: [PATCH] Keep dependency compiler warnings visible and nonfatal
+
+---
+ bazel/defs.bzl | 1 -
+ 1 file changed, 1 deletion(-)
+
+diff --git a/orig/v8-15.0.245.2/bazel/defs.bzl b/mod/v8-15.0.245.2/bazel/defs.bzl
+index 1281a73..eed886d 100644
+--- a/orig/v8-15.0.245.2/bazel/defs.bzl
++++ b/mod/v8-15.0.245.2/bazel/defs.bzl
+@@ -139,7 +139,6 @@ def _default_args():
+                 "-fPIC",
+                 "-fno-strict-aliasing",
+                 "-fconstexpr-steps=2000000",
+-                "-Werror",
+                 "-Wextra",
+                 "-Wno-unneeded-internal-declaration",
+                 "-Wno-unknown-warning-option", # b/330781959
