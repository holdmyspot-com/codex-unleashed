From a4899277cc336290592d4e44ecf721d35ff1e7a0 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Thu, 15 Oct 2026 12:34:28 -0400
Subject: [PATCH] Keep Libtool linker selection out of compile-only probes

Libtool uses LTCC both to compile its force_load capability probe and to
perform Darwin partial links. Select the system linker through a narrow
driver that omits the linker option for compile-only invocations, retaining
fatal compiler warnings and system-linker partial-link support.

Regression: the added LTCC compile invocation fails with Clang 23 against
the prerequisite queue with -Werror,-Wunused-command-line-argument. It
passes after this repair; the same test verifies normal and partial linker
selection and executes the compiled program. All 27 native-builder tests,
just fmt-check, and just bazel-lock-check pass. Native Darwin force_load
and complete voice-prefix build remain hosted acceptance gates.

Base: rust-v0.162.1 (092d3acd6bec3e3a14bdc7e7a2810ab628ab759d) with the
documented issue-61 prerequisite queue through zzzz-0016.
Evidence: .cat/work/temp/build-caches/windows-wrapper-gbpNjj/
libffi-ltcc-red.log, libffi-ltcc-green.log, libffi-ltcc-gates.log.
---
 third_party/voice/build_native.py      | 19 +++++++++++++++++--
 third_party/voice/test_build_native.py |  1 +
 2 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/third_party/voice/build_native.py b/third_party/voice/build_native.py
index a2c2d9660..4007781da 100644
--- a/third_party/voice/build_native.py
+++ b/third_party/voice/build_native.py
@@ -469,9 +469,24 @@ class NativeBuild:
 
                 # Libtool's partial links need -r, which ld64.lld does not support.
                 ffi_flags["LDFLAGS"].append("-fuse-ld=/usr/bin/ld")
-                environment["LTCC"] = self.quote(
-                    [str(self.toolchain["cc"]), "-fuse-ld=/usr/bin/ld"]
+                # LTCC also compiles feature probes, where linker flags are invalid.
+                # Its partial-link command omits LDFLAGS, so select the linker only
+                # when this driver is linking.
+                driver = ffi_build / "ltcc.sh"
+                if shlex.quote(str(driver)) != str(driver):
+                    raise ValueError("libffi driver path cannot require shell quoting")
+                compiler = shlex.quote(str(self.toolchain["cc"]))
+                driver.write_text(
+                    "#!/bin/sh\n"
+                    'for argument in "$@"; do\n'
+                    '  case "$argument" in\n'
+                    f'    -c|-E|-S|-fsyntax-only|-M|-MM) exec {compiler} "$@" ;;\n'
+                    "  esac\n"
+                    "done\n"
+                    f'exec {compiler} -fuse-ld=/usr/bin/ld "$@"\n'
                 )
+                driver.chmod(0o755)
+                environment["LTCC"] = str(driver)
             for name in ("ar", "ranlib"):
                 if name in self.toolchain:
                     path = str(self.toolchain[name])
diff --git a/third_party/voice/test_build_native.py b/third_party/voice/test_build_native.py
index fe5d46af6..a1e6d4fbd 100644
--- a/third_party/voice/test_build_native.py
+++ b/third_party/voice/test_build_native.py
@@ -231,6 +231,7 @@ class NativeBuildTests(unittest.TestCase):
         (build.output / "probe.c").write_text("int main(void) { return 0; }\n")
         for command in (
             "$CC $CFLAGS -c probe.c -o probe.o",
+            "$LTCC $CFLAGS -c probe.c -o libtool-probe.o",
             "$CC $LDFLAGS probe.o -o probe",
         ):
             result = subprocess.run(
-- 
