From 8eb340987ad0f86227356d95c60aef885cf9e885 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Thu, 15 Oct 2026 18:04:42 -0400
Subject: [PATCH] Preserve native Meson header detection with fatal warnings

Meson 1.12.1 emits unused value expressions when probing declared header symbols. Use a void expression for values and a separate pointer declaration for types. The test-only baseline fails at puts with unused-value under GCC 13 -Wall -Wextra -Werror. The prepared pinned Meson passes all eight function, variable, macro, enum, incomplete-type, and missing-symbol assertions. The native recipe probe exercises this fixture separately from the foreign-build Meson tool.
---
 third_party/voice/prepare_sources.py          | 28 +++++++++++++++++++
 tools/build-warnings/check-native-meson.py    |  2 ++
 .../meson/header-symbols/meson.build          | 11 ++++++++
 tools/build-warnings/meson/meson.build        |  5 ++++
 4 files changed, 46 insertions(+)
 create mode 100644 tools/build-warnings/meson/header-symbols/meson.build

diff --git a/third_party/voice/prepare_sources.py b/third_party/voice/prepare_sources.py
index 8f43f1602..39d8e23a7 100644
--- a/third_party/voice/prepare_sources.py
+++ b/third_party/voice/prepare_sources.py
@@ -115,6 +115,34 @@ def extract_source(source: Source, archives: Path, destination: Path) -> None:
                 )
         metadata.write_text(contents, encoding="utf-8")
 
+    if source.name == "meson" and source.version == "1.12.1":
+        # WORKAROUND: https://github.com/holdmyspot-com/codex-unleashed/issues/61
+        # Use value and type probes without unused expressions or declarations.
+        # Remove when Meson detects header symbols with fatal compiler warnings.
+        compiler = destination / source.root / "mesonbuild/compilers/c.py"
+        contents = compiler.read_text(encoding="utf-8")
+        replacements = (
+            ("                {symbol};", "                (void) {symbol};"),
+            (
+                "        return self.compiles(t.format(**fargs), extra_args=extra_args,\n"
+                "                             dependencies=dependencies)",
+                "        found, cached = self.compiles(t.format(**fargs), extra_args=extra_args,\n"
+                "                                     dependencies=dependencies)\n"
+                "        if found:\n"
+                "            return found, cached\n"
+                "        type_probe = t.replace('(void) {symbol};',\n"
+                "                               '{symbol} *meson_symbol = 0; (void) meson_symbol;')\n"
+                "        found, type_cached = self.compiles(type_probe.format(**fargs),\n"
+                "                                           extra_args=extra_args, dependencies=dependencies)\n"
+                "        return found, cached and type_cached",
+            ),
+        )
+        for original, replacement in replacements:
+            if contents.count(original) != 1:
+                raise ValueError("Pinned Meson header symbol probe does not match")
+            contents = contents.replace(original, replacement)
+        compiler.write_text(contents, encoding="utf-8")
+
     if source.name == "glib" and source.version == "2.88.3":
         # WORKAROUND: GLib's bundled gnulib has incomplete warning portability.
         # https://github.com/holdmyspot-com/codex-unleashed/issues/61
diff --git a/tools/build-warnings/check-native-meson.py b/tools/build-warnings/check-native-meson.py
index aaff86670..09625781d 100644
--- a/tools/build-warnings/check-native-meson.py
+++ b/tools/build-warnings/check-native-meson.py
@@ -69,6 +69,8 @@ def main():
         builder.environment["LD"] = str(linker)
         try:
             builder.meson("probe", [])
+            builder.sources["header-symbols"] = source / "header-symbols"
+            builder.meson("header-symbols", [])
             meson_log = builder.output / "build/probe/meson-logs/meson-log.txt"
             sanity_commands = [
                 shlex.split(line.removeprefix("Sanity check compiler command line: "))
diff --git a/tools/build-warnings/meson/header-symbols/meson.build b/tools/build-warnings/meson/header-symbols/meson.build
new file mode 100644
index 000000000..585a759d1
--- /dev/null
+++ b/tools/build-warnings/meson/header-symbols/meson.build
@@ -0,0 +1,11 @@
+project('native-header-symbols', 'c')
+
+cc = meson.get_compiler('c')
+assert(cc.has_header_symbol('stdio.h', 'puts'), 'Declared function detection must succeed')
+assert(cc.has_header_symbol('stddef.h', 'size_t'), 'Declared type detection must succeed')
+assert(cc.has_header_symbol('stdio.h', 'EOF'), 'Declared macro detection must succeed')
+assert(cc.has_header_symbol('stdio.h', 'stdin'), 'Declared variable detection must succeed')
+assert(cc.has_header_symbol('stddef.h', 'probe_variable', prefix: 'extern int probe_variable;'), 'Non-macro variable detection must succeed')
+assert(cc.has_header_symbol('stddef.h', 'probe_enum', prefix: 'enum { probe_enum = 1 };'), 'Declared enum detection must succeed')
+assert(cc.has_header_symbol('stddef.h', 'probe_type', prefix: 'typedef struct incomplete probe_type;'), 'Incomplete type detection must succeed')
+assert(not cc.has_header_symbol('stdio.h', 'codex_unleashed_missing_symbol'), 'Unavailable symbol detection must fail')
diff --git a/tools/build-warnings/meson/meson.build b/tools/build-warnings/meson/meson.build
index 9b000ac3a..4d5018ea8 100644
--- a/tools/build-warnings/meson/meson.build
+++ b/tools/build-warnings/meson/meson.build
@@ -1,3 +1,8 @@
 project('resource-probe', ['c', 'cpp'], default_options: ['cpp_std=c++20'])
+
+cc = meson.get_compiler('c')
+assert(cc.has_function('puts', prefix: '#include <stdio.h>'), 'Standard C function detection must succeed')
+assert(not cc.has_function('codex_unleashed_missing_function'), 'Unavailable function detection must fail')
+
 probe = static_library('probe', 'probe.c')
 executable('resource-probe', 'main.cc', link_with: probe)
-- 
2.43.0

