From 9ebd9b657bd042e9f9b31675bd69569322873e78 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Wed, 14 Oct 2026 08:13:27 +0000
Subject: [PATCH] Backport AWS-LC fork-detection state guards

Backport upstream c3661cc41520da201defbdadfb281d808d0837f6
(PR #3645) to AWS-LC 5.1.0.bcr.1. Test-only setters remain
no-ops on platforms without fork-UBE detection; supported platforms
retain their locking and detection state.

Include a random-generation regression around both test hooks.

Verification: bazel build @aws-lc//:crypto
--platforms=//:windows_x86_64_gnullvm
--output_groups=compilation_outputs --keep_going reproduces both
unused-global diagnostics before the backport and passes afterwards.
The focused fork_detection_test passes on Linux. Maintained
just fmt-check and just bazel-lock-check pass. Logs:
aws-fork-globals-{red,green}.log, aws-fork-detection-runtime-green.log,
aws-fork-{fmt,lock}-check.log in llvm-toolchain task evidence.
---
 MODULE.bazel                                  |  5 +-
 patches/aws_lc_fork_unused_globals.patch      | 66 +++++++++++++++++++
 tools/build-warnings/aws-lc/BUILD.bazel       |  9 +++
 .../aws-lc/fork_detection_test.c              | 17 +++++
 4 files changed, 96 insertions(+), 1 deletion(-)
 create mode 100644 patches/aws_lc_fork_unused_globals.patch
 create mode 100644 tools/build-warnings/aws-lc/fork_detection_test.c

diff --git a/MODULE.bazel b/MODULE.bazel
index 8c1fe892d..5a31af695 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -163,7 +163,10 @@ bazel_dep(name = "aws-lc", version = "5.1.0.bcr.1")
 single_version_override(
     module_name = "aws-lc",
     patch_strip = 1,
-    patches = ["//patches:aws_lc_windows_tls.patch"],
+    patches = [
+        "//patches:aws_lc_windows_tls.patch",
+        "//patches:aws_lc_fork_unused_globals.patch",
+    ],
 )

 bazel_dep(name = "rules_rs", version = "0.0.96")
diff --git a/patches/aws_lc_fork_unused_globals.patch b/patches/aws_lc_fork_unused_globals.patch
new file mode 100644
index 000000000..6bcf727de
--- /dev/null
+++ b/patches/aws_lc_fork_unused_globals.patch
@@ -0,0 +1,66 @@
+diff --git a/crypto/ube/fork_ube_detect.c b/crypto/ube/fork_ube_detect.c
+--- a/crypto/ube/fork_ube_detect.c
++++ b/crypto/ube/fork_ube_detect.c
+@@ -32,12 +32,12 @@
+ #include "fork_ube_detect.h"
+ #include "../internal.h"
+
++#if defined(AWSLC_FORK_UBE_DETECTION_SUPPORTED)
++
+ static struct CRYPTO_STATIC_MUTEX ignore_testing_lock = CRYPTO_STATIC_MUTEX_INIT;
+ static int ignore_wipeonfork = 0;
+ static int ignore_inheritzero = 0;
+
+-#if defined(AWSLC_FORK_UBE_DETECTION_SUPPORTED)
+-
+ #include <openssl/base.h>
+ #include <openssl/type_check.h>
+
+@@ -66,6 +66,18 @@ static int ignore_all_fork_ube_detection(void) {
+   return 0;
+ }
+
++void CRYPTO_fork_detect_ignore_wipeonfork_FOR_TESTING(void) {
++  CRYPTO_STATIC_MUTEX_lock_write(&ignore_testing_lock);
++  ignore_wipeonfork = 1;
++  CRYPTO_STATIC_MUTEX_unlock_write(&ignore_testing_lock);
++}
++
++void CRYPTO_fork_detect_ignore_inheritzero_FOR_TESTING(void) {
++  CRYPTO_STATIC_MUTEX_lock_write(&ignore_testing_lock);
++  ignore_inheritzero = 1;
++  CRYPTO_STATIC_MUTEX_unlock_write(&ignore_testing_lock);
++}
++
+ #if defined(OPENSSL_LINUX)
+
+ #include <sys/mman.h>
+@@ -265,6 +277,8 @@ uint64_t CRYPTO_get_fork_ube_generation(void) {
+ // assume address space duplication is not a concern and adding entropy to
+ // every RAND_bytes call is not needed.
+ uint64_t CRYPTO_get_fork_ube_generation(void) { return 0xc0ffee; }
++void CRYPTO_fork_detect_ignore_wipeonfork_FOR_TESTING(void) {}
++void CRYPTO_fork_detect_ignore_inheritzero_FOR_TESTING(void) {}
+
+ #else
+
+@@ -273,17 +287,7 @@ uint64_t CRYPTO_get_fork_ube_generation(void) { return 0xc0ffee; }
+ // space duplication could have occured on any call entropy must be added to
+ // every RAND_bytes call.
+ uint64_t CRYPTO_get_fork_ube_generation(void) { return 0; }
++void CRYPTO_fork_detect_ignore_wipeonfork_FOR_TESTING(void) {}
++void CRYPTO_fork_detect_ignore_inheritzero_FOR_TESTING(void) {}
+
+ #endif // defined(AWSLC_FORK_UBE_DETECTION_SUPPORTED)
+-
+-void CRYPTO_fork_detect_ignore_wipeonfork_FOR_TESTING(void) {
+-  CRYPTO_STATIC_MUTEX_lock_write(&ignore_testing_lock);
+-  ignore_wipeonfork = 1;
+-  CRYPTO_STATIC_MUTEX_unlock_write(&ignore_testing_lock);
+-}
+-
+-void CRYPTO_fork_detect_ignore_inheritzero_FOR_TESTING(void) {
+-  CRYPTO_STATIC_MUTEX_lock_write(&ignore_testing_lock);
+-  ignore_inheritzero = 1;
+-  CRYPTO_STATIC_MUTEX_unlock_write(&ignore_testing_lock);
+-}
diff --git a/tools/build-warnings/aws-lc/BUILD.bazel b/tools/build-warnings/aws-lc/BUILD.bazel
index cfde8a33d..7cd14ab83 100644
--- a/tools/build-warnings/aws-lc/BUILD.bazel
+++ b/tools/build-warnings/aws-lc/BUILD.bazel
@@ -1,4 +1,13 @@
+load("@rules_cc//cc:cc_test.bzl", "cc_test")
+
 test_suite(
     name = "thread_test",
     tests = ["@aws-lc//:thread_test"],
 )
+
+cc_test(
+    name = "fork_detection_test",
+    size = "small",
+    srcs = ["fork_detection_test.c"],
+    deps = ["@aws-lc//:crypto"],
+)
diff --git a/tools/build-warnings/aws-lc/fork_detection_test.c b/tools/build-warnings/aws-lc/fork_detection_test.c
new file mode 100644
index 000000000..f043a35bd
--- /dev/null
+++ b/tools/build-warnings/aws-lc/fork_detection_test.c
@@ -0,0 +1,17 @@
+#include <openssl/rand.h>
+
+void CRYPTO_fork_detect_ignore_wipeonfork_FOR_TESTING(void);
+void CRYPTO_fork_detect_ignore_inheritzero_FOR_TESTING(void);
+
+int main(void) {
+    unsigned char bytes[32];
+    if (RAND_bytes(bytes, sizeof(bytes)) != 1) {
+        return 1;
+    }
+    CRYPTO_fork_detect_ignore_wipeonfork_FOR_TESTING();
+    CRYPTO_fork_detect_ignore_inheritzero_FOR_TESTING();
+    if (RAND_bytes(bytes, sizeof(bytes)) != 1) {
+        return 2;
+    }
+    return 0;
+}
