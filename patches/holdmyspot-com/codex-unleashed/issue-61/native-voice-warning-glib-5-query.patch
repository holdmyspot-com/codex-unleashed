From 1b9667330c36ccfad7f17aa3b96e449f979ea0b6 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Wed, 14 Oct 2026 13:13:33 +0000
Subject: [PATCH] Remove unused GLib query storage while preserving its CLI

Track native warning enforcement in #61. Apply after the documented native
voice prerequisites; keep all compiler and linker checks enabled.

Reproduction evidence: native-glib-final-green.log. The actual native recipe reports the
missing outcome under LLVM 23. Runtime and fresh emitted-queue acceptance
are recorded separately; an internal authoring commit is not full CI acceptance.
---
 third_party/voice/prepare_sources.py          | 17 +++++++
 .../build-warnings/check-native-glib-query.py | 47 +++++++++++++++++++
 2 files changed, 64 insertions(+)
 create mode 100644 tools/build-warnings/check-native-glib-query.py

diff --git a/third_party/voice/prepare_sources.py b/third_party/voice/prepare_sources.py
index e2369a0fd..49ef5717d 100644
--- a/third_party/voice/prepare_sources.py
+++ b/third_party/voice/prepare_sources.py
@@ -172,6 +172,23 @@ def extract_source(source: Source, archives: Path, destination: Path) -> None:
             raise ValueError("Pinned GLib task trace counters do not match")
         task.write_text(contents.replace(original, replacement), encoding="utf-8")
 
+        # WORKAROUND: remove the unused storage identified by GLib upstream.
+        # https://github.com/GNOME/glib/commit/11de1d730e58c1f501e3a5d4c65b283fb8a26e0f
+        # Preserve the pinned release's accepted -s option and help text.
+        # Remove when the selected GLib release includes the upstream fix.
+        query = destination / source.root / "gobject/gobject-query.c"
+        contents = query.read_text(encoding="utf-8")
+        for original, replacement in (
+            ("static guint spacing = 1;\n", ""),
+            ("spacing = atoi (argv[i]);", "(void) atoi (argv[i]);"),
+        ):
+            if contents.count(original) != 1:
+                raise ValueError(
+                    "Pinned GLib query spacing implementation does not match"
+                )
+            contents = contents.replace(original, replacement)
+        query.write_text(contents, encoding="utf-8")
+
     if source.name == "ninja" and source.version == "1.13.2":
         # WORKAROUND: the pinned Ninja lacks an explicit bundled-lexer mode.
         # https://github.com/holdmyspot-com/codex-unleashed/issues/61
diff --git a/tools/build-warnings/check-native-glib-query.py b/tools/build-warnings/check-native-glib-query.py
new file mode 100644
index 000000000..23642a1a1
--- /dev/null
+++ b/tools/build-warnings/check-native-glib-query.py
@@ -0,0 +1,47 @@
+#!/usr/bin/env python3
+"""Verify the built GLib query tool preserves its accepted spacing option."""
+
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tarfile
+import tempfile
+
+
+def main() -> None:
+    archive = Path(sys.argv[1]).resolve(strict=True)
+    with tempfile.TemporaryDirectory(prefix="native-glib-query-") as temporary:
+        prefix = Path(temporary)
+        with tarfile.open(archive) as source:
+            source.extractall(prefix, filter="data")
+        executable = prefix / "bin/gobject-query"
+        environment = os.environ | {"LD_LIBRARY_PATH": str(prefix / "lib")}
+
+        def query(*arguments: str) -> str:
+            result = subprocess.run(
+                [str(executable), *arguments],
+                env=environment,
+                text=True,
+                capture_output=True,
+                check=True,
+            )
+            if result.stderr:
+                raise RuntimeError(result.stderr)
+            return result.stdout
+
+        expected = query("tree")
+        if "GObject" not in expected:
+            raise AssertionError("Query does not print its type tree")
+        for spacing in ("0", "2", "4096"):
+            if query("tree", "-s", spacing) != expected:
+                raise AssertionError(
+                    f"Accepted spacing option changes output: {spacing}"
+                )
+        if "-s" not in query("--help"):
+            raise AssertionError("Pinned query help omits its accepted spacing option")
+        print("GLib query accepts -s and preserves its type-tree output")
+
+
+if __name__ == "__main__":
+    main()
