From f71b82d0f0ca721c03c0e9578ef18e1ef03a2e35 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <gili@holdmyspot.com>
Date: Wed, 14 Oct 2026 19:02:51 +0000
Subject: [PATCH] Run Codespell in an isolated uv tool environment

Preserve the Docker action's Codespell requirement, repository configuration,
ignore list, count output and nonzero exit status while avoiding root pip
installation. Cache the isolated tool dependencies using the workflow input.

Hosted red: main CI job 116035673205 emits pip's root-user warning while
building the Codespell action image. Its latest stable v2.4.3 retains the
same root installation.

Green: the equivalent isolated command passes the complete fork repository
spelling check without warning diagnostics. The maintained authoring
just fmt-check passes. Full upstream spelling results remain separate:
the authoring checkout contains source and generated-file findings that
require a clean baseline comparison before attribution.
---
 .github/workflows/codespell.yml | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/.github/workflows/codespell.yml b/.github/workflows/codespell.yml
index 996b3dedd..9fa1ef092 100644
--- a/.github/workflows/codespell.yml
+++ b/.github/workflows/codespell.yml
@@ -20,10 +20,13 @@ jobs:
           persist-credentials: false
       - name: Annotate locations with typos
         uses: codespell-project/codespell-problem-matcher@b80729f885d32f78a716c2f107b4db1025001c42 # v1.1.0
-      - name: Codespell
-        uses: codespell-project/actions-codespell@8f01853be192eb0f849a5c7d721450e7a467c579 # v2.2
+      - name: Install uv
+        uses: astral-sh/setup-uv@08807647e7069bb48b6ef5acd8ec9567f424441b # v8.1.0
         with:
-          ignore_words_file: .codespellignore
+          version: "0.11.3"
+          cache-dependency-glob: .github/workflows/codespell.yml
+      - name: Codespell
+        run: uv tool run --from 'codespell[toml]>=2.2.4' codespell --count --skip ./.git --ignore-words .codespellignore

       - name: Check for a clean worktree
         if: always() && !cancelled()
