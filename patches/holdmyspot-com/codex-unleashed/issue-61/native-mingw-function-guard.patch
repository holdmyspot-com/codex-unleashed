diff --git a/tools/build-warnings/mingw_function_guard.bzl b/tools/build-warnings/mingw_function_guard.bzl
new file mode 100644
index 000000000..14cb6a085
--- /dev/null
+++ b/tools/build-warnings/mingw_function_guard.bzl
@@ -0,0 +1,28 @@
+load("@bazel_lib//lib:diff_test.bzl", "diff_test")
+
+def define_mingw_function_guard_tests():
+    """Check MinGW function guards with strict preprocessing for both Windows CPUs."""
+    for architecture in ["x86_64", "aarch64"]:
+        name = "mingw_function_guard_" + architecture
+        native.genrule(
+            name = name,
+            srcs = [
+                "mingw_function_guard.c",
+                "@llvm//runtimes/mingw:function_definitions",
+            ],
+            outs = [name + ".txt"],
+            cmd = " ".join([
+                '"$(execpath @llvm//tools:clang)"',
+                "-fsyntax-only -x c -std=c11 -Werror",
+                "-target " + architecture + "-w64-windows-gnu",
+                '-include "$(execpath @llvm//runtimes/mingw:function_definitions)"',
+                '"$(execpath mingw_function_guard.c)"',
+                '&& echo guard-ok > "$@"',
+            ]),
+            tools = ["@llvm//tools:clang"],
+        )
+        diff_test(
+            name = name + "_test",
+            file1 = ":" + name,
+            file2 = ["guard-ok", ""],
+        )
diff --git a/tools/build-warnings/mingw_function_guard.c b/tools/build-warnings/mingw_function_guard.c
new file mode 100644
index 000000000..52300ac20
--- /dev/null
+++ b/tools/build-warnings/mingw_function_guard.c
@@ -0,0 +1,14 @@
+enum {
+    native_x86 = 0 F_X86_NATIVE(+1),
+    native_arm = 0 F_ARM_NATIVE(+1),
+};
+
+#if defined(__x86_64__)
+_Static_assert(native_x86 == 1, "x86-64 native symbols remain enabled");
+_Static_assert(native_arm == 0, "ARM native symbols remain disabled on x86-64");
+#elif defined(__aarch64__)
+_Static_assert(native_x86 == 0, "x86 native symbols remain disabled on ARM64");
+_Static_assert(native_arm == 1, "ARM64 native symbols remain enabled");
+#else
+#error Unsupported MinGW guard test architecture
+#endif
