From e8ae1ba1a8cb64a98479295b84aea94c8ce145cc Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Wed, 14 Oct 2026 23:45:52 +0000
Subject: [PATCH] Declare the underlying Ninja executable for bundled Opus

The baseline bundled_opus_test fails because the foreign-build Ninja wrapper requires EXT_BUILD_ROOT. Declare Ninja 1.13.2 directly at the version already selected by rules_foreign_cc, inject its repository into the crate, and let execpath expansion supply the absolute executable path. The actual bundled codec now builds, links and returns its version string on Linux.
---
 MODULE.bazel                                   | 12 +++++-------
 tools/build-warnings/opus/BUILD.bazel          |  9 +++++++++
 tools/build-warnings/opus/bundled_opus_test.rs |  6 ++++++
 3 files changed, 20 insertions(+), 7 deletions(-)
 create mode 100644 tools/build-warnings/opus/BUILD.bazel
 create mode 100644 tools/build-warnings/opus/bundled_opus_test.rs

diff --git a/MODULE.bazel b/MODULE.bazel
index 29a70dc88..c2e865e10 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -187,6 +187,7 @@ single_version_override(
 )

 bazel_dep(name = "make", version = "4.4.1.bcr.2")
+bazel_dep(name = "ninja", version = "1.13.2")
 bazel_dep(name = "rules_cc_autoconf", version = "0.27.0")

 single_version_override(
@@ -687,15 +688,12 @@ crate.annotation(
         "CMAKE": "$${pwd}/$(CMAKE)",
         "CMAKE_GENERATOR": "Ninja",
         "CMAKE_TOOLCHAIN_FILE": "$(execpath @@//third_party/voice:opus-toolchain.cmake)",
-        "CODEX_VOICE_NINJA": "$${pwd}/$(NINJA)",
+        "CODEX_VOICE_NINJA": "$(execpath @ninja//:ninja)",
     },
-    build_script_toolchains = [
-        "@rules_foreign_cc//toolchains:current_cmake_toolchain",
-        "@rules_foreign_cc//toolchains:current_ninja_toolchain",
-    ],
+    build_script_toolchains = ["@rules_foreign_cc//toolchains:current_cmake_toolchain"],
     build_script_tools = [
+        "@ninja//:ninja",
         "@rules_foreign_cc//toolchains:current_cmake_toolchain",
-        "@rules_foreign_cc//toolchains:current_ninja_toolchain",
     ],
     crate = "opusic-sys",
 )
@@ -721,7 +719,7 @@ crate.annotation(
     ],
 )

-inject_repo(crate, "rules_foreign_cc")
+inject_repo(crate, "ninja", "rules_foreign_cc")

 crate.annotation(
     # Provide the hermetic SDK path so the build script doesn't try to invoke an unavailable `xcrun --show-sdk-path`.
diff --git a/tools/build-warnings/opus/BUILD.bazel b/tools/build-warnings/opus/BUILD.bazel
new file mode 100644
index 000000000..200ddeebf
--- /dev/null
+++ b/tools/build-warnings/opus/BUILD.bazel
@@ -0,0 +1,9 @@
+load("@rules_rs//rs:rust_test.bzl", "rust_test")
+
+rust_test(
+    name = "bundled_opus_test",
+    size = "small",
+    srcs = ["bundled_opus_test.rs"],
+    edition = "2024",
+    deps = ["@crates//:opusic-sys-0.7.5"],
+)
diff --git a/tools/build-warnings/opus/bundled_opus_test.rs b/tools/build-warnings/opus/bundled_opus_test.rs
new file mode 100644
index 000000000..48d5f9093
--- /dev/null
+++ b/tools/build-warnings/opus/bundled_opus_test.rs
@@ -0,0 +1,6 @@
+#[test]
+fn bundled_opus_links() {
+    // SAFETY: Opus returns a pointer to a static, NUL-terminated version string.
+    let version = unsafe { std::ffi::CStr::from_ptr(opusic_sys::opus_get_version_string()) };
+    assert!(version.to_bytes().starts_with(b"libopus "));
+}
