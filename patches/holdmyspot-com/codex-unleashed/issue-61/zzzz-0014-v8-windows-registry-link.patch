diff --git a/tools/build-warnings/v8-link-metadata/check-link-metadata.sh b/tools/build-warnings/v8-link-metadata/check-link-metadata.sh
new file mode 100644
index 000000000..d3843101e
--- /dev/null
+++ b/tools/build-warnings/v8-link-metadata/check-link-metadata.sh
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+build_script="${TEST_SRCDIR}/${TEST_WORKSPACE}/{build_script}"
+for target in x86_64-pc-windows-gnullvm aarch64-pc-windows-gnullvm x86_64-pc-windows-msvc aarch64-pc-windows-msvc x86_64-unknown-linux-gnu aarch64-apple-darwin; do
+  target_os=windows
+  target_env=gnu
+  case "$target" in
+    *-msvc) target_env=msvc ;;
+    *-linux-*) target_os=linux ;;
+    *-darwin) target_os=macos; target_env='' ;;
+  esac
+  output="$(env -u DOCS_RS -u CARGO -u GN_ARGS -u CXXSTDLIB \
+    DENO_TRYBUILD=1 TARGET="$target" CARGO_CFG_TARGET_OS="$target_os" \
+    CARGO_CFG_TARGET_ENV="$target_env" CARGO_CFG_TARGET_FEATURE=crt-static \
+    CARGO_FEATURE_USE_CUSTOM_LIBCXX=1 RUSTY_V8_SRC_BINDING_PATH=unused-binding.rs \
+    "$build_script")"
+  printf '%s\n%s\n' "$target" "$output"
+  grep -Fxq 'cargo:rustc-link-lib=static=rusty_v8' <<< "$output"
+
+  if [[ "$target_os" == windows ]]; then
+    for library in winmm dbghelp advapi32; do
+      [[ "$(grep -Fxc "cargo:rustc-link-lib=dylib=$library" <<< "$output")" == 1 ]]
+    done
+  elif grep -Eq '^cargo:rustc-link-lib=dylib=(winmm|dbghelp|advapi32)$' <<< "$output"; then
+    echo 'Windows system libraries leaked into another target.' >&2
+    exit 1
+  fi
+done
diff --git a/tools/build-warnings/v8-link-metadata/link_metadata_test.bzl b/tools/build-warnings/v8-link-metadata/link_metadata_test.bzl
new file mode 100644
index 000000000..4c0bfd30d
--- /dev/null
+++ b/tools/build-warnings/v8-link-metadata/link_metadata_test.bzl
@@ -0,0 +1,24 @@
+"""Run the crate's actual build script without downloading a V8 archive."""
+
+def _link_metadata_test_impl(ctx):
+    executable = ctx.actions.declare_file(ctx.label.name + ".sh")
+    ctx.actions.expand_template(
+        template = ctx.file._script,
+        output = executable,
+        substitutions = {"{build_script}": ctx.executable.build_script.short_path},
+        is_executable = True,
+    )
+    runfiles = ctx.runfiles(files = [ctx.executable.build_script])
+    return [DefaultInfo(
+        executable = executable,
+        runfiles = runfiles.merge(ctx.attr.build_script[DefaultInfo].default_runfiles),
+    )]
+
+link_metadata_test = rule(
+    implementation = _link_metadata_test_impl,
+    test = True,
+    attrs = {
+        "build_script": attr.label(mandatory = True, executable = True, cfg = "exec"),
+        "_script": attr.label(default = "check-link-metadata.sh", allow_single_file = True),
+    },
+)
