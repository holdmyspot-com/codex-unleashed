+++ b/patches/aws_lc_c_standard.patch
@@ -0,0 +1,128 @@
+From ee19061fb0a04cfb2326ff71993fabd820de815d Mon Sep 17 00:00:00 2001
+From: Gili Tzabari <cowwoc2020@gmail.com>
+Date: Thu, 15 Oct 2026 12:00:48 +0000
+Subject: [PATCH] Select the AWS-LC C standard exactly once
+
+---
+ BUILD.bazel | 16 +++++++++++++++-
+ 1 file changed, 15 insertions(+), 1 deletion(-)
+
+diff --git a/BUILD.bazel b/BUILD.bazel
+index 0ef1de0..e1d96c3 100755
+--- a/BUILD.bazel
++++ b/BUILD.bazel
+@@ -30,8 +30,13 @@ BORINGSSL_CONLYOPTS = select({
+     "@rules_cc//cc/compiler:msvc-cl": ["/std:c11"],
+     "//conditions:default": ["-std=c11"],
+ })
+
++# WORKAROUND: https://github.com/holdmyspot-com/codex-unleashed/issues/61
++# AWS-LC chooses C11 explicitly. Remove when its Bazel build disables the
++# toolchain's default C standard instead of passing a conflicting flag.
++BORINGSSL_FEATURES = ["-default_c_std"]
++
+ BORINGSSL_CXXOPTS = select({
+     "@platforms//os:windows": [],
+     "//conditions:default": [
+         "-fno-exceptions",
+@@ -227,9 +232,9 @@ cc_library(
+             "-fvisibility=hidden",
+         ],
+     }) + BORINGSSL_COPTS,
+     cxxopts = BORINGSSL_CXXOPTS,
+-    features = ["-opt"],
++    features = ["-opt"] + BORINGSSL_FEATURES,
+     includes = [
+         "include",
+         "third_party/jitterentropy/jitterentropy-library",
+     ],
+@@ -503,8 +508,9 @@ cc_library(
+     ),
+     conlyopts = BORINGSSL_CONLYOPTS,
+     copts = COMMON_COPTS + BORINGSSL_COPTS,
+     cxxopts = BORINGSSL_CXXOPTS,
++    features = BORINGSSL_FEATURES,
+     implementation_deps = [
+         ":jitterentropy",
+     ],
+     includes = [
+@@ -566,8 +572,9 @@ cc_library(
+     ),
+     conlyopts = BORINGSSL_CONLYOPTS,
+     copts = COMMON_COPTS + BORINGSSL_COPTS,
+     cxxopts = BORINGSSL_CXXOPTS,
++    features = BORINGSSL_FEATURES,
+     includes = ["include"],
+     visibility = ["//visibility:public"],
+     deps = [
+         ":crypto",
+@@ -586,8 +593,9 @@ cc_binary(
+     ),
+     conlyopts = BORINGSSL_CONLYOPTS,
+     copts = COMMON_COPTS + BORINGSSL_COPTS,
+     cxxopts = BORINGSSL_CXXOPTS,
++    features = BORINGSSL_FEATURES,
+     includes = [
+         "include",
+         "tool",
+     ],
+@@ -614,8 +622,9 @@ cc_library(
+     hdrs = glob(["crypto/test/*.h"]),
+     conlyopts = BORINGSSL_CONLYOPTS,
+     copts = TEST_COPTS + BORINGSSL_COPTS,
+     cxxopts = BORINGSSL_CXXOPTS,
++    features = BORINGSSL_FEATURES,
+     includes = ["include"],
+     local_defines = ["BORINGSSL_USE_BAZEL_RUNFILES"],
+     deps = [
+         ":crypto",
+@@ -636,8 +645,9 @@ cc_library(
+     ],
+     conlyopts = BORINGSSL_CONLYOPTS,
+     copts = TEST_COPTS + BORINGSSL_COPTS,
+     cxxopts = BORINGSSL_CXXOPTS,
++    features = BORINGSSL_FEATURES,
+     includes = ["crypto/test"],
+     deps = [
+         ":crypto_test_support",
+         "@googletest//:gtest",
+@@ -763,8 +773,9 @@ cc_test(
+     ],
+     conlyopts = BORINGSSL_CONLYOPTS,
+     copts = TEST_COPTS + ["-DAWS_LC_TEST_ENV"] + BORINGSSL_COPTS,
+     cxxopts = BORINGSSL_CXXOPTS,
++    features = BORINGSSL_FEATURES,
+     data = CRYPTO_TEST_DATA,
+     linkstatic = True,
+     shard_count = 30,
+     deps = [
+@@ -781,8 +792,9 @@ cc_test(
+     srcs = ["crypto/rand_extra/urandom_test.cc"],
+     conlyopts = BORINGSSL_CONLYOPTS,
+     copts = TEST_COPTS + BORINGSSL_COPTS,
+     cxxopts = BORINGSSL_CXXOPTS,
++    features = BORINGSSL_FEATURES,
+     data = CRYPTO_TEST_DATA,
+     deps = [
+         ":crypto",
+         ":crypto_test_support",
+@@ -812,8 +824,9 @@ cc_test(
+     ],
+     conlyopts = BORINGSSL_CONLYOPTS,
+     copts = TEST_COPTS + BORINGSSL_COPTS,
+     cxxopts = BORINGSSL_CXXOPTS,
++    features = BORINGSSL_FEATURES,
+     data = CRYPTO_TEST_DATA,
+     linkstatic = True,
+     deps = [
+         ":boringssl_gtest_main",
+@@ -829,8 +842,9 @@ cc_test(
+     srcs = ["crypto/thread_local_cleanup_test.cc"],
+     conlyopts = BORINGSSL_CONLYOPTS,
+     copts = COMMON_COPTS + BORINGSSL_COPTS,
+     cxxopts = BORINGSSL_CXXOPTS,
++    features = BORINGSSL_FEATURES,
+     linkstatic = True,
+     visibility = ["//visibility:public"],
+     deps = [
+         ":crypto",
