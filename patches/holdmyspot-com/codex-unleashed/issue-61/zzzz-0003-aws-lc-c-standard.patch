 patches/BUILD.bazel                           |   1 +
 patches/aws_lc_c_standard.patch               | 128 ++++++++++++++++++
 tools/build-warnings/aws-lc/BUILD.bazel       |  11 ++
 .../aws-lc/standard_flags_test.bzl            |  25 ++++
 5 files changed, 166 insertions(+)
 create mode 100644 patches/aws_lc_c_standard.patch
 create mode 100644 tools/build-warnings/aws-lc/standard_flags_test.bzl

diff --git a/MODULE.bazel b/MODULE.bazel
