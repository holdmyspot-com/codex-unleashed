 patches/openssl_assembly_defines.patch       | 695 +++++++++++++++++++
 tools/build-warnings/openssl/BUILD.bazel     |   8 +-
 tools/build-warnings/openssl/inputs_test.bzl |  38 +
 4 files changed, 741 insertions(+), 1 deletion(-)
 create mode 100644 patches/openssl_assembly_defines.patch

