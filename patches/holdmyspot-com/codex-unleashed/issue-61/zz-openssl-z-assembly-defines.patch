@@ -1,4 +1,5 @@
 load("@bazel_skylib//lib:unittest.bzl", "analysistest", "asserts")
+load("@rules_cc//cc/common:cc_info.bzl", "CcInfo")

 def _openssl_install_inputs_test_impl(ctx):
     env = analysistest.begin(ctx)
@@ -39,3 +40,40 @@ openssl_windows_defines_test = analysistest.make(
         "//command_line_option:features": ["static_link_msvcrt", "-dynamic_link_msvcrt"],
     },
 )
+
+def _openssl_assembly_defines_test_impl(ctx):
+    env = analysistest.begin(ctx)
+    actions = analysistest.target_actions(env)
+    assembly_actions = [
+        action
+        for action in actions
+        if action.mnemonic == "CppCompile" and any([arg.endswith(".s") for arg in action.argv])
+    ]
+    asserts.true(env, len(assembly_actions) > 0, "OpenSSL must compile its generated raw assembly")
+    for action in assembly_actions:
+        defines = [arg for arg in action.argv if arg.startswith("-D")]
+        asserts.equals(env, [], defines, "Raw assembly has no preprocessor")
+
+    compile_actions = [
+        action
+        for action in actions
+        if action.mnemonic == "CppCompile" and any([arg.endswith(".c") for arg in action.argv])
+    ]
+    asserts.true(env, len(compile_actions) > 0, "OpenSSL must also compile C sources")
+    for action in compile_actions:
+        defines = [arg[2:] for arg in action.argv if arg.startswith("-D")]
+        for required in ["NDEBUG", "OPENSSL_SYS_WIN32", "AES_ASM", "OPENSSL_NO_BLAKE2", 'OPENSSLDIR="/etc/ssl"']:
+            asserts.true(env, required in defines, "C sources retain %s: %s" % (required, defines))
+
+    exported_defines = analysistest.target_under_test(env)[CcInfo].compilation_context.defines.to_list()
+    for private in ["NDEBUG", "AES_ASM", "OPENSSL_NO_BLAKE2"]:
+        asserts.equals(env, [], [define for define in exported_defines if define == private], "Private macros remain internal to OpenSSL")
+    return analysistest.end(env)
+
+openssl_assembly_defines_test = analysistest.make(
+    _openssl_assembly_defines_test_impl,
+    config_settings = {
+        "//command_line_option:platforms": str(Label("//:windows_x86_64_gnullvm")),
+        str(Label("@openssl//:no-blake2")): True,
+    },
+)
