From 80b6a12fca0879b2a15a0db3496d5a83f9e8169a Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Fri, 16 Oct 2026 19:01:06 +0000
Subject: [PATCH] Keep the Windows negative voice fixture incomplete

The MSVC startup-library directory also contains runtime plugins, so copying its DLLs accidentally creates a working runtime. Remove the required coreelements plugin from the negative fixture and preserve the initialization failure assertion.

Native red: job 117096549128 fails installed_client_rejects_mixed_builds_and_missing_helper because initialization succeeds. Maintained just fmt-check passes. Native green verification remains pending in the CI repair execution record.
---
 codex-rs/voice-host/tests/installed_client.rs | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/codex-rs/voice-host/tests/installed_client.rs b/codex-rs/voice-host/tests/installed_client.rs
index d86525589..69dc52dfc 100644
--- a/codex-rs/voice-host/tests/installed_client.rs
+++ b/codex-rs/voice-host/tests/installed_client.rs
@@ -119,7 +119,14 @@ async fn installed_client_rejects_mixed_builds_and_missing_helper() -> Result<()
         .close()
         .await?;
     assert!(VoiceHost::connect(&package, "wrong-build").await.is_err());
-    // Startup libraries permit handshakes; the missing runtime receipt prevents readiness.
+    // Windows stores plugins beside startup libraries; keep one required plugin absent.
+    #[cfg(all(windows, target_env = "msvc"))]
+    fs::remove_file(
+        directory
+            .path()
+            .join("codex-resources/voice/bin/gstcoreelements.dll"),
+    )?;
+    // Startup libraries permit handshakes; the missing runtime plugin prevents readiness.
     let host = VoiceHost::connect(&package, &build_commit().await?).await?;
     assert!(host.initialize_runtime().await.is_err());
     // The same executable elsewhere in the package must not become a fallback.
