From 227cbbfd733e86478acffea1f80eb6d5519dfe75 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Thu, 15 Oct 2026 01:11:21 +0000
Subject: [PATCH] Require resolved direct Bazel dependency versions

Update the direct bazel_lib pin to 3.7.2 and the direct xz pin to 5.4.5.bcr.9, the latest stable BCR versions; xz 5.4.5.bcr.9 requires bazel_lib 3.7.2. Promote future direct-version mismatches to errors. A focused cquery fails with exit 48 against the old pin and passes after the update; the included resolver check also passes.
---
 .bazelrc                                          | 1 +
 MODULE.bazel                                      | 4 ++--
 MODULE.bazel.lock                                 | 6 ++++--
 tools/build-warnings/check-direct-dependencies.sh | 6 ++++++
 4 files changed, 13 insertions(+), 4 deletions(-)
 create mode 100755 tools/build-warnings/check-direct-dependencies.sh

diff --git a/.bazelrc b/.bazelrc
index 6474ac6..6e00c14 100644
--- a/.bazelrc
+++ b/.bazelrc
@@ -1,4 +1,5 @@
 common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
+common --check_direct_dependencies=error
 common --repo_env=BAZEL_NO_APPLE_CPP_TOOLCHAIN=1
 # Dummy xcode config so we don't need to build xcode_locator in repo rule.
 common --xcode_version_config=//:disable_xcode
diff --git a/MODULE.bazel b/MODULE.bazel
index 42b6fde..2f571fe 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -1,6 +1,6 @@
 module(name = "codex")
 
-bazel_dep(name = "bazel_lib", version = "3.2.2")
+bazel_dep(name = "bazel_lib", version = "3.7.2")
 bazel_dep(name = "bazel_skylib", version = "1.9.2")
 bazel_dep(name = "platforms", version = "1.1.0")
 
@@ -489,7 +489,7 @@ crate.annotation(
 
 inject_repo(crate, "zlib")
 
-bazel_dep(name = "xz", version = "5.4.5.bcr.8")
+bazel_dep(name = "xz", version = "5.4.5.bcr.9")
 single_version_override(
     module_name = "xz",
     patch_strip = 1,
diff --git a/MODULE.bazel.lock b/MODULE.bazel.lock
