     "https://bcr.bazel.build/modules/zlib/1.2.11/MODULE.bazel": "07b389abc85fdbca459b69e2ec656ae5622873af3f845e1c9d80fe179f3effa0",
diff --git a/tools/build-warnings/check-direct-dependencies.sh b/tools/build-warnings/check-direct-dependencies.sh
new file mode 100755
index 0000000..beae00e
--- /dev/null
+++ b/tools/build-warnings/check-direct-dependencies.sh
@@ -0,0 +1,6 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
+cd -- "$repo_root"
+bazel mod deps "$@" --check_direct_dependencies=error
