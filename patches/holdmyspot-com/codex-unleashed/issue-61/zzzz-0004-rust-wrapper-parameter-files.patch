 .../build-warnings/wrapper-params/BUILD.bazel |  15 ++
 .../wrapper-params/environment_files.bzl      |  13 ++
 .../wrapper-params/transport.rs               |   4 +
 6 files changed, 235 insertions(+), 2 deletions(-)
 create mode 100644 patches/rules_rust_wrapper_parameter_files.patch
 create mode 100644 tools/build-warnings/wrapper-params/BUILD.bazel
 create mode 100644 tools/build-warnings/wrapper-params/environment_files.bzl
 create mode 100644 tools/build-warnings/wrapper-params/transport.rs

