From 413172d1a20637f00e625ddae282a20a3b4c679e Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Wed, 14 Oct 2026 08:46:14 +0000
Subject: [PATCH] Check ICU guarded values in the lock regression

Read each value while holding its corresponding mutex and return a
failing status when a value differs. This verifies the write results and
avoids unused-global diagnostics with LLVM 23.

Red: the emitted queue-65 full just bazel-test run rejects the fixture
at -Wunused-but-set-global for both guarded values.
Green: bazel test //third_party/v8:icu_mutex_analysis_test --keep_going
passes with strict warnings. The manual icu_mutex_analysis_error target
still fails at the expected unguarded-write and read diagnostics.
just fmt-check passes. Fresh emitted verification remains required.
---
 third_party/v8/icu_mutex_analysis_test.cc | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/third_party/v8/icu_mutex_analysis_test.cc b/third_party/v8/icu_mutex_analysis_test.cc
index ea44f8301..d6833a174 100644
--- a/third_party/v8/icu_mutex_analysis_test.cc
+++ b/third_party/v8/icu_mutex_analysis_test.cc
@@ -16,29 +16,35 @@ static int analysis_value ICU_TEST_GUARDED_BY(analysis_mutex);
 static int global_analysis_value ICU_TEST_GUARDED_BY(UMutex::getGlobalMutex());
 
 int main() {
+    bool matches = true;
 #if defined(CODEX_ICU_EXPECT_ANALYSIS_ERROR)
     analysis_value = 1;
     global_analysis_value = 1;
+    matches = analysis_value == 1 && global_analysis_value == 1;
 #else
     analysis_mutex.lock();
     analysis_value = 1;
+    matches = matches && analysis_value == 1;
     analysis_mutex.unlock();
 
     umtx_lock(&analysis_mutex);
     analysis_value = 2;
+    matches = matches && analysis_value == 2;
     umtx_unlock(&analysis_mutex);
 
     {
         Mutex lock(&analysis_mutex);
         analysis_value = 3;
+        matches = matches && analysis_value == 3;
     }
     {
         Mutex lock;
         global_analysis_value = 1;
+        matches = matches && global_analysis_value == 1;
     }
     {
         Mutex lock(nullptr);
     }
 #endif
-    return 0;
+    return matches ? 0 : 1;
 }
