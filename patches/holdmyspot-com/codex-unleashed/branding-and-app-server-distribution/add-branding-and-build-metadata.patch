+#[test]
+fn session_header_keeps_full_url_at_narrow_widths() {
+    let cell = SessionHeaderHistoryCell::new(
+        "gpt-5".to_string(),
+        /*reasoning_effort*/ None,
+        PathBuf::from("project"),
+        "test",
+    );
+
+    for width in [44, 48, 20, 1, 75, 76] {
+        let lines = cell.display_lines(width);
+        let rendered = render_lines(&lines).join("\n");
+        let without_whitespace = rendered
+            .chars()
+            .filter(|ch| !ch.is_whitespace())
+            .collect::<String>();
+
+        assert!(
+            without_whitespace.contains(crate::version::CODEX_UNLEASHED_URL),
+            "URL missing at width {width}: {rendered}"
+        );
+        assert!(
+            lines
+                .iter()
+                .all(|line| line_width(line) <= usize::from(width))
+        );
+    }
+
+    let wide_lines = render_lines(&cell.display_lines(/*width*/ 80));
+    let title_column = wide_lines[0].find("Codex Unleashed").unwrap();
+    assert_eq!(wide_lines[1].find("Unofficial"), Some(title_column));
+    assert_eq!(wide_lines[2].find("https://"), Some(title_column));
+
+    let wide_header = wide_lines.join("\n");
+    assert!(
+        wide_header.contains(
+            "Unofficial fork of OpenAI Codex\n     https://holdmyspot.com/codex-unleashed/"
+        )
+    );
+}
+
+#[test]
+fn session_header_identifies_codex_unleashed_build() {
+    let cell = SessionHeaderHistoryCell::new(
+        "gpt-5".to_string(),
+        /*reasoning_effort*/ None,
+        PathBuf::from("project"),
+        crate::version::CODEX_CLI_VERSION,
+    );
+    let build_number = option_env!("CODEX_UNLEASHED_BUILD_NUMBER").unwrap_or("dev");
+    let expected_version = format!("v{}+{build_number}", env!("CARGO_PKG_VERSION"));
+    let expected_title = format!("Codex Unleashed ({expected_version})");
+    let expected_provider =
+        "Unofficial fork of OpenAI Codex\n     https://holdmyspot.com/codex-unleashed/";
+
+    let display = render_lines(&cell.display_lines(/*width*/ 80)).join("\n");
+    assert!(display.contains(&expected_title));
+    assert!(
+        display.contains(
+            "Unofficial fork of OpenAI Codex\n     https://holdmyspot.com/codex-unleashed/"
+        )
+    );
+
+    let raw = render_lines(&cell.raw_lines()).join("\n");
+    assert!(raw.contains(&expected_title));
+    assert!(raw.contains(expected_provider));
+}
