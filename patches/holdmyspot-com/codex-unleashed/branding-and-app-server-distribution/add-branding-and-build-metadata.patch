+fn branded_title(name: &'static str, version: &str) -> Vec<Span<'static>> {
     vec![
         ">_ ".fg(accent_color()),
-        "OpenAI Codex".bold(),
+        name.bold(),
         format!(" (v{version})").dim(),
     ]
 }
 
+const CODEX_UNLEASHED_FORK_LABEL: &str = "Unofficial fork of OpenAI Codex";
+
+pub(crate) fn fork_notice_lines(width: usize, indent: usize) -> Vec<Line<'static>> {
+    let indent = " ".repeat(width.saturating_sub(/*rhs*/ 1).min(indent));
+    let wrap_options = textwrap::Options::new(width.saturating_sub(indent.len()).max(/*rhs*/ 1))
+        .word_separator(textwrap::WordSeparator::AsciiSpace)
+        .word_splitter(textwrap::WordSplitter::NoHyphenation)
+        .break_words(/*break_words*/ true);
+    let mut lines = Vec::new();
+    for (text, style) in [
+        (CODEX_UNLEASHED_FORK_LABEL, Style::default()),
+        (CODEX_UNLEASHED_URL, Style::default().cyan().underlined()),
+    ] {
+        for part in textwrap::wrap(text, wrap_options.clone()) {
+            lines.push(Line::from(vec![
+                indent.clone().into(),
+                Span::styled(part.into_owned(), style),
+            ]));
+        }
+    }
+    lines
+}
