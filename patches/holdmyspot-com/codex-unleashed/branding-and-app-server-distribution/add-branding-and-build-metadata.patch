+const CODEX_UNLEASHED_FORK_LABEL: &str = "Unofficial fork of OpenAI Codex";
+
+pub(crate) fn fork_notice_lines(width: usize, indent: usize) -> Vec<Line<'static>> {
+    visible_lines(fork_notice_hyperlink_lines(width, indent))
+}
+
+pub(crate) fn fork_notice_hyperlink_lines(width: usize, indent: usize) -> Vec<HyperlinkLine> {
+    let indent = " ".repeat(width.saturating_sub(/*rhs*/ 1).min(indent));
+    let wrap_options = textwrap::Options::new(width.saturating_sub(indent.len()).max(/*rhs*/ 1))
+        .word_separator(textwrap::WordSeparator::AsciiSpace)
+        .word_splitter(textwrap::WordSplitter::NoHyphenation)
+        .break_words(/*break_words*/ true);
+    let mut lines = Vec::new();
+    for (text, style, destination) in [
+        (CODEX_UNLEASHED_FORK_LABEL, Style::default(), None),
+        (
+            CODEX_UNLEASHED_URL,
+            Style::default().cyan().underlined(),
+            Some(CODEX_UNLEASHED_URL),
+        ),
+    ] {
+        for part in textwrap::wrap(text, wrap_options.clone()) {
+            let end = indent.len() + display_width(&part);
+            let mut line = HyperlinkLine::new(Line::from(vec![
+                indent.clone().into(),
+                Span::styled(part.into_owned(), style),
+            ]));
+            if let Some(destination) = destination {
+                line.hyperlinks
+                    .push(crate::terminal_hyperlinks::TerminalHyperlink::web(
+                        indent.len()..end,
+                        destination.to_string(),
+                    ));
+            }
+            lines.push(line);
+        }
+    }
+    lines
+}
