     let server = semver::Version::parse(server).ok()?;
     let client_release = (client.major, client.minor, client.patch);
     let server_release = (server.major, server.minor, server.patch);
+    if client_release != (0, 0, 0) && is_numeric_vendor_build(&client.build) {
+        let comparison = client.cmp_precedence(&server);
+        let comparison = if comparison.is_eq() {
+            if !server.build.is_empty() && !is_numeric_vendor_build(&server.build) {
+                return (client != server).then_some(ServerVersionNoticeKind::Different);
+            }
+            client.build.cmp(&server.build)
+        } else {
+            comparison
+        };
+        return match comparison {
+            std::cmp::Ordering::Greater => Some(ServerVersionNoticeKind::Older),
+            std::cmp::Ordering::Less => Some(ServerVersionNoticeKind::Newer),
+            std::cmp::Ordering::Equal => None,
+        };
+    }
     let client_is_local = client_release == (0, 0, 0) || !client.build.is_empty();
     if client_is_local || (!client.pre.is_empty() && client_release != server_release) {
         return (client != server).then_some(ServerVersionNoticeKind::Different);
