@@ -0,0 +1,13 @@
+#!/usr/bin/env python3
+"""Print the package version for the current Unleashed build."""
+
+import os
+from pathlib import Path
+import sys
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+
+from codex_package.version import read_package_version
+
+if __name__ == "__main__":
+    print(read_package_version(os.environ.get("CODEX_UNLEASHED_BUILD_NUMBER", "dev")))
