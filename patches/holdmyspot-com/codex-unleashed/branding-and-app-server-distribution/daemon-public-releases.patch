+#[tokio::test]
+async fn vendor_package_seeds_latest_channel_and_development_stays_pinned() {
+    for (version, latest) in [("0.160.0+39", true), ("0.160.0+dev", false)] {
+        let temp = tempfile::TempDir::new().expect("temp");
+        let home = temp.path().join("home");
+        let daemon = daemon(&home);
+        let source = temp.path().join("source");
+        let bin = package(&source, version);
+        prepare_from_package(
+            &daemon,
+            &DaemonSettings::default(),
+            InstallMode::Missing,
+            Some(&source),
+            &bin,
+            |_| Ok(true),
+        )
+        .await
+        .unwrap();
+        let root = home.join("packages/app-server-daemon");
+        assert_eq!(
+            root.join("auto-update-version").exists(),
+            latest,
+            "{version}"
+        );
+    }
+}
