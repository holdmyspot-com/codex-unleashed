+/// Parse a non-development stable release, including a numeric downstream build number.
+pub(crate) fn stable_public_version(value: &str) -> Option<semver::Version> {
+    let version = semver::Version::parse(value).ok()?;
+    (version.pre.is_empty()
+        && (version.build.is_empty()
+            || version
+                .build
+                .as_str()
+                .bytes()
+                .all(|byte| byte.is_ascii_digit()))
+        && (version.major, version.minor, version.patch) != (0, 0, 0))
+        .then_some(version)
+}
+
 /// Only latest-channel stable releases may run the public latest-version updater.
 pub(crate) fn is_stable_standalone_release(codex_home: &Path, codex_bin: &Path) -> bool {
     let standalone = package_root(codex_home);
@@ -105,11 +119,7 @@ pub(crate) fn is_stable_standalone_release(codex_home: &Path, codex_bin: &Path)
     else {
         return false;
     };
-    let components: Vec<_> = version.split('.').collect();
-    components.len() == 3
-        && components.iter().all(|component| {
-            !component.is_empty() && component.bytes().all(|byte| byte.is_ascii_digit())
-        })
+    stable_public_version(version).is_some()
         && std::fs::read_to_string(standalone.join("auto-update-version"))
             .is_ok_and(|selected| selected == release_name)
         && std::fs::canonicalize(codex_bin).is_ok_and(|bin| bin.starts_with(&release))
