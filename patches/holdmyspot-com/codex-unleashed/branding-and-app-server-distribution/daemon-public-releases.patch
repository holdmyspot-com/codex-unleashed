+#[cfg(unix)]
+#[test]
+fn updater_accepts_unleashed_vendor_release_but_rejects_dev_and_prerelease() {
+    let home = tempfile::TempDir::new().expect("home");
+    let root = home.path().join("packages/app-server-daemon");
+    std::fs::create_dir_all(root.join("releases")).unwrap();
+    for (version, expected) in [
+        ("0.160.0+39", true),
+        ("0.160.0+dev", false),
+        ("0.160.0-alpha.1+39", false),
+    ] {
+        let name = format!("{version}-x86_64-unknown-linux-musl");
+        let release = root.join("releases").join(&name);
+        std::fs::create_dir_all(release.join("bin")).unwrap();
+        let bin = release.join("bin/codex");
+        std::fs::write(&bin, b"codex").unwrap();
+        let _ = std::fs::remove_file(root.join("current"));
+        std::os::unix::fs::symlink(&release, root.join("current")).unwrap();
+        std::fs::write(root.join("auto-update-version"), name).unwrap();
+        assert_eq!(
+            super::is_stable_standalone_release(home.path(), &bin),
+            expected,
+            "{version}"
+        );
+    }
+}
