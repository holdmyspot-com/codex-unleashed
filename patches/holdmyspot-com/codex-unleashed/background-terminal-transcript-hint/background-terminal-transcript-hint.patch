-        self.command_display_lines_with_hidden_details(width).lines
+        let mut lines = self.command_display_lines_with_hidden_details(width).lines;
+        if let [call] = self.group.calls.as_slice()
+            && call.source == ExecCommandSource::UnifiedExecStartup
+            && call.duration.is_some()
+        {
+            lines.push(Line::from(format!("({TRANSCRIPT_HINT})").dim()).into());
+        }
+        lines
     }
 
