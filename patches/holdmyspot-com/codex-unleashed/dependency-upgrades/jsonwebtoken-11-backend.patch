From bc73f94a7a709da424d929497b5ae2aa72b54d94 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Mon, 9 Nov 2026 13:33:00 -0500
Subject: [PATCH] WIP: select jsonwebtoken 11's aws-lc-rs crypto backend

jsonwebtoken 11 panics at first use unless exactly one of its aws_lc_rs or rust_crypto features is enabled; aws-lc-rs is already in the graph through rustls.
---
 codex-rs/Cargo.lock | 1 +
 codex-rs/Cargo.toml | 2 +-
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/codex-rs/Cargo.lock b/codex-rs/Cargo.lock
index bc4e934..867187a 100644
--- a/codex-rs/Cargo.lock
+++ b/codex-rs/Cargo.lock
@@ -10003,6 +10003,7 @@ version = "11.1.0"
 source = "registry+https://github.com/rust-lang/crates.io-index"
 checksum = "e75fe14a82d81e5f5af639997db37d8b96045938a7ac6ab18cdbe1c7467e05e1"
 dependencies = [
+ "aws-lc-rs",
  "base64 0.22.1",
  "getrandom 0.2.17",
  "js-sys",
diff --git a/codex-rs/Cargo.toml b/codex-rs/Cargo.toml
index 6997c55..390ef9c 100644
--- a/codex-rs/Cargo.toml
+++ b/codex-rs/Cargo.toml
@@ -414,7 +414,7 @@ insta = "1.46.3"
 inventory = "0.3.19"
 itertools = "0.15.0"
 jsonptr = { version = "0.8.2", default-features = false }
-jsonwebtoken = "11.1.0"
+jsonwebtoken = { version = "11.1.0", features = ["aws_lc_rs"] }
 keyring = { version = "3.6", default-features = false }
 landlock = "0.4.4"
 lazy_static = "1"
-- 
2.43.0

