From 81d2b1e24aa5c9ea7c563b65cbb531276a44c641 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Mon, 9 Nov 2026 15:23:30 -0500
Subject: [PATCH] WIP: pin unicode-width 0.2.2 so ratatui counts halfwidth
 sound marks once
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

ratatui-core 0.1.2, the latest release, adds one cell for each U+FF9E and U+FF9F because unicode-width 0.2.2 and earlier count them as zero. unicode-width 0.2.3 counts them as one, so ratatui's buffer gave "ｶﾞ" three cells while codex's layout gave it two, and eleven TUI tests failed (Linux test run 42675199649). vt100 0.18.1 needs at least 0.2.2.
---
 codex-rs/Cargo.lock | 22 +++++++++++-----------
 codex-rs/Cargo.toml |  4 +++-
 2 files changed, 14 insertions(+), 12 deletions(-)

diff --git a/codex-rs/Cargo.lock b/codex-rs/Cargo.lock
index 867187a..a7b4b54 100644
--- a/codex-rs/Cargo.lock
+++ b/codex-rs/Cargo.lock
@@ -225,7 +225,7 @@ checksum = "b2a5b0a5ab8561c603f16c3b78c24a386b1f70e7fc1b1b1e8c15738828e4a176"
 dependencies = [
  "anstyle",
  "memchr",
- "unicode-width 0.2.3",
+ "unicode-width 0.2.2",
 ]
 
 [[package]]
@@ -2787,7 +2787,7 @@ dependencies = [
  "tracing",
  "tracing-subscriber",
  "unicode-segmentation",
- "unicode-width 0.2.3",
+ "unicode-width 0.2.2",
 ]
 
 [[package]]
@@ -4187,7 +4187,7 @@ version = "0.0.0"
 dependencies = [
  "insta",
  "pretty_assertions",
- "unicode-width 0.2.3",
+ "unicode-width 0.2.2",
 ]
 
 [[package]]
@@ -5172,7 +5172,7 @@ dependencies = [
  "tracing-subscriber",
  "two-face",
  "unicode-segmentation",
- "unicode-width 0.2.3",
+ "unicode-width 0.2.2",
  "url",
  "urlencoding",
  "uuid",
@@ -13066,7 +13066,7 @@ dependencies = [
  "thiserror 2.0.21",
  "unicode-segmentation",
  "unicode-truncate",
- "unicode-width 0.2.3",
+ "unicode-width 0.2.2",
 ]
 
 [[package]]
@@ -13140,7 +13140,7 @@ dependencies = [
  "strum",
  "time",
  "unicode-segmentation",
- "unicode-width 0.2.3",
+ "unicode-width 0.2.2",
 ]
 
 [[package]]
@@ -15858,7 +15858,7 @@ checksum = "6ecfad6c3abc80a577f2b91c1e412ee57e7a060d430b553c1b0c940974ebcd49"
 dependencies = [
  "icu_segmenter",
  "smawk",
- "unicode-width 0.2.3",
+ "unicode-width 0.2.2",
 ]
 
 [[package]]
@@ -16805,7 +16805,7 @@ checksum = "16b380a1238663e5f8a691f9039c73e1cdae598a30e9855f541d29b08b53e9a5"
 dependencies = [
  "itertools 0.14.0",
  "unicode-segmentation",
- "unicode-width 0.2.3",
+ "unicode-width 0.2.2",
 ]
 
 [[package]]
@@ -16816,9 +16816,9 @@ checksum = "7dd6e30e90baa6f72411720665d41d89b9a3d039dc45b8faea1ddd07f617f6af"
 
 [[package]]
 name = "unicode-width"
-version = "0.2.3"
+version = "0.2.2"
 source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "ca718471876992059f251e33aafc334346ada08042b7661dd1fe313a9bced557"
+checksum = "b4ac048d71ede7ee76d585517add45da530660ef4390e49b098733c6e897f254"
 
 [[package]]
 name = "unicode-xid"
@@ -16964,7 +16964,7 @@ source = "registry+https://github.com/rust-lang/crates.io-index"
 checksum = "eb05cdd19ae8707bf6a0a269972c07e6358103a7079faec749dec318a5b3dc23"
 dependencies = [
  "itoa",
- "unicode-width 0.2.3",
+ "unicode-width 0.2.2",
  "vte 0.15.0",
 ]
 
diff --git a/codex-rs/Cargo.toml b/codex-rs/Cargo.toml
index 390ef9c..1e601b4 100644
--- a/codex-rs/Cargo.toml
+++ b/codex-rs/Cargo.toml
@@ -552,7 +552,9 @@ ts-rs = "12"
 tungstenite = { version = "0.27.0", features = ["deflate", "proxy"] }
 uds_windows = "1.1.0"
 unicode-segmentation = "1.12.0"
-unicode-width = "0.2"
+# ratatui-core 0.1.2 adds one cell for each halfwidth sound mark (U+FF9E, U+FF9F) because unicode-width
+# 0.2.2 counts them as zero; 0.2.3 counts them as one, so ratatui would count each mark twice.
+unicode-width = "=0.2.2"
 url = "2"
 urlencoding = "2.1"
 uuid = "1"
-- 
2.43.0

