From 3f99841bd6e316f99316905e3a8e1d69c091f373 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Sun, 8 Nov 2026 22:58:01 -0500
Subject: [PATCH] WIP: keep schemars 0.8's names for generic schema types

schemars 1 names Ordered<T>, FeatureToml<T> and ReadResponse<M> by their
base names, so different parameters collide in the rollout and config
schemas; renaming with the type parameter keeps the 0.8 output.
---
 codex-rs/ext/skills/src/tools/read.rs    | 2 ++
 codex-rs/features/src/lib.rs             | 2 ++
 codex-rs/history/src/retained_context.rs | 2 ++
 3 files changed, 6 insertions(+)

diff --git a/codex-rs/ext/skills/src/tools/read.rs b/codex-rs/ext/skills/src/tools/read.rs
index a8dcaa1..8d4e1af 100644
--- a/codex-rs/ext/skills/src/tools/read.rs
+++ b/codex-rs/ext/skills/src/tools/read.rs
@@ -56,6 +56,8 @@ struct ReadInstallationArgs {
 
 #[derive(Debug, Eq, JsonSchema, PartialEq, Serialize)]
 #[schemars(deny_unknown_fields)]
+// schemars 1 names generic types by their base name; keep 0.8's per-parameter names.
+#[schemars(rename = "ReadResponse_for_{M}")]
 struct ReadResponse<M> {
     resource: String,
     contents: String,
diff --git a/codex-rs/features/src/lib.rs b/codex-rs/features/src/lib.rs
index 5d7a36d..4509ff7 100644
--- a/codex-rs/features/src/lib.rs
+++ b/codex-rs/features/src/lib.rs
@@ -1050,6 +1050,8 @@ impl From<BTreeMap<String, bool>> for FeaturesToml {
 // require a custom config struct under `[features]`.
 #[derive(Serialize, Deserialize, Debug, Clone, PartialEq, Eq, JsonSchema)]
 #[serde(untagged)]
+// schemars 1 names generic types by their base name; keep 0.8's per-parameter names.
+#[schemars(rename = "FeatureToml_for_{T}")]
 pub enum FeatureToml<T> {
     Enabled(bool),
     Config(T),
diff --git a/codex-rs/history/src/retained_context.rs b/codex-rs/history/src/retained_context.rs
index 6418bd6..43e6fee 100644
--- a/codex-rs/history/src/retained_context.rs
+++ b/codex-rs/history/src/retained_context.rs
@@ -95,6 +95,8 @@ impl std::fmt::Debug for RetainedUserMessage {
 }
 
 #[derive(Debug, Clone, PartialEq, Serialize, Deserialize, JsonSchema)]
+// schemars 1 names generic types by their base name; keep 0.8's per-parameter names.
+#[schemars(rename = "Ordered_for_{T}")]
 struct Ordered<T> {
     #[serde(default, skip_serializing_if = "Option::is_none")]
     revision: Option<codex_protocol::ResponseItemId>,
-- 
2.43.0

