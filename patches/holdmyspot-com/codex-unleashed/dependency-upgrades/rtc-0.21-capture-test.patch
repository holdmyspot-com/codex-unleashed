From 324a35cdfabb4b04379832d8f5467fe083559ea0 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Mon, 9 Nov 2026 11:13:20 -0500
Subject: [PATCH] WIP: adapt the capture worker test's interceptor to rtc 0.21

rtc 0.21 removed the interceptor derive macros, wraps packets in AttributedPacket, replaced SettingEngine's setters with SettingEngineBuilder and builds a Registry from slots. The Linux test build failed on all four (run 42649803218).
---
 .../voice-host/src/capture_worker_tests.rs    | 58 ++++++++++++++-----
 1 file changed, 43 insertions(+), 15 deletions(-)

diff --git a/codex-rs/voice-host/src/capture_worker_tests.rs b/codex-rs/voice-host/src/capture_worker_tests.rs
index 0d85153..e15a7d9 100644
--- a/codex-rs/voice-host/src/capture_worker_tests.rs
+++ b/codex-rs/voice-host/src/capture_worker_tests.rs
@@ -7,13 +7,12 @@ use codex_realtime_webrtc::AudioControls;
 use futures::future::BoxFuture;
 use pretty_assertions::assert_eq;
 use rtc::interceptor::Interceptor;
-use rtc::interceptor::NoopInterceptor;
 use rtc::interceptor::Packet;
 use rtc::interceptor::StreamInfo;
 use rtc::interceptor::TaggedPacket;
-use rtc::interceptor::interceptor;
 use rtc::sansio;
 use rtc::shared::error::Error;
+use std::collections::VecDeque;
 use std::time::Duration;
 use tokio::sync::Notify;
 use tokio::sync::mpsc;
@@ -26,22 +25,47 @@ use webrtc::peer_connection::RTCSessionDescription;
 
 // Consume remote RTP before the upstream track queue: receipt proves the packet
 // traversed negotiation, encryption, the loopback socket, and remote decryption.
-#[derive(Interceptor)]
 struct RemoteRtp {
-    #[next]
-    next: NoopInterceptor,
+    write_queue: VecDeque<TaggedPacket>,
     sender: mpsc::Sender<rtc::rtp::packet::Packet>,
 }
 
-#[interceptor]
-impl RemoteRtp {
-    #[overrides]
+impl sansio::Protocol<TaggedPacket, TaggedPacket, ()> for RemoteRtp {
+    type Rout = TaggedPacket;
+    type Wout = TaggedPacket;
+    type Eout = ();
+    type Error = Error;
+    type Time = Instant;
+
     fn handle_read(&mut self, message: TaggedPacket) -> Result<(), Self::Error> {
-        if let Packet::Rtp(packet) = message.message {
+        if let Packet::Rtp(packet) = message.message.packet {
             self.sender.try_send(packet).unwrap();
         }
         Ok(())
     }
+
+    fn poll_read(&mut self) -> Option<Self::Rout> {
+        None
+    }
+
+    fn handle_write(&mut self, message: TaggedPacket) -> Result<(), Self::Error> {
+        self.write_queue.push_back(message);
+        Ok(())
+    }
+
+    fn poll_write(&mut self) -> Option<Self::Wout> {
+        self.write_queue.pop_front()
+    }
+}
+
+impl Interceptor for RemoteRtp {
+    fn bind_local_stream(&mut self, _info: &StreamInfo) {}
+
+    fn unbind_local_stream(&mut self, _info: &StreamInfo) {}
+
+    fn bind_remote_stream(&mut self, _info: &StreamInfo) {}
+
+    fn unbind_remote_stream(&mut self, _info: &StreamInfo) {}
 }
 
 struct Gathered(Arc<Notify>);
@@ -188,16 +212,20 @@ async fn capture_reaches_remote_rtp_and_mute_discards_queued_and_partial_audio()
         let (sender, mut received) = mpsc::channel(/*buffer*/ 32);
         let gathered = Arc::new(Notify::new());
         let (media, _) = AudioTrack::new().unwrap();
-        let mut settings = webrtc::peer_connection::SettingEngine::default();
-        settings.set_lite(/*lite*/ true);
+        let settings = webrtc::peer_connection::SettingEngineBuilder::new()
+            .with_lite(/*lite*/ true)
+            .build();
         let remote = PeerConnectionBuilder::new()
             .with_media_engine(media)
             .with_setting_engine(settings)
             .with_handler(Arc::new(Gathered(gathered.clone())))
-            .with_interceptor_registry(rtc::interceptor::Registry::from(RemoteRtp {
-                next: NoopInterceptor::new(),
-                sender,
-            }))
+            .with_interceptor_registry(rtc::interceptor::Registry::new().with(
+                rtc::interceptor::Slot::JitterBuffer,
+                RemoteRtp {
+                    write_queue: VecDeque::new(),
+                    sender,
+                },
+            ))
             .with_udp_addrs(vec!["0.0.0.0:0"])
             .build()
             .await
