From a4590c5a96e0aa090d0cacc5b40e8d0548c50f7b Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Mon, 9 Nov 2026 13:33:00 -0500
Subject: [PATCH] WIP: expect OTLP integer values as JSON strings

opentelemetry-proto 0.33 serializes asInt as a string, following the protobuf JSON mapping for 64-bit integers.
---
 codex-rs/app-server/tests/suite/v2/turn_cost_otel.rs | 2 +-
 codex-rs/cli/tests/worktree.rs                       | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/codex-rs/app-server/tests/suite/v2/turn_cost_otel.rs b/codex-rs/app-server/tests/suite/v2/turn_cost_otel.rs
index f9a06f2..c3f2b4a 100644
--- a/codex-rs/app-server/tests/suite/v2/turn_cost_otel.rs
+++ b/codex-rs/app-server/tests/suite/v2/turn_cost_otel.rs
@@ -268,7 +268,7 @@ metrics_exporter = {{ otlp-http = {{ endpoint = "{}/metrics", protocol = "json"
         }
     }
     assert_eq!(points.len(), 1);
-    assert_eq!(points[0]["asInt"], json!(1250001));
+    assert_eq!(points[0]["asInt"], json!("1250001"));
     let attrs: std::collections::BTreeMap<_, _> = points[0]["attributes"]
         .as_array()
         .expect("attributes")
diff --git a/codex-rs/cli/tests/worktree.rs b/codex-rs/cli/tests/worktree.rs
index 13b6914..5aa1042 100644
--- a/codex-rs/cli/tests/worktree.rs
+++ b/codex-rs/cli/tests/worktree.rs
@@ -669,7 +669,7 @@ trust_level = "trusted"
                     .find(|metric| metric["name"] == "codex.daemon.update")
                     .context("handoff metric")?;
                 let update_point = &update["sum"]["dataPoints"][0];
-                assert_eq!(update_point["asInt"], 1);
+                assert_eq!(update_point["asInt"], "1");
             }
             let point = exported
                 .iter()
@@ -677,7 +677,7 @@ trust_level = "trusted"
                 .flat_map(|metric| metric["sum"]["dataPoints"].as_array().into_iter().flatten())
                 .next()
                 .context("codex.tui.start data point")?;
-            assert_eq!(point["asInt"], 1);
+            assert_eq!(point["asInt"], "1");
             let tags = point["attributes"]
                 .as_array()
                 .context("codex.tui.start attributes")?
-- 
2.43.0

