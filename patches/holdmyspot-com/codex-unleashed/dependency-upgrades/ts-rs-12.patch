+        cfg,
         files,
         seen,
         error: None,
@@ -400,6 +407,7 @@ fn visit_typescript_fixture_dependencies(
 }
 
 struct TypeScriptFixtureCollector<'a> {
+    cfg: &'a Config,
     files: &'a mut BTreeMap<PathBuf, String>,
     seen: &'a mut HashSet<TypeId>,
     error: Option<anyhow::Error>,
@@ -410,7 +418,7 @@ impl TypeVisitor for TypeScriptFixtureCollector<'_> {
