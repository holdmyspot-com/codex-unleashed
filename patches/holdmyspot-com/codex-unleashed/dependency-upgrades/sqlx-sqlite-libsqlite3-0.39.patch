+    #[cfg_attr(docsrs, doc(cfg(feature = "sqlite-load-extension")))]
+    pub unsafe fn extension(mut self, extension_name: impl Into<Cow<'static, str>>) -> Self {
+        self.extensions.insert(extension_name.into(), None);
+        self
+    }
