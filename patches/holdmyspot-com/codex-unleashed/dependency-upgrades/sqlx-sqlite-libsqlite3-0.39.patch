+    ///
+    /// If the calling task cannot keep up, backpressure will be applied to the worker thread
+    /// in order to limit CPU and memory usage.
+    pub fn row_buffer_size(mut self, size: usize) -> Self {
+        self.row_channel_size = size;
+        self
+    }
