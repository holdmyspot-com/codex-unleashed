From 83b21b78336a076e108579c4df45829a81c1c2cf Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Sun, 8 Nov 2026 22:21:02 -0500
Subject: [PATCH] WIP: adapt to hmac 0.13 and tree-sitter 0.27

hmac 0.13 moves new_from_slice to KeyInit, and tree-sitter 0.27 makes
QueryMatch::captures a method. Inside json_schema!, a variable named null
is read as the JSON literal, so the null schema gets its own name.
---
 .../tests/suite/v2/connection_handling_websocket.rs           | 1 +
 codex-rs/apply-patch/src/invocation.rs                        | 2 +-
 codex-rs/cloud-config/src/cache.rs                            | 1 +
 codex-rs/hooks/src/events/model_request.rs                    | 4 ++--
 4 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/codex-rs/app-server/tests/suite/v2/connection_handling_websocket.rs b/codex-rs/app-server/tests/suite/v2/connection_handling_websocket.rs
index e083aaa..6ce87c5 100644
--- a/codex-rs/app-server/tests/suite/v2/connection_handling_websocket.rs
+++ b/codex-rs/app-server/tests/suite/v2/connection_handling_websocket.rs
@@ -27,6 +27,7 @@ use codex_protocol::config_types::TrustLevel;
 use futures::SinkExt;
 use futures::StreamExt;
 use hmac::Hmac;
+use hmac::KeyInit;
 use hmac::Mac;
 use http::StatusCode;
 use serde_json::json;
diff --git a/codex-rs/apply-patch/src/invocation.rs b/codex-rs/apply-patch/src/invocation.rs
index 203a161..e7af110 100644
--- a/codex-rs/apply-patch/src/invocation.rs
+++ b/codex-rs/apply-patch/src/invocation.rs
@@ -360,7 +360,7 @@ fn extract_apply_patch_from_bash(
         let mut heredoc_text: Option<String> = None;
         let mut cd_path: Option<String> = None;
 
-        for capture in m.captures.iter() {
+        for capture in m.captures() {
             let name = APPLY_PATCH_QUERY.capture_names()[capture.index as usize];
             match name {
                 "heredoc" => {
diff --git a/codex-rs/cloud-config/src/cache.rs b/codex-rs/cloud-config/src/cache.rs
index a085735..e8b0141 100644
--- a/codex-rs/cloud-config/src/cache.rs
+++ b/codex-rs/cloud-config/src/cache.rs
@@ -12,6 +12,7 @@ use codex_config::AbsolutePathBuf;
 use codex_config::CloudConfigBundle;
 use codex_config::CloudConfigBundlePolicyRevision;
 use hmac::Hmac;
+use hmac::KeyInit;
 use hmac::Mac;
 use serde::Deserialize;
 use serde::Serialize;
diff --git a/codex-rs/hooks/src/events/model_request.rs b/codex-rs/hooks/src/events/model_request.rs
index 34c23ae..b604ea0 100644
--- a/codex-rs/hooks/src/events/model_request.rs
+++ b/codex-rs/hooks/src/events/model_request.rs
@@ -32,9 +32,9 @@ pub enum ModelRequestHookEvent {
 // Hook schemas otherwise omit null from Option fields, but usage is always present on post.
 fn token_usage_schema(generator: &mut schemars::SchemaGenerator) -> schemars::Schema {
     let token_usage = generator.subschema_for::<TokenUsage>();
-    let null = generator.subschema_for::<()>();
+    let null_schema = generator.subschema_for::<()>();
     crate::schema::keep_null(schemars::json_schema!({
-        "anyOf": [token_usage, null],
+        "anyOf": [token_usage, null_schema],
     }))
 }
 
