--- /dev/null
+++ b/codex-rs/skills/src/yaml.rs
@@ -0,0 +1,31 @@
+//! Reads YAML with the YAML 1.2 rules that codex's skill, plugin and agent files were written against.
+
+use serde::Deserialize;
+
+/// Error produced while reading YAML.
+pub type YamlError = serde_saphyr::Error;
+
+/// Accepts only `true` and `false` as booleans and keeps numbers spelled with leading zeros or underscores as
+/// strings, as serde_yaml did, and reports errors without source snippets.
+fn options() -> serde_saphyr::Options {
+    serde_saphyr::options! {
+        strict_booleans: true,
+        leading_zero_numbers_as_strings: true,
+        underscored_numbers_as_strings: true,
+        with_snippet: false,
+    }
+}
+
+/// Deserializes one YAML document from a string.
+pub fn from_yaml_str<'de, T: Deserialize<'de>>(input: &'de str) -> Result<T, YamlError> {
+    serde_saphyr::from_str_with_options(input, options())
+}
+
+/// Deserializes one YAML document from UTF-8 bytes.
+pub fn from_yaml_slice<'de, T: Deserialize<'de>>(input: &'de [u8]) -> Result<T, YamlError> {
+    serde_saphyr::from_slice_with_options(input, options())
+}
+
+#[cfg(test)]
+#[path = "yaml_tests.rs"]
+mod tests;
diff --git a/codex-rs/skills/src/yaml_tests.rs b/codex-rs/skills/src/yaml_tests.rs
new file mode 100644
index 0000000..c7f79cc
--- /dev/null
+++ b/codex-rs/skills/src/yaml_tests.rs
@@ -0,0 +1,47 @@
+use std::collections::BTreeMap;
+
+use pretty_assertions::assert_eq;
+use serde::Deserialize;
+
+use super::from_yaml_slice;
+use super::from_yaml_str;
+
+/// A scalar whose type comes from YAML's own inference, as in an untyped frontmatter value.
+#[derive(Debug, Deserialize, PartialEq)]
+#[serde(untagged)]
+enum Scalar {
+    Bool(bool),
+    Integer(i64),
+    String(String),
+}
+
+#[derive(Debug, Deserialize)]
+struct Flag {
+    enabled: bool,
+}
+
+#[test]
+fn untyped_scalars_follow_yaml_1_2() {
+    let parsed: BTreeMap<String, Scalar> =
+        from_yaml_str("on: yes\nflag: true\nmode: 0755\ncount: 1_000\nlimit: 42\n")
+            .expect("valid YAML");
+    let expected = BTreeMap::from([
+        ("count".to_string(), Scalar::String("1_000".to_string())),
+        ("flag".to_string(), Scalar::Bool(true)),
+        ("limit".to_string(), Scalar::Integer(42)),
+        ("mode".to_string(), Scalar::String("0755".to_string())),
+        ("on".to_string(), Scalar::String("yes".to_string())),
+    ]);
+    assert_eq!(parsed, expected);
+}
+
+#[test]
+fn booleans_accept_only_true_and_false() {
+    assert_eq!(
+        from_yaml_slice::<Flag>(b"enabled: true\n")
+            .ok()
+            .map(|flag| flag.enabled),
+        Some(true)
+    );
+    assert!(from_yaml_slice::<Flag>(b"enabled: yes\n").is_err());
+}
