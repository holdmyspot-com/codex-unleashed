From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Mon, 9 Nov 2026 17:27:31 -0500
Subject: [PATCH] WIP: Adapt the Bazel labels and crate patches to the direct
 upgrades

Keeps only the hunks that the direct dependency upgrades force. The lockfile,
deny.toml and every other crate version stay as the earlier patches left them.

- cc is now 1.11.1, so the MXC annotation's build-script label follows it.
- zbus 6 turns on zruntime features that the Bazel crate resolver leaves
  off, so a Linux-only annotation_select adds them.
---
 MODULE.bazel | 24 +++++++++++++++++++++++-
 1 file changed, 23 insertions(+), 1 deletion(-)

diff --git a/MODULE.bazel b/MODULE.bazel
index f476a9cda7..73c5c7a676 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -418,6 +418,28 @@ crate.annotation(
     patches = ["//patches:notify_windows_idle.patch"],
     version = "8.2.0",
 )
+crate.annotation_select(
+    # zbus 6 turns these on through its default `default-rt` and `comms` features, but the Bazel
+    # feature resolution builds zruntime without them, so zbus fails to import its event types.
+    crate = "zruntime",
+    crate_features = [
+        "broadcast",
+        "event",
+        "helper",
+        "lock",
+        "process",
+        "runtime",
+        "tcp",
+        "unblock",
+        "unix",
+    ],
+    triples = [
+        "aarch64-unknown-linux-gnu",
+        "aarch64-unknown-linux-musl",
+        "x86_64-unknown-linux-gnu",
+        "x86_64-unknown-linux-musl",
+    ],
+)
 
 # Match the CodeModeHost response-compression benchmark's zstd level.
 crate.annotation(
@@ -519,7 +541,7 @@ crate.annotation(
 # MXC's resource compiler lookup needs an explicit path for Windows GNU targets.
 crate.annotation(
     build_script_deps = [
-        "@crates//cc-1.2.55",
+        "@crates//cc-1.11.1",
         "@crates//winresource-0.1.34",
     ],
     build_script_env = {
