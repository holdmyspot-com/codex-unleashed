From 8d05b71c6ea70a325e9839c5522b1d79d63c7691 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Mon, 9 Nov 2026 11:30:57 -0500
Subject: [PATCH] WIP: send Bytes explicitly in the plugin process fixture

tokio-util 0.7.20 adds Encoder<&[u8]> for LengthDelimitedCodec, so a frame built with .into() no longer has one target type (Linux test run 42652616421).
---
 codex-rs/plugin-host/tests/fixtures/plugin_process.rs | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/codex-rs/plugin-host/tests/fixtures/plugin_process.rs b/codex-rs/plugin-host/tests/fixtures/plugin_process.rs
index 25c7b1c..ed8f93a 100644
--- a/codex-rs/plugin-host/tests/fixtures/plugin_process.rs
+++ b/codex-rs/plugin-host/tests/fixtures/plugin_process.rs
@@ -6,6 +6,7 @@ use futures::StreamExt;
 use futures::executor::block_on;
 use futures::io::AllowStdIo;
 use std::io::Write;
+use tokio_util::bytes::Bytes;
 use tokio_util::codec::FramedRead;
 use tokio_util::codec::FramedWrite;
 use tokio_util::compat::FuturesAsyncReadCompatExt;
@@ -34,7 +35,7 @@ fn main() -> std::io::Result<()> {
         }
     }
     if std::env::args().any(|arg| arg == "--descendant") {
-        block_on(output.send(b"descendant-ready".as_slice().into()))?;
+        block_on(output.send(Bytes::from_static(b"descendant-ready")))?;
         loop {
             std::thread::park();
         }
@@ -55,12 +56,13 @@ fn main() -> std::io::Result<()> {
         AllowStdIo::new(std::io::stdin().lock()).compat(),
         framing::codec(),
     );
-    block_on(output.send(codex_plugin_host::READY.into()))?;
+    block_on(output.send(Bytes::from_static(codex_plugin_host::READY)))?;
     #[cfg(unix)]
     {
         // SAFETY: getpgrp reads this process's group identifier.
         let group = unsafe { libc::getpgrp() };
-        block_on(output.send(serde_json::to_vec(&(std::process::id(), group))?.into()))?;
+        let identity = serde_json::to_vec(&(std::process::id(), group))?;
+        block_on(output.send(Bytes::from(identity)))?;
     }
     let mut descendants = Vec::new();
     while let Some(message) = block_on(input.next()) {
-- 
