diff --git a/codex-rs/app-server-protocol/src/export.rs b/codex-rs/app-server-protocol/src/export.rs
index 1d26946..397338d 100644
--- a/codex-rs/app-server-protocol/src/export.rs
+++ b/codex-rs/app-server-protocol/src/export.rs
@@ -1409,10 +1409,20 @@ where
 }
 
 fn keep_enum_open_ended(schema: &mut Map<String, Value>) {
-    if let Some(Value::Array(mut variants)) = schema.remove("oneOf") {
-        variants.push(serde_json::json!({ "type": ["string", "object"] }));
-        schema.insert("anyOf".to_string(), Value::Array(variants));
+    let Some(Value::Array(mut variants)) = schema.remove("anyOf") else {
+        return;
+    };
+    // schemars 1 writes the untagged unit variant `Other` as `null`, but it is sent as "other"
+    // and accepts any error string or object.
+    variants.retain(|variant| *variant != serde_json::json!({ "type": "null" }));
+    if let Some(Value::Array(names)) = variants
+        .iter_mut()
+        .find_map(|variant| variant.get_mut("enum"))
+    {
+        names.push(Value::String("other".to_string()));
     }
+    variants.push(serde_json::json!({ "type": ["string", "object"] }));
+    schema.insert("anyOf".to_string(), Value::Array(variants));
 }
 
 fn add_server_notification_emitted_at_to_json_schema(schema: &mut Value) -> Result<()> {
