+/// Temporary marker for schemas whose `null` alternative is intentional.
+const KEEP_NULL_MARKER: &str = "x-keep-null";
+
+/// Marks a schema so `remove_null_variants` leaves its `null` alternative in place.
+pub(crate) fn keep_null(mut schema: Schema) -> Schema {
+    schema.insert(KEEP_NULL_MARKER.to_string(), true.into());
+    schema
+}
+
+/// Removes the `null` alternative that schemars adds for `Option<T>` so optional hook fields keep
+/// the plain schema of `T`. Schemas marked with `keep_null` are left untouched.
+fn remove_null_variants(schema: &mut Schema) {
+    transform_subschemas(&mut remove_null_variants, schema);
+
+    let Some(object) = schema.as_object_mut() else {
+        return;
+    };
+    if object.remove(KEEP_NULL_MARKER).is_some() {
+        return;
+    }
+    if let Some(Value::Array(types)) = object.get_mut("type")
+        && types.len() > 1
+        && types.iter().any(|value| value == "null")
+    {
+        types.retain(|value| value != "null");
+        if types.len() == 1 {
+            let only = types.remove(0);
+            object.insert("type".to_string(), only);
+        }
+        if let Some(Value::Array(values)) = object.get_mut("enum") {
+            values.retain(|value| !value.is_null());
+        }
+    }
+    let Some(Value::Array(variants)) = object.get_mut("anyOf") else {
+        return;
+    };
+    let null_schema = json!({ "type": "null" });
+    let original_len = variants.len();
+    variants.retain(|variant| *variant != null_schema);
+    if variants.len() == original_len || variants.len() != 1 {
+        return;
+    }
+    let remaining = variants.remove(0);
+    object.remove("anyOf");
+    match remaining {
+        Value::Object(remaining) if object.is_empty() || !remaining.contains_key("$ref") => {
+            object.extend(remaining);
+        }
+        remaining => {
+            object.insert("allOf".to_string(), Value::Array(vec![remaining]));
+        }
     }
 }
 
