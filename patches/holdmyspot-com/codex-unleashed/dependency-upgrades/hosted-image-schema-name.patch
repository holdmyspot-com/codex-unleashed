From ebedc18322e7529fc3f52d2f23552f41738920b3 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Sun, 8 Nov 2026 22:22:06 -0500
Subject: [PATCH] WIP: name the hosted image-generation item's schema apart
 from the extension's

schemars 0.8 identified schemas by name, so the rollout schema silently
merged core's ImageGenerationItem with the image extension's. schemars 1
numbers the second one, which the export's collision check rejects.
---
 codex-rs/protocol/src/items.rs | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/codex-rs/protocol/src/items.rs b/codex-rs/protocol/src/items.rs
index 220e98a..5f1ffe0 100644
--- a/codex-rs/protocol/src/items.rs
+++ b/codex-rs/protocol/src/items.rs
@@ -402,6 +402,8 @@ pub struct ImageViewItem {
 }
 
 #[derive(Debug, Clone, Deserialize, Serialize, TS, JsonSchema, PartialEq)]
+// The image extension's item shares this Rust name, and both reach the rollout schema.
+#[schemars(rename = "HostedImageGenerationItem")]
 pub struct ImageGenerationItem {
     pub id: String,
     pub status: String,
-- 
2.43.0

