From 3a96d3b2ca72f9517668f89c832e85f63bdc3fb0 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Mon, 9 Nov 2026 07:18:17 -0500
Subject: [PATCH] WIP: keep schemars 0.8's single-value enums

schemars 1 writes single-value enums as const, which the Python SDK
generator and other schema consumers do not expect; ReplaceConstValue
restores the enum form.
---
 codex-rs/app-server-protocol/src/export.rs | 3 +++
 codex-rs/config/src/schema.rs              | 3 +++
 codex-rs/hooks/src/schema.rs               | 3 +++
 3 files changed, 9 insertions(+)

diff --git a/codex-rs/app-server-protocol/src/export.rs b/codex-rs/app-server-protocol/src/export.rs
index a1d52d7..1d26946 100644
--- a/codex-rs/app-server-protocol/src/export.rs
+++ b/codex-rs/app-server-protocol/src/export.rs
@@ -25,6 +25,7 @@ use anyhow::Result;
 use anyhow::anyhow;
 use codex_history::RolloutLine;
 use schemars::generate::SchemaSettings;
+use schemars::transform::ReplaceConstValue;
 use serde_json::Map;
 use serde_json::Value;
 use std::collections::BTreeMap;
@@ -1358,7 +1359,9 @@ where
     let (raw_namespace, logical_name) = split_namespace(file_stem);
     let include_in_json_codegen =
         raw_namespace != Some("v1") || JSON_V1_ALLOWLIST.contains(&logical_name);
+    // schemars 1 writes single-value enums as `const`; keep 0.8's `enum` form for schema consumers.
     let schema = SchemaSettings::draft07()
+        .with_transform(ReplaceConstValue::default())
         .into_generator()
         .into_root_schema_for::<T>();
     let mut schema_value = serde_json::to_value(schema)?;
diff --git a/codex-rs/config/src/schema.rs b/codex-rs/config/src/schema.rs
index 2a483b2..d6f4d6e 100644
--- a/codex-rs/config/src/schema.rs
+++ b/codex-rs/config/src/schema.rs
@@ -8,6 +8,7 @@ use schemars::Schema;
 use schemars::SchemaGenerator;
 use schemars::generate::SchemaSettings;
 use schemars::json_schema;
+use schemars::transform::ReplaceConstValue;
 use schemars::transform::transform_subschemas;
 use serde_json::Map;
 use serde_json::Value;
@@ -225,8 +226,10 @@ pub fn mcp_servers_schema(schema_gen: &mut SchemaGenerator) -> Schema {
 
 /// Build the config schema for `config.toml`.
 pub fn config_schema() -> Schema {
+    // schemars 1 writes single-value enums as `const`; keep 0.8's `enum` form for schema consumers.
     let mut schema = SchemaSettings::draft07()
         .with_transform(remove_null_variants)
+        .with_transform(ReplaceConstValue::default())
         .into_generator()
         .into_root_schema_for::<ConfigToml>();
     add_shell_environment_policy_constraints(&mut schema);
diff --git a/codex-rs/hooks/src/schema.rs b/codex-rs/hooks/src/schema.rs
index eed791c..7f05b54 100644
--- a/codex-rs/hooks/src/schema.rs
+++ b/codex-rs/hooks/src/schema.rs
@@ -3,6 +3,7 @@ use schemars::Schema;
 use schemars::SchemaGenerator;
 use schemars::generate::SchemaSettings;
 use schemars::json_schema;
+use schemars::transform::ReplaceConstValue;
 use schemars::transform::transform_subschemas;
 use serde::Deserialize;
 use serde::Serialize;
@@ -823,8 +824,10 @@ fn schema_for_type<T>() -> Schema
 where
     T: JsonSchema,
 {
+    // schemars 1 writes single-value enums as `const`; keep 0.8's `enum` form for schema consumers.
     SchemaSettings::draft07()
         .with_transform(remove_null_variants)
+        .with_transform(ReplaceConstValue::default())
         .into_generator()
         .into_root_schema_for::<T>()
 }
