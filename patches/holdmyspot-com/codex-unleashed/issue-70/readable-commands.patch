+#[tokio::test]
+async fn readable_command_preview_protocol_source_survives_live_and_replay() {
+    let original = "'/plugins/CAT path/very/long/cache/bin/run-part' <<'EOF'\nprintf '%s\\n' 'a b' > '/reports/long path/result.txt'\nEOF\n";
+    for enabled in [true, false] {
+        let (mut chat, mut rx, _ops) = make_chatwidget_manual(None).await;
+        if enabled {
+            chat.config
+                .features
+                .enable(codex_features::Feature::UnleashedReadableCommands)
+                .expect("readable rendering fixture permits opt-in");
+        }
+        drain_insert_history(&mut rx);
+        let mut item = AppServerThreadItem::CommandExecution {
+            id: "readable-protocol".into(),
+            plugin_id: None,
+            script_path: None,
+            model_context: None,
+            sandbox_type: None,
+            command: original.into(),
+            cwd: chat.config.cwd.clone().into(),
+            process_id: None,
+            source: ExecCommandSource::Agent,
+            status: AppServerCommandExecutionStatus::InProgress,
+            command_actions: Vec::new(),
+            aggregated_output: None,
+            exit_code: None,
+            duration_ms: None,
+        };
+        let check = |cell: &dyn HistoryCell| {
+            let lines = cell.compact_hyperlink_lines(48);
+            let sources: Vec<_> = lines
+                .iter()
+                .filter_map(|line| line.source.as_ref())
+                .filter_map(|source| source.command.as_deref())
+                .collect();
+            if enabled {
+                assert!(!sources.is_empty());
+                assert!(sources.iter().all(|source| *source == original));
+                assert!(
+                    lines
+                        .iter()
+                        .map(|line| line.line.to_string())
+                        .collect::<Vec<_>>()
+                        .join("\n")
+                        .contains("run-part'")
+                );
+            } else {
+                assert!(sources.is_empty());
+            }
+        };
+        chat.handle_command_execution_started_now(item.clone());
+        check(chat.transcript.active_cell.as_deref().unwrap());
+        if let AppServerThreadItem::CommandExecution {
+            status,
+            aggregated_output,
+            exit_code,
+            duration_ms,
+            ..
+        } = &mut item
+        {
+            *status = AppServerCommandExecutionStatus::Completed;
+            *aggregated_output = Some("retained output\n".into());
+            *exit_code = Some(0);
+            *duration_ms = Some(5);
+        }
+        chat.handle_command_execution_completed_now(item.clone());
+        let completed = std::iter::from_fn(|| rx.try_recv().ok())
+            .filter_map(|event| match event {
+                AppEvent::InsertHistoryCell(cell) if !cell.activity_ids().is_empty() => Some(cell),
+                _ => None,
+            })
+            .collect::<Vec<_>>();
+        assert_eq!(completed.len(), 1);
+        check(completed[0].as_ref());
+        let projected = thread_items_to_transcript_cells(
+            chat.thread_id,
+            &chat.config.cwd,
+            [item],
+            RawReasoningVisibility::Hidden,
+            Some(&chat.config),
+        );
+        assert_eq!(projected.len(), 1);
+        check(projected[0].as_ref());
+    }
+}
