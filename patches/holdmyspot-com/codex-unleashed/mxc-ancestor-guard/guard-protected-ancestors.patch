+fn sorted_strings(paths: &[&Path]) -> Vec<String> {
+    let mut paths = paths
+        .iter()
+        .map(|path| path.to_str().unwrap().to_owned())
+        .collect::<Vec<_>>();
+    paths.sort();
+    paths
+}
+
+fn metadata_carveouts(root: &Path) -> Vec<PathBuf> {
+    [".agents", ".aws", ".codex", ".git"]
+        .map(|name| root.join(name))
+        .to_vec()
+}
+
+#[test]
+fn writable_chain_to_denied_directory_is_partitioned_into_child_grants() -> Result<()> {
+    let temp = tempfile::tempdir()?;
+    let canonical = canonical_root(&temp)?;
+    let workspace = canonical.join("W");
+    let upper = workspace.join("Upper");
+    let inner = upper.join("Inner");
+    let denied = inner.join("A");
+    let sibling = inner.join("sibling.txt");
+    let allowed = workspace.join("Allowed");
+    std::fs::create_dir_all(&denied)?;
+    std::fs::create_dir_all(&allowed)?;
+    std::fs::write(denied.join("protected.txt"), "protected")?;
+    std::fs::write(&sibling, "sibling")?;
+    let fs = FileSystemSandboxPolicy::restricted(vec![
+        entry(&workspace, FileSystemAccessMode::Write)?,
+        entry(&denied, FileSystemAccessMode::Deny)?,
+    ]);
+    let profile =
+        PermissionProfile::from_runtime_permissions(&fs, NetworkSandboxPolicy::Restricted);
+    let request = build_request(
+        &command(&profile, &workspace),
+        &workspace,
+        Vec::new(),
+        &[],
+        &[],
+    )?;
+    let metadata = metadata_carveouts(&workspace);
+    let mut readonly = vec![workspace.as_path(), upper.as_path(), inner.as_path()];
+    readonly.extend(metadata.iter().map(PathBuf::as_path));
+    assert_eq!(
+        (
+            request.policy.readwrite_paths,
+            request.policy.readonly_paths,
+            request.policy.denied_paths
+        ),
+        (
+            sorted_strings(&[&allowed, &sibling]),
+            sorted_strings(&readonly),
+            sorted_strings(&[&denied]),
+        )
+    );
+    Ok(())
+}
+
+#[test]
+fn writable_chain_to_read_only_file_keeps_other_files_writable() -> Result<()> {
+    let temp = tempfile::tempdir()?;
+    let canonical = canonical_root(&temp)?;
+    let workspace = canonical.join("W");
+    let upper = workspace.join("Upper");
+    let inner = upper.join("Inner");
+    let directory = inner.join("A");
+    let protected = directory.join("protected.txt");
+    let neighbor = directory.join("neighbor.txt");
+    let sibling = inner.join("sibling.txt");
+    let allowed = workspace.join("Allowed");
+    std::fs::create_dir_all(&directory)?;
+    std::fs::create_dir_all(&allowed)?;
+    std::fs::write(&protected, "protected")?;
+    std::fs::write(&neighbor, "neighbor")?;
+    std::fs::write(&sibling, "sibling")?;
+    let fs = FileSystemSandboxPolicy::restricted(vec![
+        entry(&workspace, FileSystemAccessMode::Write)?,
+        entry(&protected, FileSystemAccessMode::Read)?,
+    ]);
+    let profile =
+        PermissionProfile::from_runtime_permissions(&fs, NetworkSandboxPolicy::Restricted);
+    let request = build_request(
+        &command(&profile, &workspace),
+        &workspace,
+        Vec::new(),
+        &[],
+        &[],
+    )?;
+    let metadata = metadata_carveouts(&workspace);
+    let mut readonly = vec![
+        workspace.as_path(),
+        upper.as_path(),
+        inner.as_path(),
+        directory.as_path(),
+        protected.as_path(),
+    ];
+    readonly.extend(metadata.iter().map(PathBuf::as_path));
+    assert_eq!(
+        (
+            request.policy.readwrite_paths,
+            request.policy.readonly_paths,
+            request.policy.denied_paths
+        ),
+        (
+            sorted_strings(&[&allowed, &neighbor, &sibling]),
+            sorted_strings(&readonly),
+            Vec::<String>::new(),
+        )
+    );
+    Ok(())
+}
