+#[test]
+fn guarded_directory_enumeration_failure_is_reported_with_its_path() -> Result<()> {
+    let temp = tempfile::tempdir()?;
+    let gone = canonical_root(&temp)?.join("gone");
+    let key = PathUri::from_host_native_path(&gone)?;
+    let error = partition_guarded_directory(
+        &gone,
+        key,
+        &HashMap::new(),
+        &HashSet::new(),
+        &mut HashMap::new(),
+        &mut HashMap::new(),
+    )
+    .unwrap_err();
+    assert!(matches!(
+        &error,
+        PolicyError::EnumerateGuardedDirectory { path, .. } if path == &gone
+    ));
+    assert!(error.to_string().starts_with(&format!(
+        "enumerate guarded MXC directory {}",
+        gone.display()
+    )));
+    Ok(())
+}
