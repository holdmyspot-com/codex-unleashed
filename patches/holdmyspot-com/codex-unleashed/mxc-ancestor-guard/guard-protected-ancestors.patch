+#[test]
+fn nested_writable_exception_in_read_only_peer_is_partitioned() -> Result<()> {
+    let temp = tempfile::tempdir()?;
+    let canonical = canonical_root(&temp)?;
+    let workspace = canonical.join("W");
+    let readonly_peer = workspace.join("RO");
+    let nested = readonly_peer.join("nested");
+    let denied_peer = readonly_peer.join("secret.txt");
+    let denied_nested = nested.join("D");
+    let sibling = nested.join("sibling.txt");
+    let free = nested.join("free");
+    let top_file = workspace.join("top.txt");
+    std::fs::create_dir_all(&denied_nested)?;
+    std::fs::create_dir_all(&free)?;
+    std::fs::write(readonly_peer.join("peer.txt"), "peer")?;
+    std::fs::write(&denied_peer, "secret")?;
+    std::fs::write(denied_nested.join("x.txt"), "x")?;
+    std::fs::write(&sibling, "sibling")?;
+    std::fs::write(&top_file, "top")?;
+    let fs = FileSystemSandboxPolicy::restricted(vec![
+        entry(&workspace, FileSystemAccessMode::Write)?,
+        entry(&readonly_peer, FileSystemAccessMode::Read)?,
+        entry(&nested, FileSystemAccessMode::Write)?,
+        entry(&denied_peer, FileSystemAccessMode::Deny)?,
+        entry(&denied_nested, FileSystemAccessMode::Deny)?,
+    ]);
+    let profile =
+        PermissionProfile::from_runtime_permissions(&fs, NetworkSandboxPolicy::Restricted);
+    let request = build_request(
+        &command(&profile, &workspace),
+        &workspace,
+        Vec::new(),
+        &[],
+        &[],
+    )?;
+    let workspace_metadata = metadata_carveouts(&workspace);
+    let nested_metadata = metadata_carveouts(&nested);
+    let mut readonly = vec![
+        workspace.as_path(),
+        readonly_peer.as_path(),
+        nested.as_path(),
+    ];
+    readonly.extend(workspace_metadata.iter().map(PathBuf::as_path));
+    readonly.extend(nested_metadata.iter().map(PathBuf::as_path));
+    assert_eq!(
+        (
+            request.policy.readwrite_paths,
+            request.policy.readonly_paths,
+            request.policy.denied_paths
+        ),
+        (
+            sorted_strings(&[&top_file, &sibling, &free]),
+            sorted_strings(&readonly),
+            sorted_strings(&[&denied_peer, &denied_nested]),
+        )
+    );
+    Ok(())
+}
