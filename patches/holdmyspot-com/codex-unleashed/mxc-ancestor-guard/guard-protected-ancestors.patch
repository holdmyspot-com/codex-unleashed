+#[test]
+fn missing_protected_paths_do_not_guard_their_ancestors() -> Result<()> {
+    let temp = tempfile::tempdir()?;
+    let canonical = canonical_root(&temp)?;
+    let workspace = canonical.join("W");
+    let missing_read_only = workspace.join("Upper").join("absent.txt");
+    std::fs::create_dir_all(workspace.join("Upper"))?;
+    let fs = FileSystemSandboxPolicy::restricted(vec![
+        entry(&workspace, FileSystemAccessMode::Write)?,
+        entry(&missing_read_only, FileSystemAccessMode::Read)?,
+    ]);
+    let profile =
+        PermissionProfile::from_runtime_permissions(&fs, NetworkSandboxPolicy::Restricted);
+    let request = build_request(
+        &command(&profile, &workspace),
+        &workspace,
+        Vec::new(),
+        &[],
+        &[],
+    )?;
+    let metadata = metadata_carveouts(&workspace);
+    let mut readonly = vec![missing_read_only.as_path()];
+    readonly.extend(metadata.iter().map(PathBuf::as_path));
+    assert_eq!(
+        (
+            request.policy.readwrite_paths,
+            request.policy.readonly_paths,
+        ),
+        (sorted_strings(&[&workspace]), sorted_strings(&readonly))
+    );
+    Ok(())
+}
