     Ok(expanded)
 }
 
+/// Split every writable grant that is an ancestor of an existing protected object (a denied path or
+/// a read-only carveout) so that no writable grant retains the right to rename a directory on the way
+/// to that object.
+///
+/// Returns the writable grants and the guarded directories. The guarded directories were writable,
+/// so they were readable; the caller grants them read access. Each guarded directory is replaced
+/// by a grant for every immediate child that is neither protected nor itself an ancestor of a
+/// protected object. Existing files therefore keep exact grants, and ancestors stay unwritable.
+/// A protected path that does not exist cannot be renamed, so it guards nothing; ancestors above
+/// the writable grants are left ungranted.
+pub(super) fn guard_protected_ancestors(
+    write: NativePaths,
+    protected: &NativePaths,
+) -> Result<(NativePaths, NativePaths), PolicyError> {
+    let mut existing = HashSet::new();
+    let mut ancestors = NativePaths::new();
+    for (key, path) in protected {
+        if std::fs::symlink_metadata(path).is_err() {
+            continue;
+        }
+        existing.insert(key.clone());
+        for ancestor in path
+            .ancestors()
+            .skip(1)
+            .filter(|ancestor| !ancestor.as_os_str().is_empty())
+        {
+            ancestors.insert(
+                PathUri::from_host_native_path(ancestor)?,
+                ancestor.to_path_buf(),
+            );
+        }
+    }
+    let mut guarded_write = NativePaths::new();
+    let mut guards = NativePaths::new();
+    for (key, path) in write {
+        if ancestors.contains_key(&key) {
+            partition_guarded_directory(
+                &path,
+                key,
+                &ancestors,
+                &existing,
+                &mut guarded_write,
+                &mut guards,
+            )?;
+        } else {
+            guarded_write.insert(key, path);
+        }
+    }
+    Ok((guarded_write, guards))
+}
+
+// Enumerate only the directories on the chains to protected objects; an unreadable chain fails
+// policy construction instead of falling back to a broader grant.
+pub(super) fn partition_guarded_directory(
+    directory: &Path,
+    key: PathUri,
+    ancestors: &NativePaths,
+    protected: &HashSet<PathUri>,
+    write: &mut NativePaths,
+    guards: &mut NativePaths,
+) -> Result<(), PolicyError> {
+    if guards.insert(key, directory.to_path_buf()).is_some() {
+        return Ok(());
+    }
+    let entries = std::fs::read_dir(directory)
+        .and_then(Iterator::collect::<std::io::Result<Vec<_>>>)
+        .map_err(|source| PolicyError::EnumerateGuardedDirectory {
+            path: directory.to_path_buf(),
+            source,
+        })?;
+    for entry in entries {
+        let child = entry.path();
+        if child.to_str().is_none() {
+            continue;
+        }
+        let child_key = PathUri::from_host_native_path(&child)?;
+        if protected.contains(&child_key) {
+            continue;
+        }
+        if ancestors.contains_key(&child_key) {
+            partition_guarded_directory(&child, child_key, ancestors, protected, write, guards)?;
+            continue;
+        }
+        // Only resolve links: broken targets prevent PSEC startup.
+        if entry.file_type().is_ok_and(|kind| kind.is_symlink())
+            && std::fs::metadata(&child).is_err()
+        {
+            continue;
+        }
+        write.insert(child_key, child);
+    }
+    Ok(())
+}
+
 fn collect_paths(paths: impl IntoIterator<Item = PathBuf>) -> Result<NativePaths, PolicyError> {
     paths
         .into_iter()
