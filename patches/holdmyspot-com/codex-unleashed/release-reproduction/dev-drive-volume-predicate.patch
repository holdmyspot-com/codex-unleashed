-# Test-Path models whether the runner exposes an existing Dev Drive at D:.
+# The test-owned type models platform observations while setup retains the real bit decision.
+Microsoft.PowerShell.Utility\Add-Type -TypeDefinition @'
+using System;
+
+namespace Codex
+{
+    public static class DevDriveVolumeStateHelper
+    {
+    }
+
+    public static class DevDriveVolumeState
+    {
+        public static Func<string, string> FileSystemReader;
+        public static Func<string, uint> VolumeFlagsReader;
+
+        public static string QueryFileSystem(string drive)
+        {
+            return FileSystemReader(drive);
+        }
+
+        public static uint QueryVolumeFlags(string drive)
+        {
+            return VolumeFlagsReader(drive);
+        }
+    }
+}
+'@ -PassThru -ErrorAction Stop | Out-Null
+
+# Add-Type returns the test-owned type to production for same-process controlled observations.
+function Add-Type {
+    param(
+        [string]$TypeDefinition,
+        [switch]$PassThru,
+        [System.Management.Automation.ActionPreference]$ErrorAction
+    )
+    $script:TestState.Calls.Add("Add-Type")
+    if ($script:TestState.AddTypeEmitsMultipleTypes) {
+        return [System.Type[]]@([Codex.DevDriveVolumeStateHelper], [Codex.DevDriveVolumeState])
+    }
+    return [Codex.DevDriveVolumeState]
+}
+
+function Set-TestVolumeReaders {
+    [Codex.DevDriveVolumeState]::FileSystemReader = [System.Func[string, string]] {
+        param([string]$Drive)
+        $script:TestState.Calls.Add("QueryFileSystem $Drive")
+        if ($Drive -eq "D:" -and $script:TestState.ExistingFileSystemFails) {
+            throw [System.ComponentModel.Win32Exception]::new(5)
+        }
+        if ($Drive -eq "D:") {
+            return [string]$script:TestState.ExistingFileSystem
+        }
+        if ($script:TestState.NonDevDrives -contains $Drive) {
+            return "NTFS"
+        }
+        return [string]$script:TestState.NewFileSystem
+    }
+    [Codex.DevDriveVolumeState]::VolumeFlagsReader = [System.Func[string, uint32]] {
+        param([string]$Drive)
+        $script:TestState.Calls.Add("QueryVolumeFlags $Drive")
+        if ($Drive -eq "D:" -and $script:TestState.ExistingVolumeFlagsFail) {
+            throw [System.ComponentModel.Win32Exception]::new(5)
+        }
+        if ($Drive -eq "D:") {
+            return [uint32]$script:TestState.ExistingVolumeFlags
+        }
+        if ($script:TestState.NewVolumeFlagsFail) {
+            throw [System.ComponentModel.Win32Exception]::new(5)
+        }
+        return [uint32]$script:TestState.NewVolumeFlags
+    }
+}
+
+# Test-Path models whether the runner exposes an existing volume at D:, whether the owned VHD file exists, and whether another
+# volume root is present.
 function Test-Path {
     param([string]$Path)
     $script:TestState.Calls.Add("Test-Path $Path")
-    $isExistingDevDrive = $Path -eq "D:\" -and $script:TestState.ExistingDevDrive
-    return $isExistingDevDrive
+    if ($Path -eq "D:\") {
+        return $script:TestState.ExistingDrivePresent
+    }
+    if ($Path -eq $script:ExpectedVhdPath) {
+        return $script:TestState.VhdFilePresent
+    }
+    return $script:TestState.PresentDrives -contains $Path
+}
+
+# Remove-Item models deleting the owned VHD file, which Windows refuses while the VHD is attached.
+function Remove-Item {
+    param([string]$Path, [switch]$Force)
+    $script:TestState.Calls.Add("Remove-Item $Path")
+    if ($script:TestState.VhdAttached) {
+        throw "The process cannot access the file '$Path' because it is being used by another process."
+    }
+}
+
+# Get-VHD models reading whether the owned VHD file is attached.
+function Get-VHD {
+    param([string]$Path)
+    $script:TestState.Calls.Add("Get-VHD $Path")
+    [pscustomobject]@{ Attached = $script:TestState.VhdAttached; DiskNumber = 7 }
+}
+
+# Get-Partition models listing the partitions of an attached VHD's disk, each with a drive letter or none.
+function Get-Partition {
+    param([int]$DiskNumber)
+    $script:TestState.Calls.Add("Get-Partition $DiskNumber")
+    [pscustomobject]@{ DriveLetter = [char]0 }
+    foreach ($letter in $script:TestState.AttachedPartitionLetters) {
+        [pscustomobject]@{ DriveLetter = [char]$letter }
+    }
 }
 
