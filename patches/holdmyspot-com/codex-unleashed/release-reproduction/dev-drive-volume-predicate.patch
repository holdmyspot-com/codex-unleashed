From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Sun, 15 Nov 2026 02:08:07 -0500
Subject: [PATCH] Fix Dev Drive volume-state detection and reuse a provisioned
 Dev Drive

A second setup in the same job used to remove and recreate the owned VHD, which Windows refuses while the first setup's VHD is attached, so the second setup failed and the job stopped. The setup now reuses the Dev Drive that CI_BUILD_ROOT records, or that the attached owned VHD exposes, when it passes the Dev Drive test, and then removes and recreates nothing.
---
 .github/scripts/setup-dev-drive.ps1          | 172 ++++++++++++++++-
 .github/scripts/test-setup-dev-drive-bfs.ps1 | 193 ++++++++++++++++++-
 2 files changed, 353 insertions(+), 12 deletions(-)

diff --git a/.github/scripts/setup-dev-drive.ps1 b/.github/scripts/setup-dev-drive.ps1
index d171231eba..157aa7a13c 100644
--- a/.github/scripts/setup-dev-drive.ps1
+++ b/.github/scripts/setup-dev-drive.ps1
@@ -5,11 +5,161 @@
 # build directories where CI spends significant time doing I/O, so fail the
 # job if no real Dev Drive is available.
 
+function Resolve-DevDriveVolumeStateType {
+    param([object[]]$EmittedTypes)
+
+    $matchingTypes = @(
+        foreach ($emittedType in $EmittedTypes) {
+            if (($emittedType -is [System.Type]) -and ($emittedType.FullName -ceq "Codex.DevDriveVolumeState")) {
+                $emittedType
+            }
+        }
+    )
+    if ($matchingTypes.Count -ne 1) {
+        throw "Add-Type must emit exactly one type named 'Codex.DevDriveVolumeState'; found $($matchingTypes.Count)."
+    }
+
+    return $matchingTypes[0]
+}
+
+$emittedDevDriveTypes = Add-Type -TypeDefinition @'
+using System;
+using System.ComponentModel;
+using System.IO;
+using System.Runtime.InteropServices;
+using Microsoft.Win32.SafeHandles;
+
+namespace Codex
+{
+    public static class DevDriveVolumeState
+    {
+        [StructLayout(LayoutKind.Sequential)]
+        private struct PersistentVolumeInformation
+        {
+            public uint VolumeFlags;
+            public uint FlagMask;
+            public uint Version;
+            public uint Reserved;
+        }
+
+        [DllImport("kernel32.dll", CharSet = CharSet.Unicode, EntryPoint = "CreateFileW", SetLastError = true)]
+        private static extern SafeFileHandle CreateFile(
+            string fileName,
+            uint desiredAccess,
+            uint shareMode,
+            IntPtr securityAttributes,
+            uint creationDisposition,
+            uint flagsAndAttributes,
+            IntPtr templateFile);
+
+        [DllImport("kernel32.dll", SetLastError = true)]
+        private static extern bool DeviceIoControl(
+            SafeFileHandle device,
+            uint controlCode,
+            ref PersistentVolumeInformation input,
+            uint inputSize,
+            out PersistentVolumeInformation output,
+            uint outputSize,
+            out uint bytesReturned,
+            IntPtr overlapped);
+
+        public static string QueryFileSystem(string drive)
+        {
+            return new DriveInfo(drive + @"\").DriveFormat;
+        }
+
+        public static uint QueryVolumeFlags(string drive)
+        {
+            using (SafeFileHandle volume = CreateFile(drive + @"\", 0x00000080, 3, IntPtr.Zero, 3, 0x02000000, IntPtr.Zero))
+            {
+                if (volume.IsInvalid)
+                {
+                    int nativeError = Marshal.GetLastWin32Error();
+                    throw new Win32Exception(nativeError, "Could not open volume " + drive + " (Win32 error " + nativeError + ").");
+                }
+
+                PersistentVolumeInformation input = new PersistentVolumeInformation();
+                input.FlagMask = 0x00002000;
+                input.Version = 1;
+                PersistentVolumeInformation output;
+                uint bytesReturned;
+                bool querySucceeded = DeviceIoControl(volume, 0x0009023c, ref input, 16, out output, 16, out bytesReturned, IntPtr.Zero);
+                if (!querySucceeded)
+                {
+                    int nativeError = Marshal.GetLastWin32Error();
+                    throw new Win32Exception(nativeError, "Could not query Dev Drive state for " + drive + " (Win32 error " + nativeError + ").");
+                }
+                if (bytesReturned < 16)
+                {
+                    throw new IOException("Dev Drive state query for " + drive + " returned only " + bytesReturned + " bytes.");
+                }
+
+                return output.VolumeFlags;
+            }
+        }
+    }
+}
+'@ -PassThru -ErrorAction Stop
+$script:DevDriveVolumeStateType = Resolve-DevDriveVolumeStateType -EmittedTypes $emittedDevDriveTypes
+
 function Test-DevDrive {
     param([string]$Drive)
 
-    & fsutil devdrv query $Drive *> $null
-    return $LASTEXITCODE -eq 0
+    # True means the typed state marks a ReFS volume as a Dev Drive; query failures propagate.
+    $fileSystem = $script:DevDriveVolumeStateType::QueryFileSystem($Drive)
+    $isReFs = [string]::Equals($fileSystem, "ReFS", [System.StringComparison]::OrdinalIgnoreCase)
+    if ($isReFs) {
+        $volumeFlags = $script:DevDriveVolumeStateType::QueryVolumeFlags($Drive)
+        $devVolumeMask = [uint32]0x00002000
+        $isDevVolume = ($volumeFlags -band $devVolumeMask) -gt 0
+        return $isDevVolume
+    }
+
+    return $false
+}
+
+function Get-RecordedDevDrive {
+    param([string]$BuildRoot)
+
+    # A setup that ran earlier in this job recorded its drive in CI_BUILD_ROOT. That drive is reusable only while it is a
+    # bare drive letter that is present and still passes the Dev Drive test; query failures propagate.
+    if ($BuildRoot -notmatch '^[A-Za-z]:$') {
+        return $null
+    }
+    if (-not (Test-Path "$BuildRoot\")) {
+        return $null
+    }
+    if (Test-DevDrive $BuildRoot) {
+        return $BuildRoot
+    }
+
+    return $null
+}
+
+function Get-AttachedDevDrive {
+    param([string]$VhdPath)
+
+    # An owned VHD that is already attached cannot be removed or recreated; its Dev Drive is the one to reuse.
+    if (-not (Test-Path $VhdPath)) {
+        return $null
+    }
+
+    $vhd = Get-VHD -Path $VhdPath -ErrorAction Stop
+    if (-not $vhd.Attached) {
+        return $null
+    }
+
+    foreach ($partition in @(Get-Partition -DiskNumber $vhd.DiskNumber -ErrorAction Stop)) {
+        $letter = [string]$partition.DriveLetter
+        if ($letter -match '^[A-Za-z]$') {
+            $drive = "${letter}:"
+            if (Test-DevDrive $drive) {
+                return $drive
+            }
+        }
+    }
+
+    throw "The owned VHD $VhdPath is already attached but exposes no Dev Drive volume."
 }
 
