From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Wed, 18 Nov 2026 12:21:44 -0500
Subject: [PATCH] bazel: Configure AWS-LC C actions for C11

Add a rules_cc feature overlay that removes the default C standard selection for AWS-LC targets.
Keep the configured C11 standard unique while preserving warning and static CRT configuration.
---
 MODULE.bazel                            |   8 ++
 patches/BUILD.bazel                     |   1 +
 patches/aws_lc_c_standard.patch         | 100 ++++++++++++++++++++++++
 tools/aws-lc-standard/BUILD.bazel       |  91 +++++++++++++++++++++
 tools/aws-lc-standard/default.c         |   1 +
 tools/aws-lc-standard/standard_test.bzl |  42 ++++++++++
 6 files changed, 243 insertions(+)
 create mode 100644 patches/aws_lc_c_standard.patch
 create mode 100644 tools/aws-lc-standard/BUILD.bazel
 create mode 100644 tools/aws-lc-standard/default.c
 create mode 100644 tools/aws-lc-standard/standard_test.bzl

diff --git a/MODULE.bazel b/MODULE.bazel
index 980722af7e..61a453b292 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -169,6 +169,14 @@ use_repo(cc_configure, "local_config_cc")
 bazel_dep(name = "rules_platform", version = "0.1.0")
 bazel_dep(name = "rules_pkg", version = "1.0.1")
 bazel_dep(name = "aws-lc", version = "5.1.0.bcr.3")
+single_version_override(
+    module_name = "aws-lc",
+    patch_strip = 1,
+    patches = [
+        "//patches:aws_lc_c_standard.patch",
+    ],
+)
+
 bazel_dep(name = "rules_rs", version = "0.2.3")
 bazel_dep(name = "rules_foreign_cc", version = "0.15.1")
 single_version_override(
