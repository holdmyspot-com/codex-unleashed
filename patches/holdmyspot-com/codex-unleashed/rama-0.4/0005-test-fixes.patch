+/// Returns the request path exactly as it appeared on the wire, without
+/// percent-encoding normalization, so literal characters such as `[` stay literal.
+fn raw_path(uri: &rama_http::Uri) -> String {
+    let text = uri.as_str();
+    let rest = match text.split_once("://") {
+        Some((_, after_scheme)) => after_scheme
+            .find('/')
+            .map_or("", |idx| &after_scheme[idx..]),
+        None => text,
+    };
+    let end = rest.find(['?', '#']).unwrap_or(rest.len());
+    let path = &rest[..end];
+    if path.is_empty() {
+        "/".to_string()
+    } else {
+        path.to_string()
+    }
+}
