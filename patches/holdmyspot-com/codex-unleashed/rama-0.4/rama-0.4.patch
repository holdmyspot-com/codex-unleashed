diff --git a/MODULE.bazel b/MODULE.bazel
index 41595db..f361ecc 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -452,6 +452,13 @@ crate.annotation(
         ],
     },
 )
+crate.annotation(
+    # rama-dns links `Dnsapi`, but the MinGW import library is `libdnsapi.a`, so linking from a
+    # case-sensitive file system fails. Windows resolves either spelling to the same DLL.
+    crate = "rama-dns",
+    patch_args = ["-p1"],
+    patches = ["//patches:rama-dns_windows_dnsapi_link_name.patch"],
+)
 
