From 20aa8259744ed386b174c7e845ad8d9081af39bb Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Wed, 14 Oct 2026 13:30:33 +0000
Subject: [PATCH] Propagate generated compiler environment files to integration
 tests

Refs #69. Keep production sandbox permissions and digest verification
unchanged. Declared upstream release base: rust-v0.162.1 (092d3acd6).

Red: sandbox-compiler-env-regression-red.log.
Green: sandbox-all-with-metadata-green-test.log (67 passed, 3 ignored).
The compiler-env regression fails at its missing digest before propagation.
Formatting: sandbox-metadata-regression-fmt.log passes. Fresh emitted queue
and full hosted acceptance remain separate required gates.
---
 codex-rs/linux-sandbox/tests/suite/managed_proxy.rs | 10 ++++++++++
 defs.bzl                                            |  6 +++++-
 2 files changed, 15 insertions(+), 1 deletion(-)

diff --git a/codex-rs/linux-sandbox/tests/suite/managed_proxy.rs b/codex-rs/linux-sandbox/tests/suite/managed_proxy.rs
index 2012855cc..d4cad58cf 100644
--- a/codex-rs/linux-sandbox/tests/suite/managed_proxy.rs
+++ b/codex-rs/linux-sandbox/tests/suite/managed_proxy.rs
@@ -460,6 +460,16 @@ printf 'legacy proc fallback\n'
     }
 }
 
+#[test]
+fn bazel_tests_receive_bundled_bwrap_digest() {
+    if option_env!("BAZEL_PACKAGE").is_some() {
+        assert!(
+            option_env!("CODEX_BWRAP_SHA256").is_some(),
+            "Bazel integration tests require the library's bundled bubblewrap digest"
+        );
+    }
+}
+
 #[tokio::test]
 async fn unsupported_system_bwrap_falls_back_to_bundled_bwrap() {
     if option_env!("CODEX_BWRAP_SHA256")
diff --git a/defs.bzl b/defs.bzl
index 34fa7fca2..f89ddb8e6 100644
--- a/defs.bzl
+++ b/defs.bzl
@@ -267,7 +267,8 @@ def codex_rust_crate(
             generated build-commit environment file. Other workspace status is
             excluded from their compilation inputs.
         rustc_env: Extra rustc_env entries to merge with defaults.
-        rustc_env_files: Generated compiler environment files for the library target.
+        rustc_env_files: Generated compiler environment files for the library and
+            integration test targets.
         deps_extra: Extra normal deps beyond @crates resolution.
             Typically only needed when features add additional deps.
         integration_compile_data_extra: Extra compile_data for integration tests.
@@ -605,6 +606,7 @@ def codex_rust_crate(
                     "--remap-path-prefix=codex-rs=",
                 ],
                 rustc_env = rustc_env,
+                rustc_env_files = rustc_env_files,
                 target_compatible_with = WINDOWS_GNULLVM_INCOMPATIBLE,
                 tags = test_tags + ["manual"],
                 version = crate_version,
@@ -647,6 +649,7 @@ def codex_rust_crate(
                     "--remap-path-prefix=codex-rs=",
                 ],
                 rustc_env = rustc_env,
+                rustc_env_files = rustc_env_files,
                 env = integration_test_cargo_env,
                 target_compatible_with = WINDOWS_GNULLVM_INCOMPATIBLE,
                 tags = test_tags,
@@ -721,6 +724,7 @@ def codex_rust_crate(
                 "--remap-path-prefix=codex-rs=",
             ],
             rustc_env = rustc_env,
+            rustc_env_files = rustc_env_files,
             env = integration_test_cargo_env,
             target_compatible_with = WINDOWS_GNULLVM_ONLY,
             tags = test_tags + ["manual"],
