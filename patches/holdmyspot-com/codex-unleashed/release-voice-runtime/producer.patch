+  printf 'fixture shared library\n' > "$runtime/lib/libfixture.so"
+fi
+printf '{"target": "%s", "sourceCommit": "%s"}\n' "$voice_target" "$FAKE_GIT_COMMIT" > "$runtime/runtime.json"
+mkdir -p bazel-bin/codex-rs/voice-host
+extension=
