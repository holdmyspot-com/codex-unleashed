+  rm -f -- "$TEST_ROOT/git-changed" "$TEST_ROOT/build-arguments.txt"
+  if run_producer "$root" "$target" "$runner_os" "$machine" "$commit" "$result" "$@"; then
+    fail "$name unexpectedly succeeded"
