+make_fixture wrong-windows-package-identity
+windows_root="$FIXTURE_ROOT"
+mkdir -p "$windows_root/windows-tools/evidence" "$windows_root/windows-tools/pkgconf-image" "$windows_root/windows-tools/cygwin"
+printf '{"target": "x86_64-pc-windows-msvc", "pkgconf_version": "3.0.6"}\n' > "$windows_root/windows-tools/evidence/tools.json"
+printf '{"schemaVersion": 1, "target": "x86_64-pc-windows-msvc", "cygwinArchitecture": "x86_64"}\n' > "$windows_root/windows-tools/voice-tools.json"
+printf 'fixture package inventory\n' > "$windows_root/windows-tools/evidence/packages.txt"
+export VOICE_WINDOWS_BAZEL_REPOSITORY="$windows_root/windows-tools"
+check_failed_case wrong-windows-package-identity x86_64-pc-windows-msvc Windows x86_64 FAKE_WINDOWS_PACKAGES_OK=0
+unset VOICE_WINDOWS_BAZEL_REPOSITORY
+
+# Verify that the Windows producer rejects absent authoritative tools metadata.
+# Arguments: fixture name; metadata layout, either missing or root-only.
+# Environment: TEST_ROOT and FIXTURE_ROOT select the test scratch and fixture paths.
+# Environment: VOICE_WINDOWS_BAZEL_REPOSITORY is set to the fixture repository during
+# the producer call and unset before returning.
+# Errors: Calls fail when the producer accepts invalid metadata, reports the wrong
+# path, leaves failed output, or invokes Bazel before rejecting the prerequisite.
+# Exit status: Returns 0 when rejection and cleanup checks pass; fail exits with 1.
+check_windows_tools_metadata_failure() {
+  local name="$1"
+  local layout="$2"
+  local target=x86_64-pc-windows-msvc
+  local root
+  local result="$TEST_ROOT/$name result"
+  local tools_root
+  local expected_metadata
+
+  make_fixture "$name"
+  root="$FIXTURE_ROOT"
+  rm -f -- "$TEST_ROOT/git-changed" "$TEST_ROOT/build-arguments.txt"
+  tools_root="$root/windows-tools"
+  mkdir -p "$tools_root/evidence" "$tools_root/pkgconf-image" "$tools_root/cygwin"
+  printf '{"schemaVersion": 1, "target": "%s", "cygwinArchitecture": "x86_64"}\n' "$target" > "$tools_root/voice-tools.json"
+  printf 'fixture package inventory\n' > "$tools_root/evidence/packages.txt"
+  if [[ "$layout" == root-only ]]; then
+    printf '{"target": "%s", "pkgconf_version": "3.0.6"}\n' "$target" > "$tools_root/tools.json"
+  fi
+  export VOICE_WINDOWS_BAZEL_REPOSITORY="$tools_root"
+  if run_producer "$root" "$target" Windows x86_64 "$EXPECTED_COMMIT" "$result"; then
+    fail "$name unexpectedly succeeded"
+  fi
+  expected_metadata="$tools_root/evidence/tools.json"
+  if grep -Fq -- "Windows build-tool identity file is missing: $expected_metadata" "$TEST_ROOT/logs/$target.stderr"; then :; else
+    fail "$name did not reject the missing authoritative metadata path"
+  fi
+  assert_failed_result_cleanup "$result"
+  if [[ -s "$TEST_ROOT/build-arguments.txt" ]]; then
+    fail "$name invoked Bazel before prerequisite metadata was rejected"
+  fi
+  unset VOICE_WINDOWS_BAZEL_REPOSITORY
+}
+
+check_windows_tools_metadata_failure missing-windows-tools-metadata missing
+check_windows_tools_metadata_failure misleading-root-only-windows-tools-metadata root-only
+
+# The producer preserves a caller-owned result path when it already exists.
+make_fixture preexisting-result
+existing_root="$FIXTURE_ROOT"
+existing_result="$TEST_ROOT/preexisting-result result"
+mkdir -p "$existing_result"
+printf 'caller-owned\n' > "$existing_result/sentinel"
+if run_producer "$existing_root" x86_64-unknown-linux-musl Linux x86_64 "$EXPECTED_COMMIT" "$existing_result"; then
+  fail 'producer accepted a preexisting result directory'
+fi
+assert_equal caller-owned "$(cat "$existing_result/sentinel")" 'preexisting result sentinel'
+assert_absent "$existing_result/completed" 'preexisting result completion marker'
