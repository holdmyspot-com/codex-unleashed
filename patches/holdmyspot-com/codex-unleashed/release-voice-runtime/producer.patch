+
+# Runs a preflight failure and requires that no result directory is created.
+check_preflight_failure() {
+  local name="$1"
+  local target="$2"
+  local runner_os="$3"
+  local machine="$4"
+  local commit="$5"
+  shift 5
+  local root
+  local result="$TEST_ROOT/$name result"
+
+  make_fixture "$name"
