+FAKE_PYTHON
+  cat > "$root/.github/scripts/run-bazel-ci.sh" <<'FAKE_BUILD'
+#!/usr/bin/env bash
+set -euo pipefail
+printf '<%s>\n' "$@" >> "$FAKE_BUILD_ARGUMENTS"
+suffix=
+targets=0
+for argument in "$@"; do
