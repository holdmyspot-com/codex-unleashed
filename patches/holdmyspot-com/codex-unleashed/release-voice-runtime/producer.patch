+  local runner_os="$2"
+  local machine="$3"
+  local expected_voice="$4"
+  local expected_suffix="$5"
+  local expected_runner="$6"
+  local expected_helper="$7"
+  local processor_architecture=AMD64
+  local name="mapping-${target}"
