+# Runs a failure case and checks that its result directory contains evidence only.
+check_failed_case() {
+  local name="$1"
+  local target="$2"
+  local runner_os="$3"
+  local machine="$4"
+  shift 4
+  local root
+  local result="$TEST_ROOT/$name result"
+
+  make_fixture "$name"
