+  cat > "$bin/uname" <<'FAKE_UNAME'
+#!/usr/bin/env bash
+set -euo pipefail
+if [[ "${1:-}" == -m ]]; then
+  printf '%s\n' "$FAKE_UNAME_MACHINE"
