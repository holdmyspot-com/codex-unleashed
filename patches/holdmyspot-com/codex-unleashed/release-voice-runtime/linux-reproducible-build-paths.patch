index 5dacbcaf2..18a15eb33 100644
--- a/third_party/voice/native.bzl
+++ b/third_party/voice/native.bzl
@@ -30,6 +30,7 @@ def _native_prefix_impl(ctx):
         "prefix": prefix.path,
         "receipt": receipt.path,
         "target": ctx.attr.target,
+        "fixed_mount": ctx.attr.target.endswith("unknown-linux-gnu") and ctx.var.get("codex_voice_fixed_mount") == "1",
         "deployment_target": minimums[0] if minimums else None,
         "jobs": 8,
         "cc": tools.cc,
