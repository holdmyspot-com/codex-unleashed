From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Sun, 15 Nov 2026 02:54:39 +0000
Subject: [PATCH] bugfix: receive voice RTP before optional jitter buffering

Register RTP ingress before the optional jitter interceptor so incoming
packets retain arrival order and reach the receiver exactly once.

---
diff --git a/codex-rs/voice-host/src/capture_worker_tests.rs b/codex-rs/voice-host/src/capture_worker_tests.rs
index e15a7d9..e3c8e00 100644
--- a/codex-rs/voice-host/src/capture_worker_tests.rs
+++ b/codex-rs/voice-host/src/capture_worker_tests.rs
@@ -220,7 +220,7 @@ async fn capture_reaches_remote_rtp_and_mute_discards_queued_and_partial_audio()
             .with_setting_engine(settings)
             .with_handler(Arc::new(Gathered(gathered.clone())))
             .with_interceptor_registry(rtc::interceptor::Registry::new().with(
-                rtc::interceptor::Slot::JitterBuffer,
+                rtc::interceptor::Slot::from(crate::transport::INGRESS_SLOT),
                 RemoteRtp {
                     write_queue: VecDeque::new(),
                     sender,
diff --git a/codex-rs/voice-host/src/transport.rs b/codex-rs/voice-host/src/transport.rs
index ea0213e..2f583da 100644
--- a/codex-rs/voice-host/src/transport.rs
+++ b/codex-rs/voice-host/src/transport.rs
@@ -23,6 +23,10 @@ use webrtc::peer_connection::RTCSessionDescription;
 
 const WAIT: Duration = Duration::from_secs(/*secs*/ 15);
 const MAX_REMOTE_CANDIDATES: usize = 32;
+
+/// Orders ingress before upstream jitter-buffer slot 13_000 to preserve network arrival times.
+pub(crate) const INGRESS_SLOT: usize = 12_500;
+
 type Result<T> = std::result::Result<T, &'static str>;
 
 struct Events(Arc<Notify>);
@@ -79,6 +83,11 @@ impl Transport {
         Self::with_runtime(Arc::new(crate::transport_runtime::VoiceRuntime::default())).await
     }
 
+    /// Builds the peer's registry so ingress consumes Opus RTP before optional jitter buffering.
+    fn interceptor_registry(ingress: crate::incoming::Ingress) -> rtc::interceptor::Registry {
+        rtc::interceptor::Registry::new().with(rtc::interceptor::Slot::from(INGRESS_SLOT), ingress)
+    }
+
     async fn with_runtime(runtime: Arc<dyn webrtc::runtime::Runtime>) -> Result<Self> {
         let (media, audio) = crate::audio_track::AudioTrack::new()?;
         let (incoming, ingress) = crate::incoming::Incoming::new();
@@ -94,10 +103,7 @@ impl Transport {
             .build();
         let connection: Arc<dyn PeerConnection> = Arc::new(
             PeerConnectionBuilder::new()
-                .with_interceptor_registry(
-                    rtc::interceptor::Registry::new()
-                        .with(rtc::interceptor::Slot::JitterBuffer, ingress),
-                )
+                .with_interceptor_registry(Self::interceptor_registry(ingress))
                 .with_media_engine(media)
                 .with_runtime(runtime)
                 .with_setting_engine(settings)
diff --git a/codex-rs/voice-host/src/transport_tests.rs b/codex-rs/voice-host/src/transport_tests.rs
index 52e05bd..85b60b1 100644
--- a/codex-rs/voice-host/src/transport_tests.rs
+++ b/codex-rs/voice-host/src/transport_tests.rs
@@ -3,9 +3,77 @@ mod network;
 
 use super::*;
 use pretty_assertions::assert_eq;
+use rtc::interceptor::Interceptor;
+use rtc::interceptor::Packet;
+use rtc::interceptor::StreamInfo;
+use rtc::interceptor::TaggedPacket;
+use rtc::rtp::header::Header;
+use rtc::sansio::Protocol;
+use rtc::shared::marshal::Marshal;
+use std::time::Instant;
 use tokio::sync::mpsc;
 use webrtc::data_channel::RTCDataChannelState;
 
+/// Registry assembly delivers original arrivals once while optional jitter buffering is installed.
+#[test]
+fn ingress_precedes_optional_jitter_without_duplicate_rtp() {
+    let (mut incoming, ingress) = crate::incoming::Incoming::new();
+    incoming.set_suppressed(/*suppressed*/ false).unwrap();
+    let depth = Duration::from_millis(/*millis*/ 40);
+    let mut chain = Transport::interceptor_registry(ingress)
+        .with(
+            rtc::interceptor::Slot::JitterBuffer,
+            rtc::interceptor::JitterBufferBuilder::new()
+                .with_depth(depth)
+                .build(),
+        )
+        .build();
+    chain.bind_remote_stream(&StreamInfo {
+        ssrc: 7,
+        clock_rate: 48_000,
+        payload_type: 111,
+        mime_type: "audio/opus".to_owned(),
+        ..Default::default()
+    });
+    let arrival = Instant::now() - Duration::from_millis(/*millis*/ 20);
+    let packet = rtc::rtp::Packet {
+        header: Header {
+            version: 2,
+            payload_type: 111,
+            sequence_number: 321,
+            timestamp: 960,
+            ssrc: 7,
+            ..Default::default()
+        },
+        payload: vec![0xf8, 0xff, 0xfe].into(),
+    };
+    let expected = packet.marshal().unwrap();
+
+    chain
+        .handle_read(TaggedPacket {
+            now: arrival,
+            transport: Default::default(),
+            message: Packet::Rtp(packet).into(),
+        })
+        .unwrap();
+    let received = incoming
+        .take()
+        .unwrap()
+        .expect("ingress must receive RTP before jitter buffering");
+    assert_eq!(
+        (received.at, received.as_ref()),
+        (arrival, expected.as_ref())
+    );
+    assert!(incoming.take().unwrap().is_none());
+    assert!(chain.poll_read().is_none());
+
+    chain
+        .handle_timeout(arrival + depth + Duration::from_millis(/*millis*/ 1))
+        .unwrap();
+    assert!(chain.poll_read().is_none());
+    assert!(incoming.take().unwrap().is_none());
+}
+
 struct RemoteEvents(mpsc::Sender<Arc<dyn DataChannel>>, Arc<Notify>);
 
 impl PeerConnectionEventHandler for RemoteEvents {
