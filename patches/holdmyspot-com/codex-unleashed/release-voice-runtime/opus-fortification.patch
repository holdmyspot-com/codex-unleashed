+    @unittest.skipIf(os.name == "nt", "Exercises Unix toolchain fortification flags")
+    def test_opus_uses_declared_toolchain_fortification_once(self):
+        cases = [
+            ["-O2", "-D_FORTIFY_SOURCE=1"],
+            ["-O2", "-D_FORTIFY_SOURCE=2"],
+            ["-O2", "-D_FORTIFY_SOURCE"],
+            ["-O2", "-D_FORTIFY_SOURCE="],
+        ]
+        for index, flags in enumerate(cases):
+            with self.subTest(flags=flags):
+                options, build, receipt = self._capture_opus_request(
+                    flags, output_name=f"opus-fortify-{index}"
+                )
+                self.assertEqual(options.count("-DOPUS_FORTIFY_SOURCE=OFF"), 1)
+                self.assertEqual(build.flags["CFLAGS"], flags)
+                self.assertEqual(build.environment["CFLAGS"], shlex.join(flags))
+                self.assertEqual(receipt["flags"]["CFLAGS"], flags)
+
+    @unittest.skipIf(os.name == "nt", "Exercises Unix toolchain fortification flags")
+    def test_opus_retains_its_default_fortification_without_toolchain_definition(self):
+        cases = [
+            ([], [], None),
+            (["-O2"], [], None),
+            (["-O2", "-D_FORTIFY_SOURCE_OTHER=1"], [], None),
+            ([], ["-D_FORTIFY_SOURCE=2"], None),
+            ([], [], "-D_FORTIFY_SOURCE=2"),
+        ]
+        for index, (c_flags, cxx_flags, ambient_cflags) in enumerate(cases):
+            with self.subTest(
+                c_flags=c_flags, cxx_flags=cxx_flags, ambient_cflags=ambient_cflags
+            ):
+                options, build, receipt = self._capture_opus_request(
+                    c_flags,
+                    output_name=f"opus-default-{index}",
+                    cxx_flags=cxx_flags,
+                    ambient_cflags=ambient_cflags,
+                )
+                self.assertFalse(
+                    any(
+                        option.startswith("-DOPUS_FORTIFY_SOURCE=")
+                        for option in options
+                    )
+                )
+                self.assertEqual(build.flags["CFLAGS"], c_flags)
+                self.assertEqual(receipt["flags"]["CFLAGS"], c_flags)
+                if c_flags:
+                    self.assertEqual(build.environment["CFLAGS"], shlex.join(c_flags))
+                else:
+                    self.assertNotIn("CFLAGS", build.environment)
+                self.assertEqual(build.flags["CXXFLAGS"], cxx_flags)
+                self.assertEqual(receipt["flags"]["CXXFLAGS"], cxx_flags)
+                if cxx_flags:
+                    self.assertEqual(
+                        build.environment["CXXFLAGS"], shlex.join(cxx_flags)
+                    )
+                if ambient_cflags is not None:
+                    self.assertNotIn("CFLAGS", build.environment)
+
