From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Sat, 14 Nov 2026 23:28:21 +0000
Subject: [PATCH] bugfix: preserve caller-owned Opus fortification

Disable the Opus default macro only when explicit C compiler flags
already define it, preserving the caller-selected hardening level.

---
diff --git a/third_party/voice/build_native.py b/third_party/voice/build_native.py
index 58d4828..a470545 100644
--- a/third_party/voice/build_native.py
+++ b/third_party/voice/build_native.py
@@ -475,12 +475,21 @@ class NativeBuild:
             )
             if "/cygdrive/" in (self.output / "libffi-pkg-config.log").read_text():
                 raise ValueError("pkg-config did not relocate libffi to native paths")
+        has_declared_c_fortify_source = any(
+            flag == "-D_FORTIFY_SOURCE" or flag.startswith("-D_FORTIFY_SOURCE=")
+            for flag in self.flags["CFLAGS"]
+        )
         self.cmake(
             "opus",
             [
                 "-DOPUS_BUILD_SHARED_LIBRARY=ON",
                 "-DOPUS_BUILD_TESTING=OFF",
                 "-DOPUS_BUILD_PROGRAMS=OFF",
+                *(
+                    ["-DOPUS_FORTIFY_SOURCE=OFF"]
+                    if has_declared_c_fortify_source
+                    else []
+                ),
                 # Windows ARM64 guarantees NEON; upstream misses its ARM64 spelling.
                 *(
                     ["-DOPUS_PRESUME_NEON=ON"]
diff --git a/third_party/voice/test_build_native.py b/third_party/voice/test_build_native.py
index 9cd6703..62d6c2e 100644
--- a/third_party/voice/test_build_native.py
+++ b/third_party/voice/test_build_native.py
@@ -48,6 +48,36 @@ class NativeBuildTests(unittest.TestCase):
             "LIB": "fixture lib",
         }
 
+    def _capture_opus_request(
+        self, c_flags, *, output_name, cxx_flags=None, ambient_cflags=None
+    ):
+        self.args.output = self.root / output_name
+        self.args.c_flag = list(c_flags)
+        self.args.cxx_flag = list(cxx_flags or [])
+        if ambient_cflags is None:
+            self.environment.pop("CFLAGS", None)
+        else:
+            self.environment["CFLAGS"] = ambient_cflags
+
+        build = NativeBuild(self.args, self.environment)
+        with (
+            patch(
+                "build_native.prepare_sources",
+                side_effect=lambda *args: (build.output / "build").mkdir(),
+            ),
+            patch.object(build, "cmake") as cmake,
+            patch.object(build, "meson"),
+            patch.object(build, "run"),
+        ):
+            build.build()
+
+        opus_requests = [
+            call.args[1] for call in cmake.call_args_list if call.args[0] == "opus"
+        ]
+        self.assertEqual(len(opus_requests), 1)
+        receipt = json.loads((build.output / "built.json").read_text())
+        return opus_requests[0], build, receipt
+
