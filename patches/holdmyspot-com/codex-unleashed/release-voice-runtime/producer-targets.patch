+# Extracts the single executable path from a retained Bazel query output.
+# Arguments:
+# - Query standard-output log and the path file to write.
+# Side effects:
+# - Writes the path and one LF to the path file, without newline translation.
+# Exit status:
+# - 0 when the log holds exactly one nonempty line, with an optional CRLF ending from a Windows Bazel; otherwise 1 with a diagnostic on standard error.
+read_query_path() {
+  local stdout_log="$1"
+  local path_file="$2"
+  local line
+  local query_path=
+  local line_count=0
+
+  while IFS= read -r line || [[ -n "$line" ]]; do
+    line_count=$((line_count + 1))
+    if ((line_count == 1)); then
+      query_path="${line%$'\r'}"
+    fi
+  done < "$stdout_log"
+  if ((line_count != 1)) || [[ -z "$query_path" || "$query_path" == *$'\r'* ]]; then
+    printf 'query must return exactly one nonempty executable path line\n' >&2
+    return 1
+  fi
+  printf '%s\n' "$query_path" > "$path_file"
+}
+
+# Queries one built rust_test executable using the exact build configuration and preserves the provider result.
+query_native_executable() {
+  local upstream_root="$1"
+  local evidence_root="$2"
+  local runtime_suffix="$3"
+  local runner_os="$4"
+  local windows_tools_root="$5"
+  local system_root="$6"
+  local windows_architecture="$7"
+  local target_label="$8"
+  local output_name="$9"
+  local role="${10}"
+  local stdout_log="$evidence_root/$output_name.stdout.log"
+  local stderr_log="$evidence_root/$output_name.stderr.log"
+  local path_file="$evidence_root/$output_name.path"
+  local resolved_path
+  local -a wrapper_args=()
+  local -a bazel_args=()
+
+  configure_bazel_arguments cquery "$runner_os" "$windows_tools_root" "$system_root" "$windows_architecture"
+  bazel_args+=(
+    --output=starlark
+    "--starlark:expr=providers(target)['DefaultInfo'].files_to_run.executable.path"
+    --
+    "$target_label"
+  )
+  (
+    trap - EXIT
+    cd -- "$upstream_root"
+    run_logged "$role Bazel executable query" "$stdout_log" "$stderr_log" "$BAZEL_WRAPPER" "${wrapper_args[@]}" -- "${bazel_args[@]}"
+  )
+  read_query_path "$stdout_log" "$path_file" || fail "$role Bazel executable query returned an empty or multi-line path; see $stdout_log and $stderr_log"
+  IFS= read -r resolved_path < "$path_file"
+  # The line ends with a carriage return when a Windows tool wrote it.
+  resolved_path="${resolved_path%$'\r'}"
+  if [[ "$resolved_path" == /* ]]; then :; else
+    resolved_path="$upstream_root/$resolved_path"
+  fi
+  require_build_file "$resolved_path" "$role"
+  if [[ -x "$resolved_path" ]]; then :; else
+    fail "$role is not executable: $resolved_path"
+  fi
+  QUERY_EXECUTABLE="$resolved_path"
+}
