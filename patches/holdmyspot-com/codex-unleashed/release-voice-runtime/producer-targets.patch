@@ -0,0 +1,94 @@
+"""Exercise how Windows CRT staging rewrites the staged runtime manifest."""
+
+import hashlib
+import io
+import json
+from pathlib import Path
+import stat
+import tempfile
+import unittest
+from unittest.mock import MagicMock, patch
+import zipfile
+
+import windows_crt
+
+TARGET = "x86_64-pc-windows-msvc"
+MEMBER = "Contents/VC/Redist/vcruntime140.dll"
+DLL = b"fixture retail CRT"
+
+
+def windows_text_write(self, data, encoding=None, errors=None, newline=None):
+    """Writes as the Windows interpreter does: text mode translates "\\n" to "\\r\\n"."""
+    with open(self, "w", encoding=encoding, errors=errors, newline="\r\n") as stream:
+        return stream.write(data)
+
+
+class CrtStagingTests(unittest.TestCase):
+    def setUp(self):
+        temporary = tempfile.TemporaryDirectory(prefix="voice crt ")
+        self.addCleanup(temporary.cleanup)
+        base = Path(temporary.name)
+        archive = io.BytesIO()
+        with zipfile.ZipFile(archive, "w") as bundle:
+            bundle.writestr(MEMBER, DLL)
+        archive = archive.getvalue()
+        pins = base / "tool"
+        pins.mkdir()
+        (pins / "windows-crt.json").write_text(
+            json.dumps(
+                {
+                    TARGET: {
+                        "url": "https://example.invalid/crt.vsix",
+                        "sha256": hashlib.sha256(archive).hexdigest(),
+                        "member": MEMBER,
+                        "dllSha256": hashlib.sha256(DLL).hexdigest(),
+                    }
+                }
+            )
+        )
+        response = MagicMock()
+        response.__enter__.return_value.read.return_value = archive
+        self.root = base / "runtime"
+        (self.root / "bin").mkdir(parents=True)
+        self.helper = base / "helper.exe"
+        self.manifest = self.root / "runtime.json"
+        self.manifest.write_text(
+            json.dumps({"target": TARGET, "developmentOnly": True, "libraries": []})
+            + "\n"
+        )
+        # Bazel materializes its outputs read-only, and a copy keeps that mode.
+        self.manifest.chmod(stat.S_IRUSR | stat.S_IRGRP | stat.S_IROTH)
+        for name, replacement in (
+            ("__file__", str(pins / "windows_crt.py")),
+            ("urllib", MagicMock(request=MagicMock(urlopen=lambda *a, **k: response))),
+            ("subprocess", MagicMock(run=lambda *a, **k: MagicMock(stdout=b""))),
+        ):
+            patcher = patch.object(windows_crt, name, replacement)
+            patcher.start()
+            self.addCleanup(patcher.stop)
+
+    def test_rewrites_a_read_only_manifest(self):
+        windows_crt.stage(self.root, TARGET, self.helper)
+
+        libraries = json.loads(self.manifest.read_text())["libraries"]
+        self.assertEqual(
+            [
+                {
+                    "path": "bin/vcruntime140.dll",
+                    "sha256": hashlib.sha256(DLL).hexdigest(),
+                }
+            ],
+            libraries,
+        )
+
+    def test_writes_the_manifest_with_line_feeds_on_windows(self):
+        self.manifest.chmod(stat.S_IRUSR | stat.S_IWUSR)
+        with patch.object(Path, "write_text", windows_text_write):
+            windows_crt.stage(self.root, TARGET, self.helper)
+
+        self.assertNotIn(b"\r", self.manifest.read_bytes())
+        self.assertTrue(self.manifest.read_bytes().endswith(b"}\n"))
+
+
+if __name__ == "__main__":
+    unittest.main()
