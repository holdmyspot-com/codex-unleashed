From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Wed, 18 Nov 2026 12:21:44 -0500
Subject: [PATCH] build: include voice runtime in release packages

Stage verified voice resources in the primary release package.

---
diff --git a/.github/actions/build-codex-packages/action.yml b/.github/actions/build-codex-packages/action.yml
index 1976334..a6bb18f 100644
--- a/.github/actions/build-codex-packages/action.yml
+++ b/.github/actions/build-codex-packages/action.yml
@@ -13,6 +13,12 @@ inputs:
   build-system:
     description: Build package binaries with Cargo or Bazel.
     default: cargo
+  voice-release-dir:
+    description: Sealed voice runtime release directory for the primary package.
+  voice-build-commit:
+    description: Source commit used to build the voice runtime.
+  tooling-launcher:
+    description: Assembled tooling launcher used to stage voice runtime resources.
 
 # Resolve package sources relative to the action so it works in both repository layouts.
 runs:
@@ -79,10 +85,21 @@ runs:
         RUNNER_OS: ${{ runner.os }}
         BINARIES: ${{ env.NEEDED_BINARIES }}
         CODEX_PACKAGE_VERSION: ${{ inputs.package-version }}
+        VOICE_RELEASE_DIR: ${{ inputs.voice-release-dir }}
+        VOICE_BUILD_COMMIT: ${{ inputs.voice-build-commit }}
+        TOOLING_LAUNCHER: ${{ inputs.tooling-launcher }}
         PACKAGE_SOURCE_ROOT: ${{ steps.package_setup.outputs.source_root }}
       run: |
         set -euo pipefail
         archive_result="${RUNNER_TEMP}/codex-archive-operations-${TARGET}"
+        archive_arguments=()
+        if [[ -n "$VOICE_RELEASE_DIR" || -n "$VOICE_BUILD_COMMIT" || -n "$TOOLING_LAUNCHER" ]]; then
+          archive_arguments+=(
+            --voice-release-dir "$VOICE_RELEASE_DIR"
+            --voice-build-commit "$VOICE_BUILD_COMMIT"
+            --tooling-launcher "$TOOLING_LAUNCHER"
+          )
+        fi
         bash "${PACKAGE_SOURCE_ROOT}/.github/scripts/codex-package-operations.sh" \
           archive-packages \
           --target "$TARGET" \
@@ -93,7 +110,8 @@ runs:
           --workspace "$GITHUB_WORKSPACE" \
           --runner-temp "$RUNNER_TEMP" \
           --package-version "$CODEX_PACKAGE_VERSION" \
-          --result-dir "$archive_result"
+          --result-dir "$archive_result" \
+          "${archive_arguments[@]}"
         echo "CODEX_PACKAGE_ARCHIVE_RESULT=${archive_result}" >> "$GITHUB_ENV"
 
     - name: Smoke-test assembled packages
diff --git a/.github/scripts/codex-package-operations.sh b/.github/scripts/codex-package-operations.sh
