Date: Sun, 15 Nov 2026 17:34:04 -0500
Subject: [PATCH] test: gate shell snapshot imports to supported platforms

Match the test-only imports to the Linux and macOS snapshot failure test so Windows test compilation keeps warnings enabled.
---
 codex-rs/exec-server/src/local_process.rs | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/codex-rs/exec-server/src/local_process.rs b/codex-rs/exec-server/src/local_process.rs
index 61848f7..da31611 100644
--- a/codex-rs/exec-server/src/local_process.rs
+++ b/codex-rs/exec-server/src/local_process.rs
@@ -1244,7 +1244,9 @@ fn notification_sender(inner: &Inner) -> Option<RpcNotificationSender> {
 #[cfg(test)]
 mod tests {
     use super::*;
+    #[cfg(any(target_os = "linux", target_os = "macos"))]
     use crate::protocol::ShellInfo;
+    #[cfg(any(target_os = "linux", target_os = "macos"))]
     use crate::protocol::ShellSnapshotRequest;
     use codex_exec_server_protocol::JSONRPCMessage;
     use codex_exec_server_protocol::JSONRPCResponse;
