+#[tokio::test]
+async fn unleashed_collapsed_tool_activity_groups_reads_and_shell_commands() {
+    for enabled in [true, false] {
+        let (mut chat, mut rx, _operations) = make_chatwidget_manual(None).await;
+        chat.config
+            .features
+            .set_enabled(Feature::UnleashedCollapsedToolActivity, enabled)
+            .expect("set collapsed tool activity feature");
+        chat.on_task_started();
+        for (id, command) in [
+            ("read", "cat .gitattributes"),
+            ("branch", "git branch --show-current"),
+            ("log", "git log -3 --format='%h %s'"),
+        ] {
+            let item = begin_exec(&mut chat, id, command);
+            end_exec(&mut chat, item, "retained output\n", "", 0);
+        }
+        let last = begin_exec(&mut chat, "wait", "date +%T; sleep 60; date +%T");
+        let cell = chat.transcript.active_cell.as_ref().unwrap();
+        let command = cell.as_any().downcast_ref::<ExecCell>().unwrap();
+        assert_eq!(command.iter_calls().count(), if enabled { 4 } else { 1 });
+        if enabled {
+            let text = lines_to_single_string(&cell.display_lines(80));
+            assert!(
+                text.contains("Reading 1 file, running 3 shell commands"),
+                "{text}"
+            );
+            assert!(text.contains("date +%T; sleep 60; date +%T"), "{text}");
+            assert!(!text.contains("retained output"), "{text}");
+            assert!(drain_insert_history(&mut rx).is_empty());
+        }
+        end_exec(&mut chat, last, "first clock\nsecond clock\n", "", 0);
+        chat.on_task_complete(None, None, false);
+        if enabled {
+            let cells = drain_insert_history(&mut rx);
+            let text = cells
+                .iter()
+                .map(|lines| lines_to_single_string(lines))
+                .collect::<Vec<_>>()
+                .join("\n");
+            assert!(text.contains("Read 1 file, ran 3 shell commands"), "{text}");
+            assert!(!text.contains("date +%T"), "{text}");
+        }
+    }
+}
