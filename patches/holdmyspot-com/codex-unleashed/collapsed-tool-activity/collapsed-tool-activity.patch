+            .set_enabled(Feature::UnleashedCollapsedToolActivity, enabled)
+            .expect("configure collapsed tool activity");
+        chat.on_task_started();
+        let item = begin_unified_exec_startup(
+            &mut chat,
+            "unclassified",
+            "process",
+            "date +%T; sleep 60; date +%T",
+        );
+        if enabled {
+            let cell = chat
+                .transcript
+                .active_cell
+                .as_ref()
+                .expect("running shell activity");
+            let summary = lines_to_single_string(&cell.display_lines(80));
+            assert!(summary.contains("Running 1 shell command"), "{summary}");
+            assert!(
+                chat.active_cell_transcript_key()
+                    .unwrap()
+                    .animation_tick
+                    .is_some()
+            );
+            chat.on_exec_command_output_delta("unclassified", "clock output\n");
+            let summary = lines_to_single_string(
+                &chat
+                    .transcript
+                    .active_cell
+                    .as_ref()
+                    .unwrap()
+                    .display_lines(80),
+            );
+            assert!(summary.contains("1 line)"), "{summary}");
+        } else {
+            assert!(chat.transcript.active_cell.is_none());
+        }
+        end_exec(&mut chat, item, "clock output\n", "", 0);
+        chat.on_task_complete(None, None, false);
+        let cells = drain_insert_history_with(&mut events, |cell| {
+            if enabled {
+                assert!(cell.transcript_animation_tick().is_none());
+                assert!(
+                    lines_to_single_string(&cell.transcript_lines(80)).contains("clock output")
+                );
+            }
+            cell.display_lines(80)
+        });
+        if enabled {
+            assert_eq!(cells.len(), 1);
+            assert!(lines_to_single_string(&cells[0]).contains("Ran 1 shell command"));
