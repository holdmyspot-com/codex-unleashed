+            assert!(!compact.contains("output line"));
+        }
+        let detail = cells
+            .iter()
+            .flat_map(|cell| cell.transcript_lines(80))
+            .map(|line| line.to_string())
+            .collect::<Vec<_>>()
+            .join("\n");
+        assert_eq!(detail.matches("cargo check").count(), 3);
+        assert_eq!(detail.matches("output line 12").count(), 3);
+        assert!(
+            cells
+                .iter()
+                .all(|cell| cell.transcript_animation_tick().is_none())
+        );
+    }
+}
