+#[tokio::test]
+async fn unleashed_collapsed_tool_activity_turn_completion_closes_live_expansion() {
+    use codex_app_server_protocol::CommandExecutionSource;
+    use codex_app_server_protocol::CommandExecutionStatus;
+    use codex_app_server_protocol::ThreadItem;
+    let (mut app, mut events, _operations) = make_test_app_with_channels().await;
+    assert!(app.chat_widget.set_feature_enabled(
+        codex_features::Feature::UnleashedCollapsedToolActivity,
+        true
+    ));
+    app.transcript_cells.clear();
+    let turn = |status| codex_app_server_protocol::Turn {
+        id: "tool-turn".into(),
+        items_view: codex_app_server_protocol::TurnItemsView::Full,
+        items: Vec::new(),
+        status,
+        error: None,
+        started_at: None,
+        completed_at: None,
+        duration_ms: None,
+    };
+    app.chat_widget.handle_server_notification(
+        ServerNotification::TurnStarted(codex_app_server_protocol::TurnStartedNotification {
+            thread_id: String::new(),
+            turn: turn(codex_app_server_protocol::TurnStatus::InProgress),
+        }),
+        None,
+    );
+    let mut item = ThreadItem::CommandExecution {
+        id: "turn-command".into(),
+        plugin_id: None,
+        script_path: None,
+        model_context: None,
+        sandbox_type: None,
+        command: "printf retained-command".into(),
+        cwd: codex_utils_path_uri::LegacyAppPathString::from_string("/tmp"),
+        process_id: None,
+        source: CommandExecutionSource::Agent,
+        status: CommandExecutionStatus::InProgress,
+        command_actions: Vec::new(),
+        aggregated_output: None,
+        exit_code: None,
+        duration_ms: None,
+    };
+    app.chat_widget
+        .handle_command_execution_started_now(item.clone());
+    app.sync_owned_transcript(80);
+    let area = Rect::new(0, 0, 80, 20);
+    let mut buffer = Buffer::empty(area);
+    app.transcript_view
+        .render(area, &mut buffer, &app.transcript_cells);
+    let click = MouseEvent {
+        kind: Down(Left),
+        column: 60,
+        row: 0,
+        modifiers: KeyModifiers::NONE,
+    };
+    app.transcript_view
+        .handle_mouse(click, &app.transcript_cells);
+    app.sync_owned_transcript(80);
+    app.transcript_view
+        .render(area, &mut buffer, &app.transcript_cells);
+    assert_eq!(buffer[(60, 0)].bg, ratatui::style::Color::Gray);
+    if let ThreadItem::CommandExecution {
+        status,
+        aggregated_output,
+        exit_code,
+        duration_ms,
+        ..
+    } = &mut item
+    {
+        *status = CommandExecutionStatus::Completed;
+        *aggregated_output = Some("completion output\n".into());
+        *exit_code = Some(0);
+        *duration_ms = Some(1000);
+    }
+    app.chat_widget.handle_command_execution_completed_now(item);
+    app.chat_widget.handle_server_notification(
+        ServerNotification::TurnCompleted(codex_app_server_protocol::TurnCompletedNotification {
+            thread_id: String::new(),
+            turn: turn(codex_app_server_protocol::TurnStatus::Completed),
+        }),
+        None,
+    );
+    while let Ok(event) = events.try_recv() {
+        if let AppEvent::InsertHistoryCell(cell) = event
+            && cell.as_any().is::<crate::exec_cell::ExecCell>()
+        {
+            app.transcript_cells.push(Arc::from(cell));
+        }
+    }
+    app.sync_owned_transcript(80);
+    buffer = Buffer::empty(area);
+    app.transcript_view
+        .render(area, &mut buffer, &app.transcript_cells);
+    assert!(buffer_text(&buffer).contains("Ran 1 shell command"));
+    assert!(!buffer_text(&buffer).contains("completion output"));
+    assert_ne!(buffer[(60, 0)].bg, ratatui::style::Color::Gray);
+    app.transcript_view
+        .handle_mouse(click, &app.transcript_cells);
+    app.sync_owned_transcript(80);
+    app.transcript_view
+        .render(area, &mut buffer, &app.transcript_cells);
+    assert!(buffer_text(&buffer).contains("completion output"));
+}
