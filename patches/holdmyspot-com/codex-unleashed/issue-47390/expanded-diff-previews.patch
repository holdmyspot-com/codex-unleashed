         .join("\n")
 }
 
+#[tokio::test]
+async fn expanded_diff_previews_are_configurable_for_owned_transcript() -> Result<()> {
+    let mut app = crate::app::test_support::make_test_app().await;
+    assert!(
+        app.config
+            .features
+            .enabled(codex_features::Feature::UnleashedExpandedDiffPreviews)
+    );
+    assert!(!app.config.unleashed_expanded_diff_previews);
+    let patch = crate::history_cell::new_patch_event(
+        std::collections::HashMap::from([(
+            std::path::PathBuf::from("new.txt"),
+            crate::diff_model::FileChange::Add {
+                content: (0..40)
+                    .map(|line| format!("added line {line:02}"))
+                    .collect::<Vec<_>>()
+                    .join("\n"),
+            },
+        )]),
+        std::path::Path::new("."),
+    );
+    let failure = crate::history_cell::new_patch_apply_failure(
+        (0..40)
+            .map(|line| format!("diagnostic line {line:02}"))
+            .collect::<Vec<_>>()
+            .join("\n"),
+    );
+    app.transcript_cells = vec![Arc::new(patch), Arc::new(failure)];
+
+    let render = |app: &mut App| {
+        app.sync_owned_transcript(/*width*/ 80);
+        let area = Rect::new(
+            /*x*/ 0, /*y*/ 0, /*width*/ 80, /*height*/ 100,
+        );
+        let mut buffer = Buffer::empty(area);
+        app.transcript_view
+            .render(area, &mut buffer, &app.transcript_cells);
+        buffer_text(&buffer)
+    };
+
+    let compact = render(&mut app);
+    assert!(!compact.contains("added line 39"));
+    assert!(!compact.contains("diagnostic line 39"));
+
+    app.config
+        .features
+        .enable(codex_features::Feature::UnleashedExpandedDiffPreviews)?;
+    let enabled_without_project_setting = render(&mut app);
+    assert!(!enabled_without_project_setting.contains("added line 39"));
+    assert!(!enabled_without_project_setting.contains("diagnostic line 39"));
+
+    app.config.unleashed_expanded_diff_previews = true;
+    let expanded = render(&mut app);
+    assert!(expanded.contains("added line 39"));
+    assert!(!expanded.contains("diagnostic line 39"));
+
+    app.config
+        .features
+        .disable(codex_features::Feature::UnleashedExpandedDiffPreviews)?;
+    let disabled_with_project_setting = render(&mut app);
+    assert!(!disabled_with_project_setting.contains("added line 39"));
+    assert!(!disabled_with_project_setting.contains("diagnostic line 39"));
+    Ok(())
+}
