+#[tokio::test]
+async fn project_unleashed_expanded_diff_previews_is_silent_when_feature_disabled()
+-> std::io::Result<()> {
+    let tmp = tempdir()?;
+    let project_root = tmp.path().join("project");
+    let dot_codex = project_root.join(".codex");
+    tokio::fs::create_dir_all(&dot_codex).await?;
+    tokio::fs::write(
+        dot_codex.join(CONFIG_TOML_FILE),
+        r#"
+unleashed_expanded_diff_previews = true
+
+[features]
+unleashed_expanded_diff_previews = false
+"#,
+    )
+    .await?;
+
+    let codex_home = tmp.path().join("home");
+    tokio::fs::create_dir_all(&codex_home).await?;
+    make_config_for_test(
+        &codex_home,
+        &project_root,
+        TrustLevel::Trusted,
+        /*project_root_markers*/ None,
+    )
+    .await?;
+
+    let cwd = AbsolutePathBuf::from_absolute_path(&project_root)?;
+    let layers = load_config_layers_state(
+        LOCAL_FS.as_ref(),
+        &codex_home,
+        Some(cwd),
+        &[] as &[(String, TomlValue)],
+        LoaderOverrides::default(),
+        &codex_config::NoopThreadConfigLoader,
+    )
+    .await?;
+
+    assert_eq!(
+        layers
+            .effective_config()
+            .get("unleashed_expanded_diff_previews"),
+        Some(&TomlValue::Boolean(true))
+    );
+    assert_eq!(
+        layers
+            .effective_config()
+            .get("features")
+            .and_then(|features| features.get("unleashed_expanded_diff_previews")),
+        Some(&TomlValue::Boolean(false))
+    );
+    let no_warnings: &[String] = &[];
+    assert_eq!(layers.startup_warnings(), Some(no_warnings));
+
+    Ok(())
+}
