+#[tokio::test]
+async fn runtime_config_resolves_unleashed_expanded_diff_previews() {
+    for (source, expected) in [
+        ("", false),
+        ("unleashed_expanded_diff_previews = true", true),
+        ("unleashed_expanded_diff_previews = false", false),
+    ] {
+        let config_toml: ConfigToml = toml::from_str(source).expect("parse config");
+        let config = Config::load_from_base_config_with_overrides(
+            config_toml,
+            ConfigOverrides::default(),
+            tempdir().expect("tempdir").abs(),
+        )
+        .await
+        .expect("load config");
+
+        assert_eq!(
+            config.unleashed_expanded_diff_previews, expected,
+            "{source}"
+        );
+    }
+}
