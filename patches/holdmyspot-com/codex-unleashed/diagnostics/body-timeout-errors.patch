From 04952039a554ee486e0d5c0e385385a352e6a195 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Mon, 9 Nov 2026 13:33:54 -0500
Subject: [PATCH] Diagnostic: print the errors of the two body timeout tests

---
 .../src/transport/remote_control/server_api_tests.rs          | 3 ++-
 codex-rs/exec-server/src/remote.rs                            | 4 ++--
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/codex-rs/app-server-transport/src/transport/remote_control/server_api_tests.rs b/codex-rs/app-server-transport/src/transport/remote_control/server_api_tests.rs
index cc8d93d..2199ba8 100644
--- a/codex-rs/app-server-transport/src/transport/remote_control/server_api_tests.rs
+++ b/codex-rs/app-server-transport/src/transport/remote_control/server_api_tests.rs
@@ -28,7 +28,8 @@ fn assert_transient_timeout(err: &io::Error, expected_status: Option<StatusCode>
             request_error.status,
             request_error.is_transient(err.kind()),
         ),
-        (ErrorKind::TimedOut, expected_status, true)
+        (ErrorKind::TimedOut, expected_status, true),
+        "diagnostic error: {err:?}"
     );
 }
 
diff --git a/codex-rs/exec-server/src/remote.rs b/codex-rs/exec-server/src/remote.rs
index a43f5ac..e091b34 100644
--- a/codex-rs/exec-server/src/remote.rs
+++ b/codex-rs/exec-server/src/remote.rs
@@ -1695,9 +1695,9 @@ mod tests {
         };
 
         assert!(matches!(
-            error,
+            &error,
             ExecServerError::EnvironmentRegistryRequest(error) if error.is_timeout()
-        ));
+        ), "diagnostic error: {error:?}");
     }
 
     #[tokio::test]
-- 
2.43.0

