From 15b37f02433aab412b56c8cd458c5dc517a7b954 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Mon, 9 Nov 2026 15:24:13 -0500
Subject: [PATCH] Diagnostic: print the body timeout's error chain and the log
 metric points

---
 .../src/transport/remote_control/server_api.rs                | 2 +-
 codex-rs/app-server/tests/suite/logging.rs                    | 4 ++++
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/codex-rs/app-server-transport/src/transport/remote_control/server_api.rs b/codex-rs/app-server-transport/src/transport/remote_control/server_api.rs
index 204ebbd..992fa3b 100644
--- a/codex-rs/app-server-transport/src/transport/remote_control/server_api.rs
+++ b/codex-rs/app-server-transport/src/transport/remote_control/server_api.rs
@@ -257,7 +257,7 @@ where
             }
             let timed_out = err.is_timeout();
             RemoteControlServerRequestError::io_error(
-                format!("failed to {action} remote control server at `{url}`: {err}"),
+                format!("failed to {action} remote control server at `{url}`: {err} / {err:?}"),
                 /*status*/ None,
                 /*retry_at*/ None,
                 timed_out,
diff --git a/codex-rs/app-server/tests/suite/logging.rs b/codex-rs/app-server/tests/suite/logging.rs
index ce6590e..172e06f 100644
--- a/codex-rs/app-server/tests/suite/logging.rs
+++ b/codex-rs/app-server/tests/suite/logging.rs
@@ -510,6 +510,7 @@ async fn sqlite_log_metrics_exports_do_not_create_log_cycles() -> Result<()> {
                 .flat_map(|resource| resource["scopeMetrics"].as_array().into_iter().flatten())
                 .flat_map(|scope| scope["metrics"].as_array().into_iter().flatten())
                 .filter(|metric| metric["name"].as_str() == Some(name))
+                .inspect(|metric| eprintln!("diagnostic status={status} metric={name} temporality={}", metric[kind]["aggregationTemporality"]))
                 .flat_map(|metric| metric[kind]["dataPoints"].as_array().into_iter().flatten())
                 .collect::<Vec<_>>();
             assert!(
@@ -518,6 +519,7 @@ async fn sqlite_log_metrics_exports_do_not_create_log_cycles() -> Result<()> {
             );
 
             for point in points {
+                eprintln!("diagnostic status={status} metric={name} point={point}");
                 let attributes: BTreeMap<&str, &str> = point["attributes"]
                     .as_array()
                     .context("metric data points must include attributes")?
@@ -584,6 +586,8 @@ async fn sqlite_log_metrics_exports_do_not_create_log_cycles() -> Result<()> {
         )
         .await?;
         let persisted_logs = state.query_logs(&codex_state::LogQuery::default()).await?;
+        eprintln!("diagnostic status={status} requests={} rows={}", requests.len(), persisted_logs.len());
+        for row in &persisted_logs { eprintln!("diagnostic row {row:?}"); }
         assert_eq!(
             observed_metrics[codex_state::LOG_WRITE_ENTRIES_METRIC].1,
             persisted_logs.len() as f64,
-- 
2.43.0

