+            for path in ["/bin", "/sbin", "/lib", "/lib64"] {
+                if let Ok(metadata) = fs::symlink_metadata(path) {
+                    if metadata.file_type().is_symlink() {
+                        command
+                            .arg("--symlink")
+                            .arg(fs::read_link(path).unwrap())
+                            .arg(path);
+                    } else {
+                        command.args(["--ro-bind", path, path]);
+                    }
