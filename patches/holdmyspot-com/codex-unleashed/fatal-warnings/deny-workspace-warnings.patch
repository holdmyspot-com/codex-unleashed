From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Sun, 8 Nov 2026 18:35:59 -0500
Subject: [PATCH] Deny rustc lint warnings and linker messages in every
 workspace crate

The workspace lint table set no rustc levels, so a new warning in Codex
only scrolled past in the build log. Every crate inherits the table, so
denying warnings there makes each one fail its build. The linker_messages
lint is allowed by default and so not covered by warnings; deny it too, so
linker warnings fail the build instead of being hidden. Cargo still caps
dependency lints, so dependencies are not affected.

Bazel does not read Cargo's lint table, so .bazelrc passes -Dwarnings to
rustc for target and exec builds. It leaves linker messages allowed: the
hermetic LLVM toolchain's own link flags make clang++ warn that
--unwindlib=none is unused on every link.

The x86-64 musl release link passes --icf=safe to lld. lld warns for each
C object that zig cc built, because the object's .llvm_addrsig section is
not linked to a symbol table (sh_link=0), and the denied linker_messages
lint turned those warnings into a failed link of codex-bwrap. The musl
tools script now compiles C and C++ for that link with -fno-addrsig, so the
objects carry no such section and lld treats their symbols as
address-significant without a warning. Rust objects keep their tables.
---
 .bazelrc                                    |  6 ++++++
 .github/scripts/install-musl-build-tools.sh | 19 +++++++++++++++++--
 codex-rs/Cargo.toml                         |  5 +++++
 codex-rs/app-server/tests/suite/v2/sleep.rs |  3 ---
 4 files changed, 28 insertions(+), 5 deletions(-)

diff --git a/.bazelrc b/.bazelrc
index 1f804fcd9f..c6d9f2b61f 100644
--- a/.bazelrc
+++ b/.bazelrc
@@ -24,6 +24,12 @@ common --experimental_platform_in_output_dir
 build --features=-dynamic_link_msvcrt --features=static_link_msvcrt
 build --host_features=-dynamic_link_msvcrt --host_features=static_link_msvcrt
 
+# Match codex-rs/Cargo.toml [workspace.lints.rust]: rustc warnings fail the build. Linker messages
+# are not denied here: the hermetic LLVM toolchain's own link flags draw a clang++ warning
+# (--unwindlib=none unused) on every link, which is toolchain configuration, not Codex.
+build --@rules_rust//rust/settings:extra_rustc_flag=-Dwarnings
+build --@rules_rust//rust/settings:extra_exec_rustc_flag=-Dwarnings
+
 build --workspace_status_command=./scripts/workspace-status.sh
 build:windows --workspace_status_command=./scripts/workspace-status.cmd
 
diff --git a/.github/scripts/install-musl-build-tools.sh b/.github/scripts/install-musl-build-tools.sh
index da8d3e31a1..663dab3401 100644
--- a/.github/scripts/install-musl-build-tools.sh
+++ b/.github/scripts/install-musl-build-tools.sh
@@ -240,8 +240,23 @@ if [[ -n "${sysroot}" && "${sysroot}" != "/" ]]; then
   echo "${boring_sysroot_var}=${sysroot}" >> "$GITHUB_ENV"
 fi
 
+# Fold identical code and pack relocations for x86-64 musl release packages.
+musl_release_link=0
+if [[ "${TARGET}" == "x86_64-unknown-linux-musl" && "${CODEX_MUSL_RELEASE_LINK_FLAGS:-}" == "1" ]]; then
+  musl_release_link=1
+fi
+
 cflags="-pthread"
 cxxflags="-pthread"
+if [[ "${musl_release_link}" == "1" ]]; then
+  # lld reports the .llvm_addrsig section of an object that zig cc built as not linked to a symbol table
+  # (sh_link=0) and warns for it under --icf=safe; the workspace denies linker_messages, so each warning
+  # fails the link. Nothing in this build rewrites objects with objcopy or ld -r. Compile without the
+  # section instead: lld treats every symbol of an object that has none as address-significant, with no
+  # warning, which is how it already treats these objects.
+  cflags="${cflags} -fno-addrsig"
+  cxxflags="${cxxflags} -fno-addrsig"
+fi
 if [[ "${TARGET}" == "aarch64-unknown-linux-musl" ]]; then
   # BoringSSL enables -Wframe-larger-than=25344 under clang and treats warnings as errors.
   cflags="${cflags} -Wno-error=frame-larger-than"
@@ -261,8 +276,8 @@ target_cxx_var="CXX_${TARGET}"
 target_cxx_var="${target_cxx_var//-/_}"
 echo "${target_cxx_var}=${cxx}" >> "$GITHUB_ENV"
 
-# Fold identical code and pack relocations for x86-64 musl release packages.
-if [[ "${TARGET}" == "x86_64-unknown-linux-musl" && "${CODEX_MUSL_RELEASE_LINK_FLAGS:-}" == "1" ]]; then
+# Rust objects keep their address-significance tables, so --icf=safe still folds identical Rust code.
+if [[ "${musl_release_link}" == "1" ]]; then
   link_flags=(-Cllvm-args=--addrsig -Clink-arg=-fuse-ld=lld -Clink-arg=-Wl,--icf=safe,-z,pack-relative-relocs)
   echo "RUSTFLAGS=${RUSTFLAGS:+$RUSTFLAGS }${link_flags[*]}" >> "$GITHUB_ENV"
 fi
diff --git a/codex-rs/Cargo.toml b/codex-rs/Cargo.toml
index 01d075adec..baefbc2f5a 100644
--- a/codex-rs/Cargo.toml
+++ b/codex-rs/Cargo.toml
@@ -599,6 +599,11 @@ zeroize = "1.8.2"
 
 [workspace.lints.rust]
 unexpected_cfgs = { level = "warn", check-cfg = ['cfg(codex_bazel)'] }
+# Every workspace crate inherits these lints, so any rustc lint warning in Codex fails
+# its build. Dependencies keep Cargo's cap and are not affected.
+warnings = "deny"
+# Rust 1.95 allows linker output by default, which hides it; deny it like any warning.
+linker_messages = "deny"
 
 [workspace.lints.clippy]
 await_holding_invalid_type = "deny"
diff --git a/codex-rs/app-server/tests/suite/v2/sleep.rs b/codex-rs/app-server/tests/suite/v2/sleep.rs
index 66e5d7ea01..4fa5bae1cb 100644
--- a/codex-rs/app-server/tests/suite/v2/sleep.rs
+++ b/codex-rs/app-server/tests/suite/v2/sleep.rs
@@ -5,11 +5,8 @@ use codex_app_server_protocol::ClientRequest;
 use codex_app_server_protocol::ItemStartedNotification;
 use codex_app_server_protocol::ThreadItemPayload;
 use codex_app_server_protocol::ThreadStartParams;
-use codex_app_server_protocol::ThreadStartResponse;
-use codex_app_server_protocol::TurnCompletedNotification;
 use codex_app_server_protocol::TurnStartParams;
 use codex_app_server_protocol::TurnStartResponse;
-use codex_app_server_protocol::TurnStatus;
 use codex_app_server_protocol::UserInput as V2UserInput;
 use core_test_support::responses;
 use pretty_assertions::assert_eq;
-- 
