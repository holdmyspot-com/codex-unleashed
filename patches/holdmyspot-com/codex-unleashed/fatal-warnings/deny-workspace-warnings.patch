From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Sun, 8 Nov 2026 18:35:59 -0500
Subject: [PATCH 25/54] Deny rustc lint warnings and linker messages in every
 workspace crate

The workspace lint table set no rustc levels, so a new warning in Codex
only scrolled past in the build log. Every crate inherits the table, so
denying warnings there makes each one fail its build. The linker_messages
lint is allowed by default and so not covered by warnings; deny it too, so
linker warnings fail the build instead of being hidden. Cargo still caps
dependency lints, so dependencies are not affected.

Bazel does not read Cargo's lint table, so .bazelrc passes -Dwarnings to
rustc for target and exec builds. It leaves linker messages allowed: the
hermetic LLVM toolchain's own link flags make clang++ warn that
--unwindlib=none is unused on every link.
---
 .bazelrc            | 6 ++++++
 codex-rs/Cargo.toml | 8 ++++++--
 2 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/.bazelrc b/.bazelrc
index b62d2d0..b504262 100644
--- a/.bazelrc
+++ b/.bazelrc
@@ -19,6 +19,12 @@ common --experimental_platform_in_output_dir
 build --features=static_link_msvcrt
 build --host_features=static_link_msvcrt
 
+# Match codex-rs/Cargo.toml [workspace.lints.rust]: rustc warnings fail the build. Linker messages
+# are not denied here: the hermetic LLVM toolchain's own link flags draw a clang++ warning
+# (--unwindlib=none unused) on every link, which is toolchain configuration, not Codex.
+build --@rules_rust//rust/settings:extra_rustc_flag=-Dwarnings
+build --@rules_rust//rust/settings:extra_exec_rustc_flag=-Dwarnings
+
 build --workspace_status_command=./scripts/workspace-status.sh
 build:windows --workspace_status_command=./scripts/workspace-status.cmd
 
diff --git a/codex-rs/Cargo.toml b/codex-rs/Cargo.toml
index 0107584..f1b9ccf 100644
--- a/codex-rs/Cargo.toml
+++ b/codex-rs/Cargo.toml
@@ -587,8 +587,12 @@ zstd = "0.13"
 wiremock = "0.6"
 zeroize = "1.8.2"
 
-[workspace.lints]
-rust = {}
+[workspace.lints.rust]
+# Every workspace crate inherits these lints, so any rustc lint warning in Codex fails
+# its build. Dependencies keep Cargo's cap and are not affected.
+warnings = "deny"
+# Rust 1.95 allows linker output by default, which hides it; deny it like any warning.
+linker_messages = "deny"
 
 [workspace.lints.clippy]
 await_holding_invalid_type = "deny"
-- 
2.43.0

