@@ -0,0 +1,50 @@
+use codex_utils_cargo_bin::cargo_bin;
+use codex_utils_cargo_bin::find_resource;
+use std::process::Command;
+
+#[test]
+fn codex_unleashed_config_schema_matches_published_fixture() {
+    let temp = tempfile::tempdir().unwrap();
+    let output = temp.path().join("config.schema.json");
+    assert!(
+        Command::new(cargo_bin("codex-write-config-schema").unwrap())
+            .arg("--out")
+            .arg(&output)
+            .status()
+            .unwrap()
+            .success()
+    );
+    let generated_bytes = std::fs::read(output).unwrap();
+    #[cfg(windows)]
+    let generated_bytes = String::from_utf8(generated_bytes)
+        .unwrap()
+        .replace("\r\n", "\n")
+        .into_bytes();
+    let generated: serde_json::Value = serde_json::from_slice(&generated_bytes).unwrap();
+    let fixture = find_resource!("../core/config.schema.json")
+        .expect("resolve the published configuration schema");
+    let published_bytes = std::fs::read(fixture).unwrap();
+    #[cfg(windows)]
+    let published_bytes = String::from_utf8(published_bytes)
+        .unwrap()
+        .replace("\r\n", "\n")
+        .into_bytes();
+    let published: serde_json::Value = serde_json::from_slice(&published_bytes).unwrap();
+    for property in ["collapsed_tool_activity", "expanded_diff_previews"] {
+        assert_eq!(
+            generated.pointer(&format!(
+                "/definitions/CodexUnleashedToml/properties/{property}/type"
+            )),
+            Some(&serde_json::json!("boolean")),
+            "{property} must be a registered boolean setting"
+        );
+    }
+    assert!(
+        generated_bytes == published_bytes,
+        "published configuration schema must match the schema CLI output exactly"
+    );
+    assert!(
+        generated == published,
+        "published config schema must match generated schema"
+    );
+}
