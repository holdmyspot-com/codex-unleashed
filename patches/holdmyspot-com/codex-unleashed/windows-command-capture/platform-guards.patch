From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Sun, 15 Nov 2026 07:18:41 -0500
Subject: [PATCH] Keep Windows capture helpers out of Linux production builds

---
 codex-rs/windows-sandbox-rs/src/capture.rs | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/codex-rs/windows-sandbox-rs/src/capture.rs b/codex-rs/windows-sandbox-rs/src/capture.rs
index 2d32246daa..c605edf814 100644
--- a/codex-rs/windows-sandbox-rs/src/capture.rs
+++ b/codex-rs/windows-sandbox-rs/src/capture.rs
@@ -1,10 +1,13 @@
 use std::fmt;
 use std::io;
+#[cfg(any(target_os = "windows", test))]
 use std::time::Duration;
 
 use crate::CaptureResult;
 
+#[cfg(any(target_os = "windows", test))]
 const CAPTURE_BUFFER_SIZE: usize = 8192;
+#[cfg(any(target_os = "windows", test))]
 const CAPTURE_POLL_INTERVAL: Duration = Duration::from_millis(5);
 
 /// Drains a capture pipe while preserving the legacy completion snapshot rule.
@@ -54,6 +57,7 @@ pub(crate) fn drain_pipe(
     output
 }
 
+#[cfg(any(target_os = "windows", test))]
 pub(crate) fn drain_pipe_into(
     output: &mut Vec<u8>,
     mut is_finished: impl FnMut() -> bool,
@@ -218,11 +222,13 @@ impl fmt::Display for CaptureFailure {
 
 impl std::error::Error for CaptureFailure {}
 
+#[cfg(any(target_os = "windows", test))]
 pub(crate) struct CaptureReadError {
     pub operation: CaptureOperation,
     pub error: io::Error,
 }
 
+#[cfg(any(target_os = "windows", test))]
 pub(crate) fn collect_output(
     read_stdout: impl FnOnce(&mut Vec<u8>) -> Result<(), CaptureReadError> + Send,
     read_stderr: impl FnOnce(&mut Vec<u8>) -> Result<(), CaptureReadError> + Send,
@@ -255,6 +261,7 @@ pub(crate) fn collect_output(
     }
 }
 
+#[cfg(any(target_os = "windows", test))]
 fn collect_failure(
     failures: &mut Vec<CaptureStreamFailure>,
     stream: CaptureStream,
-- 
2.43.0

