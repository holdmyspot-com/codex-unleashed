+/// Returns the exit code to report for a command whose output capture failed: its own non-zero
+/// exit code, or [`EXEC_OUTPUT_TRUNCATED_EXIT_CODE`] when it exited with 0.
+fn capture_failure_exit_code(exit_code: i32) -> i32 {
+    if exit_code == 0 {
+        EXEC_OUTPUT_TRUNCATED_EXIT_CODE
+    } else {
+        exit_code
+    }
+}
+
+fn truncate_utf8_to_bytes(value: &mut String, max_bytes: usize) {
+    if value.len() <= max_bytes {
+        return;
+    }
+    let mut end = max_bytes;
+    while !value.is_char_boundary(end) {
+        end -= 1;
+    }
+    value.truncate(end);
+}
