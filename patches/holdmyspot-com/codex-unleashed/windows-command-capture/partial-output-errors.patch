+#[test]
+fn windows_capture_conversion_obeys_output_caps() {
+    let cap = ExecCapturePolicy::ShellTool
+        .retained_bytes_cap()
+        .expect("shell output is capped");
+    let policies = [
+        ExecCapturePolicy::ShellTool,
+        ExecCapturePolicy::FullBuffer,
+        ExecCapturePolicy::FullBufferWithExpiration,
+        ExecCapturePolicy::SensitiveFullBuffer,
+    ];
+    for policy in policies {
+        for is_failure in [false, true] {
+            let capture = codex_windows_sandbox::CaptureResult {
+                exit_code: 2,
+                stdout: vec![b'o'; cap * 2],
+                stderr: vec![b'e'; cap * 2],
+                timed_out: false,
+            };
+            let result = if is_failure {
+                Err(anyhow::Error::new(
+                    codex_windows_sandbox::CaptureFailure::new(
+                        capture,
+                        vec![codex_windows_sandbox::CaptureStreamFailure {
+                            stream: codex_windows_sandbox::CaptureStream::Stdout,
+                            operation: codex_windows_sandbox::CaptureOperation::Peek,
+                            error: None,
+                        }],
+                    ),
+                ))
+            } else {
+                Ok(capture)
+            };
+            let raw = windows_capture_output(result, policy).expect("capture conversion");
+            let expected = if policy == ExecCapturePolicy::ShellTool {
+                cap
+            } else {
+                cap * 2
+            };
+            assert_eq!(raw.stdout.text.len(), expected);
+            assert_eq!(raw.stderr.text.len(), expected);
+        }
+    }
+}
