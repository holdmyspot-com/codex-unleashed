+#[test]
+fn windows_capture_truncation_code_avoids_reserved_exit_codes() {
+    let reserved = [
+        0,
+        1,
+        SIGKILL_CODE,
+        TIMEOUT_CODE,
+        EXEC_TIMEOUT_EXIT_CODE,
+        EXIT_CODE_SIGNAL_BASE + SIGKILL_CODE,
+        255,
+    ];
+    assert!(!reserved.contains(&EXEC_OUTPUT_TRUNCATED_EXIT_CODE));
+    // Above the 128 + signal range of shells and below the byte-wrapped -1.
+    const {
+        assert!(EXEC_OUTPUT_TRUNCATED_EXIT_CODE > EXIT_CODE_SIGNAL_BASE + 64);
+        assert!(EXEC_OUTPUT_TRUNCATED_EXIT_CODE < 255);
+    }
+}
