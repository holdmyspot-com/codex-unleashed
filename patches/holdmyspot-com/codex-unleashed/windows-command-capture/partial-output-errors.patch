+fn windows_capture_zero_exit_is_output_bearing_failure() {
+    let raw_output = RawExecToolCallOutput {
+        exit_status: synthetic_exit_status(0),
+        stdout: StreamOutput {
+            text: b"stdout prefix".to_vec(),
+            truncated_after_lines: None,
