+#[cfg(any(test, target_os = "windows"))]
+fn windows_capture_output(
+    capture_result: anyhow::Result<codex_windows_sandbox::CaptureResult>,
+    capture_policy: ExecCapturePolicy,
+) -> anyhow::Result<RawExecToolCallOutput> {
+    let capture = match capture_result {
+        Ok(capture) => capture,
+        Err(error) => {
+            let failure = error.downcast::<codex_windows_sandbox::CaptureFailure>()?;
+            let diagnostic = failure.to_string();
+            let capture = failure.output;
+            let reported_exit_code = capture_failure_exit_code(capture.exit_code);
+            let diagnostic = if reported_exit_code == capture.exit_code {
+                diagnostic
+            } else {
+                format!("{diagnostic}; output truncated (reported exit code {reported_exit_code})")
+            };
+            let exit_status = synthetic_exit_status_for_code(reported_exit_code);
+            let mut stdout_text = capture.stdout;
+            let cap = capture_policy.retained_bytes_cap();
+            if let Some(max_bytes) = cap {
+                stdout_text.truncate(max_bytes);
+            }
+            let mut stderr_text = capture.stderr;
+            if let Some(max_bytes) = cap {
+                stderr_text.truncate(max_bytes);
+            }
+            let stdout = StreamOutput {
+                text: stdout_text,
+                truncated_after_lines: None,
+            };
+            let stderr = StreamOutput {
+                text: stderr_text,
+                truncated_after_lines: None,
+            };
+            let mut aggregate = format!("{diagnostic}\npartial output:\n").into_bytes();
+            aggregate.extend_from_slice(&stdout.text);
+            aggregate.extend_from_slice(&stderr.text);
+            if let Some(max_bytes) = cap {
+                aggregate.truncate(max_bytes);
+            }
+            return Ok(RawExecToolCallOutput {
+                exit_status,
+                stdout,
+                stderr,
+                aggregated_output: StreamOutput {
+                    text: aggregate,
+                    truncated_after_lines: None,
+                },
+                timed_out: capture.timed_out,
+                capture_failure: Some(diagnostic),
+            });
+        }
+    };
+    let exit_status = synthetic_exit_status_for_code(capture.exit_code);
