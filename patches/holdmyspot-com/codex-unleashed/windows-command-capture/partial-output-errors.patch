+#[test]
+fn windows_capture_conversion_preserves_success() {
+    let raw = windows_capture_output(
+        Ok(codex_windows_sandbox::CaptureResult {
+            exit_code: 7,
+            stdout: b"out".to_vec(),
+            stderr: b"err".to_vec(),
+            timed_out: true,
+        }),
+        ExecCapturePolicy::FullBuffer,
+    )
+    .expect("successful capture converts");
+    assert_eq!(raw.exit_status.code(), Some(7));
+    assert_eq!(raw.stdout.text, b"out");
+    assert_eq!(raw.stderr.text, b"err");
+    assert!(raw.timed_out);
+    assert!(raw.capture_failure.is_none());
+}
