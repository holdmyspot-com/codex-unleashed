+        stderr: StreamOutput {
+            text: b"stderr prefix".to_vec(),
+            truncated_after_lines: None,
+        },
+        aggregated_output: StreamOutput {
+            text: b"stdout prefixstderr prefix".to_vec(),
+            truncated_after_lines: None,
+        },
+        timed_out: false,
+        capture_failure: Some(
+            "stdout capture peek failed (Win32 error 5); child exit code 0".into(),
+        ),
+    };
+
+    let error = finalize_exec_result(
+        Ok(raw_output),
+        SandboxType::WindowsRestrictedToken,
+        Duration::from_millis(5),
+        ExecCapturePolicy::FullBuffer,
+    )
+    .expect_err("capture failure must not be treated as successful exit");
+
+    let CodexErrorDetails::Sandbox(SandboxErr::Capture { output, message }) = error.details()
+    else {
+        panic!("expected output-bearing capture error, got {error}");
+    };
+    assert_eq!(output.exit_code, EXEC_OUTPUT_TRUNCATED_EXIT_CODE);
+    assert_eq!(output.stdout.text, "stdout prefix");
+    assert_eq!(output.stderr.text, "stderr prefix");
+    assert!(message.contains("child exit code 0"));
+    assert!(output.aggregated_output.text.contains("stdout prefix"));
+    assert!(output.aggregated_output.text.contains("stderr prefix"));
