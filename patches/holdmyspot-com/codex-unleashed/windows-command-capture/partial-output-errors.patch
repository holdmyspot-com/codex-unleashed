+#[test]
+fn windows_capture_conversion_recovers_partial_output() {
+    let output = codex_windows_sandbox::CaptureResult {
+        exit_code: 0,
+        stdout: b"prefix".to_vec(),
+        stderr: b"diagnostic".to_vec(),
+        timed_out: false,
+    };
+    let failure = codex_windows_sandbox::CaptureFailure::new(
+        output,
+        vec![codex_windows_sandbox::CaptureStreamFailure {
+            stream: codex_windows_sandbox::CaptureStream::Stderr,
+            operation: codex_windows_sandbox::CaptureOperation::Read,
+            error: Some(std::io::Error::from_raw_os_error(6)),
+        }],
+    );
+    let raw = windows_capture_output(
+        Err(anyhow::Error::new(failure)),
+        ExecCapturePolicy::FullBuffer,
+    )
+    .expect("typed capture failure returns partial output");
+    assert_eq!(
+        raw.exit_status.code(),
+        Some(EXEC_OUTPUT_TRUNCATED_EXIT_CODE)
+    );
+    assert_eq!(raw.stdout.text, b"prefix");
+    assert_eq!(raw.stderr.text, b"diagnostic");
+    let diagnostic = raw.capture_failure.unwrap();
+    assert!(diagnostic.contains("Win32 error 6"));
+    assert!(diagnostic.contains("child exit code 0"));
+    assert!(diagnostic.contains("output truncated"));
+    assert!(
+        raw.aggregated_output
+            .text
+            .starts_with(b"stderr capture read failed")
+    );
+}
