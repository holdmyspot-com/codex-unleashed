+    pub(crate) async fn suppress_interrupted_wakeups(&self) -> bool {
+        let mut mails = self.mailbox_pending_mails.lock().await;
+        for mail in mails.iter_mut() {
+            if mail.communication.wake_policy
+                == codex_protocol::MailboxWakePolicy::UnlessInterrupted
+            {
+                mail.communication.clear_trigger_turn();
+            }
+        }
+        mails.iter().any(|mail| mail.communication.trigger_turn)
+    }
