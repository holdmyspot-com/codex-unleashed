+
+    async fn cleanup_pending_input(
+        &self,
+        turn_state: &Mutex<TurnState>,
+        disposition: PendingInputDisposition,
+    ) {
+        let (results, start_options) = {
+            let mut turn_state = turn_state.lock().await;
+            if matches!(disposition, PendingInputDisposition::Discard) {
+                turn_state.clear_pending_waiters();
+            }
+            let pending = std::mem::take(&mut turn_state.pending_input.items);
+            let mut results = Vec::new();
+            for input in pending {
+                match input {
+                    TurnInput::InterAgentCommunication(mut communication)
+                        if matches!(disposition, PendingInputDisposition::Preserve)
+                            || communication.wake_policy
+                                == codex_protocol::MailboxWakePolicy::UnlessInterrupted =>
+                    {
+                        if communication.wake_policy
+                            == codex_protocol::MailboxWakePolicy::UnlessInterrupted
+                        {
+                            communication.trigger_turn = false;
+                        }
+                        results.push(communication);
+                    }
+                    input if matches!(disposition, PendingInputDisposition::Preserve) => {
+                        turn_state.pending_input.items.push(input);
+                    }
+                    _ => {}
+                }
+            }
+            let start_options = if matches!(disposition, PendingInputDisposition::Preserve) {
+                turn_state
+                    .reserved_mailbox_start_options
+                    .clone()
+                    .unwrap_or_default()
+            } else {
+                TurnStartOptions::default()
+            };
+            (results, start_options)
+        };
+        for communication in results {
+            self.enqueue_mailbox_communication(communication, start_options.clone())
+                .await;
+        }
