-    /// Clear any pending waiters and input buffered for the current turn.
+    /// Clear turn-local input, retaining unobserved background results for an explicit turn.
     pub(crate) async fn clear_pending(&self, active_turn: &ActiveTurn) {
-        let mut turn_state = active_turn.turn_state.lock().await;
-        turn_state.clear_pending_waiters();
+        self.cleanup_pending_input(
+            active_turn.turn_state.as_ref(),
+            PendingInputDisposition::Discard,
+        )
+        .await;
+    }
+
+    /// Returns unconsumed mail from an abandoned task start to the session queue.
+    /// Unrelated turn-local input remains with its original turn-state owner.
+    pub(crate) async fn recover_unstarted_input(&self, turn_state: &Mutex<TurnState>) {
+        self.cleanup_pending_input(turn_state, PendingInputDisposition::Preserve)
+            .await;
+    }
+
+    async fn cleanup_pending_input(
+        &self,
+        turn_state: &Mutex<TurnState>,
+        disposition: PendingInputDisposition,
+    ) {
         // Pending mail can own extension attachments whose destructors need the lock released.
-        let pending_input = std::mem::take(&mut turn_state.pending_input);
-        drop(turn_state);
-        drop(pending_input);
+        let (results, start_options, _discarded) = {
+            let mut turn_state = turn_state.lock().await;
+            if matches!(disposition, PendingInputDisposition::Discard) {
+                turn_state.clear_pending_waiters();
+            }
+            let pending = std::mem::take(&mut turn_state.pending_input);
+            if matches!(disposition, PendingInputDisposition::Preserve) {
+                turn_state.pending_input.has_pending_injection = pending.has_pending_injection;
+            }
+            let mut results = Vec::new();
+            let mut discarded = Vec::new();
+            for input in pending.items {
+                match input {
+                    TurnInput::InterAgentCommunication(mut communication)
+                        if matches!(disposition, PendingInputDisposition::Preserve)
+                            || communication.wake_policy
+                                == codex_protocol::MailboxWakePolicy::UnlessInterrupted =>
+                    {
+                        if communication.wake_policy
+                            == codex_protocol::MailboxWakePolicy::UnlessInterrupted
+                        {
+                            communication.clear_trigger_turn();
+                        }
+                        results.push(communication);
+                    }
+                    input if matches!(disposition, PendingInputDisposition::Preserve) => {
+                        turn_state.pending_input.items.push(input);
+                    }
+                    input => discarded.push(input),
+                }
+            }
+            let start_options = if matches!(disposition, PendingInputDisposition::Preserve) {
+                turn_state
+                    .reserved_mailbox_start_options
+                    .clone()
+                    .unwrap_or_default()
+            } else {
+                TurnStartOptions::default()
+            };
+            (results, start_options, discarded)
+        };
+        for communication in results {
+            self.enqueue_mailbox_communication(communication, start_options.clone())
+                .await;
+        }
     }
 
