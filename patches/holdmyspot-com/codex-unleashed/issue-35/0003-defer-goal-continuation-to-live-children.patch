diff --git a/codex-rs/core/src/codex_thread.rs b/codex-rs/core/src/codex_thread.rs
index 316af05..e29db2e 100644
--- a/codex-rs/core/src/codex_thread.rs
+++ b/codex-rs/core/src/codex_thread.rs
@@ -961,6 +961,40 @@ impl CodexThread {
         self.session.multi_agent_version()
     }
 
+    /// Reports whether a direct V2 child is running or starting with automatic
+    /// completion delivery enabled. Idle goal continuation can defer to that
+    /// child's result without blocking user input or loading historical children.
+    pub async fn has_running_background_subagents(&self) -> CodexResult<bool> {
+        if self.multi_agent_version() != Some(MultiAgentVersion::V2)
+            || !self
+                .session
+                .get_config()
+                .await
+                .features
+                .enabled(Feature::UnleashedBackgroundSubagents)
+        {
+            return Ok(false);
+        }
+
+        let control = &self.session.services.agent_control;
+        let children = control.child_agent_paths(self.session.thread_id).await;
+        if children.is_empty() {
+            return Ok(false);
+        }
+        let agents = control
+            .list(self.session.thread_id, None, &self.session_source, None)
+            .await?;
+        Ok(agents.into_iter().any(|agent| {
+            matches!(
+                agent.status,
+                AgentStatus::PendingInit | AgentStatus::Running
+            ) && agent
+                .metadata
+                .agent_path
+                .is_some_and(|path| children.contains(&path))
+        }))
+    }
+
     /// Shares an immutable view of the live parent model context and retained host facts.
     pub async fn conversation_history_snapshot(&self) -> Arc<dyn ConversationHistorySnapshot> {
         self.session.conversation_history_snapshot().await
