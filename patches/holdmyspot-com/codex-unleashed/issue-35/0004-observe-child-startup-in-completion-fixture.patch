From e1572abad636dd6d31a721a399b30d0c5caf8230 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Wed, 7 Oct 2026 23:24:38 -0400
Subject: [PATCH] Observe child startup before asserting background execution

Base: rust-v0.160.0 with the issue-35 series. Red: macOS Bazel run 37704873399 reports PendingInit at the simultaneous-completion fixture running-state assertion. Spawn registration precedes the child TurnStarted event. Both fixtures observe that event before asserting Running; delivery, identity and turn-serialization assertions remain unchanged. Focused emitted-patch verification is retained by the CI repair task.
---
 codex-rs/core/tests/suite/background_subagent_tests.rs | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/codex-rs/core/tests/suite/background_subagent_tests.rs b/codex-rs/core/tests/suite/background_subagent_tests.rs
index 9c894f7..7ba3593 100644
--- a/codex-rs/core/tests/suite/background_subagent_tests.rs
+++ b/codex-rs/core/tests/suite/background_subagent_tests.rs
@@ -380,6 +380,7 @@ async fn background_subagent_completion_coordinates_parent_turns(
     test.submit_turn("delegate background work").await?;
     let child_id = ThreadId::from_string(&wait_for_spawned_thread_id(&test).await?)?;
     let child = test.thread_manager.get_thread(child_id).await?;
+    wait_for_event(&child, |event| matches!(event, EventMsg::TurnStarted(_))).await;
     assert_eq!(child.agent_status().await, AgentStatus::Running,);
     assert_eq!(
         test.codex.has_running_background_subagents().await?,
@@ -634,6 +635,7 @@ async fn background_subagent_simultaneous_results_serialize_parent_turns() -> Re
     for id in test.thread_manager.list_thread_ids().await {
         if id != test.session_configured.thread_id {
             let child = test.thread_manager.get_thread(id).await?;
+            wait_for_event(&child, |event| matches!(event, EventMsg::TurnStarted(_))).await;
             assert_eq!(child.agent_status().await, AgentStatus::Running);
             running_children += 1;
         }
