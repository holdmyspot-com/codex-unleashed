 codex-rs/voice-host/tests/common/mod.rs       | 31 +++++++++++++++++++
 codex-rs/voice-host/tests/installed_client.rs | 13 ++++++--
 codex-rs/voice-host/tests/lifecycle.rs        |  9 +++---
 codex-rs/voice-host/tests/packaged_runtime.rs |  6 ++--
 defs.bzl                                      | 13 ++++++++
 6 files changed, 67 insertions(+), 9 deletions(-)
 create mode 100644 codex-rs/voice-host/tests/common/mod.rs

