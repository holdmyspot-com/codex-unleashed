     Ok(())
 }
 
+#[tokio::test]
+async fn open_agent_picker_search_filters_case_insensitive_and_preserves_refresh_state()
+-> Result<()> {
+    let (mut app, mut app_event_rx, _op_rx) = Box::pin(make_test_app_with_channels()).await;
+    let mut app_server = Box::pin(crate::start_embedded_app_server_for_picker(
+        app.chat_widget.config_ref(),
+    ))
+    .await
+    .expect("embedded app server");
+    let main_thread_id = ThreadId::from_u128(/*value*/ 1);
+    let reviewer_thread_id = ThreadId::from_u128(/*value*/ 2);
+    let review_helper_thread_id = ThreadId::from_u128(/*value*/ 3);
+    let worker_thread_id = ThreadId::from_u128(/*value*/ 4);
+    app.enqueue_primary_thread_session(
+        test_thread_session(main_thread_id, test_path_buf("/tmp/project")),
+        Vec::new(),
+    )
+    .await?;
+    for (thread_id, agent_path) in [
+        (reviewer_thread_id, "/root/reviewer"),
+        (review_helper_thread_id, "/root/review-helper"),
+        (worker_thread_id, "/root/worker"),
+    ] {
+        app.agent_navigation
+            .record_sub_agent_activity(SubAgentActivityDisplay {
+                thread_id,
+                agent_path: agent_path.to_string(),
+                is_running_hint: false,
+            });
+    }
+
+    Box::pin(app.open_agent_picker(&mut app_server)).await;
+    let initially_unfiltered = render_bottom_popup(&app.chat_widget, /*width*/ 80);
+    assert!(initially_unfiltered.contains("/root/reviewer"));
+    assert!(initially_unfiltered.contains("/root/review-helper"));
+    assert!(initially_unfiltered.contains("/root/worker"));
+
+    for character in "VIEW".chars() {
+        app.chat_widget
+            .handle_key_event(KeyEvent::new(KeyCode::Char(character), KeyModifiers::NONE));
+    }
+
+    let filtered = render_bottom_popup(&app.chat_widget, /*width*/ 80);
+    assert!(filtered.contains("VIEW"));
+    assert!(filtered.contains("/root/reviewer"));
+    assert!(filtered.contains("/root/review-helper"));
+    assert!(!filtered.contains("/root/worker"));
+
+    for character in "xyz".chars() {
+        app.chat_widget
+            .handle_key_event(KeyEvent::new(KeyCode::Char(character), KeyModifiers::NONE));
+    }
+    let no_matches = render_bottom_popup(&app.chat_widget, /*width*/ 80);
+    assert!(no_matches.contains("no matches"));
+    assert!(!no_matches.contains("/root/reviewer"));
+
+    for _ in 0..7 {
+        app.chat_widget
+            .handle_key_event(KeyEvent::new(KeyCode::Backspace, KeyModifiers::NONE));
+    }
+    let cleared = render_bottom_popup(&app.chat_widget, /*width*/ 80);
+    assert!(!cleared.contains("no matches"));
+    assert!(cleared.contains("/root/reviewer"));
+    assert!(cleared.contains("/root/worker"));
+
+    for character in "VIEW".chars() {
+        app.chat_widget
+            .handle_key_event(KeyEvent::new(KeyCode::Char(character), KeyModifiers::NONE));
+    }
+    app.chat_widget
+        .handle_key_event(KeyEvent::new(KeyCode::Down, KeyModifiers::NONE));
+    app.chat_widget.show_selection_view(SelectionViewParams {
+        title: Some("Agent details".to_string()),
+        items: vec![SelectionItem {
+            name: "Temporary child".to_string(),
+            ..Default::default()
+        }],
+        ..SelectionViewParams::picker()
+    });
+    let newly_discovered_thread_id = ThreadId::from_u128(/*value*/ 5);
+    app.agent_navigation
+        .record_sub_agent_activity(SubAgentActivityDisplay {
+            thread_id: newly_discovered_thread_id,
+            agent_path: "/root/review-added".to_string(),
+            is_running_hint: false,
+        });
+    app.refresh_agent_picker();
+    assert!(render_bottom_popup(&app.chat_widget, /*width*/ 80).contains("Temporary child"));
+    app.chat_widget
+        .handle_key_event(KeyEvent::new(KeyCode::Esc, KeyModifiers::NONE));
+    let refreshed = render_bottom_popup(&app.chat_widget, /*width*/ 80);
+    assert!(refreshed.contains("VIEW"));
+    assert!(refreshed.contains("/root/reviewer"));
+    assert!(refreshed.contains("/root/review-helper"));
+    assert!(refreshed.contains("/root/review-added"));
+    assert!(!refreshed.contains("/root/worker"));
+
+    while app_event_rx.try_recv().is_ok() {}
+    app.chat_widget
+        .handle_key_event(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE));
+    assert_matches!(
+        app_event_rx.try_recv(),
+        Ok(AppEvent::SelectAgentThread(selected_thread_id))
+            if selected_thread_id == review_helper_thread_id
+    );
+    app_server.shutdown().await?;
+    Ok(())
+}
+
