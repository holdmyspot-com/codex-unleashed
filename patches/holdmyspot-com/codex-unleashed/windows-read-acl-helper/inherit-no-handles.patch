+struct ProcessGuard(OwnedHandle);
+
+impl ProcessGuard {
+    /// Returns the exit code once the process exits within `timeout`, or `None` if it still runs.
+    fn wait(&self, timeout: Duration) -> io::Result<Option<u32>> {
+        let handle = self.0.as_raw_handle() as HANDLE;
+        let millis = u32::try_from(timeout.as_millis()).unwrap_or(u32::MAX);
+        match unsafe { WaitForSingleObject(handle, millis) } {
+            WAIT_OBJECT_0 => {
+                let mut exit_code = 0;
+                if unsafe { GetExitCodeProcess(handle, &mut exit_code) } == 0 {
+                    return Err(io::Error::last_os_error());
+                }
+                Ok(Some(exit_code))
+            }
+            WAIT_TIMEOUT => Ok(None),
+            _ => Err(io::Error::last_os_error()),
+        }
+    }
+}
+
+impl Drop for ProcessGuard {
+    fn drop(&mut self) {
+        let handle = self.0.as_raw_handle() as HANDLE;
+        unsafe {
+            TerminateProcess(handle, /*exit_code*/ 1);
+            WaitForSingleObject(handle, /*milliseconds*/ 10_000);
+        }
+    }
+}
