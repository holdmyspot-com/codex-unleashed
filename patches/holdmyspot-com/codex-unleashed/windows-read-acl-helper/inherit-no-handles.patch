+/// Starts `command` without a console window as a process that inherits no handle except a
+/// `NUL` device for its standard input, output and error, and returns the process handle.
+///
+/// `std::process::Command` lets a child inherit every inheritable handle of this process,
+/// including pipe ends that this process itself inherited. A helper that outlives its launcher
+/// would keep such a pipe open, so a reader waiting for its end-of-file waits until the helper
+/// exits. The program, arguments, environment changes and working directory of `command` apply;
+/// its standard I/O and creation flags do not. The program must be a path: it is not searched for
+/// on `PATH`.
+///
+/// Returns an error of kind [`io::ErrorKind::InvalidInput`] if the program or an argument is not
+/// valid Unicode, or the operating system error if the process cannot be created.
+pub(super) fn spawn_without_inherited_handles(command: &Command) -> io::Result<OwnedHandle> {
+    let mut argv = vec![unicode_argument(command.get_program())?];
+    for argument in command.get_args() {
+        argv.push(unicode_argument(argument)?);
+    }
+    let mut command_line = to_wide(argv_to_command_line(&argv));
+    let program = to_wide(command.get_program());
+    let environment = environment_block(command);
+    let current_dir = command.get_current_dir().map(to_wide);
+
+    let null_device = std::fs::OpenOptions::new()
+        .read(true)
+        .write(true)
+        .open("NUL")?;
+    let null_handle = null_device.as_raw_handle() as HANDLE;
+    // The handle list admits only inheritable handles; it is the child's sole inherited handle.
+    if unsafe { SetHandleInformation(null_handle, HANDLE_FLAG_INHERIT, HANDLE_FLAG_INHERIT) } == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let mut attributes = ProcThreadAttributeList::new(/*attr_count*/ 1)?;
+    attributes.set_handle_list(vec![null_handle])?;
+    let mut startup_info: STARTUPINFOEXW = unsafe { std::mem::zeroed() };
+    startup_info.StartupInfo.cb = std::mem::size_of::<STARTUPINFOEXW>() as u32;
+    startup_info.StartupInfo.dwFlags = STARTF_USESTDHANDLES;
+    startup_info.StartupInfo.hStdInput = null_handle;
+    startup_info.StartupInfo.hStdOutput = null_handle;
+    startup_info.StartupInfo.hStdError = null_handle;
+    startup_info.lpAttributeList = attributes.as_mut_ptr();
+
+    let mut process_info: PROCESS_INFORMATION = unsafe { std::mem::zeroed() };
+    let created = unsafe {
+        CreateProcessW(
+            program.as_ptr(),
+            command_line.as_mut_ptr(),
+            std::ptr::null(),
+            std::ptr::null(),
+            /*binherithandles*/ 1,
+            CREATE_NO_WINDOW | CREATE_UNICODE_ENVIRONMENT | EXTENDED_STARTUPINFO_PRESENT,
+            environment.as_ptr().cast(),
+            current_dir.as_ref().map_or(std::ptr::null(), Vec::as_ptr),
+            &startup_info.StartupInfo,
+            &mut process_info,
+        )
+    };
+    if created == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    unsafe {
+        CloseHandle(process_info.hThread);
+    }
+    // SAFETY: CreateProcessW returned a process handle that nothing else owns.
+    Ok(unsafe { OwnedHandle::from_raw_handle(process_info.hProcess.cast()) })
+}
+
+fn unicode_argument(argument: &OsStr) -> io::Result<String> {
+    argument.to_str().map(str::to_owned).ok_or_else(|| {
+        io::Error::new(
+            io::ErrorKind::InvalidInput,
+            format!("process argument is not valid Unicode: {argument:?}"),
+        )
+    })
+}
+
+/// Builds the environment that `std::process::Command` would pass: this process's variables with
+/// the command's changes applied, sorted by name without regard to case as Windows requires.
+fn environment_block(command: &Command) -> Vec<u16> {
+    let mut variables: Vec<(OsString, OsString)> = std::env::vars_os().collect();
+    for (key, value) in command.get_envs() {
+        let folded_key = fold_case(key);
+        variables.retain(|(existing, _)| fold_case(existing) != folded_key);
+        if let Some(value) = value {
+            variables.push((key.to_owned(), value.to_owned()));
+        }
+    }
+    variables.sort_by_cached_key(|(key, _)| fold_case(key));
+
+    let mut block = Vec::new();
+    for (key, value) in &variables {
+        block.extend(key.encode_wide());
+        block.push(u16::from(b'='));
+        block.extend(value.encode_wide());
+        block.push(0);
+    }
+    if variables.is_empty() {
+        block.push(0);
+    }
+    block.push(0);
+    block
+}
+
+fn fold_case(key: &OsStr) -> String {
+    key.to_string_lossy().to_uppercase()
+}
