-#[ignore = "child process for child_retains_directory_pin_until_exit"]
+fn isolated_child_does_not_keep_inheritable_pipe_open() -> io::Result<()> {
+    let temporary = tempfile::tempdir()?;
+    // Stands in for a pipe end that the launcher inherited from its own parent.
+    let (mut reader, writer) = io::pipe()?;
+    let writer_handle = writer.as_raw_handle() as HANDLE;
+    if unsafe { SetHandleInformation(writer_handle, HANDLE_FLAG_INHERIT, HANDLE_FLAG_INHERIT) } == 0
+    {
+        return Err(io::Error::last_os_error());
+    }
+    let mut command = Command::new(std::env::current_exe()?);
+    command
+        .args(["--exact", CHILD_TEST, "--ignored"])
+        .env(CHILD_DIRECTORY_ENV, temporary.path());
+    let child = ProcessGuard(spawn_without_inherited_handles(&command)?);
+    drop(writer);
+
+    let started = Instant::now();
+    while !temporary.path().join("ready").exists() {
+        assert_eq!(
+            child.wait(Duration::ZERO)?,
+            None,
+            "child exited before becoming ready"
+        );
+        assert!(
+            started.elapsed() < CHILD_TIMEOUT,
+            "child did not become ready"
+        );
+        std::thread::sleep(POLL_INTERVAL);
+    }
+    let (sender, receiver) = mpsc::channel();
+    std::thread::spawn(move || {
+        let mut output = Vec::new();
+        let _ = sender.send(reader.read_to_end(&mut output));
+    });
+    let bytes_read = receiver
+        .recv_timeout(CHILD_TIMEOUT)
+        .expect("a running child must not keep the parent's inheritable pipe open")?;
+    assert_eq!(bytes_read, 0);
+    assert_eq!(
+        child.wait(Duration::ZERO)?,
+        None,
+        "end-of-file must arrive while the child still runs"
+    );
+
+    fs::write(temporary.path().join("release"), b"")?;
+    assert_eq!(
+        child.wait(CHILD_TIMEOUT)?,
+        Some(0),
+        "child did not exit cleanly"
+    );
+    Ok(())
+}
