+pub(crate) const INHERIT_PID_NAMESPACE_ENV: &str = "CODEX_EXEC_SERVER_TEST_INHERIT_PID_NAMESPACE";
 
 const CODEX_WINDOWS_SANDBOX_ARG1: &str = "--run-as-windows-sandbox";
 const DELAYED_OUTPUT_AFTER_EXIT_CHILD_ARG: &str = "--codex-test-delayed-output-after-exit-child";
@@ -224,6 +225,10 @@ fn maybe_run_exec_server_from_test_binary(guard: Option<&TestBinaryDispatchGuard
             std::process::exit(1);
         }
     };
+    if env::var(INHERIT_PID_NAMESPACE_ENV).as_deref() == Ok("1") {
