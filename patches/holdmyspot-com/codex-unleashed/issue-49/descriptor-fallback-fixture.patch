+            .with_linux_sandbox_pid_namespace(codex_sandboxing::LinuxSandboxPidNamespace::Inherit);
+    }
     runtime_paths.prefer_mxc = env::var("CODEX_EXEC_SERVER_TEST_PREFER_MXC")
         .ok()
         .map(|value| {
