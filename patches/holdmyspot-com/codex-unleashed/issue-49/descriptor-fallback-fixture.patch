             backend: environment.get_exec_backend(),
             _server: None,
         }
+    } else if deny_fd_path && cfg!(target_os = "linux") {
+        // A new PID namespace mounts a fresh /proc over the /proc denial below.
+        let server = common::exec_server::exec_server_with_env(
+            [(common::INHERIT_PID_NAMESPACE_ENV, "1")],
+            &[],
+        )
+        .await?;
+        let environment = Environment::create_for_tests(Some(server.websocket_url().to_string()))?;
+        ProcessContext {
+            backend: environment.get_exec_backend(),
+            _server: Some(server),
+        }
     } else {
         create_process_context(deny_fd_path).await?
     };
@@ -139,12 +151,12 @@ async fn shell_snapshot_concurrent_replays_keep_independent_readers(
     let payload_len = if deny_fd_path { 1 } else { 480 * 1024 };
     let payload = "x".repeat(payload_len);
