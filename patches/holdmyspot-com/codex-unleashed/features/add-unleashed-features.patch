Subject: [PATCH] add-unleashed-features

---
 codex-rs/features/src/lib.rs | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/codex-rs/features/src/lib.rs b/codex-rs/features/src/lib.rs
index 1a31316..a3b3f49 100644
--- a/codex-rs/features/src/lib.rs
+++ b/codex-rs/features/src/lib.rs
@@ -93,6 +93,8 @@ impl Stage {
 pub enum Feature {
     /// Discover model catalogs for OpenAI API-key authentication.
     ApiKeyModelDiscovery,
+    /// Use the latest compacted conversation when replaying a resumed thread.
+    UnleashedAgentFastSwitching,
     /// Enable the interactive transcript composer and turn-selection UI.
     TranscriptV2,
     // Stable.
@@ -902,6 +904,12 @@ pub struct FeatureSpec {
 }
 
 pub const FEATURES: &[FeatureSpec] = &[
+    FeatureSpec {
+        id: Feature::UnleashedAgentFastSwitching,
+        key: "unleashed_agent_fast_switching",
+        stage: Stage::Stable,
+        default_enabled: true,
+    },
     FeatureSpec {
         id: Feature::TranscriptV2,
         key: "transcript_v2",
