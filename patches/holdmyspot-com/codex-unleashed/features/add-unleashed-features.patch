From: Codex Unleashed <holdmyspot-com@users.noreply.github.com>
Date: Sun, 6 Sep 2026 00:00:00 -0400
Subject: [PATCH] Register Codex Unleashed features

---
 codex-rs/features/src/lib.rs | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/codex-rs/features/src/lib.rs b/codex-rs/features/src/lib.rs
index 80cc9fa..c5b52d7 100644
--- a/codex-rs/features/src/lib.rs
+++ b/codex-rs/features/src/lib.rs
@@ -90,6 +90,8 @@ pub enum Feature {
 /// Unique features toggled via configuration.
 #[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
 pub enum Feature {
+    /// Use the latest compacted conversation when replaying a resumed thread.
+    UnleashedAgentFastSwitching,
     /// Enable the interactive transcript composer and turn-selection UI.
     TranscriptV2,
     // Stable.
@@ -846,6 +848,12 @@ pub const FEATURES: &[FeatureSpec] = &[
 }
 
 pub const FEATURES: &[FeatureSpec] = &[
+    FeatureSpec {
+        id: Feature::UnleashedAgentFastSwitching,
+        key: "unleashed_agent_fast_switching",
+        stage: Stage::Stable,
+        default_enabled: true,
+    },
     FeatureSpec {
         id: Feature::TranscriptV2,
         key: "transcript_v2",
