diff --git a/codex-rs/core/src/config/config_loader_tests.rs b/codex-rs/core/src/config/config_loader_tests.rs
index d50816a..a2c6abd 100644
--- a/codex-rs/core/src/config/config_loader_tests.rs
+++ b/codex-rs/core/src/config/config_loader_tests.rs
@@ -3970,6 +3970,32 @@ wire_api = "responses"
     Ok(())
 }
 
+#[tokio::test]
+async fn strict_config_rejects_unknown_codex_unleashed_settings() {
+    for (contents, expected) in [
+        (
+            "unleashed_expanded_diff_previews = true",
+            "unknown configuration field `unleashed_expanded_diff_previews`",
+        ),
+        (
+            "[codex_unleashed]\nunused = true",
+            "unknown configuration field `codex_unleashed.unused`",
+        ),
+    ] {
+        let tmp = tempdir().expect("tempdir");
+        std::fs::write(tmp.path().join(CONFIG_TOML_FILE), contents).expect("write config");
+        let err = ConfigBuilder::default()
+            .codex_home(tmp.path().to_path_buf())
+            .fallback_cwd(Some(tmp.path().to_path_buf()))
+            .loader_overrides(LoaderOverrides::without_managed_config_for_tests())
+            .strict_config(/*strict_config*/ true)
+            .build()
+            .await
+            .expect_err("unknown setting should be rejected");
+        assert_eq!(config_error_from_io(&err).message, expected);
+    }
+}
+
