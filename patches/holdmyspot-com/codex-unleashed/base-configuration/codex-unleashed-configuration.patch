+++ b/codex-rs/core/config.schema.json
@@ -741,6 +741,11 @@
       },
       "type": "object"
     },
+    "CodexUnleashedToml": {
+      "additionalProperties": false,
+      "description": "Project settings for Codex Unleashed features.",
+      "type": "object"
+    },
     "ComputerUseConfigToml": {
       "additionalProperties": false,
       "properties": {
@@ -7408,6 +7413,14 @@
       ],
       "description": "Cloud-owned feature settings."
     },
+    "codex_unleashed": {
+      "allOf": [
+        {
+          "$ref": "#/definitions/CodexUnleashedToml"
