From ddd7befd93f8a0e36071e57879c9a9fb47acd673 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Sat, 7 Nov 2026 08:53:58 -0500
Subject: [PATCH] Add a shared configuration table for Codex Unleashed settings

Codex Unleashed features need project settings, and each feature should
own its typed fields instead of adding top-level keys. The new optional
codex_unleashed table starts empty and rejects undeclared settings, as
the rest of config.toml does. The published config schema includes the
table so the schema fixture test keeps matching.
---
 codex-rs/config/src/config_toml.rs            | 10 +++++++
 codex-rs/config/src/types_tests.rs            | 13 ++++++++++
 codex-rs/core/config.schema.json              | 13 ++++++++++
 .../core/src/config/config_loader_tests.rs    | 26 +++++++++++++++++++
 4 files changed, 62 insertions(+)

diff --git a/codex-rs/config/src/config_toml.rs b/codex-rs/config/src/config_toml.rs
index dedf0ae..4f8bee1 100644
--- a/codex-rs/config/src/config_toml.rs
+++ b/codex-rs/config/src/config_toml.rs
@@ -162,10 +162,20 @@ pub struct FeatureToggleToml {
     pub enabled: Option<bool>,
 }
 
+/// Project settings for Codex Unleashed features.
+#[derive(Serialize, Deserialize, Debug, Clone, Default, PartialEq, Eq, JsonSchema)]
+#[schemars(deny_unknown_fields)]
+pub struct CodexUnleashedToml {
+    // Fields are registered by their owning feature patches.
+}
+
 /// Base config deserialized from ~/.codex/config.toml.
 #[derive(Serialize, Deserialize, Debug, Clone, Default, PartialEq, JsonSchema)]
 #[schemars(deny_unknown_fields)]
 pub struct ConfigToml {
+    /// Project settings for Codex Unleashed features.
+    pub codex_unleashed: Option<CodexUnleashedToml>,
+
     /// Optional override of model selection.
     pub model: Option<String>,
     /// Default Daybreak preference for new threads and non-interactive turns.
diff --git a/codex-rs/config/src/types_tests.rs b/codex-rs/config/src/types_tests.rs
index 5a78075..e844413 100644
--- a/codex-rs/config/src/types_tests.rs
+++ b/codex-rs/config/src/types_tests.rs
@@ -82,6 +82,19 @@ fn mouse_scroll_speed_rejects_nonpositive_and_nonfinite_values() {
     }
 }
 
+#[test]
+fn codex_unleashed_table_schema_rejects_undeclared_properties() {
+    let schema = serde_json::to_value(crate::schema::config_schema()).unwrap();
+    assert_eq!(
+        schema.pointer("/properties/codex_unleashed/allOf/0/$ref"),
+        Some(&serde_json::json!("#/definitions/CodexUnleashedToml"))
+    );
+    assert_eq!(
+        schema.pointer("/definitions/CodexUnleashedToml/additionalProperties"),
+        Some(&serde_json::json!(false))
+    );
+}
+
 #[test]
 fn deserialize_skill_config_with_name_selector() {
     let cfg: SkillConfig = toml::from_str(
