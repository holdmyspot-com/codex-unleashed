From 15c2b8bad3dd3739f0a54edd005d227be44339c6 Mon Sep 17 00:00:00 2001
From: Codex Unleashed <codex-unleashed@holdmyspot.com>
Date: Wed, 30 Sep 2026 18:48:00 -0400
Subject: [PATCH] config: share the Codex Unleashed configuration table

Base: openai/codex rust-v0.159.2 ff6aec96948b70d94983af2641a6b67c94faeff5

Declare the shared table without feature flags or runtime properties. Each
feature patch supplies its own typed fields. Preserve strict rejection of
undeclared settings through the existing config loader.

TDD receipts (Rust 1.95.0):
- cargo test -p codex-config --lib codex_unleashed_table_schema_rejects_undeclared_properties
  RED on pristine base: table reference missing (None vs Some).
  GREEN with the shared declaration: 1 passed.
- cargo test -p codex-core --lib codex_unleashed: 4 passed in the complete queue,
  including strict rejection of undeclared fields and silent disabled settings.

The schema/refresh-config-schema.patch artifact publishes the generated schema
and owns the real CLI exact-output check after all runtime patches are applied.
---
 codex-rs/config/src/config_toml.rs            | 10 +++++++
 codex-rs/config/src/types_tests.rs            | 13 ++++++++++
 .../core/src/config/config_loader_tests.rs    | 26 +++++++++++++++++++
 3 files changed, 49 insertions(+)

diff --git a/codex-rs/config/src/config_toml.rs b/codex-rs/config/src/config_toml.rs
index 84b5321..5634e8d 100644
--- a/codex-rs/config/src/config_toml.rs
+++ b/codex-rs/config/src/config_toml.rs
@@ -159,10 +159,20 @@ pub struct FeatureToggleToml {
     pub enabled: Option<bool>,
 }
 
+/// Project settings for Codex Unleashed features.
+#[derive(Serialize, Deserialize, Debug, Clone, Default, PartialEq, Eq, JsonSchema)]
+#[schemars(deny_unknown_fields)]
+pub struct CodexUnleashedToml {
+    // Fields are registered by their owning feature patches.
+}
+
 /// Base config deserialized from ~/.codex/config.toml.
 #[derive(Serialize, Deserialize, Debug, Clone, Default, PartialEq, JsonSchema)]
 #[schemars(deny_unknown_fields)]
 pub struct ConfigToml {
+    /// Project settings for Codex Unleashed features.
+    pub codex_unleashed: Option<CodexUnleashedToml>,
+
     /// Optional override of model selection.
     pub model: Option<String>,
     /// Review model override used by the `/review` feature.
diff --git a/codex-rs/config/src/types_tests.rs b/codex-rs/config/src/types_tests.rs
index ab383ca..3c58873 100644
--- a/codex-rs/config/src/types_tests.rs
+++ b/codex-rs/config/src/types_tests.rs
@@ -1,6 +1,19 @@
 use super::*;
 use pretty_assertions::assert_eq;
 
+#[test]
+fn codex_unleashed_table_schema_rejects_undeclared_properties() {
+    let schema = serde_json::to_value(crate::schema::config_schema()).unwrap();
+    assert_eq!(
+        schema.pointer("/properties/codex_unleashed/allOf/0/$ref"),
+        Some(&serde_json::json!("#/definitions/CodexUnleashedToml"))
+    );
+    assert_eq!(
+        schema.pointer("/definitions/CodexUnleashedToml/additionalProperties"),
+        Some(&serde_json::json!(false))
+    );
+}
+
