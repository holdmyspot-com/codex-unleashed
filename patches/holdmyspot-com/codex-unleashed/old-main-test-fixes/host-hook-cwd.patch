From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Tue, 10 Nov 2026 17:25:13 -0500
Subject: [PATCH] bugfix: run host hooks in the host working directory for
 remote sessions

Selecting only a remote environment makes the turn's executor working
directory a path that does not exist on the host, so host command hooks
failed to spawn. Fall back to the per-turn host working directory for every
hook request, as already done for tool hooks, while a selected local
environment keeps priority.

The regression selects a remote-only environment and expects the hook
working directory to be the host working directory.
---
 codex-rs/core/src/hook_runtime.rs  | 39 +++++++++++++++---------------
 codex-rs/core/src/session/tests.rs | 20 +++++++++++++++
 2 files changed, 40 insertions(+), 19 deletions(-)

diff --git a/codex-rs/core/src/hook_runtime.rs b/codex-rs/core/src/hook_runtime.rs
index 603a6e4..6f4d176 100644
--- a/codex-rs/core/src/hook_runtime.rs
+++ b/codex-rs/core/src/hook_runtime.rs
@@ -156,8 +156,7 @@ pub(crate) async fn run_pending_session_start_hooks(
         };
         let request = codex_hooks::SessionStartRequest {
             session_id: sess.session_id().into(),
-            #[allow(deprecated)]
-            cwd: turn_context.cwd.clone(),
+            cwd: tool_hook_cwd(&turn_context.initial_environments, turn_context),
             transcript_path: sess.hook_transcript_path().await,
             model: turn_context.model_info().slug.clone(),
             permission_mode: hook_permission_mode(turn_context.approval_policy()),
@@ -258,12 +257,14 @@ pub(crate) async fn run_pre_tool_use_hooks(
     }
 }
 
-#[allow(deprecated)]
-fn tool_hook_cwd(environments: &TurnEnvironmentSnapshot, turn: &TurnContext) -> AbsolutePathBuf {
+pub(crate) fn tool_hook_cwd(
+    environments: &TurnEnvironmentSnapshot,
+    turn: &TurnContext,
+) -> AbsolutePathBuf {
     // Hooks run on the host, so a remote workspace cannot replace the local fallback.
     environments
         .local_environment_cwd()
-        .unwrap_or_else(|| turn.cwd.clone())
+        .unwrap_or_else(|| turn.config.cwd.clone())
 }
 
