diff --git a/codex-rs/core/src/session/tests.rs b/codex-rs/core/src/session/tests.rs
index ae6a29f..6295fb3 100644
--- a/codex-rs/core/src/session/tests.rs
+++ b/codex-rs/core/src/session/tests.rs
@@ -13653,5 +13653,25 @@ async fn rejected_mcp_refresh_then_corrected_user_config_blocks_ordinary_replace
         "rejection must not permit same-name ordinary-auth replacement in this session"
     );
 }
+#[tokio::test]
+async fn hook_cwd_stays_on_host_when_only_a_remote_environment_is_selected() {
+    let (_session, mut turn) = make_session_and_context().await;
+    let host_cwd = turn.config.cwd.join("host-workspace");
+    Arc::make_mut(&mut turn.config).cwd = host_cwd.clone();
+    let mut remote_only = turn.initial_environments.clone();
+    let TurnEnvironmentState::Ready(environment) = &mut remote_only.environments[0] else {
+        panic!("fixture should have a ready environment");
+    };
+    environment.environment = Arc::new(
+        codex_exec_server::Environment::create_for_tests(Some("ws://127.0.0.1:8765".to_string()))
+            .expect("remote environment"),
+    );
+
+    assert_eq!(
+        crate::hook_runtime::tool_hook_cwd(&remote_only, &turn),
+        host_cwd
+    );
+}
+
 #[path = "resume_warmup_tests.rs"]
 mod resume_warmup_tests;
