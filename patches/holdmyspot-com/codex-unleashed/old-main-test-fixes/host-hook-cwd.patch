             triggered_at: chrono::Utc::now(),
             hook_event: codex_hooks::HookEvent::AfterAgent {
@@ -696,8 +698,7 @@ pub(crate) async fn inspect_pending_input(
                 session_id: sess.session_id().into(),
                 turn_id: turn_context.sub_id.clone(),
