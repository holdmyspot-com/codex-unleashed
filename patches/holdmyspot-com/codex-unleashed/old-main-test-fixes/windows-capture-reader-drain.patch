+        eprint!("{}", "E".repeat(LEGACY_CAPTURE_OUTPUT_LEN));
+    } else {
+        // This is an isolated fixture process. Do not let the child retain the
+        // root's ConPTY handles alongside its explicit file stdio. Otherwise EOF
+        // cannot arrive until the child that our caller releases exits.
