+        // Write past one pipe read buffer before the descendant starts. The
+        // descendant may inherit the capture pipes: capture must still finish
+        // when this root exits.
+        print!(
+            "LEGACY-CAPTURE-DIRECT{}",
+            "O".repeat(LEGACY_CAPTURE_OUTPUT_LEN)
