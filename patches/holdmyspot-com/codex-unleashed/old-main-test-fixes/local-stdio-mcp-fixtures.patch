+// These inline Python servers belong to the host even when tools use a remote executor.
+fn set_host_stdio_cwd(config: &Config, server: &mut McpServerConfig) {
+    let McpServerTransportConfig::Stdio { cwd, .. } = &mut server.transport else {
+        panic!("expected a stdio MCP fixture");
+    };
+    *cwd = Some(LegacyAppPathString::from_path(&config.codex_home));
+}
+
+fn set_host_stdio_servers(config: &mut Config, mut servers: HashMap<String, McpServerConfig>) {
+    for server in servers.values_mut() {
+        set_host_stdio_cwd(config, server);
+    }
+    config.mcp_servers.set(servers).expect("set MCP fixture");
+}
