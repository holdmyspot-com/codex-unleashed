From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Tue, 10 Nov 2026 17:25:12 -0500
Subject: [PATCH] test: keep legacy PowerShell workloads within writable
 fixtures

Supply executor-local SystemRoot and owned TEMP/TMP for the three legacy
PowerShell fixtures: the non-TTY interrupt, the capture cancellation and the
TTY output-and-input tests. The cancellation fixture uses its writable workspace for
them. Upstream already runs the normal-capture and ConPTY descendant lifecycle
tests as native fixtures inside a writable workspace, so they need no change.
Preserve sandbox policies, expected output, assertions and deadlines.
---
 .../src/unified_exec/tests.rs                 | 22 ++++++++++++++++---
 1 file changed, 19 insertions(+), 3 deletions(-)

diff --git a/codex-rs/windows-sandbox-rs/src/unified_exec/tests.rs b/codex-rs/windows-sandbox-rs/src/unified_exec/tests.rs
index 4245b16cec..6237748fe0 100644
--- a/codex-rs/windows-sandbox-rs/src/unified_exec/tests.rs
+++ b/codex-rs/windows-sandbox-rs/src/unified_exec/tests.rs
@@ -120,6 +120,20 @@ fn powershell_literal(path: &Path) -> String {
     path.to_string_lossy().replace('\'', "''")
 }
 
+fn powershell_env(temp_dir: &Path) -> HashMap<String, String> {
+    let temp_dir = temp_dir.to_string_lossy().into_owned();
+    // PowerShell needs SystemRoot for Windows security policy and module loading.
+    // Keep compilation and redirected child I/O inside the fixture's writable root.
+    HashMap::from([
+        (
+            "SystemRoot".to_string(),
+            std::env::var("SystemRoot").expect("Windows PowerShell requires SystemRoot"),
+        ),
+        ("TEMP".to_string(), temp_dir.clone()),
+        ("TMP".to_string(), temp_dir),
+    ])
+}
+
 fn start_powershell_child(
     pwsh: &Path,
     stdio_dir: &Path,
@@ -480,6 +494,7 @@ fn legacy_non_tty_powershell_interrupt_terminates_process() {
     let runtime = current_thread_runtime();
     runtime.block_on(async move {
         let cwd = sandbox_cwd();
+        let workload_temp = tempfile::tempdir_in(&cwd).expect("create PowerShell workload tempdir");
         let codex_home = sandbox_home("legacy-non-tty-pwsh");
         println!("pwsh codex_home={}", codex_home.path().display());
         let permission_profile = PermissionProfile::workspace_write();
@@ -494,7 +509,7 @@ fn legacy_non_tty_powershell_interrupt_terminates_process() {
                 format!("{ASSERT_NO_CONSOLE} Write-Output LEGACY-NONTTY-DIRECT; [System.Threading.ManualResetEvent]::new($false).WaitOne()"),
             ],
             cwd.as_path(),
-            HashMap::new(),
+            powershell_env(workload_temp.path()),
             /*timeout_ms*/ None,
             &[],
             &[],
@@ -995,7 +1010,7 @@ fn legacy_capture_cancellation_terminates_descendants_without_timeout() {
             parent_command,
         ],
         cwd.as_path(),
-        HashMap::new(),
+        powershell_env(cwd.as_path()),
         Some(30_000),
         /*cancellation*/ Some(cancellation),
     )
@@ -1122,6 +1137,7 @@ fn legacy_tty_powershell_emits_output_and_accepts_input() {
     let runtime = current_thread_runtime();
     runtime.block_on(async move {
         let cwd = sandbox_cwd();
+        let workload_temp = tempfile::tempdir_in(&cwd).expect("create PowerShell workload tempdir");
         let codex_home = sandbox_home("legacy-tty-pwsh");
         println!("tty pwsh codex_home={}", codex_home.path().display());
         let permission_profile = PermissionProfile::workspace_write();
@@ -1138,7 +1154,7 @@ fn legacy_tty_powershell_emits_output_and_accepts_input() {
                 "$PID; Write-Output ready".to_string(),
             ],
             cwd.as_path(),
-            HashMap::new(),
+            powershell_env(workload_temp.path()),
             Some(10_000),
             &[],
             &[],
