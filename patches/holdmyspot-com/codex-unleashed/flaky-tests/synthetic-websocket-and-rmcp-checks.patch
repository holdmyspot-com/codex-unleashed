+#[tokio::test]
+async fn redirect_wrapper_controls_same_origin_following() -> anyhow::Result<()> {
+    for stream_response in [false, true] {
+        let recorder = Arc::new(RecordingRedirectHttpClient::default());
+        let client = SameOriginRedirectHttpClient::new(recorder.clone());
+        let params = HttpRequestParams {
+            method: "GET".to_string(),
+            body: None,
+            stream_response,
+            ..request("https://server.example.invalid/start")
+        };
+        let response = if stream_response {
+            client.http_request_stream(params).await?.0
+        } else {
+            client.http_request(params).await?
+        };
+        assert_eq!(response.status, 200);
+
+        let requests = recorder.requests.lock().expect("request recorder lock");
+        assert_eq!(requests.len(), 2);
+        assert_eq!(requests[0].url, "https://server.example.invalid/start");
+        assert_eq!(requests[1].url, "https://server.example.invalid/final");
+        for request in requests.iter() {
+            assert_eq!(request.redirect_policy, HttpRedirectPolicy::Stop);
+        }
+    }
+    Ok(())
+}
+
+#[tokio::test]
+async fn redirect_wrapper_rejects_origin_change_before_following() {
+    for status in [307, 308] {
+        for (method, stream_response) in [("POST", true), ("GET", true), ("DELETE", false)] {
+            let recorder = Arc::new(RecordingRedirectHttpClient {
+                location: Some("https://other.example.invalid/next"),
+                redirect_status: Some(status),
+                ..Default::default()
+            });
+            let client = SameOriginRedirectHttpClient::new(recorder.clone());
+            let params = HttpRequestParams {
+                method: method.to_string(),
+                body: (method == "POST").then(|| b"fixture-body".to_vec().into()),
+                stream_response,
+                ..request("https://server.example.invalid/start")
+            };
+            let error = if stream_response {
+                client.http_request_stream(params).await.err()
+            } else {
+                client.http_request(params).await.err()
+            }
+            .expect("origin change must be rejected");
+            assert!(error.to_string().contains("different origin"));
+
+            let requests = recorder.requests.lock().expect("request recorder lock");
+            assert_eq!(requests.len(), 1);
+            assert_eq!(requests[0].url, "https://server.example.invalid/start");
+            assert_eq!(requests[0].redirect_policy, HttpRedirectPolicy::Stop);
+        }
+    }
+}
