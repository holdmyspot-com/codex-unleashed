+#[cfg(test)]
+mod origin_policy_tests {
+    use super::*;
+
+    #[test]
+    fn redirect_policy_requires_the_original_scheme_host_and_port() -> anyhow::Result<()> {
+        let origin = Url::parse("https://server.example.invalid/start")?.origin();
+        validate_redirect_origin(
+            &origin,
+            &Url::parse("https://server.example.invalid:443/next")?,
+        )?;
+        for destination in [
+            "https://other.example.invalid/next",
+            "http://server.example.invalid/next",
+            "https://server.example.invalid:444/next",
+        ] {
+            assert!(validate_redirect_origin(&origin, &Url::parse(destination)?).is_err());
+        }
+        Ok(())
+    }
