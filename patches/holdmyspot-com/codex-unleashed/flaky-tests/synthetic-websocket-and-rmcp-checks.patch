     }
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use http::HeaderValue;
+
+    #[test]
+    fn probe_debug_preserves_status_and_hides_synthetic_values() {
+        let mut headers = HeaderMap::new();
+        headers.insert("x-request-id", HeaderValue::from_static("fixture-header"));
+        let probe = ResponsesWebsocketProbe {
+            url: "wss://example.invalid/fixture-url".into(),
+            status: StatusCode::SWITCHING_PROTOCOLS,
+            headers,
+            reasoning_included: true,
+            server_model_present: false,
+            immediate_close: Some(ResponsesWebsocketClose {
+                code: "1000".into(),
+                reason: "fixture-reason".into(),
+            }),
+        };
+
+        let debug = format!("{probe:?}");
+        for hidden in ["fixture-url", "fixture-header", "fixture-reason"] {
+            assert!(!debug.contains(hidden));
+        }
+        assert!(debug.contains("status: 101"));
+        assert!(debug.contains("reasoning_included: true"));
+        assert!(debug.contains("server_model_present: false"));
+        assert!(debug.contains("1000"));
+    }
+
+    #[test]
+    fn probe_failure_preserves_status_and_hides_synthetic_values() {
+        let mut headers = HeaderMap::new();
+        headers.insert("x-request-id", HeaderValue::from_static("fixture-header"));
+        let failure = ResponsesWebsocketProbeError {
+            error: Box::new(ApiError::Stream("fixture-error".into())),
+            stage: ResponsesWebsocketProbeFailureStage::Unknown,
+            status: Some(StatusCode::SWITCHING_PROTOCOLS),
+            headers: Some(headers),
+        };
+
+        let debug = format!("{failure:?}");
+        assert!(debug.contains("stage: Unknown"));
+        assert!(debug.contains("101"));
+        assert!(!debug.contains("fixture-header"));
+        assert!(!debug.contains("fixture-error"));
+        assert_eq!(failure.to_string(), "Responses WebSocket probe failed");
+    }
+}
