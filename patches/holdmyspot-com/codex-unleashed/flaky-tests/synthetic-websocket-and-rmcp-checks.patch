+#[cfg(test)]
+mod probe_header_tests {
+    use super::*;
+
+    #[test]
+    fn probe_close_evidence_preserves_code_and_hides_reason_in_debug() {
+        use tokio_tungstenite::tungstenite::protocol::frame::coding::CloseCode;
+
+        let evidence = close_frame_to_probe(CloseFrame {
+            code: CloseCode::Normal,
+            reason: "fixture-reason".into(),
+        });
+        assert_eq!(evidence.code, "1000");
+        assert_eq!(evidence.reason, "fixture-reason");
+        let debug = format!("{evidence:?}");
+        assert!(debug.contains("1000"));
+        assert!(!debug.contains("fixture-reason"));
+    }
+
+    #[test]
+    fn probe_retains_only_tracking_headers() {
+        let mut response = HeaderMap::new();
+        for name in [
+            "x-request-id",
+            "x-oai-request-id",
+            "cf-ray",
+            "x-ms-request-id",
+        ] {
+            response.append(name, http::HeaderValue::from_static("fixture-first"));
+            response.append(name, http::HeaderValue::from_static("fixture-second"));
+        }
+        response.append("x-extra", http::HeaderValue::from_static("fixture-private"));
+
+        let evidence = probe_tracking_headers(&response);
+        assert_eq!(evidence.len(), 8);
+        assert!(!evidence.contains_key("x-extra"));
+        for name in [
+            "x-request-id",
+            "x-oai-request-id",
+            "cf-ray",
+            "x-ms-request-id",
+        ] {
+            assert!(
+                evidence
+                    .get_all(name)
+                    .iter()
+                    .eq(response.get_all(name).iter())
+            );
+        }
+    }
+}
