+#[tokio::test]
+async fn probe_reports_normal_loopback_handshake_and_close() -> anyhow::Result<()> {
+    let listener = TcpListener::bind((std::net::Ipv4Addr::LOCALHOST, 0)).await?;
+    let client = probe_client(format!("http://{}", listener.local_addr()?));
+    let factory = HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault);
+    let close_reason = "fixture completed";
+    let request_id = "fixture-request-id";
+    let server = async {
+        let (stream, _) = listener.accept().await?;
+        let mut config = WebSocketConfig::default();
+        config.extensions.permessage_deflate = Some(DeflateConfig::default());
+        let mut socket = accept_hdr_async_with_config(
+            stream,
+            |request: &Request, mut response: Response| {
+                assert_eq!(request.uri().path(), "/responses");
+
+                let headers = response.headers_mut();
+                headers.insert("x-request-id", HeaderValue::from_static(request_id));
+                headers.insert("x-fixture-note", HeaderValue::from_static("fixture note"));
+                headers.insert("x-reasoning-included", HeaderValue::from_static("true"));
+                headers.insert("openai-model", HeaderValue::from_static("fixture model"));
+                Ok(response)
+            },
+            Some(config),
+        )
+        .await?;
+        socket
+            .close(Some(CloseFrame {
+                code: CloseCode::Normal,
+                reason: close_reason.into(),
+            }))
+            .await?;
+
+        match socket.next().await {
+            None | Some(Ok(Message::Close(_))) => {}
+            Some(Err(WsError::Protocol(ProtocolError::ResetWithoutClosingHandshake))) => {}
+            Some(other) => anyhow::bail!("unexpected frame after probe upgrade: {other:?}"),
+        }
+        Ok::<(), anyhow::Error>(())
+    };
+    let probe = client.probe_handshake(
+        &factory,
+        HeaderMap::new(),
+        HeaderMap::new(),
+        Duration::from_secs(/*secs*/ 5),
+    );
+
+    let (server_result, evidence) = tokio::time::timeout(Duration::from_secs(/*secs*/ 10), async {
+        tokio::join!(server, probe)
+    })
+    .await?;
+    server_result?;
+    let evidence = evidence.expect("probe handshake");
+    assert_eq!(evidence.status, StatusCode::SWITCHING_PROTOCOLS);
+    assert_eq!(
+        evidence.headers,
+        HeaderMap::from_iter([(
+            http::HeaderName::from_static("x-request-id"),
+            HeaderValue::from_static(request_id),
+        )])
+    );
+    assert!(evidence.reasoning_included);
+    assert!(evidence.server_model_present);
+
+    let close = evidence.immediate_close.as_ref().expect("normal close");
+    assert_eq!(close.code, "1000");
+    assert_eq!(close.reason, close_reason);
+    let diagnostics = format!("{evidence:?}");
+    assert!(diagnostics.contains("101"));
+    assert!(diagnostics.contains("1000"));
+    assert!(!diagnostics.contains(request_id));
+    assert!(!diagnostics.contains(close_reason));
+    Ok(())
+}
