+#[tokio::test]
+async fn ordinary_http_discovery_returns_advertised_peer_info() -> anyhow::Result<()> {
+    let server = MockServer::start().await;
+    Mock::given(method("POST"))
+        .and(path("/mcp"))
+        .respond_with(|request: &Request| {
+            let body: Value = request.body_json().expect("JSON-RPC request");
+            assert_eq!(body["method"], "server/discover");
+            modern_discover_response(&body)
+        })
+        .expect(1)
+        .mount(&server)
+        .await;
+
+    let client = create_client(&server, McpProtocolMode::V20260728).await?;
+    let peer_info = initialize_client(&client).await;
+    client.shutdown().await;
+    let peer_info = peer_info?;
+
+    assert_eq!(peer_info.protocol_version, ProtocolVersion::V_2026_07_28);
+    assert_eq!(
+        peer_info.server_info,
+        Some(Implementation::new("modern-test", "1.0.0"))
+    );
+    assert_eq!(
+        peer_info.capabilities,
+        ServerCapabilities::builder().enable_tools().build()
+    );
+    Ok(())
+}
