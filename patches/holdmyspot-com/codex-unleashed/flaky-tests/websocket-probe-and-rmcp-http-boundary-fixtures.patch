+#[tokio::test]
+async fn probe_preserves_upgrade_evidence_when_loopback_peer_disconnects() -> anyhow::Result<()> {
+    let listener = TcpListener::bind((std::net::Ipv4Addr::LOCALHOST, 0)).await?;
+    let client = probe_client(format!("http://{}", listener.local_addr()?));
+    let factory = HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault);
+    let server = async {
+        let (stream, _) = listener.accept().await?;
+        let socket = accept_hdr_async_with_config(
+            stream,
+            |_: &Request, mut response: Response| {
+                response.headers_mut().extend(fixture_tracking_headers());
+                response
+                    .headers_mut()
+                    .insert("x-fixture-note", HeaderValue::from_static("fixture note"));
+                Ok(response)
+            },
+            Some(fixture_socket_config()),
+        )
+        .await?;
+        // A peer can lose its transport after completing an otherwise valid upgrade.
+        drop(socket);
+        Ok::<(), anyhow::Error>(())
+    };
+    let probe = client.probe_handshake(
+        &factory,
+        HeaderMap::new(),
+        HeaderMap::new(),
+        Duration::from_secs(/*secs*/ 5),
+    );
+    let (server_result, probe_result) =
+        tokio::time::timeout(Duration::from_secs(/*secs*/ 10), async {
+            tokio::join!(server, probe)
+        })
+        .await?;
+    server_result?;
+    let failure = probe_result.expect_err("read failed after upgrade");
+    assert_eq!(failure.stage, ResponsesWebsocketProbeFailureStage::Unknown);
+    assert_eq!(failure.status, Some(StatusCode::SWITCHING_PROTOCOLS));
+    assert_eq!(failure.headers.as_ref(), Some(&fixture_tracking_headers()));
+    assert!(matches!(*failure.error, ApiError::Stream(_)));
+    let diagnostics = format!("{failure:?}");
+    assert!(diagnostics.contains("101"));
+    assert!(!diagnostics.contains("fixture-"));
+    Ok(())
+}
