+#[tokio::test]
+async fn ordinary_modern_http_tool_catalog_accepts_json_at_message_limit() -> anyhow::Result<()> {
+    let server = MockServer::start().await;
+    Mock::given(method("POST"))
+        .and(path("/mcp"))
+        .respond_with(|request: &Request| {
+            let request: Value = request.body_json().expect("JSON-RPC request");
+            match request["method"].as_str() {
+                Some("server/discover") => modern_discover_response(&request),
+                Some("tools/list") => {
+                    let body = json!({
+                        "jsonrpc": "2.0",
+                        "id": request["id"],
+                        "result": {
+                            "resultType": "complete",
+                            "tools": [{
+                                "name": "read_sample",
+                                "inputSchema": {"type": "object"},
+                            }],
+                        },
+                    });
+                    let mut response = serde_json::to_vec(&body).expect("tool catalog response");
+                    response.resize(MAX_MCP_MESSAGE_BYTES, b' ');
+                    ResponseTemplate::new(200).set_body_raw(response, "application/json")
+                }
+                other => panic!("unexpected modern lifecycle request: {other:?}"),
+            }
+        })
+        .expect(2)
+        .mount(&server)
+        .await;
+
+    let client = create_client(&server, McpProtocolMode::V20260728).await?;
+    initialize_client(&client).await?;
+    let tools = client
+        .list_tools(/*params*/ None, Some(Duration::from_secs(5)))
+        .await;
+    client.shutdown().await;
+
+    let tools = tools?.tools;
+    assert_eq!(tools.len(), 1);
+    assert_eq!(tools[0].name.as_ref(), "read_sample");
+    Ok(())
+}
