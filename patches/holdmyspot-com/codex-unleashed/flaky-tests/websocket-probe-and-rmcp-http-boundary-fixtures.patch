+#[tokio::test]
+async fn probe_reports_ordinary_loopback_http_rejection() -> anyhow::Result<()> {
+    let listener = TcpListener::bind((std::net::Ipv4Addr::LOCALHOST, 0)).await?;
+    let client = probe_client(format!("http://{}", listener.local_addr()?));
+    let factory = HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault);
+    let body = "fixture unavailable";
+    let tracking_id = "fixture-rejection";
+    let server = async {
+        let (stream, _) = listener.accept().await?;
+        let result = accept_hdr_async_with_config(
+            stream,
+            |request: &Request, _: Response| {
+                assert_eq!(request.uri().path(), "/responses");
+                let mut response = http::Response::new(Some(body.to_owned()));
+                *response.status_mut() = StatusCode::SERVICE_UNAVAILABLE;
+                let headers = response.headers_mut();
+                headers.insert(http::header::CONTENT_LENGTH, HeaderValue::from(body.len()));
+                headers.insert("x-request-id", HeaderValue::from_static(tracking_id));
+                Err(response)
+            },
+            Some(fixture_socket_config()),
+        )
+        .await;
+        assert!(matches!(result, Err(WsError::Http(_))));
+        Ok::<(), anyhow::Error>(())
+    };
+    let probe = client.probe_handshake(
+        &factory,
+        HeaderMap::new(),
+        HeaderMap::new(),
+        Duration::from_secs(/*secs*/ 5),
+    );
+    let (server_result, probe_result) =
+        tokio::time::timeout(Duration::from_secs(/*secs*/ 10), async {
+            tokio::join!(server, probe)
+        })
+        .await?;
+    server_result?;
+    let failure = probe_result.expect_err("upgrade rejected");
+    assert_eq!(failure.stage, ResponsesWebsocketProbeFailureStage::Unknown);
+    assert_eq!(failure.status, None);
+    assert_eq!(failure.headers, None);
+    assert_eq!(failure.to_string(), "Responses WebSocket probe failed");
+    let diagnostics = format!("{failure:?}");
+    assert!(!diagnostics.contains(body));
+    assert!(!diagnostics.contains(tracking_id));
+
+    let ApiError::Transport(TransportError::Http {
+        status,
+        headers,
+        body: actual_body,
+        ..
+    }) = *failure.error
+    else {
+        anyhow::bail!("expected HTTP rejection");
+    };
+    assert_eq!(status, StatusCode::SERVICE_UNAVAILABLE);
+    assert_eq!(
+        headers.expect("rejection headers")["x-request-id"],
+        tracking_id
+    );
+    assert_eq!(actual_body.as_deref(), Some(body));
+    Ok(())
+}
