+#[tokio::test]
+async fn ordinary_modern_http_discovery_stops_at_same_origin_redirect() -> anyhow::Result<()> {
+    let server = MockServer::start().await;
+    Mock::given(method("POST"))
+        .and(path("/mcp"))
+        .respond_with(ResponseTemplate::new(307).insert_header("location", "/alternate"))
+        .expect(1)
+        .mount(&server)
+        .await;
+    Mock::given(path("/alternate"))
+        .respond_with(ResponseTemplate::new(200))
+        .expect(0)
+        .mount(&server)
+        .await;
+
+    let client = create_client(&server, McpProtocolMode::V20260728).await?;
+    let result = initialize_client(&client).await;
+    client.shutdown().await;
+
+    assert!(result.is_err());
+    Ok(())
+}
