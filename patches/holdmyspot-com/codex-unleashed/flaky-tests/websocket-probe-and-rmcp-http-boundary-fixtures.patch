+#[tokio::test]
+async fn ordinary_modern_http_discovery_accepts_json_at_message_limit() -> anyhow::Result<()> {
+    let server = MockServer::start().await;
+    Mock::given(method("POST"))
+        .and(path("/mcp"))
+        .respond_with(|request: &Request| {
+            let request: Value = request.body_json().expect("JSON-RPC request");
+            assert_eq!(request["method"], "server/discover");
+
+            let mut response =
+                serde_json::to_vec(&modern_discover_result(&request)).expect("discovery response");
+            response.resize(MAX_MCP_MESSAGE_BYTES, b' ');
+            ResponseTemplate::new(200).set_body_raw(response, "application/json")
+        })
+        .expect(1)
+        .mount(&server)
+        .await;
+
+    let client = create_client(&server, McpProtocolMode::V20260728).await?;
+    let peer_info = initialize_client(&client).await;
+    client.shutdown().await;
+
+    assert_eq!(peer_info?.protocol_version, ProtocolVersion::V_2026_07_28);
+    Ok(())
+}
