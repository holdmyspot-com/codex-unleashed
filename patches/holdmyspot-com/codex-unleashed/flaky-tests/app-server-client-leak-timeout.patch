From 78f4af61bffd6452b8dd2a374666b34b2580ae56 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Thu, 12 Nov 2026 14:20:48 -0500
Subject: [PATCH] test: give codex-app-server-client tests a 2 second nextest
 leak timeout

Their output handles close within 2 seconds of exit on Windows ARM64, so the default 100 ms reported passing tests as leaky (4 of 35 in 43274822988, 0 of 35 at 2 s in 43283804308).
---
 codex-rs/.config/nextest.toml | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/codex-rs/.config/nextest.toml b/codex-rs/.config/nextest.toml
index 6a5a83ae0..50fb1aa81 100644
--- a/codex-rs/.config/nextest.toml
+++ b/codex-rs/.config/nextest.toml
@@ -22,6 +22,12 @@ filter = 'package(codex-cli) & binary(=app_server_daemon_package)'
 slow-timeout = { period = "1m", terminate-after = 2 }
 threads-required = "num-test-threads"
 
+[[profile.default.overrides]]
+# On Windows ARM64 runners these in-process app-server tests' output handles stay open for up to about 2 seconds
+# after the test process exits, with no child process alive at shutdown, which the default 100 ms reported as leaks.
+filter = 'package(codex-app-server-client)'
+leak-timeout = "2s"
+
 [profile.default.junit]
 path = "junit.xml"
 
-- 
2.43.0

