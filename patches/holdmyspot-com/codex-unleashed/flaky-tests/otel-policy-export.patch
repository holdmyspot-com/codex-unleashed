+/// How long an export waits for the application network policy to be published before it fails.
+///
+/// Telemetry readers start exporting before the configuration owner has published the policy. Failing
+/// such an export drops its data, because the metrics use delta temporality.
+const POLICY_PUBLICATION_WAIT: Duration = Duration::from_secs(/*secs*/ 10);
 
