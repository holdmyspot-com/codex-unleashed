-fn denied(error: codex_http_client::NetworkPolicyDenied) -> OTelSdkError {
+fn denied(error: NetworkPolicyDenied) -> OTelSdkError {
     OTelSdkError::InternalFailure(error.to_string())
 }
 
+/// Acquires an SDK permit, waiting up to `wait` for a policy that has not been published yet.
+///
+/// Every other denial is final and returns at once. SDK worker threads drive export futures outside a Tokio
+/// runtime, so the bound comes from a timer thread instead of a Tokio timer.
+async fn acquire(
+    policy: &NetworkPolicy,
+    wait: Duration,
+) -> Result<NetworkPermit, NetworkPolicyDenied> {
+    // Subscribe before the first check so a publication between the check and the wait is not missed.
+    let mut changes = policy.changes();
+    let mut timer = None;
+    loop {
+        match policy.acquire_for_unsupported_sdk() {
+            Err(NetworkPolicyDenied::Unavailable) => {}
+            result => return result,
+        }
+        let Some(changes) = changes.as_mut() else {
+            return Err(NetworkPolicyDenied::Unavailable);
+        };
+        let timer = timer.get_or_insert_with(|| start_timer(wait));
+        if !wait_for_change(changes, timer).await {
+            return Err(NetworkPolicyDenied::Unavailable);
+        }
+    }
+}
+
+/// Resolves once `wait` has elapsed. It resolves at once if the timer thread cannot start.
+fn start_timer(wait: Duration) -> oneshot::Receiver<()> {
+    let (elapsed, timer) = oneshot::channel();
+    let _ = std::thread::Builder::new()
+        .name("otel-policy-wait".to_string())
+        .spawn(move || {
+            std::thread::sleep(wait);
+            let _ = elapsed.send(());
+        });
+    timer
+}
+
+/// Returns true when the policy changed and false when the timer ended first or the policy owner is gone.
+async fn wait_for_change(
+    changes: &mut watch::Receiver<()>,
+    timer: &mut oneshot::Receiver<()>,
+) -> bool {
+    let mut changed = pin!(changes.changed());
+    let mut timer = pin!(timer);
+    std::future::poll_fn(|context| {
+        if let Poll::Ready(result) = changed.as_mut().poll(context) {
+            return Poll::Ready(result.is_ok());
+        }
+        if timer.as_mut().poll(context).is_ready() {
+            return Poll::Ready(false);
+        }
+        Poll::Pending
+    })
+    .await
+}
