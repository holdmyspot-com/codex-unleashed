+struct InMemoryToolCatalog;
+
+impl HttpClient for InMemoryToolCatalog {
+    fn http_request(
+        &self,
+        _params: HttpRequestParams,
+    ) -> BoxFuture<'_, Result<HttpRequestResponse, ExecServerError>> {
+        panic!("the MCP adapter must request a streaming response");
+    }
+
+    fn http_request_stream(
+        &self,
+        _params: HttpRequestParams,
+    ) -> BoxFuture<'_, Result<(HttpRequestResponse, HttpResponseBodyStream), ExecServerError>> {
+        Box::pin(async {
+            let mut body =
+                br#"{"jsonrpc":"2.0","id":1,"result":{"resultType":"complete","tools":[]}}"#
+                    .to_vec();
+            body.resize(MAX_MCP_STDIO_LINE_BYTES + 1, b' ');
+            let response = HttpRequestResponse {
+                status: 200,
+                headers: vec![HttpHeader {
+                    name: "content-type".to_string(),
+                    value: "application/json".to_string(),
+                    value_env_var: None,
+                }],
+                body: Vec::new().into(),
+            };
+            Ok((response, HttpResponseBodyStream::from_chunks(vec![body])))
+        })
+    }
+}
+
+#[tokio::test]
+async fn modern_tool_catalog_applies_configured_response_cap() -> anyhow::Result<()> {
+    let client = StreamableHttpClientAdapter::new(
+        Arc::new(InMemoryToolCatalog),
+        HeaderMap::new(),
+        /*auth_provider*/ None,
+        /*has_configured_headers*/ false,
+        StreamableHttpRedirectMode::Legacy,
+        Arc::default(),
+    );
+    let message = serde_json::from_value(json!({
+        "jsonrpc": "2.0",
+        "id": 1,
+        "method": "tools/list",
+    }))?;
+    let headers = [(
+        HeaderName::from_bytes(HEADER_MCP_PROTOCOL_VERSION.as_bytes())?,
+        HeaderValue::from_str(ProtocolVersion::V_2026_07_28.as_str())?,
+    )]
+    .into();
+    let result = client
+        .post_message(
+            Arc::from("https://mcp.example.com/mcp"),
+            message,
+            /*session_id*/ None,
+            /*auth_token*/ None,
+            headers,
+        )
+        .await;
+
+    assert!(matches!(
+        result,
+        Err(StreamableHttpError::Client(
+            StreamableHttpClientAdapterError::ResponseTooLarge {
+                maximum_bytes: MAX_MCP_STDIO_LINE_BYTES,
+            }
+        ))
+    ));
+    Ok(())
+}
