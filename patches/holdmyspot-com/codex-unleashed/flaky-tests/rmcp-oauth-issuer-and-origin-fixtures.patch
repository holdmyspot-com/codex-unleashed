+#[test]
+fn issuer_bound_oauth_metadata_requires_an_explicit_issuer() -> Result<()> {
+    let mut metadata: AuthorizationMetadata = serde_json::from_value(json!({
+        "authorization_endpoint": "https://login.example.com/authorize",
+        "token_endpoint": "https://login.example.com/token",
+        "authorization_response_iss_parameter_supported": true,
+    }))?;
+
+    let error = validate_authorization_server_endpoints(&metadata)
+        .expect_err("issuer-bound callbacks require an issuer");
+    assert_eq!(
+        error.to_string(),
+        "OAuth issuer-bound callbacks require an authorization server issuer"
+    );
+
+    metadata.issuer = Some("https://login.example.com/tenant".to_string());
+    validate_authorization_server_endpoints(&metadata)
+}
+
+#[test]
+fn issuerless_oauth_metadata_requires_one_endpoint_origin() -> Result<()> {
+    let mut metadata: AuthorizationMetadata = serde_json::from_value(json!({
+        "authorization_endpoint": "https://login.example.com/authorize",
+        "token_endpoint": "https://login.example.com:443/token",
+    }))?;
+    validate_authorization_server_endpoints(&metadata)?;
+
+    metadata.token_endpoint = "https://login.example.com:8443/token".to_string();
+    let error = validate_authorization_server_endpoints(&metadata)
+        .expect_err("a different port changes the origin");
+    assert_eq!(
+        error.to_string(),
+        "OAuth token endpoint origin does not match the authorization server origin without issuer-bound callbacks"
+    );
+    Ok(())
+}
+
