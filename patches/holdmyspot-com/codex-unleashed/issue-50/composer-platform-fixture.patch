             draft: DraftState::new(),
             popups: PopupState::default(),
             app_event_tx,
@@ -3844,14 +3848,18 @@ impl ChatComposer {
     fn footer_props(&self) -> FooterProps {
         let mode = self.footer_mode();
         let is_wsl = {
-            #[cfg(target_os = "linux")]
+            #[cfg(all(target_os = "linux", not(test)))]
             {
                 mode == FooterMode::ShortcutOverlay && crate::clipboard_paste::is_probably_wsl()
             }
-            #[cfg(not(target_os = "linux"))]
+            #[cfg(all(not(target_os = "linux"), not(test)))]
             {
                 false
             }
+            #[cfg(test)]
+            {
+                mode == FooterMode::ShortcutOverlay && self.is_wsl
+            }
         };
 
         FooterProps {
@@ -5106,6 +5114,23 @@ mod tests {
         )
     }
 
+    #[test]
+    fn shortcut_overlay_paste_hint_uses_fixture_platform() {
+        let (mut composer, _rx) = new_test_composer();
+        composer.footer.mode = FooterMode::ShortcutOverlay;
+
+        for (is_wsl, expected_hint) in [(false, "ctrl+v"), (true, "ctrl+⌥v")] {
+            composer.is_wsl = is_wsl;
+            let lines = crate::bottom_pane::shortcut_overlay::lines(&composer.footer_props(), 120);
+            let paste_line = lines
+                .iter()
+                .map(ToString::to_string)
+                .find(|line| line.contains("Paste image"))
+                .expect("shows the paste image shortcut");
+            assert!(paste_line.contains(expected_hint), "{paste_line}");
+        }
+    }
+
