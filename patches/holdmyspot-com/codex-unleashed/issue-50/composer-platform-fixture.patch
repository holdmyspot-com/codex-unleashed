+    #[test]
+    fn shortcut_overlay_paste_hint_uses_fixture_platform() {
+        let (mut composer, _rx) = new_test_composer();
+        composer.footer.mode = FooterMode::ShortcutOverlay;
+
+        for (is_wsl, expected_hint) in [(false, "⌃v"), (true, "⌃⌥v")] {
+            composer.is_wsl = is_wsl;
+            let lines = crate::bottom_pane::shortcut_overlay::lines(
+                &composer.footer_props(),
+                /*width*/ 120,
+            );
+            let paste_line = lines
+                .iter()
+                .map(ToString::to_string)
+                .find(|line| line.contains("Paste image"))
+                .expect("shows the paste image shortcut");
+            assert!(paste_line.contains(expected_hint), "{paste_line}");
+        }
+    }
