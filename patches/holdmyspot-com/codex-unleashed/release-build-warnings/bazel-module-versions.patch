From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Sat, 7 Nov 2026 23:26:22 -0500
Subject: [PATCH 24/54] Require the platforms and rules_cc versions Bazel
 already resolves

Other modules require platforms 1.1.0 and rules_cc 0.2.20, so Bazel warns
that the root module asks for older versions than it gets. Raise the root
requirements to match; the resolved graph is unchanged.
---
 MODULE.bazel      | 4 ++--
 MODULE.bazel.lock | 2 --
 2 files changed, 2 insertions(+), 4 deletions(-)

diff --git a/MODULE.bazel b/MODULE.bazel
index 1d00dc3..22e185c 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -2,7 +2,7 @@ module(name = "codex")
 
 bazel_dep(name = "bazel_lib", version = "3.2.2")
 bazel_dep(name = "bazel_skylib", version = "1.9.0")
-bazel_dep(name = "platforms", version = "1.0.0")
+bazel_dep(name = "platforms", version = "1.1.0")
 
 # Expose the public protobuf rules already used transitively by rules_rs.
 bazel_dep(name = "protobuf", version = "34.0.bcr.1", repo_name = "com_google_protobuf")
@@ -145,7 +145,7 @@ use_repo(osx, "macos_sdk")
 
 # Needed to disable xcode...
 bazel_dep(name = "apple_support", version = "2.1.0")
-bazel_dep(name = "rules_cc", version = "0.2.18")
+bazel_dep(name = "rules_cc", version = "0.2.20")
 
 # Windows voice jobs explicitly select the installed MSVC C toolchains.
 cc_configure = use_extension("@rules_cc//cc:extensions.bzl", "cc_configure_extension")
diff --git a/MODULE.bazel.lock b/MODULE.bazel.lock
index 223f3dc..8fde4a2 100644
--- a/MODULE.bazel.lock
+++ b/MODULE.bazel.lock
@@ -48,7 +48,6 @@
