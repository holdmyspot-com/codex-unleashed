From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Wed, 11 Nov 2026 08:45:00 -0500
Subject: [PATCH] bugfix: drop cargo-deny entries that no longer match any
 crate

cargo-deny warned about deny.toml entries that match nothing in the
lockfile. The lockfile now holds zstd 0.13.4 and 0.14.3 and zstd-safe 7.4.1
and 8.2.0, all patched for the three advisories whose exceptions remain
(RUSTSEC-2026-0391, -0398 and -0403). aws-lc-sys 0.45.0 does not declare the
OpenSSL license, and sentry 0.49.5 no longer depends on reqwest directly.
The webrtc-sys-build wrapper and the juberti-oai/rust-sdks source match
nothing in the lockfile. The hickory-proto async-trait wrapper stays: the
network proxy still uses rama 0.3, which keeps hickory-proto 0.25.2. Every
remaining check is unchanged.
---
 codex-rs/deny.toml | 10 ----------
 1 file changed, 10 deletions(-)

diff --git a/codex-rs/deny.toml b/codex-rs/deny.toml
index 0c4abed54e..a91e78bfe7 100644
--- a/codex-rs/deny.toml
+++ b/codex-rs/deny.toml
@@ -104,10 +104,6 @@ ignore = [
     # Reviewed 2026-10-20.
     { id = "RUSTSEC-2026-0374", reason = "basic-toml 0.1.10 is unmaintained; pulled in via i18n-config/i18n-embed-fl under age 0.12.1 used by codex-secrets; no patched release; remove when age's localization dependencies migrate off basic-toml" },
     { id = "RUSTSEC-2026-0387", reason = "crypto-bigint 0.5.5 via elliptic-curve 0.13.8 is used by age, AWS login, user verification, and WebRTC; timing leakage can affect private-key or session-secret operations; remove when these dependency paths use crypto-bigint >=0.7.6" },
-    # Reviewed 2026-10-26.
-    { id = "RUSTSEC-2026-0391", reason = "Codex, tonic and zip use zstd 0.13.3 without reusing borrowed contexts across streams. Remove when all paths use zstd >=0.14.3." },
-    { id = "RUSTSEC-2026-0398", reason = "zstd 0.13.3 pulls in zstd-safe 7.2.4 with the affected seekable feature disabled. Remove when all paths use zstd-safe >=8.2.0." },
-    { id = "RUSTSEC-2026-0403", reason = "zstd 0.13.3 pulls in zstd-safe 7.2.4. Codex, tonic and zip use read decoders or initialized output buffers and discard output on error. Remove when all paths use zstd-safe >=8.2.0." },
     # Reviewed 2026-11-05.
     { id = "RUSTSEC-2026-0441", reason = "pin-utils 0.1.0 is unmaintained; pulled in via aws-smithy-http/aws-smithy-runtime/aws-smithy-types and loom under tokio-graceful; no patched release; remove when these dependency paths drop pin-utils" },
     # Reviewed 2026-11-17.
@@ -163,9 +159,6 @@ allow = [
     # MPL-2.0 - https://www.mozilla.org/MPL/2.0/
     # Used by: nucleo-matcher
     "MPL-2.0",
-    # OpenSSL - https://spdx.org/licenses/OpenSSL.html
-    # Used by: aws-lc-sys
-    "OpenSSL",
     # Unicode-3.0 - https://opensource.org/license/unicode
     # Used by: icu_decimal, icu_locale_core, icu_provider
     "Unicode-3.0",
@@ -285,8 +278,6 @@ deny = [
         "opentelemetry-http",
         "opentelemetry-otlp",
         "rmcp",
-        "sentry",
-        "webrtc-sys-build",
     ], reason = "new direct reqwest dependencies must use codex-http-client; temporary wrappers track migration debt" },
 ]
 
@@ -348,7 +339,6 @@ allow-git = [
     "https://github.com/helix-editor/nucleo.git",
     # CONNECT request handling needs this pinned H3 revision until released.
     "https://github.com/hyperium/h3",
-    "https://github.com/juberti-oai/rust-sdks.git",
     "https://github.com/microsoft/mxc",
     "https://github.com/modelcontextprotocol/rust-sdk",
     "https://github.com/openai-oss-forks/crossterm",
-- 
