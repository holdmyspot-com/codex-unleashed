+#[tokio::test]
+async fn startup_skills_refresh_avoids_blocking_duplicate_and_preserves_later_refreshes()
+-> Result<()> {
+    for same_cwd in [true, false] {
+        let (mut app, mut events) = make_startup_skills_app().await;
+        let mut server = start_config_write_test_app_server(&app).await?;
+        app.refresh_startup_skills(&server);
+        let cwd = if same_cwd {
+            app.config.cwd.to_path_buf()
+        } else {
+            app.config.cwd.join("different").to_path_buf()
+        };
+        let session = test_thread_session(ThreadId::new(), cwd.clone());
+        app.enqueue_primary_thread_session(session.clone(), Vec::new())
+            .await?;
+        let mut refreshes = Vec::new();
+        while let Ok(event) = events.try_recv() {
+            if let AppEvent::CodexOp(AppCommand::ListSkills { cwds, force_reload }) = event {
+                refreshes.push((cwds, force_reload));
+            }
+        }
+        assert_eq!(
+            refreshes,
+            if same_cwd {
+                Vec::new()
+            } else {
+                vec![(vec![cwd.clone()], true)]
+            }
+        );
+
+        // A subsequent configuration still requests fresh metadata, even in the same directory.
+        app.chat_widget.handle_thread_session_quiet(session);
+        let refresh = std::iter::from_fn(|| events.try_recv().ok()).find_map(|event| match event {
+            AppEvent::CodexOp(AppCommand::ListSkills { cwds, force_reload }) => {
+                Some((cwds, force_reload))
+            }
+            _ => None,
+        });
+        assert_eq!(refresh, Some((vec![cwd.clone()], true)));
+
+        app.app_event_tx.list_skills(vec![cwd.clone()], true);
+        let explicit_refresh =
+            std::iter::from_fn(|| events.try_recv().ok()).find_map(|event| match event {
+                AppEvent::CodexOp(AppCommand::ListSkills { cwds, force_reload }) => {
+                    Some((cwds, force_reload))
+                }
+                _ => None,
+            });
+        assert_eq!(explicit_refresh, Some((vec![cwd], true)));
+
+        if same_cwd {
+            let mut tui = crate::tui::test_support::make_test_tui()?;
+            // A failed background response still reaches the existing user-visible error handler.
+            app.handle_event(
+                &mut tui,
+                &mut server,
+                AppEvent::SkillsListLoaded {
+                    cwd: app.config.cwd.to_path_buf(),
+                    result: Err("startup request failed".into()),
+                },
+            )
+            .await?;
+            let errors = std::iter::from_fn(|| events.try_recv().ok())
+                .filter_map(|event| match event {
+                    AppEvent::InsertHistoryCell(cell) => {
+                        Some(lines_to_single_string(&cell.transcript_lines(80)))
+                    }
+                    _ => None,
+                })
+                .collect::<String>();
+            assert!(errors.contains("failed to load skills on startup: startup request failed"));
+            assert!(app.skill_load_warnings.startup_complete);
+        }
+        server.shutdown().await?;
+    }
+    Ok(())
+}
+
+async fn make_startup_skills_app() -> (Box<App>, tokio::sync::mpsc::UnboundedReceiver<AppEvent>) {
+    let (mut app, events, _ops) = make_test_app_with_channels().await;
+    let replacement = ChatWidget::new_with_app_event(ChatWidgetInit {
+        requires_openai_auth: true,
+        local_settings: crate::local_settings::LocalSettings::from(&app.config),
+        config: app.config.clone(),
+        frame_requester: crate::tui::FrameRequester::test_dummy(),
+        app_event_tx: app.app_event_tx.clone(),
+        workspace_command_runner: None,
+        initial_user_message: None,
+        enhanced_keys_supported: app.enhanced_keys_supported,
+        has_chatgpt_account: app.chat_widget.has_chatgpt_account(),
+        has_codex_backend_auth: app.chat_widget.has_codex_backend_auth(),
+        model_catalog: app.model_catalog.clone(),
+        feedback: app.feedback.clone(),
+        is_first_run: false,
+        status_account_display: app.chat_widget.status_account_display().cloned(),
+        initial_plan_type: app.chat_widget.current_plan_type(),
+        model: Some(app.chat_widget.current_model().to_string()),
+        startup_tooltip_override: None,
+        status_line_invalid_items_warned: app.status_line_invalid_items_warned.clone(),
+        terminal_title_invalid_items_warned: app.terminal_title_invalid_items_warned.clone(),
+        session_telemetry: app.session_telemetry.clone(),
+    });
+    app.replace_chat_widget(replacement);
+
+    (app, events)
+}
+
+#[tokio::test]
+async fn startup_skills_refresh_preserves_metadata_before_or_after_session_configuration()
+-> Result<()> {
+    for metadata_first in [true, false] {
+        let (mut app, _events) = make_startup_skills_app().await;
+        let mut server = start_config_write_test_app_server(&app).await?;
+        let mut tui = crate::tui::test_support::make_test_tui()?;
+        app.refresh_startup_skills(&server);
+        let cwd = app.config.cwd.to_path_buf();
+        let response = SkillsListResponse {
+            data: vec![codex_app_server_protocol::SkillsListEntry {
+                cwd: cwd.clone(),
+                skills: vec![codex_app_server_protocol::SkillMetadata {
+                    name: "startup-skill".into(),
+                    description: "Startup metadata".into(),
+                    short_description: None,
+                    interface: None,
+                    dependencies: None,
+                    path: app.config.cwd.join("SKILL.md"),
+                    scope: crate::test_support::skill_scope_user(),
+                    enabled: true,
+                    plugin_id: None,
+                }],
+                errors: Vec::new(),
+            }],
+        };
+        for deliver_metadata in [metadata_first, !metadata_first] {
+            if deliver_metadata {
+                app.handle_event(
+                    &mut tui,
+                    &mut server,
+                    AppEvent::SkillsListLoaded {
+                        cwd: cwd.clone(),
+                        result: Ok(response.clone()),
+                    },
+                )
+                .await?;
+            } else {
+                app.enqueue_primary_thread_session(
+                    test_thread_session(ThreadId::new(), cwd.clone()),
+                    Vec::new(),
+                )
+                .await?;
+            }
+        }
+        app.chat_widget.open_skills_list();
+        assert!(render_bottom_popup(&app.chat_widget, 80).contains("startup-skill"));
+        server.shutdown().await?;
+    }
+    Ok(())
+}
