+#[tokio::test]
+async fn cold_resume_refreshes_skill_metadata_after_watches_are_ready() -> Result<()> {
+    skip_if_remote!(
+        Ok(()),
+        "host-local skill watching requires a local executor"
+    );
+    let server = create_mock_responses_server_repeating_assistant("Done").await;
+    let codex_home = TempDir::new()?;
+    MockResponsesConfig::new(&server.uri()).write(codex_home.path())?;
+    write_skill(&codex_home, "demo")?;
+    let mut mcp = TestAppServer::builder()
+        .with_codex_home(codex_home.path())
+        .build_initialized_with_timeout(DEFAULT_TIMEOUT)
+        .await?;
+    let request = mcp
+        .send_thread_start_request_with_auto_env(ThreadStartParams::default())
+        .await?;
+    let started: ThreadStartResponse =
+        timeout(DEFAULT_TIMEOUT, mcp.read_response(request)).await??;
+    mcp.start_turn_and_wait_for_completion(TurnStartParams {
+        thread_id: started.thread.id.clone(),
+        input: vec![UserInput::Text {
+            text: "Persist the session".to_string(),
+            text_elements: Vec::new(),
+        }],
+        ..Default::default()
+    })
+    .await?;
+    // Restart the app server so resume creates a new listener and watch registration.
+    drop(mcp);
+    let mut mcp = TestAppServer::builder()
+        .with_codex_home(codex_home.path())
+        .build_initialized_with_timeout(DEFAULT_TIMEOUT)
+        .await?;
+    let request = mcp
+        .send_thread_resume_request(ThreadResumeParams {
+            thread_id: started.thread.id,
+            exclude_turns: true,
+            ..Default::default()
+        })
+        .await?;
+    let _: ThreadResumeResponse = timeout(DEFAULT_TIMEOUT, mcp.read_response(request)).await??;
+    // This refresh closes the interval in which filesystem changes precede watch installation.
+    expect_skills_changed_notification(&mut mcp, WATCHER_TIMEOUT).await?;
+    std::fs::write(
+        codex_home.path().join("skills/demo/SKILL.md"),
+        "---\nname: demo\ndescription: updated\n---\n\n# Updated\n",
+    )?;
+    expect_skills_changed_notification(&mut mcp, WATCHER_TIMEOUT).await?;
+    let request = mcp
+        .send_skills_list_request(SkillsListParams {
+            cwds: vec![codex_home.path().to_path_buf()],
+            force_reload: false,
+        })
+        .await?;
+    let skills: SkillsListResponse = timeout(DEFAULT_TIMEOUT, mcp.read_response(request)).await??;
+    assert!(
+        skills.data[0]
+            .skills
+            .iter()
+            .any(|skill| skill.name == "demo" && skill.description == "updated")
+    );
+    Ok(())
+}
