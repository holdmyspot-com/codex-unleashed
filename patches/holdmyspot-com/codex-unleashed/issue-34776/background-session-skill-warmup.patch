+    let subscriber = tracing_subscriber::registry().with(calls.clone());
+    session
+        .record_initial_history(InitialHistory::Resumed(ResumedHistory {
+            conversation_id: ThreadId::default(),
+            history: Arc::new(Vec::new()),
+            history_revision: None,
