+async fn measure_switch_back_with_compactions(
+    conversation_count: usize,
+    fast_switching_enabled: bool,
+) -> Result<(Duration, bool)> {
+    let (mut app, mut app_events, _ops) = make_test_app_with_channels().await;
+    if !fast_switching_enabled {
