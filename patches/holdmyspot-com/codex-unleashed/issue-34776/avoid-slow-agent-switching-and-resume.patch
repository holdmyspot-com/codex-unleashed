+            AppEvent::InsertHistoryCell(cell) => Some(cell.display_lines(/*width*/ 80)),
+            _ => None,
+        })
+        .map(|lines| lines_to_single_string(&lines))
+        .collect::<String>();
+    assert!(rendered.contains(&format!("conversation-{conversation_count}")));
+    let renders_older_conversation = rendered.contains("conversation-0")
