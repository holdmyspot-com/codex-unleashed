+                text: format!("conversation-{index} {conversation_text}"),
+                text_elements: Vec::new(),
+            }],
+        }],
+        status: codex_app_server_protocol::TurnStatus::Completed,
+        error: None,
+        started_at: None,
+        completed_at: None,
+        duration_ms: None,
+    };
+    let compaction = |index: usize| codex_app_server_protocol::Turn {
+        id: format!("compaction-turn-{index}"),
+        items_view: codex_app_server_protocol::TurnItemsView::Full,
+        items: vec![codex_app_server_protocol::ThreadItem::ContextCompaction {
+            id: format!("compaction-{index}"),
+        }],
+        status: codex_app_server_protocol::TurnStatus::Completed,
+        error: None,
+        started_at: None,
+        completed_at: None,
+        duration_ms: None,
+    };
+    let mut turns = Vec::new();
+    for index in 0..conversation_count {
+        turns.push(conversation(index));
+        turns.push(compaction(index));
+    }
+    turns.push(conversation(conversation_count));
+    app.thread_event_channels[&root_thread_id]
+        .store
+        .lock()
+        .await
+        .set_turns(turns);
+
+    app.agent_navigation.upsert(
+        child_thread_id,
+        Some("worker".to_string()),
+        Some("worker".to_string()),
