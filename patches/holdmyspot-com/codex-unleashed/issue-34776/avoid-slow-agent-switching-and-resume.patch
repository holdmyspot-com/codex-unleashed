+#[test]
+fn switching_back_replays_only_latest_compacted_conversation() -> Result<()> {
+    const TEST_STACK_SIZE_BYTES: usize = 8 * 1024 * 1024;
+    std::thread::Builder::new()
+        .stack_size(TEST_STACK_SIZE_BYTES)
+        .spawn(|| {
+            let runtime = tokio::runtime::Builder::new_multi_thread()
+                .worker_threads(1)
+                .thread_stack_size(TEST_STACK_SIZE_BYTES)
+                .enable_all()
+                .build()?;
+            runtime.block_on(async {
+                let (one_window, _) =
+                    measure_switch_back_with_compactions(
+                        /*conversation_count*/ 1,
+                        /*fast_switching_enabled*/ true,
+                    )
+                    .await?;
+                let (fifty_windows, renders_older_conversation) =
+                    measure_switch_back_with_compactions(
+                        /*conversation_count*/ 50,
+                        /*fast_switching_enabled*/ true,
+                    )
+                    .await?;
+                assert!(
+                    !renders_older_conversation,
+                    "switching back with fifty compacted windows rendered an older conversation"
+                );
+                assert!(
+                    fifty_windows <= one_window + Duration::from_secs(1),
+                    "switching scaled with compacted history: one window took {one_window:?}, fifty took {fifty_windows:?}"
+                );
+                assert!(
+                    fifty_windows < Duration::from_secs(3),
+                    "switching back to the main agent with fifty compacted windows took {fifty_windows:?}"
+                );
+                let (_, renders_older_conversation_when_disabled) =
+                    measure_switch_back_with_compactions(
+                        /*conversation_count*/ 1,
+                        /*fast_switching_enabled*/ false,
+                    )
+                    .await?;
+                assert!(
+                    renders_older_conversation_when_disabled,
+                    "disabling fast switching should replay the full conversation"
+                );
+                Ok(())
+            })
+        })
+        .map_err(|err| color_eyre::eyre::eyre!("failed to start test thread: {err}"))?
+        .join()
+        .map_err(|_| color_eyre::eyre::eyre!("test thread panicked"))?
+}
