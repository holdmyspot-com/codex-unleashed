     pub(super) fn snapshot(&self) -> ThreadEventSnapshot {
+        self.snapshot_with_turns(self.turns.clone())
+    }
+
+    pub(super) fn snapshot_for_agent_switch(&self) -> ThreadEventSnapshot {
+        let first_latest_conversation_turn = self
+            .turns
+            .iter()
+            .rposition(|turn| {
+                turn.items
+                    .iter()
+                    .any(|item| matches!(item, ThreadItem::ContextCompaction { .. }))
+            })
+            .map(|index| index + 1)
+            .unwrap_or(0);
+        self.snapshot_with_turns(self.turns[first_latest_conversation_turn..].to_vec())
+    }
+
+    fn snapshot_with_turns(&self, turns: Vec<Turn>) -> ThreadEventSnapshot {
         let mut snapshot = ThreadEventSnapshot {
             session: self.session.clone(),
             delegated_turns: self.delegated_turns.iter().cloned().collect(),
-            turns: self.turns.clone(),
+            turns,
             // Thread switches replay buffered events into a rebuilt ChatWidget. Only replay
             // interactive prompts that are still pending, or answered approvals/input will reappear.
             events: self
diff --git a/codex-rs/tui/src/app/thread_routing.rs b/codex-rs/tui/src/app/thread_routing.rs
index a3501c3..b874987 100644
--- a/codex-rs/tui/src/app/thread_routing.rs
+++ b/codex-rs/tui/src/app/thread_routing.rs
@@ -121,12 +121,23 @@ impl App {
     pub(super) async fn activate_thread_for_replay(
         &mut self,
         thread_id: ThreadId,
+        snapshot_mode: ThreadEventSnapshotMode,
     ) -> Option<(mpsc::Receiver<ThreadBufferedEvent>, ThreadEventSnapshot)> {
+        let replay_latest_compacted_conversation = snapshot_mode
+            == ThreadEventSnapshotMode::AgentSwitch
+            && self
+                .config
+                .features
+                .enabled(codex_features::Feature::UnleashedAgentFastSwitching);
         let channel = self.thread_event_channels.get_mut(&thread_id)?;
         let receiver = channel.receiver.take()?;
         let mut store = channel.store.lock().await;
         store.active = true;
-        let snapshot = store.snapshot();
+        let snapshot = if replay_latest_compacted_conversation {
+            store.snapshot_for_agent_switch()
+        } else {
+            store.snapshot()
+        };
         Some((receiver, snapshot))
     }
 
