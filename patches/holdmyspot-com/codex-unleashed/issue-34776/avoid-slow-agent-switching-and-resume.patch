+            crate::app_server_session::ResumeModelSettings::RestoreFromThread,
+        )
+        .await?;
+    app.enqueue_primary_thread_session(root.session, root.turns)
+        .await?;
+
+    const CONTEXT_WINDOW_TOKENS: usize = 27_200;
+    let conversation_text = "history ".repeat(CONTEXT_WINDOW_TOKENS);
+    let conversation = |index: usize| codex_app_server_protocol::Turn {
+        id: format!("turn-{index}"),
+        items_view: codex_app_server_protocol::TurnItemsView::Full,
+        items: vec![codex_app_server_protocol::ThreadItem::UserMessage {
+            id: format!("user-{index}"),
