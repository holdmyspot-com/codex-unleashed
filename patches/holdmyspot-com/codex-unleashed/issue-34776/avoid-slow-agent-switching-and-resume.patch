+#[tokio::test]
+async fn replay_plain_assistant_messages_with_many_writable_roots_stays_responsive() {
+    let (mut chat, mut rx, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    let workspace = tempfile::tempdir().expect("temporary writable roots");
+    let mut entries = vec![FileSystemSandboxEntry {
+        path: FileSystemPath::Special {
+            value: FileSystemSpecialPath::Root,
+        },
+        access: FileSystemAccessMode::Read,
+        missing_path_behavior: None,
+    }];
+    for index in 0..64 {
+        let root = workspace.path().join(format!("root-{index}"));
+        std::fs::create_dir(&root).expect("create writable root");
+        entries.push(FileSystemSandboxEntry {
+            path: FileSystemPath::Path {
+                path: codex_utils_absolute_path::AbsolutePathBuf::from_absolute_path(root)
+                    .expect("absolute writable root")
+                    .into(),
+            },
+            access: FileSystemAccessMode::Write,
+            missing_path_behavior: None,
+        });
+    }
+    chat.config
+        .permissions
+        .set_permission_profile(PermissionProfile::Managed {
+            network: NetworkSandboxPolicy::Restricted,
+            file_system: ManagedFileSystemPermissions::Restricted {
+                entries,
+                glob_scan_max_depth: None,
+            },
+        })
+        .expect("set permission profile");
+    chat.thread_id = Some(ThreadId::new());
+
+    let started = std::time::Instant::now();
+    for index in 0..32 {
+        replay_agent_message(
+            &mut chat,
+            &format!("assistant-{index}"),
+            format!("Retained assistant message {index}."),
+            ReplayKind::ResumeInitialMessages,
+        );
+    }
+    let elapsed = started.elapsed();
+    let rendered = drain_insert_history(&mut rx)
+        .iter()
+        .map(|lines| lines_to_single_string(lines))
+        .collect::<String>();
+    for index in 0..32 {
+        assert!(rendered.contains(&format!("Retained assistant message {index}.")));
+    }
+    assert!(
+        elapsed < std::time::Duration::from_secs(/*secs*/ 3),
+        "plain assistant history replay took {elapsed:?} with many writable roots"
+    );
+}
