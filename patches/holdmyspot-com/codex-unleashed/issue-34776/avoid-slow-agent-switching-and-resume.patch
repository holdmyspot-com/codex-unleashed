+#[tokio::test]
+async fn markdown_context_keeps_visualization_links_and_rechecks_permissions() {
+    use crate::legacy_core::config::ConfigBuilder;
+    use crate::legacy_core::config::ConfigOverrides;
+    use codex_config::LoaderOverrides;
+    use codex_protocol::models::PermissionProfile;
+    use codex_protocol::permissions::NetworkSandboxPolicy;
+    use codex_utils_absolute_path::AbsolutePathBuf;
+
+    let codex_home = tempfile::tempdir().expect("temporary codex home");
+    let mut config = ConfigBuilder::default()
+        .codex_home(codex_home.path().to_path_buf())
+        .loader_overrides(LoaderOverrides::without_managed_config_for_tests())
+        .harness_overrides(ConfigOverrides {
+            cwd: Some(codex_home.path().to_path_buf()),
+            ..ConfigOverrides::default()
+        })
+        .build()
+        .await
+        .expect("isolated config");
+    config
+        .permissions
+        .set_permission_profile(PermissionProfile::read_only())
+        .expect("read-only permissions");
+    let thread_id = ThreadId::new();
+    assert!(
+        InlineVisualizationContext::from_config_for_markdown(&config, thread_id, "Plain answer")
+            .is_none()
+    );
+    let markdown = "::codex-inline-vis{file=\"chart.html\"}";
+    let context =
+        InlineVisualizationContext::from_config_for_markdown(&config, thread_id, markdown)
+            .expect("visualization context");
+    fs::create_dir_all(&context.thread_dir).expect("visualization directory");
+    fs::write(context.thread_dir.join("chart.html"), "<div>chart</div>").expect("fragment");
+    assert_eq!(
+        rewrite_inline_visualizations(markdown, Some(&context))
+            .trusted_file_links
+            .len(),
+        1
+    );
+
+    let writable_home =
+        AbsolutePathBuf::from_absolute_path(codex_home.path()).expect("absolute codex home");
+    config
+        .permissions
+        .set_permission_profile(PermissionProfile::workspace_write_with(
+            &[writable_home],
+            NetworkSandboxPolicy::Restricted,
+            /*exclude_tmpdir_env_var*/ true,
+            /*exclude_slash_tmp*/ true,
+        ))
+        .expect("writable viewer cache permissions");
+    assert!(
+        InlineVisualizationContext::from_config_for_markdown(&config, thread_id, markdown)
+            .is_none()
+    );
+}
