+#[tokio::test]
+async fn initial_resume_keeps_compacted_history_when_fast_switching_is_enabled() {
+    let (mut chat, mut rx, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    let conversation = |index: usize| AppServerTurn {
+        items: vec![AppServerThreadItem::UserMessage {
+            id: format!("user-{index}"),
+            client_id: None,
+            content: vec![AppServerUserInput::Text {
+                text: format!("conversation-{index}"),
+                text_elements: Vec::new(),
+            }],
+        }],
+        ..app_server_turn(
+            &format!("turn-{index}"),
+            AppServerTurnStatus::Completed,
+            /*duration_ms*/ None,
+            /*error*/ None,
+        )
+    };
+    let compaction = AppServerTurn {
+        items: vec![AppServerThreadItem::ContextCompaction {
+            id: "compaction-0".to_string(),
+        }],
+        ..app_server_turn(
+            "compaction-turn-0",
+            AppServerTurnStatus::Completed,
+            /*duration_ms*/ None,
+            /*error*/ None,
+        )
+    };
+
+    chat.replay_thread_turns(
+        vec![conversation(0), compaction, conversation(1)],
+        ReplayKind::ResumeInitialMessages,
+    );
+
+    let rendered = drain_insert_history(&mut rx)
+        .into_iter()
+        .map(|lines| lines_to_single_string(&lines))
+        .collect::<String>();
+    assert!(rendered.contains("conversation-0"));
+    assert!(rendered.contains("conversation-1"));
+}
