From 1f8ad35884f8f6761884252bdae7782370a933eb Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Fri, 23 Oct 2026 02:55:42 -0400
Subject: [PATCH] test: control the native TLS client used by fallback
 regressions

The fallback tests require an initial native-TLS client. Construct that client explicitly so an inherited custom CA configuration cannot select rustls before the behavior under test. Production custom-CA policy is unchanged.

Prerequisite: issue-71 latest-stable-dependencies.patch and its documented release-queue prerequisites on rust-v0.163.0 (83086188ae0614bd882818ff1aa23f3194962012). This helper uses the upgraded reqwest 0.13 API.

Authoring reproduction: the focused seven TLS fallback tests fail five cases with inherited SSL_CERT_FILE; after this fixture correction the same seven pass. All 115 codex-http-client library tests also pass. Emitted-patch replay remains a separate required check.
---
 .../src/route_aware_tls_fallback_tests.rs     | 63 +++++++++----------
 1 file changed, 29 insertions(+), 34 deletions(-)

diff --git a/codex-rs/http-client/src/route_aware_tls_fallback_tests.rs b/codex-rs/http-client/src/route_aware_tls_fallback_tests.rs
index c350323..ecc1d14 100644
--- a/codex-rs/http-client/src/route_aware_tls_fallback_tests.rs
+++ b/codex-rs/http-client/src/route_aware_tls_fallback_tests.rs
@@ -35,15 +35,34 @@ type SuccessfulTlsFallbackServer = (
     mpsc::Receiver<io::Result<Vec<String>>>,
 );

+fn create_native_tls_pool() -> RouteAwareClientPool {
+    let pool = RouteAwareClientPool::new(
+        HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+        ClientRouteClass::Other,
+    );
+    let client = reqwest::Client::builder()
+        .tls_backend_native()
+        .no_proxy()
+        .redirect(reqwest::redirect::Policy::none())
+        .build()
+        .expect("native TLS test client should build");
+
+    pool.clients
+        .lock()
+        .expect("native TLS client cache should not be poisoned")
+        .insert(
+            OutboundProxyRoute::Direct,
+            TransportClient::new(client, RequestLogging::Enabled, http::HeaderMap::new()),
+        );
+    pool
+}
+
