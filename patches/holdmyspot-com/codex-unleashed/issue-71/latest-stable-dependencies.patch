+diff --git a/util/process_wrapper/main.rs b/util/process_wrapper/main.rs
+--- a/util/process_wrapper/main.rs
++++ b/util/process_wrapper/main.rs
+@@ -358,6 +358,32 @@ fn contains_byte_sequence(reader: &mut impl io::Read, needle: &[u8]) -> io::Resu
+     }
+ }
+
++/// Describes the first occurrence of `needle` in `contents` by its offset and the printable string around it, so a
++/// rejected output names the embedded value rather than only the directory it contains.
++fn working_dir_context(contents: &[u8], needle: &[u8]) -> Option<String> {
++    const LIMIT: usize = 256;
++    if needle.is_empty() {
++        return None;
++    }
++    let offset = contents
++        .windows(needle.len())
++        .position(|window| window == needle)?;
++    let printable = |byte: &u8| byte.is_ascii_graphic() || *byte == b' ';
++    let start = contents[..offset]
++        .iter()
++        .rev()
++        .take(LIMIT)
++        .take_while(|byte| printable(byte))
++        .count();
++    let end = contents[offset..]
++        .iter()
++        .take(LIMIT)
++        .take_while(|byte| printable(byte))
++        .count();
++    let text = String::from_utf8_lossy(&contents[offset - start..offset + end]);
++    Some(format!(" at byte offset {offset} in \"{text}\""))
++}
++
+ fn check_output_for_working_dir(
+     output_path: &str,
+     working_dir: &str,
+@@ -368,8 +394,12 @@ fn check_output_for_working_dir(
