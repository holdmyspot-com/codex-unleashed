diff --git a/codex-rs/protocol/src/schema_nullability.rs b/codex-rs/protocol/src/schema_nullability.rs
new file mode 100644
index 0000000..fc1dfe9
--- /dev/null
+++ b/codex-rs/protocol/src/schema_nullability.rs
@@ -0,0 +1,139 @@
+//! Generates JSON Schemas that describe an `Option<T>` field as `T` rather than as `T` or `null`.
+
+use schemars::Schema;
+use schemars::transform::RecursiveTransform;
+use serde_json::Value;
+
+/// Marks a schema whose `null` alternative is intentional rather than added for `Option<T>`.
+const KEEP_NULL_KEY: &str = "x-codex-keep-null";
+
+/// A schema transform that omits the `null` alternative that Schemars adds for `Option<T>`.
+///
+/// Apply it with [`schemars::generate::SchemaSettings::with_transform`]. The transform visits every subschema
+/// and removes `null` from `type` lists, `enum` lists, and `anyOf` alternatives. A schema that is
+/// left with a single `anyOf` alternative becomes that alternative. Schemas built with
+/// [`keep_null`] are left unchanged.
+pub fn omit_null_alternatives() -> RecursiveTransform<fn(&mut Schema)> {
+    RecursiveTransform(omit_null_alternatives_from_schema)
+}
+
+/// Exempts a hand-written nullable schema from [`omit_null_alternatives`].
+pub fn keep_null(mut schema: Schema) -> Schema {
+    schema.insert(KEEP_NULL_KEY.to_string(), Value::Bool(true));
+    schema
+}
+
+fn omit_null_alternatives_from_schema(schema: &mut Schema) {
+    let Some(object) = schema.as_object_mut() else {
+        return;
+    };
+    if object.remove(KEEP_NULL_KEY).is_some() {
+        return;
+    }
+
+    if let Some(Value::Array(types)) = object.get_mut("type") {
+        types.retain(|candidate| candidate != "null");
+    }
+    if matches!(object.get("type"), Some(Value::Array(types)) if types.len() == 1)
+        && let Some(Value::Array(mut types)) = object.remove("type")
+    {
+        object.insert("type".to_string(), types.remove(0));
+    }
+
+    if let Some(Value::Array(values)) = object.get_mut("enum") {
+        values.retain(|candidate| !candidate.is_null());
+    }
+
+    let has_only_alternatives = object.len() == 1;
+    let mut single_alternative = None;
+    if let Some(Value::Array(alternatives)) = object.get_mut("anyOf") {
+        alternatives.retain(|alternative| !is_null_schema(alternative));
+        if alternatives.len() == 1 && has_only_alternatives {
+            single_alternative = Some(alternatives.remove(0));
+        }
+    }
+    // A lone alternative beside annotations such as `description` keeps the
+    // `allOf` wrapper draft-07 uses so `$ref` siblings stay meaningful.
+    if single_alternative.is_none()
+        && matches!(object.get("anyOf"), Some(Value::Array(alternatives)) if alternatives.len() == 1)
+        && let Some(alternatives) = object.remove("anyOf")
+    {
+        object.insert("allOf".to_string(), alternatives);
+    }
+    if let Some(alternative) = single_alternative
+        && let Ok(alternative) = Schema::try_from(alternative)
+    {
+        *schema = alternative;
+    }
+}
+
+fn is_null_schema(value: &Value) -> bool {
+    value
+        .get("type")
+        .is_some_and(|candidate| candidate == "null")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::omit_null_alternatives;
+    use pretty_assertions::assert_eq;
+    use schemars::JsonSchema;
+    use schemars::generate::SchemaSettings;
+    use serde::Serialize;
+    use serde_json::json;
+
+    #[derive(JsonSchema, Serialize)]
+    struct Sample {
+        text: Option<String>,
+        count: Option<Inner>,
+        /// Described reference.
+        described: Option<Inner>,
+        nullable: Nullable,
+    }
+
+    #[derive(Serialize)]
+    struct Nullable(Option<String>);
+
+    impl JsonSchema for Nullable {
+        fn schema_name() -> std::borrow::Cow<'static, str> {
+            "Nullable".into()
+        }
+
+        fn inline_schema() -> bool {
+            true
+        }
+
+        fn json_schema(_generator: &mut schemars::SchemaGenerator) -> schemars::Schema {
+            super::keep_null(schemars::json_schema!({ "type": ["string", "null"] }))
+        }
+    }
+
+    #[derive(JsonSchema, Serialize)]
+    struct Inner {
+        value: u8,
+    }
+
+    #[test]
+    fn omits_null_from_optional_fields() {
+        let schema = SchemaSettings::draft07()
+            .with_transform(omit_null_alternatives())
+            .into_generator()
+            .into_root_schema_for::<Sample>();
+
+        let properties =
+            serde_json::to_value(schema).expect("schema serializes")["properties"].clone();
+
+        assert_eq!(
+            properties,
+            json!({
+                "text": {"type": "string"},
+                "count": {"$ref": "#/definitions/Inner"},
+                "described": {
+                    "allOf": [{"$ref": "#/definitions/Inner"}],
+                    "description": "Described reference.",
+                },
+                "nullable": {"type": ["string", "null"]},
+            })
+        );
+    }
+}
