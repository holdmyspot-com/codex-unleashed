From 74697134995b50e14e37627d117cc1b7c187b673 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Sat, 24 Oct 2026 18:01:49 -0400
Subject: [PATCH] test: make secret identity fallback independent of temporary
 directory ancestry

Use the canonical filesystem root so the fixture exercises the fallback even when the test runner places temporary files beneath a Git checkout. Preserve the exact path-hash assertion.

The original fixture failed under Bazel 9.3.1 when its sandbox replaced action TMPDIR with the client temporary directory. The corrected full secrets target passed all 9 tests with test-result caching disabled; maintained just fmt-check passed. Declared base: rust-v0.163.0 (83086188ae0614bd882818ff1aa23f3194962012); no prerequisite patches.
---
 codex-rs/secrets/src/lib.rs | 14 +++++++++-----
 1 file changed, 9 insertions(+), 5 deletions(-)

diff --git a/codex-rs/secrets/src/lib.rs b/codex-rs/secrets/src/lib.rs
index de7e07e3..94072940 100644
--- a/codex-rs/secrets/src/lib.rs
+++ b/codex-rs/secrets/src/lib.rs
@@ -216,13 +216,17 @@ mod tests {
     #[test]
     fn environment_id_fallback_has_cwd_prefix() {
         let dir = tempfile::tempdir().expect("tempdir");
-        let env_id = environment_id_from_cwd(dir.path());
-        let canonical = dir
+        let canonical_dir = dir
             .path()
             .canonicalize()
-            .expect("tempdir canonical path should exist")
-            .to_string_lossy()
-            .into_owned();
+            .expect("tempdir canonical path should exist");
+        // A filesystem root has no repository name, even when temporary files inherit a checkout.
+        let filesystem_root = canonical_dir
+            .ancestors()
+            .last()
+            .expect("an absolute path has a filesystem root");
+        let env_id = environment_id_from_cwd(filesystem_root);
+        let canonical = filesystem_root.to_string_lossy().into_owned();
         let mut hasher = Sha256::new();
         hasher.update(canonical.as_bytes());
         let digest = hasher.finalize();
