+/// Returns whether the chat widget asked the app to quit, ignoring its other events.
+fn exit_requested(rx: &mut tokio::sync::mpsc::UnboundedReceiver<AppEvent>) -> bool {
+    while let Ok(event) = rx.try_recv() {
+        if matches!(event, AppEvent::Exit(ExitMode::ShutdownFirst)) {
+            return true;
+        }
+    }
+    false
+}
+
+#[tokio::test]
+async fn tui_tools_server_startup_leaves_ctrl_c_to_quit() {
+    let (mut chat, mut rx, mut op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    // A thread without configured MCP servers expects none; the TUI adds its tools server per thread.
+    chat.set_mcp_startup_expected_servers(Vec::<String>::new());
+
+    notify_mcp_status(
+        &mut chat,
+        crate::dynamic_tools::NAMESPACE,
+        McpServerStartupState::Starting,
+    );
+
+    assert!(!chat.bottom_pane.is_task_running());
+    assert!(!chat.bottom_pane.status_indicator_visible());
+    chat.handle_key_event(KeyEvent::new(KeyCode::Char('c'), KeyModifiers::CONTROL));
+    assert!(exit_requested(&mut rx), "Ctrl+C did not quit");
+    while let Ok(op) = op_rx.try_recv() {
+        assert!(
+            !matches!(op, Op::Interrupt),
+            "Ctrl+C interrupted MCP startup"
+        );
+    }
+}
+
+#[tokio::test]
+async fn ctrl_c_interrupts_user_mcp_server_startup() {
+    let (mut chat, mut rx, mut op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.set_mcp_startup_expected_servers(["alpha".to_string()]);
+
+    notify_mcp_status(&mut chat, "alpha", McpServerStartupState::Starting);
+    notify_mcp_status(
+        &mut chat,
+        crate::dynamic_tools::NAMESPACE,
+        McpServerStartupState::Starting,
+    );
+    chat.handle_key_event(KeyEvent::new(KeyCode::Char('c'), KeyModifiers::CONTROL));
+
+    next_interrupt_op(&mut op_rx);
+    assert!(!exit_requested(&mut rx), "Ctrl+C quit during MCP startup");
+}
