+#[tokio::test]
+async fn mcp_startup_status_leaves_out_the_tui_tools_server() {
+    let (mut chat, _rx, _op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.set_mcp_startup_expected_servers(["alpha".to_string()]);
+
+    notify_mcp_status(
+        &mut chat,
+        crate::dynamic_tools::NAMESPACE,
+        McpServerStartupState::Starting,
+    );
+    notify_mcp_status(&mut chat, "alpha", McpServerStartupState::Starting);
+    assert!(chat.bottom_pane.is_task_running());
+    assert_eq!(
+        chat.status_state.current_status.header,
+        "Booting MCP server: alpha"
+    );
+
+    notify_mcp_status(&mut chat, "alpha", McpServerStartupState::Ready);
+    assert!(!chat.bottom_pane.is_task_running());
+    assert!(!chat.bottom_pane.status_indicator_visible());
+
+    notify_mcp_status(
+        &mut chat,
+        crate::dynamic_tools::NAMESPACE,
+        McpServerStartupState::Ready,
+    );
+    assert!(chat.mcp_startup_status.is_none());
+}
