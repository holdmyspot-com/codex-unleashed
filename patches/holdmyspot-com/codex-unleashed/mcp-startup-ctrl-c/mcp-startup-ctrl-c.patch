+    /// Returns whether an MCP startup round is running for more than the TUI's own tools server.
+    ///
+    /// The TUI starts its tools server for every thread. That startup is brief and not work the
+    /// user asked for, so while it is all that keeps the round open, the TUI is not busy and Ctrl+C
+    /// quits instead of interrupting it.
+    pub(super) fn user_mcp_startup_running(&self) -> bool {
+        let Some(current) = &self.mcp_startup_status else {
+            return false;
+        };
+        let only_tui_tools_server_starting = current.get(dynamic_tools::NAMESPACE)
+            == Some(&McpStartupStatus::Starting)
+            && current.iter().all(|(name, state)| {
+                name == dynamic_tools::NAMESPACE || !matches!(state, McpStartupStatus::Starting)
+            })
+            && self
+                .mcp_startup_expected_servers
+                .as_ref()
+                .is_some_and(|expected| expected.iter().all(|name| current.contains_key(name)));
+        !only_tui_tools_server_starting
+    }
