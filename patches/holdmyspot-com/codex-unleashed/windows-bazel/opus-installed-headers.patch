From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Wed, 11 Nov 2026 15:54:52 -0500
Subject: [PATCH] bugfix: install regular Opus headers under Bazel on Windows

Bazel on Windows presents the opusic-sys build script's sources as symbolic
links, and CMake's install step copied each public header as a link whose
target Bazel's output validation cannot resolve, failing the opusic-sys build
script and every voice target. Backport of openai/codex#59752 (the
opusic-sys crate annotation) and openai/codex#59972 (the patch): the Opus
CMakeLists.txt copies its public headers into the build directory before
installing them, so only regular files reach the install prefix.
---
 MODULE.bazel                             |  2 ++
 patches/BUILD.bazel                      |  1 +
 patches/opusic_sys_install_headers.patch | 26 ++++++++++++++++++++++++
 3 files changed, 29 insertions(+)
 create mode 100644 patches/opusic_sys_install_headers.patch

diff --git a/MODULE.bazel b/MODULE.bazel
index 3c1bfb7ab4..14f3cc47a1 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -732,6 +732,8 @@ crate.annotation(
         "@rules_foreign_cc//toolchains:current_ninja_toolchain",
     ],
     crate = "opusic-sys",
+    patch_args = ["-p1"],
+    patches = ["//patches:opusic_sys_install_headers.patch"],
 )
 
 # The musl CLI's allocator needs declared native tools and consistent header flags.
diff --git a/patches/BUILD.bazel b/patches/BUILD.bazel
index e0dc7056d3..334598195c 100644
--- a/patches/BUILD.bazel
+++ b/patches/BUILD.bazel
@@ -1,4 +1,5 @@
 exports_files([
+    "opusic_sys_install_headers.patch",
     "rules_cc_windows_native_llvm.patch",
     "abseil_windows_gnullvm_thread_identity.patch",
     "bzip2_windows_stack_args.patch",
diff --git a/patches/opusic_sys_install_headers.patch b/patches/opusic_sys_install_headers.patch
new file mode 100644
index 0000000000..e79a5a1db1
--- /dev/null
+++ b/patches/opusic_sys_install_headers.patch
@@ -0,0 +1,26 @@
+--- a/opus/CMakeLists.txt
++++ b/opus/CMakeLists.txt
+@@ -301,13 +301,22 @@
+ get_library_version(OPUS_LIBRARY_VERSION OPUS_LIBRARY_VERSION_MAJOR)
+ message(DEBUG "Opus library version: ${OPUS_LIBRARY_VERSION}")
+
++# Build-script inputs can be relative symlinks. Materialize public headers so
++# CMake does not preserve links that become dangling in the install prefix.
++foreach(header IN LISTS Opus_PUBLIC_HEADER)
++  get_filename_component(header_name "${header}" NAME)
++  set(install_header "${CMAKE_CURRENT_BINARY_DIR}/public_headers/${header_name}")
++  configure_file("${header}" "${install_header}" COPYONLY)
++  list(APPEND Opus_INSTALL_HEADERS "${install_header}")
++endforeach()
++
+ set_target_properties(opus
+                       PROPERTIES SOVERSION
+                                  ${OPUS_LIBRARY_VERSION_MAJOR}
+                                  VERSION
+                                  ${OPUS_LIBRARY_VERSION}
+                                  PUBLIC_HEADER
+-                                 "${Opus_PUBLIC_HEADER}")
++                                 "${Opus_INSTALL_HEADERS}")
+
+ target_include_directories(
+   opus
-- 
2.43.0

