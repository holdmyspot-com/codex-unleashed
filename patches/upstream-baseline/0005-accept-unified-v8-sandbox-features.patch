From 656dc93671b02f5c7fc0e34ed76dcf003df4889b Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Sun, 25 Oct 2026 08:07:23 +0000
Subject: [PATCH] test: respect workspace feature unification in the V8 proof
 of concept

---
 codex-rs/v8-poc/src/lib.rs | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/codex-rs/v8-poc/src/lib.rs b/codex-rs/v8-poc/src/lib.rs
index 5103cde..623a3c7 100644
--- a/codex-rs/v8-poc/src/lib.rs
+++ b/codex-rs/v8-poc/src/lib.rs
@@ -65,8 +65,17 @@ mod tests {
     }
 
     #[test]
-    fn sandbox_feature_matches_linked_v8() {
-        assert_eq!(super::linked_v8_has_sandbox(), cfg!(feature = "sandbox"));
+    fn requested_sandbox_feature_is_available_in_linked_v8() {
+        // Cargo unifies dependency features: code-mode-runtime enables V8's
+        // sandbox even when this crate's optional forwarding feature is off.
+        // Requesting the feature requires sandbox support; omitting it does not
+        // require that other workspace consumers disable the shared feature.
+        let sandbox_requested = cfg!(feature = "sandbox");
+        let sandbox_linked = super::linked_v8_has_sandbox();
+        assert!(
+            sandbox_linked || !sandbox_requested,
+            "the sandbox feature requires a sandbox-enabled V8 library"
+        );
     }
 
     #[test]
