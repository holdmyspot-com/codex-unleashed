From 7d66487b94d007bf94d9a53ecf9e0c767a436eb0 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Sun, 25 Oct 2026 05:55:36 -0400
Subject: [PATCH] test: use a development version in packaged daemon fixtures

The stable release version enables automatic updates in package metadata, while these bootstrap fixtures require development-mode packages. Keep runtime versioning and updater behavior unchanged. Native comparison: original bootstrap fails; the development fixture passes all four package tests.
---
 codex-rs/cli/tests/app_server_daemon/package.rs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/codex-rs/cli/tests/app_server_daemon/package.rs b/codex-rs/cli/tests/app_server_daemon/package.rs
index 6c010c5..e004956 100644
--- a/codex-rs/cli/tests/app_server_daemon/package.rs
+++ b/codex-rs/cli/tests/app_server_daemon/package.rs
@@ -58,7 +58,7 @@ fn packaged_daemon_launch(action: &str, initial: InitialDaemon) -> Result<()> {
     std::fs::write(
         package.join("codex-package.json"),
         serde_json::to_vec(&serde_json::json!({
-            "version": env!("CARGO_PKG_VERSION"), "target": target, "entrypoint": "bin/codex"
+            "version": "0.0.0", "target": target, "entrypoint": "bin/codex"
         }))?,
     )?;
     if action == "start" && initial == InitialDaemon::Missing {
