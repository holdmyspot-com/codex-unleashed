From 4daf0d6e5bf122b8a440c733a90005b4a7205d57 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Sun, 25 Oct 2026 13:32:59 +0000
Subject: [PATCH] test: isolate MCP binding capture from concurrent callsites

---
 codex-rs/core/tests/suite/mcp_tool_cache.rs | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/codex-rs/core/tests/suite/mcp_tool_cache.rs b/codex-rs/core/tests/suite/mcp_tool_cache.rs
index 602252b..0b33047 100644
--- a/codex-rs/core/tests/suite/mcp_tool_cache.rs
+++ b/codex-rs/core/tests/suite/mcp_tool_cache.rs
@@ -589,6 +589,9 @@ async fn cached_mcp_startup_is_eager_for_root_and_lazy_for_subagents() -> anyhow
     skip_if_no_network!(Ok(()));
 
     let binding_captures = Arc::new(AtomicUsize::new(0));
+    // Keep concurrent tests without a subscriber from caching this shared callsite as disabled.
+    let _interest_cache_guard =
+        tracing::Dispatch::new(tracing::subscriber::NoSubscriber::default());
     let _tracing = tracing_subscriber::registry()
         .with(McpBindingCaptureCounter(Arc::clone(&binding_captures)))
         .set_default();
