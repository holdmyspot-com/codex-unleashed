From 3922b5d2e9c0498fc8304d3f39565a44474ce680 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Sun, 25 Oct 2026 06:38:16 -0400
Subject: [PATCH] test: require an assignable supplementary group in ownership
 fixtures

---
 codex-rs/rollout/src/compression_tests.rs | 24 ++++++++++++++++++-----
 1 file changed, 19 insertions(+), 5 deletions(-)

diff --git a/codex-rs/rollout/src/compression_tests.rs b/codex-rs/rollout/src/compression_tests.rs
index 806039d..e33e4c0 100644
--- a/codex-rs/rollout/src/compression_tests.rs
+++ b/codex-rs/rollout/src/compression_tests.rs
@@ -754,17 +754,30 @@ async fn worker_preserves_alternate_group_through_materialization() -> anyhow::R
     let original_group = fs::metadata(&path)?.gid();
     let groups = Command::new("id").arg("-G").output()?;
     assert!(groups.status.success());
-    let Some(group) = std::str::from_utf8(&groups.stdout)?
+    let mut alternate_group = None;
+    for group in std::str::from_utf8(&groups.stdout)?
         .split_whitespace()
         .map(str::parse::<u32>)
         .collect::<Result<Vec<_>, _>>()?
         .into_iter()
-        .find(|group| *group != original_group)
-    else {
-        eprintln!("skipping ownership regression: no alternate supplementary group");
+        .filter(|group| *group != original_group)
+    {
+        match std::os::unix::fs::chown(&path, /*uid*/ None, Some(group)) {
+            Ok(()) => {
+                alternate_group = Some(group);
+                break;
+            }
+            // A user namespace can expose unmapped groups as an unassignable overflow GID.
+            Err(error) if error.kind() == io::ErrorKind::InvalidInput => {
+                eprintln!("ownership fixture cannot assign supplementary group {group}: {error}");
+            }
+            Err(error) => return Err(error.into()),
+        }
+    }
+    let Some(group) = alternate_group else {
+        eprintln!("skipping ownership regression: no assignable alternate supplementary group");
         return Ok(());
     };
-    std::os::unix::fs::chown(&path, /*uid*/ None, Some(group))?;
     assert_eq!(fs::metadata(&path)?.gid(), group);
 
     worker::run(home.path().to_path_buf(), Startup).await?;
@@ -772,6 +785,7 @@ async fn worker_preserves_alternate_group_through_materialization() -> anyhow::R
     assert_eq!(fs::metadata(compressed_rollout_path(&path))?.gid(), group);
     materialize_rollout_for_append(&path, /*writer_lock*/ None).await?;
     assert_eq!(fs::metadata(&path)?.gid(), group);
+    eprintln!("ownership regression preserved alternate group {group} through materialization");
     Ok(())
 }
 
