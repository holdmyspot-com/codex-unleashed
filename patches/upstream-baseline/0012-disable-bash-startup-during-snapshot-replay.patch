From f4a22234688c2acde4e8a46b1461089b9be8c2e7 Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Sun, 25 Oct 2026 14:09:30 +0000
Subject: [PATCH] fix: prevent Bash startup files during snapshot replay

---
 codex-rs/exec-server/src/shell_snapshot.rs       | 6 ++++++
 codex-rs/exec-server/src/shell_snapshot_tests.rs | 4 ++--
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/codex-rs/exec-server/src/shell_snapshot.rs b/codex-rs/exec-server/src/shell_snapshot.rs
index 55a831c..ed67b58 100644
--- a/codex-rs/exec-server/src/shell_snapshot.rs
+++ b/codex-rs/exec-server/src/shell_snapshot.rs
@@ -371,6 +371,12 @@ impl ShellSnapshotCache {
             )
         };
 
+        if shell_type == ShellType::Bash {
+            prepared
+                .command
+                .insert(shell_start + 1, "--norc".to_string());
+        }
+
         telemetry.shell_snapshot_command(wait, availability, "used");
         Ok(reader)
     }
diff --git a/codex-rs/exec-server/src/shell_snapshot_tests.rs b/codex-rs/exec-server/src/shell_snapshot_tests.rs
index 7f5298f..b6b39ee 100644
--- a/codex-rs/exec-server/src/shell_snapshot_tests.rs
+++ b/codex-rs/exec-server/src/shell_snapshot_tests.rs
@@ -139,8 +139,8 @@ async fn snapshot_failure_retries_are_bounded_and_single_flight(
         for (prepared, reader) in [(&mut prepared, first), (&mut concurrent, second)] {
             if let Some(reader) = reader {
                 let fd = std::os::fd::AsRawFd::as_raw_fd(&reader);
-                prepared.command[2] =
-                    prepared.command[2].replace(&format!("/dev/fd/{fd}"), "/dev/fd/SNAPSHOT");
+                let script = prepared.command.last_mut().expect("shell command script");
+                *script = script.replace(&format!("/dev/fd/{fd}"), "/dev/fd/SNAPSHOT");
             }
         }
         assert_eq!(
-- 
2.43.0
