--- a/codex-rs/tui/src/chatwidget/tests/history_replay.rs
+++ b/codex-rs/tui/src/chatwidget/tests/history_replay.rs
@@ -76,6 +76,65 @@ async fn resumed_initial_messages_render_history() {
     );
 }
 
+#[tokio::test]
+async fn replayed_compacted_history_contains_only_latest_conversation() {
+    let (mut chat, mut rx, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    let conversation = |index: usize| AppServerTurn {
+        items: vec![
+            AppServerThreadItem::UserMessage {
+                id: format!("user-{index}"),
+                client_id: None,
+                content: vec![AppServerUserInput::Text {
+                    text: format!("conversation-{index}"),
+                    text_elements: Vec::new(),
+                }],
+            },
+            AppServerThreadItem::AgentMessage {
+                id: format!("answer-{index}"),
+                text: format!("answer-{index}"),
+                phase: Some(MessagePhase::FinalAnswer),
+                memory_citation: None,
+                delivery: None,
+                questions: None,
+            },
+        ],
+        ..app_server_turn(
+            &format!("turn-{index}"),
+            AppServerTurnStatus::Completed,
+            /*duration_ms*/ None,
+            /*error*/ None,
+        )
+    };
+    let compaction = |index: usize| AppServerTurn {
+        items: vec![AppServerThreadItem::ContextCompaction {
+            id: format!("compaction-{index}"),
+        }],
+        ..app_server_turn(
+            &format!("compaction-turn-{index}"),
+            AppServerTurnStatus::Completed,
+            /*duration_ms*/ None,
+            /*error*/ None,
+        )
+    };
+    let mut turns = Vec::new();
+    for index in 0..50 {
+        turns.push(conversation(index));
+        turns.push(compaction(index));
+    }
+    turns.push(conversation(50));
+
+    chat.replay_thread_turns(turns, ReplayKind::ThreadSnapshot);
+
+    let rendered = drain_insert_history(&mut rx)
+        .into_iter()
+        .map(|lines| lines_to_single_string(&lines))
+        .collect::<String>();
+    assert!(rendered.contains("conversation-50"));
+    assert!(rendered.contains("answer-50"));
+    assert!(!rendered.contains("conversation-0"));
+    assert!(!rendered.contains("answer-49"));
+}
+
 #[tokio::test]
 async fn replayed_failed_turns_preserve_overload_warnings_between_retries() {
     let (mut chat, mut rx, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
diff --git a/codex-rs/tui/src/chatwidget/replay.rs b/codex-rs/tui/src/chatwidget/replay.rs
index 0fb1efd..0000000 100644
--- a/codex-rs/tui/src/chatwidget/replay.rs
+++ b/codex-rs/tui/src/chatwidget/replay.rs
@@ -104,9 +104,22 @@ impl ChatWidget {
     pub(crate) fn replay_thread_turns(&mut self, turns: Vec<Turn>, replay_kind: ReplayKind) {
+        let first_latest_conversation_turn = turns
+            .iter()
+            .rposition(|turn| {
+                turn.items
+                    .iter()
+                    .any(|item| matches!(item, ThreadItem::ContextCompaction { .. }))
+            })
+            .map(|index| index + 1)
+            .unwrap_or(0);
+        let turns = turns
+            .into_iter()
+            .skip(first_latest_conversation_turn)
+            .collect::<Vec<_>>();
         if matches!(replay_kind, ReplayKind::ThreadSnapshot) && !turns.is_empty() {
             self.warning_display_state.startup_complete = true;
         }
         let latest_turn_id = turns.last().map(|turn| turn.id.clone());
         let hidden_nested_review_turns = std::iter::once(/*value*/ false)
             .chain(turns.windows(/*size*/ 2).map(|turns| {
                 crate::app_backtrack::is_hidden_nested_review_turn(&turns[0], &turns[1])
             }))
