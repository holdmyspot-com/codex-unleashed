+    def has_edge($from; $to):
+        [.resolve.nodes[] | select(.id == $from)] |
+        length == 1 and any(.[0].deps[]; .pkg == $to);
+    . as $metadata |
+    package("crypto-bigint"; "0.5.5") as $local |
+    package("age"; "0.12.1") as $age |
+    package("p256"; "0.13.2") as $p256 |
+    package("elliptic-curve"; "0.13.8") as $elliptic |
+    ($local | has("source")) and
+    $local.source == null and $local.manifest_path == $manifest and
+    all($metadata.packages[] | select(.name == "crypto-bigint" and .version != "0.5.5");
+        . as $registry |
+        (.source | type == "string" and startswith("registry+")) and
+        ($metadata | package("crypto-bigint"; $registry.version) | .id == $registry.id) and
+        ($metadata | has_one_node($registry.id))) and
+    ($metadata | has_one_node($local.id)) and
+    ($metadata | has_edge($age.id; $p256.id)) and
+    ($metadata | has_edge($p256.id; $elliptic.id)) and
+    ($metadata | has_edge($elliptic.id; $local.id))
+' "$scratch/metadata.json" > /dev/null || fail 'Cargo metadata does not resolve the reviewed age dependency chain'
+printf 'Verified reviewed crypto-bigint source and locked Cargo dependency chain.\n'
