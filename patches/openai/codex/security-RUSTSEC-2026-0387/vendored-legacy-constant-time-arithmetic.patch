+vendor="$checkout/codex-rs/vendor/crypto-bigint-0.5.5"
+provenance="$checkout/codex-rs/vendor/crypto-bigint-backport"
+archive="$provenance/upstream.tar.gz"
+patch="$provenance/backport.patch"
+archive_sha256=8bc61c0012bfede94eb4191b08a6d0c674b04f32ea12eb94c8182e2d623f2238
+patch_sha256=daab4a04c34beea7f417fae1b348ada597221bed826c9fc0b6c0cdcef00d0002
+
+fail() {
+    printf 'crypto-bigint backport: %s\n' "$1" >&2
+    exit 1
+}
+
+[[ -f "$archive" ]] || fail "missing upstream archive: $archive"
+[[ -s "$patch" ]] || fail "missing or empty reviewed patch: $patch"
+printf '%s  %s\n' "$archive_sha256" "$archive" | sha256sum --check --status || fail 'upstream archive checksum mismatch'
+printf '%s  %s\n' "$patch_sha256" "$patch" | sha256sum --check --status || fail 'reviewed patch checksum mismatch'
+[[ -d "$vendor" && ! -L "$vendor" ]] || fail "vendor must be a directory, not a symlink: $vendor"
+vendor_symlink=$(find "$vendor" -type l -print -quit)
+[[ -z "$vendor_symlink" ]] || fail 'vendor contains a symlink'
+vendor=$(cd -P -- "$vendor" && pwd)
+: "${TMPDIR:?TMPDIR must name caller-owned temporary storage}"
+scratch=$(mktemp -d "$TMPDIR/crypto-bigint-backport.XXXXXXXX")
+
+cleanup() {
+    status=$?
+    trap - EXIT
+    if rm -rf -- "$scratch"; then
+        exit "$status"
+    else
+        printf 'crypto-bigint backport: cleanup failed: %s\n' "$scratch" >&2
