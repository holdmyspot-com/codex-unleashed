+use crate::rng::{PrivateRng, PublicRng};
+use checkct_macros::checkct;
+use core::hint::black_box;
+use crypto_bigint::{Limb, Reciprocal, U256, U512, Word};
+
+#[checkct]
+pub fn leading_zeros_u512() {
+    black_box(PublicRng::new().next_u32());
+    let mut bytes = [0u8; 64];
+    PrivateRng::new().fill_bytes(&mut bytes);
+    black_box(leading_zeros(&U512::from_be_slice(&bytes)));
+}
+
+#[inline(never)]
+fn leading_zeros(value: &U512) -> usize {
+    value.leading_zeros()
+}
+
+#[checkct]
+pub fn trailing_zeros_u512() {
+    black_box(PublicRng::new().next_u32());
+    let mut bytes = [0u8; 64];
+    PrivateRng::new().fill_bytes(&mut bytes);
+    bytes[63] |= 1;
+    black_box(trailing_zeros(&U512::from_be_slice(&bytes)));
+}
+
+#[inline(never)]
+fn trailing_zeros(value: &U512) -> usize {
+    value.trailing_zeros()
+}
+
+#[checkct]
+pub fn reciprocal_secret_limb() {
+    black_box(PublicRng::new().next_u32());
+    let divisor = Limb(PrivateRng::new().next_u64() as Word);
+    black_box(Reciprocal::ct_new(black_box(divisor)));
+}
+
+#[checkct]
+pub fn trailing_zeros_full_u512() {
+    black_box(PublicRng::new().next_u32());
+    let mut bytes = [0u8; 64];
+    PrivateRng::new().fill_bytes(&mut bytes);
+    black_box(trailing_zeros(&U512::from_be_slice(&bytes)));
+}
+
+#[checkct]
+pub fn trailing_ones_u512() {
+    black_box(PublicRng::new().next_u32());
+    let mut bytes = [0u8; 64];
+    PrivateRng::new().fill_bytes(&mut bytes);
+    black_box(trailing_ones(&U512::from_be_slice(&bytes)));
+}
+
+#[inline(never)]
+fn trailing_ones(value: &U512) -> usize {
+    value.trailing_ones()
+}
+
+fn inputs() -> (U256, U256, U256) {
+    let mut private = PrivateRng::new();
+    let mut public = PublicRng::new();
+    let mut bytes = [0u8; 32];
+
+    private.fill_bytes(&mut bytes);
+    bytes[0] &= 0x7f;
+    let a = U256::from_be_slice(&bytes);
+
+    private.fill_bytes(&mut bytes);
+    bytes[0] &= 0x7f;
+    let b = U256::from_be_slice(&bytes);
+
+    public.fill_bytes(&mut bytes);
+    bytes[0] |= 0x80;
+    let p = U256::from_be_slice(&bytes);
+
+    (a, b, p)
+}
+
+#[checkct]
+pub fn sub_mod_u256() {
+    black_box(PublicRng::new().next_u32());
+    let (a, b, p) = inputs();
+    black_box(a.sub_mod(&b, &p));
+}
