+            CARGO_RESPONSE=str(self.root / "response"),
+        )
+
+    def run_guard(self, expected=1):
+        response = self.root / "response"
+        response.write_text(json.dumps(self.metadata))
+        before = file_hashes(self.vendor)
+        result = subprocess.run(
+            [str(self.guard), str(self.checkout)],
+            env=self.environment,
+            capture_output=True,
+            text=True,
+        )
+        self.assertEqual(list(self.scratch.iterdir()), [], result.stderr)
+        self.assertEqual(before, file_hashes(self.vendor), "guard changes vendor bytes")
+        if expected == 0:
+            self.assertEqual(result.returncode, 0, result.stderr)
+            request = (self.root / "request").read_text().splitlines()
+            self.assertEqual(
+                request,
+                [
+                    "metadata",
+                    "--locked",
+                    "--format-version",
+                    "1",
+                    "--manifest-path",
+                    str(self.checkout / "codex-rs/Cargo.toml"),
+                ],
+            )
+        elif expected == 1:
+            self.assertNotEqual(result.returncode, 0, result.stdout)
+        else:
+            self.assertEqual(result.returncode, expected, result.stderr)
+        return result
+
+    def mutate_metadata(self, expression, *arguments):
+        result = subprocess.run(
+            ["jq", *arguments, expression],
+            input=json.dumps(self.metadata),
+            capture_output=True,
