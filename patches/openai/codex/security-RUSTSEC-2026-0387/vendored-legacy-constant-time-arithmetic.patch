+        shutil.copytree(
+            self.options.checkout / "codex-rs/vendor/crypto-bigint-backport",
+            self.provenance,
+        )
+        subprocess.run(
+            [
+                "tar",
+                "-xzf",
+                str(self.provenance / "upstream.tar.gz"),
+                "--strip-components=1",
+                "-C",
+                str(self.vendor),
+            ],
+            check=True,
+        )
+        environment = os.environ.copy()
+        environment["GIT_CEILING_DIRECTORIES"] = str(self.root)
+        subprocess.run(
+            [
+                "git",
+                "-C",
+                str(self.vendor),
+                "apply",
+                "--",
+                str(self.provenance / "backport.patch"),
