++macro_rules! impl_rng {
++    ($rng:ident, $rand:ident) => {
++        impl $rng {
++            pub const fn new() -> Self {
++                Self
++            }
++
++            pub fn next_u32(&mut self) -> u32 {
++                u32::from_be_bytes([$rand(), $rand(), $rand(), $rand()])
++            }
++
++            pub fn next_u64(&mut self) -> u64 {
++                (self.next_u32() as u64) << 32 | (self.next_u32() as u64)
++            }
++
++            pub fn fill_bytes(&mut self, dest: &mut [u8]) {
++                for d in dest {
++                    *d = $rand();
++                }
++            }
++        }
++
++        impl rand_core::TryRng for $rng {
++            type Error = core::convert::Infallible;
++
++            fn try_next_u32(&mut self) -> Result<u32, Self::Error> {
++                Ok($rng::next_u32(self))
++            }
++
++            fn try_next_u64(&mut self) -> Result<u64, Self::Error> {
++                Ok($rng::next_u64(self))
++            }
++
++            fn try_fill_bytes(&mut self, dest: &mut [u8]) -> Result<(), Self::Error> {
++                $rng::fill_bytes(self, dest);
++                Ok(())
++            }
++        }
++
++        impl rand_core::TryCryptoRng for $rng {}
++
++        impl rand_core_09::RngCore for $rng {
++            fn next_u32(&mut self) -> u32 {
