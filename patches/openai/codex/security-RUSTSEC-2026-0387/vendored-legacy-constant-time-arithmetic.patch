+jq --exit-status --arg manifest "$vendor/Cargo.toml" '
+    def package($name; $version):
+        [.packages[] | select(.name == $name and .version == $version)] |
+        if length == 1 then .[0] else error("expected exactly one " + $name + "@" + $version) end;
+    def has_one_node($id):
