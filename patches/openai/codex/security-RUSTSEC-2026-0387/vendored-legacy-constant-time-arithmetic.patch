+diff --git a/tests/zero_count_backport.rs b/tests/zero_count_backport.rs
+new file mode 100644
+index 0000000..518eb14
+--- /dev/null
++++ b/tests/zero_count_backport.rs
+@@ -0,0 +1,56 @@
++use crypto_bigint::{Limb, NonZero, Reciprocal, Word, U128};
++
++const ZERO_COUNTS: [usize; 4] = [
++    Limb::ZERO.bits(),
++    Limb::ZERO.leading_zeros(),
++    Limb::ZERO.trailing_zeros(),
++    Limb::MAX.trailing_ones(),
++];
++
++#[test]
++fn zero_counts_preserve_const_evaluation() {
++    assert_eq!(ZERO_COUNTS, [0, Limb::BITS, Limb::BITS, Limb::BITS]);
++}
++
++#[test]
++fn zero_counts_match_word_at_each_bit_boundary() {
++    for bit in 0..Word::BITS {
++        let power = (1 as Word) << bit;
++        for value in [power.wrapping_sub(1), power, power.wrapping_add(1)] {
++            let limb = Limb(value);
++            assert_eq!(limb.bits(), (Word::BITS - value.leading_zeros()) as usize);
++            assert_eq!(limb.leading_zeros(), value.leading_zeros() as usize);
++            assert_eq!(limb.trailing_zeros(), value.trailing_zeros() as usize);
++            assert_eq!(limb.trailing_ones(), value.trailing_ones() as usize);
++        }
++    }
++    assert_eq!(Limb::MAX.leading_zeros(), 0);
++    assert_eq!(Limb::MAX.trailing_zeros(), 0);
++}
++
++#[test]
++fn reciprocal_normalization_preserves_division_at_each_bit_boundary() {
++    let dividend = U128::from_u128(u128::MAX);
++    for bit in 0..Word::BITS {
++        let power = (1 as Word) << bit;
++        for divisor in [power.wrapping_sub(1), power, power.wrapping_add(1)] {
++            if divisor == 0 {
++                continue;
++            }
++
++            let (reciprocal, valid) = Reciprocal::ct_new(Limb(divisor));
++            assert!(bool::from(valid));
++            let (quotient, remainder) = dividend.ct_div_rem_limb_with_reciprocal(&reciprocal);
++            assert_eq!(quotient, U128::from_u128(u128::MAX / u128::from(divisor)));
++            assert_eq!(remainder.0 as u128, u128::MAX % u128::from(divisor));
++            assert_eq!(
++                (quotient, remainder),
++                dividend.div_rem_limb(NonZero::new(Limb(divisor)).unwrap())
++            );
++        }
++    }
++
++    let (dummy, valid) = Reciprocal::ct_new(Limb::ZERO);
++    assert!(!bool::from(valid));
++    let _ = dividend.ct_div_rem_limb_with_reciprocal(&dummy);
++}
