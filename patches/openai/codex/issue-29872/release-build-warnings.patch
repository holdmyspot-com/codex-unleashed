From c9158e481d43af4f6459546a7840dff1a391e36f Mon Sep 17 00:00:00 2001
From: Gili Tzabari <cowwoc2020@gmail.com>
Date: Thu, 1 Oct 2026 22:48:17 -0400
Subject: [PATCH] Remove unused imports and bindings from release builds

Keep cloud mock-backend imports and the mutable app-server configuration
binding behind the same debug_assertions condition as their uses. Remove
the unused core ToolCallSource import. Preserve runtime behavior in both
profiles and add a focused release-warning regression check.

Fixes https://github.com/openai/codex/issues/29872
Base: rust-v0.160.0 (a956835d020762cb2b570053af06f643a11c0ecc)

Red: cargo clippy --release --lib -p codex-core -p codex-app-server
-p codex-cloud-tasks -- -D unused_imports -D unused_mut failed with the
unused core import, then the app-server unused_mut, then both cloud imports
as each predecessor was repaired. Rust 1.95.0 reproduces the release
warnings; Rust 1.98.0 also reports an unchanged upstream recursion overflow.
Green: the same release command and just check-release-warnings pass on
Rust 1.95.0. Upstream just fmt-check passes with local Rust 1.98.0.

The focused gate uses --no-deps to lint only the three affected libraries.
Green: the focused release command also passes with the complete downstream
nine-patch queue applied to the declared base.
---
 codex-rs/app-server/src/lib.rs      | 5 ++++-
 codex-rs/cloud-tasks/src/lib.rs     | 2 ++
 codex-rs/core/src/tools/registry.rs | 1 -
 justfile                            | 4 ++++
 4 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/codex-rs/app-server/src/lib.rs b/codex-rs/app-server/src/lib.rs
index d1a622c..3669fbf 100644
--- a/codex-rs/app-server/src/lib.rs
+++ b/codex-rs/app-server/src/lib.rs
@@ -1501,5 +1501,8 @@ fn test_user_config_file_from_env() -> Option<std::path::PathBuf> {
 fn loader_overrides_with_test_user_config_file(
-    mut loader_overrides: LoaderOverrides,
+    loader_overrides: LoaderOverrides,
     test_user_config_file: Option<std::path::PathBuf>,
 ) -> IoResult<LoaderOverrides> {
+    #[cfg(debug_assertions)]
+    let mut loader_overrides = loader_overrides;
+
     #[cfg(debug_assertions)]
diff --git a/codex-rs/cloud-tasks/src/lib.rs b/codex-rs/cloud-tasks/src/lib.rs
index 6643684..1c3dea7 100644
--- a/codex-rs/cloud-tasks/src/lib.rs
+++ b/codex-rs/cloud-tasks/src/lib.rs
@@ -15,3 +15,5 @@ use codex_git_utils::default_branch_name;
 use codex_http_client::ClientRouteClass;
+#[cfg(debug_assertions)]
 use codex_http_client::HttpClientFactory;
+#[cfg(debug_assertions)]
 use codex_http_client::OutboundProxyPolicy;
diff --git a/codex-rs/core/src/tools/registry.rs b/codex-rs/core/src/tools/registry.rs
index 7d88650..9ac7b76 100644
--- a/codex-rs/core/src/tools/registry.rs
+++ b/codex-rs/core/src/tools/registry.rs
@@ -15,3 +15,2 @@ use crate::session::turn_context::TurnContext;
 use crate::tools::context::FunctionToolOutput;
-use crate::tools::context::ToolCallSource;
 use crate::tools::context::ToolCallState;
diff --git a/justfile b/justfile
index 3614939..6fe4962 100644
--- a/justfile
+++ b/justfile
@@ -62,2 +62,6 @@ clippy *args:
 
+# Check unused imports and mutable bindings in release builds.
+check-release-warnings:
+    cargo clippy --release --lib -p codex-core -p codex-app-server -p codex-cloud-tasks -- --no-deps -D unused_imports -D unused_mut
+
 [unix]
-- 
2.43.0

