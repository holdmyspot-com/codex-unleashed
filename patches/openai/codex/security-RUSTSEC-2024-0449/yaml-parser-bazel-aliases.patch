+"""Analysis-only regressions for configured Cargo dependency aliases."""
+
+load("@crates//:defs.bzl", "aliases")
+load("@rules_rs//rs/private:all_crate_deps.bzl", "all_crate_aliases")
+
+def _alias_test_impl(ctx):
+    return [AnalysisTestResultInfo(
+        success = ctx.attr.actual == ctx.attr.expected,
+        message = "expected aliases %s, got %s" % (ctx.attr.expected, ctx.attr.actual),
+    )]
+
+_alias_test = rule(
+    implementation = _alias_test_impl,
+    analysis_test = True,
+    attrs = {
+        "actual": attr.string_dict(),
+        "expected": attr.string_dict(),
+    },
+)
+
+def cargo_aliases_tests():
+    """Exercise kind filtering, platform selection and common/default promotion."""
+    platforms = [":one", ":two"]
+    data = {
+        "aliases": {
+            "//:normal": "renamed_normal",
+            "//:dev": "test_support",
+            "//:build": "renamed_build",
+            "//:conditional": "platform_only",
+            "//:promoted": "on_every_platform",
+        },
+        "deps": ["//:normal"],
+        "dev_deps": ["//:dev"],
+        "build_deps": ["//:build"],
+        "deps_by_platform": {
+            ":one": ["//:conditional", "//:promoted"],
+            ":two": ["//:promoted"],
+        },
+    }
+    normal = {"//:normal": "renamed_normal", "//:promoted": "on_every_platform"}
+    configured_normal = select({
+        ":one": normal | {"//:conditional": "platform_only"},
+        "//conditions:default": normal,
+    })
+    _alias_test(
+        size = "small",
+        name = "normal_excludes_dev_cycle_test",
+        actual = all_crate_aliases(data, platforms),
+        expected = configured_normal,
+    )
+    _alias_test(
+        size = "small",
+        name = "dev_only_test",
+        actual = all_crate_aliases(data, platforms, normal_dev = True),
+        expected = {"//:dev": "test_support"},
+    )
+    _alias_test(
+        size = "small",
+        name = "build_only_test",
+        actual = all_crate_aliases(data, platforms, build = True),
+        expected = {"//:build": "renamed_build"},
+    )
+    _alias_test(
+        size = "small",
+        name = "normal_and_dev_test",
+        actual = all_crate_aliases(data, platforms, normal = True, normal_dev = True),
+        expected = select({
+            ":one": normal | {"//:conditional": "platform_only", "//:dev": "test_support"},
+            "//conditions:default": normal | {"//:dev": "test_support"},
+        }),
+    )
+    _alias_test(
+        size = "small",
+        name = "unconditional_keyring_test",
+        actual = aliases(package_name = "codex-rs/keyring-store", normal = True),
+        expected = {"@crates//:keyring-core-1.0.1": "keyring"},
+    )
+    _alias_test(
+        size = "small",
+        name = "legacy_aliases_test",
+        actual = aliases(package_name = "codex-rs/secrets"),
+        expected = {
+            "//codex-rs/git-utils": "codex_git_utils",
+            "//codex-rs/keyring-store": "codex_keyring_store",
+            "@crates//:keyring-core-1.0.1": "keyring",
+        },
+    )
+    native.test_suite(name = "tests", tests = [
+        ":normal_excludes_dev_cycle_test",
+        ":dev_only_test",
+        ":build_only_test",
+        ":normal_and_dev_test",
+        ":unconditional_keyring_test",
+        ":legacy_aliases_test",
+    ])
diff --git a/codex-rs/skills/tests/yaml_dependency_alias.rs b/codex-rs/skills/tests/yaml_dependency_alias.rs
new file mode 100644
index 00000000..4c2e6b5a
--- /dev/null
+++ b/codex-rs/skills/tests/yaml_dependency_alias.rs
@@ -0,0 +1,16 @@
+use codex_skills::parse_skill_frontmatter_metadata;
+
+#[test]
+fn maintained_yaml_alias_matches_public_skill_metadata() {
+    let yaml = "name: alias-check\ndescription: A maintained YAML parser\n";
+    let value: serde_yaml::Value = serde_yaml::from_str(yaml).expect("valid YAML");
+    let document = format!("---\n{yaml}---\nSkill body\n");
+    let metadata = parse_skill_frontmatter_metadata(&document, || "fallback".to_string())
+        .expect("valid skill frontmatter");
+
+    assert_eq!(Some(metadata.name.as_str()), value["name"].as_str());
+    assert_eq!(
+        Some(metadata.description.as_str()),
+        value["description"].as_str()
+    );
+}
