+def _crate_aliases(package_data, kinds):
+    shared = {}
+    branches = {}
+    names = package_data["aliases"]
+    for kind in kinds:
+        for dependency in package_data.get(kind, []):
+            if dependency in names:
+                shared[dependency] = names[dependency]
+        for platform, dependencies in package_data.get(kind + "_by_platform", {}).items():
+            branch = branches.setdefault(platform, {})
+            for dependency in dependencies:
+                if dependency in names:
+                    branch[dependency] = names[dependency]
+
+    if not branches:
+        return shared
+
+    return select({platform: shared | branch for platform, branch in branches.items()} | {
+        "//conditions:default": shared,
+    })
+
