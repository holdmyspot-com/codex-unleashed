diff --git a/codex-rs/skills/tests/yaml_dependency_alias.rs b/codex-rs/skills/tests/yaml_dependency_alias.rs
new file mode 100644
index 0000000..4c2e6b5
--- /dev/null
+++ b/codex-rs/skills/tests/yaml_dependency_alias.rs
@@ -0,0 +1,16 @@
+use codex_skills::parse_skill_frontmatter_metadata;
+
+#[test]
+fn maintained_yaml_alias_matches_public_skill_metadata() {
+    let yaml = "name: alias-check\ndescription: A maintained YAML parser\n";
+    let value: serde_yaml::Value = serde_yaml::from_str(yaml).expect("valid YAML");
+    let document = format!("---\n{yaml}---\nSkill body\n");
+    let metadata = parse_skill_frontmatter_metadata(&document, || "fallback".to_string())
+        .expect("valid skill frontmatter");
+
+    assert_eq!(Some(metadata.name.as_str()), value["name"].as_str());
+    assert_eq!(
+        Some(metadata.description.as_str()),
+        value["description"].as_str()
+    );
+}
diff --git a/defs.bzl b/defs.bzl
