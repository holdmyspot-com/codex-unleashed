+diff --git a/rs/extensions.bzl b/rs/extensions.bzl
+index 75fd8a8..ed20d66 100644
+--- a/rs/extensions.bzl
++++ b/rs/extensions.bzl
+@@ -611,18 +611,28 @@ filegroup(
+
+     defs_bzl_contents = \
+         """load(":data.bzl", "DEP_DATA")
+-load("@rules_rs//rs/private:all_crate_deps.bzl", _all_crate_deps = "all_crate_deps")
++load("@rules_rs//rs/private:all_crate_deps.bzl", _all_crate_aliases = "all_crate_aliases", _all_crate_deps = "all_crate_deps")
+
+ _PLATFORMS = [
+     {platforms}
+ ]
+
+-def aliases(package_name = None):
++def aliases(package_name = None, normal = None, normal_dev = None, build = None):
+     dep_data = DEP_DATA.get(package_name or native.package_name())
+     if not dep_data:
+         return {{}}
+
+-    return dep_data["aliases"]
++    # Preserve the original unfiltered API unless dependency kinds are supplied.
++    if normal == None and normal_dev == None and build == None:
++        return dep_data["aliases"]
++
++    return _all_crate_aliases(
++        dep_data,
++        platforms = _PLATFORMS,
++        normal = normal,
++        normal_dev = normal_dev,
++        build = build,
++    )
+
+ def crate_name(package_name = None):
+     dep_data = DEP_DATA.get(package_name or native.package_name())
+diff --git a/rs/private/all_crate_deps.bzl b/rs/private/all_crate_deps.bzl
+index f6d9ceb..3aa96c9 100644
+--- a/rs/private/all_crate_deps.bzl
++++ b/rs/private/all_crate_deps.bzl
+@@ -36,13 +36,7 @@ def merge_structured_dep_specs(specs, platforms, filter_prefix):
+     deps, per_platform = compute_select(merged_deps, merged_by_platform)
+     return sorted(deps), per_platform
+
+-def all_crate_deps(
+-        dep_data,
+-        platforms,
+-        normal = False,
+-        normal_dev = False,
+-        build = False,
+-        filter_prefix = None):
++def _selected_dep_specs(dep_data, normal, normal_dev, build):
+     specs = []
+
+     if normal_dev:
+@@ -54,8 +48,38 @@ def all_crate_deps(
+     if normal or not specs:
+         specs.append(_kind_dep_spec(dep_data, "deps"))
+
++    return specs
++
++def all_crate_aliases(dep_data, platforms, normal = False, normal_dev = False, build = False):
++    """Restrict aliases to the exact configured dependency labels of selected kinds."""
++    deps, per_platform = merge_structured_dep_specs(
++        _selected_dep_specs(dep_data, normal, normal_dev, build),
++        platforms,
++        None,
++    )
++    aliases = dep_data["aliases"]
++    common = {dep: aliases[dep] for dep in deps if dep in aliases}
++    branches = {}
++    for platform, platform_deps in sorted(per_platform.items()):
++        configured = dict(common)
++        configured.update({dep: aliases[dep] for dep in platform_deps if dep in aliases})
++        branches[platform] = configured
++
++    if not branches:
++        return common
++
++    branches["//conditions:default"] = common
++    return select(branches)
++
++def all_crate_deps(
++        dep_data,
++        platforms,
++        normal = False,
++        normal_dev = False,
++        build = False,
++        filter_prefix = None):
+     deps, per_platform = merge_structured_dep_specs(
+-        specs,
++        _selected_dep_specs(dep_data, normal, normal_dev, build),
+         platforms,
+         filter_prefix,
+     )
