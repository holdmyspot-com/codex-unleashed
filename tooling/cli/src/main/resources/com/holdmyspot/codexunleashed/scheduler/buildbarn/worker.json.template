{
  "blobstore": {
    "contentAddressableStorage": {
      "grpc": {
        "client": "@STORAGE_CLIENT@"
      }
    },
    "actionCache": {
      "grpc": {
        "client": "@STORAGE_CLIENT@"
      }
    }
  },
  "scheduler": "@SCHEDULER_WORKER@",
  "maximumMessageSizeBytes": 67108864,
  "inputDownloadConcurrency": "@CONCURRENCY@",
  "outputUploadConcurrency": "@CONCURRENCY@",
  "filePool": {
    "blockDevice": {
      "file": {
        "path": "@FILE_POOL@",
        "sizeBytes": 10737418240
      }
    }
  },
  "buildDirectories": [
    {
      "native": {
        "buildDirectoryPath": "@WORKER_ROOT@",
        "cacheDirectoryPath": "@WORKER_CACHE@",
        "maximumCacheFileCount": 1000000,
        "maximumCacheSizeBytes": 10737418240,
        "cacheReplacementPolicy": "LEAST_RECENTLY_USED"
      },
      "runners": [
        {
          "endpoint": "@RUNNER_CLIENT@",
          "concurrency": "@CONCURRENCY@",
          "instanceNamePrefix": "",
          "platform": {
            "properties": []
          },
          "buildDirectoryOwnerUserId": "@TRUSTED_UID@",
          "buildDirectoryOwnerGroupId": "@TRUSTED_GID@",
          "maximumFilePoolFileCount": 1000000,
          "maximumFilePoolSizeBytes": 10737418240
        }
      ]
    }
  ]
}
