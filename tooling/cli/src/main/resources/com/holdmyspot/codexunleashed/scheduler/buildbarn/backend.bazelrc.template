# Invocation-private supported REAPI execution; the native host/exec platform is unchanged.
common --remote_executor=@ENDPOINT@
common --remote_cache=@ENDPOINT@
# The invocation-private storage advertises mandatory identity encoding only.
common --noremote_cache_compression
common --tls_certificate=@CA@
common --tls_client_certificate=@CERT@
common --tls_client_key=@KEY@
common --spawn_strategy=remote
common --noremote_local_fallback
common --jobs=@JOBS@
