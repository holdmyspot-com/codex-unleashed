<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.holdmyspot.codexunleashed</groupId>
  <artifactId>tooling-cli</artifactId>
  <version>1.0-SNAPSHOT</version>
  <name>Codex build cache inputs</name>
  <properties>
    <maven.compiler.release>27</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <tooling.build.directory>${project.basedir}/../../.cat/work/temp/build-caches/maven/source-cache</tooling.build.directory>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-compress</artifactId>
        <version>1.28.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-compress</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.java-diff-utils</groupId>
      <artifactId>java-diff-utils</artifactId>
      <version>4.16</version>
    </dependency>
    <dependency>
      <groupId>io.github.cowwoc.pouch</groupId>
      <artifactId>pouch-core</artifactId>
      <version>10.3</version>
    </dependency>
    <dependency>
      <groupId>tools.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
      <version>3.3.0</version>
    </dependency>
    <dependency>
      <groupId>tools.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-toml</artifactId>
      <version>3.3.0</version>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>3.3.0</version>
    </dependency>
    <dependency>
      <groupId>commons-io</groupId>
      <artifactId>commons-io</artifactId>
      <version>2.22.0</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>2.0.20</version>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <version>1.6.6</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.github.cowwoc.requirements</groupId>
      <artifactId>requirements-java</artifactId>
      <version>13.2</version>
    </dependency>
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <version>7.12.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <directory>${tooling.build.directory}</directory>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.moditect</groupId>
          <artifactId>moditect-maven-plugin</artifactId>
          <version>1.3.0.Final</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.6.4</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-antrun-plugin</artifactId>
          <version>3.2.0</version>
          <dependencies>
            <dependency>
              <groupId>com.puppycrawl.tools</groupId>
              <artifactId>checkstyle</artifactId>
              <version>14.1.0</version>
            </dependency>
            <dependency>
              <groupId>net.sourceforge.pmd</groupId>
              <artifactId>pmd-ant</artifactId>
              <version>7.27.0</version>
            </dependency>
            <dependency>
              <groupId>net.sourceforge.pmd</groupId>
              <artifactId>pmd-java</artifactId>
              <version>7.27.0</version>
            </dependency>
          </dependencies>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- Build entry points stay outside the runtime module, but participate in typed packaging tests. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.7.0</version>
        <executions>
          <execution>
            <id>packaging-test-sources</id>
            <phase>generate-test-sources</phase>
            <goals><goal>add-test-source</goal></goals>
            <configuration>
              <sources><source>${project.basedir}/src/build/java</source></sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Modular recompilation can reset classes; stage runtime resources after compilation. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>default-resources</id>
            <phase>process-classes</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <showWarnings>true</showWarnings>
          <failOnWarning>false</failOnWarning>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.1</version>
        <configuration>
          <argLine>"-Djava.io.tmpdir=${java.io.tmpdir}"</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.11.0</version>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>quality-preflight</id>
      <properties>
        <quality.report.base>${project.build.directory}/quality-preflight</quality.report.base>
        <quality.driver>${project.basedir}/src/build/java/com/holdmyspot/codexunleashed/build/QualityPreflight.java</quality.driver>
        <quality.repository>${project.basedir}/../..</quality.repository>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>quality-checkstyle</id>
                <phase>verify</phase>
                <goals><goal>run</goal></goals>
                <configuration>
                  <!-- Missing completion receipts remain fatal in the final aggregation. -->
                  <failOnError>false</failOnError>
                  <target>
                    <property file="${quality.report.base}/current.properties"/>
                    <property name="quality.run.directory" value="${quality.report.base}/${quality.run.id}"/>
                    <record name="${quality.run.directory}/checkstyle.log" loglevel="verbose" action="start"/>
                    <taskdef name="checkstyle" classname="com.puppycrawl.tools.checkstyle.ant.CheckstyleAntTask"
                      classpathref="maven.plugin.classpath"/>
                    <checkstyle config="${project.basedir}/../config/checkstyle.xml" failOnViolation="false"
                      failureProperty="quality.checkstyle.findings" maxErrors="0" maxWarnings="0">
                      <formatter type="xml" toFile="${quality.run.directory}/checkstyle.xml"/>
                      <fileset dir="${project.basedir}/src" followsymlinks="false" defaultexcludes="false"
                        includes="main/java/**/*.java,test/java/**/*.java,build/java/**/*.java">
                        <present targetdir="${quality.run.directory}/sources/tooling/cli/src"/>
                      </fileset>
                    </checkstyle>
                    <condition property="quality.checkstyle.outcome" value="findings" else="passed">
                      <isset property="quality.checkstyle.findings"/>
                    </condition>
                    <echo file="${quality.run.directory}/checkstyle.result">${quality.checkstyle.outcome}</echo>
                    <record name="${quality.run.directory}/checkstyle.log" action="stop"/>
                  </target>
                </configuration>
              </execution>
              <execution>
                <id>quality-pmd</id>
                <phase>verify</phase>
                <goals><goal>run</goal></goals>
                <configuration>
                  <!-- Missing completion receipts remain fatal in the final aggregation. -->
                  <failOnError>false</failOnError>
                  <target>
                    <property file="${quality.report.base}/current.properties"/>
                    <property name="quality.run.directory" value="${quality.report.base}/${quality.run.id}"/>
                    <record name="${quality.run.directory}/pmd.log" loglevel="verbose" action="start"/>
                    <pathconvert property="quality.dependency.classpath" refid="maven.test.classpath"/>
                    <echo file="${quality.run.directory}/classpath.txt" encoding="UTF-8">${quality.dependency.classpath}</echo>
                    <echo file="${quality.run.directory}/javadoc-main-classes.txt" encoding="UTF-8" message="${project.build.outputDirectory}"/>
                    <echo file="${quality.run.directory}/javadoc-test-classes.txt" encoding="UTF-8" message="${project.build.testOutputDirectory}"/>
                    <echo file="${quality.run.directory}/javadoc-build-classes.txt" encoding="UTF-8" message="${project.build.testOutputDirectory}"/>
                    <taskdef name="pmd" classname="net.sourceforge.pmd.ant.PMDTask"
                      classpathref="maven.plugin.classpath"/>
                    <pmd rulesetfiles="${project.basedir}/../config/pmd.xml" failOnError="true"
                      failOnRuleViolation="false" failuresPropertyName="quality.pmd.findings"
                      minimumPriority="5" encoding="UTF-8" cacheLocation="${project.build.directory}/quality-pmd.cache">
                      <sourceLanguage name="java" version="${maven.compiler.release}"/>
                      <auxclasspath>
                        <!-- PMD needs the JDK classes as well as the resolved test classpath. -->
                        <pathelement location="${java.home}/lib/jrt-fs.jar"/>
                        <restrict><path refid="maven.test.classpath"/><exists/></restrict>
                      </auxclasspath>
                      <formatter type="xml" toFile="${quality.run.directory}/pmd.xml"/>
                      <formatter type="html" toFile="${quality.run.directory}/pmd.html"/>
                      <fileset dir="${project.basedir}/src" followsymlinks="false" defaultexcludes="false"
                        includes="main/java/**/*.java,test/java/**/*.java,build/java/**/*.java">
                        <present targetdir="${quality.run.directory}/sources/tooling/cli/src"/>
                      </fileset>
                    </pmd>
                    <condition property="quality.pmd.outcome" value="findings" else="passed">
                      <isset property="quality.pmd.findings"/>
                    </condition>
                    <echo file="${quality.run.directory}/pmd.result">${quality.pmd.outcome}</echo>
                    <record name="${quality.run.directory}/pmd.log" action="stop"/>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <configuration>
              <executable>${java.home}/bin/java</executable>
              <workingDirectory>${quality.repository}</workingDirectory>
            </configuration>
            <executions>
              <execution>
                <id>quality-validate-manifest</id>
                <phase>initialize</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <arguments>
                    <argument>-Djava.io.tmpdir=${java.io.tmpdir}</argument>
                    <argument>${quality.driver}</argument>
                    <argument>prepare</argument>
                    <argument>${quality.repository}</argument>
                    <argument>${quality.paths}</argument>
                    <argument>${quality.report.base}</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>quality-aggregate</id>
                <phase>verify</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <arguments>
                    <argument>-Djava.io.tmpdir=${java.io.tmpdir}</argument>
                    <argument>${quality.driver}</argument>
                    <argument>verify</argument>
                    <argument>${quality.repository}</argument>
                    <argument>${quality.paths}</argument>
                    <argument>${quality.report.base}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>runtime</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-clean-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>reset-runtime-staging</id>
                <phase>initialize</phase>
                <goals>
                  <goal>clean</goal>
                </goals>
                <configuration>
                  <excludeDefaultDirectories>true</excludeDefaultDirectories>
                  <filesets>
                    <fileset>
                      <directory>${project.build.directory}/modules</directory>
                      <followSymlinks>false</followSymlinks>
                    </fileset>
                    <fileset>
                      <directory>${project.build.directory}/runtime</directory>
                      <followSymlinks>false</followSymlinks>
                    </fileset>
                  </filesets>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>stage-runtime-dependencies</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>copy-dependencies</goal>
                </goals>
                <configuration>
                  <includeScope>runtime</includeScope>
                  <outputDirectory>${project.build.directory}/modules</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.moditect</groupId>
            <artifactId>moditect-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>modularize-java-diff-utils</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>add-module-info</goal>
                </goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/modules</outputDirectory>
                  <overwriteExistingFiles>true</overwriteExistingFiles>
                  <modules>
                    <module>
                      <artifact>
                        <groupId>io.github.java-diff-utils</groupId>
                        <artifactId>java-diff-utils</artifactId>
                        <type>jar</type>
                      </artifact>
                      <moduleInfoSource>
                        module io.github.javadiffutils {
                          requires java.logging;
                          exports com.github.difflib;
                          exports com.github.difflib.algorithm;
                          exports com.github.difflib.algorithm.myers;
                          exports com.github.difflib.patch;
                          exports com.github.difflib.text;
                          exports com.github.difflib.text.deltamerge;
                          exports com.github.difflib.unifieddiff;
                        }
                      </moduleInfoSource>
                    </module>
                  </modules>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <configuration>
              <outputDirectory>${project.build.directory}/modules</outputDirectory>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>build-bundled-runtime</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${java.home}/bin/java</executable>
                  <arguments>
                    <argument>-Djava.io.tmpdir=${java.io.tmpdir}</argument>
                    <argument>${project.basedir}/src/build/java/com/holdmyspot/codexunleashed/distribution/DistributionMain.java</argument>
                    <argument>${project.build.directory}/modules</argument>
                    <argument>${project.build.directory}/runtime</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
