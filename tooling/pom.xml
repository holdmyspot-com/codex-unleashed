<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.holdmyspot.codexunleashed</groupId>
	<artifactId>tooling</artifactId>
	<version>1.0-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>Codex Unleashed tooling</name>
	<description>Build, verification, and release tooling for Codex Unleashed</description>

	<modules>
		<module>bootstrap</module>
		<module>cli</module>
		<module>distribution</module>
	</modules>

	<properties>
		<tooling.release.workflow>${project.rootDirectory}/../.github/workflows/build-release.yml</tooling.release.workflow>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<maven.compiler.release>27</maven.compiler.release>
		<tooling.config.directory>${project.rootDirectory}/config</tooling.config.directory>
		<tooling.build.root>${project.rootDirectory}/../.cat/work/temp/build-caches/maven/target</tooling.build.root>
		<tooling.test.jvm.options/>
		<tooling.native.bash>bash</tooling.native.bash>
		<maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
		<maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
		<maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
		<maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
		<maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
		<maven-antrun-plugin.version>3.2.0</maven-antrun-plugin.version>
		<checkstyle.version>14.3.0</checkstyle.version>
		<pmd.version>7.28.0</pmd.version>
		<logback.version>1.6.5</logback.version>
		<test.thread.count>4</test.thread.count>
		<testng.version>7.12.0</testng.version>
		<requirements.version>13.2</requirements.version>
		<maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
		<exec-maven-plugin.version>3.6.4</exec-maven-plugin.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>io.github.cowwoc.requirements</groupId>
				<artifactId>requirements-java</artifactId>
				<version>${requirements.version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>io.github.cowwoc.pouch</groupId>
				<artifactId>pouch-core</artifactId>
				<version>10.3</version>
			</dependency>
			<dependency>
				<groupId>ch.qos.logback</groupId>
				<artifactId>logback-classic</artifactId>
				<version>${logback.version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>org.testng</groupId>
				<artifactId>testng</artifactId>
				<version>${testng.version}</version>
				<scope>test</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<!-- WORKAROUND: Enabled inherited Java.net repositories trigger prefix filtering against
	     an expired endpoint: https://github.com/apache/maven-resolver/issues/2156
	     Remove both overrides when the dependency chain drops this repository or a shipped
	     Resolver/Maven fix handles enabled inherited repositories, verified by fresh-cache
	     online checks. PR2192 only handles disabled policies and is insufficient. -->
	<repositories>
		<repository>
			<id>jvnet-nexus-releases</id>
			<url>https://repo.maven.apache.org/maven2/</url>
			<releases><enabled>true</enabled></releases>
			<snapshots><enabled>false</enabled></snapshots>
		</repository>
	</repositories>

	<pluginRepositories>
		<pluginRepository>
			<id>jvnet-nexus-releases</id>
			<url>https://repo.maven.apache.org/maven2/</url>
			<releases><enabled>true</enabled></releases>
			<snapshots><enabled>false</enabled></snapshots>
		</pluginRepository>
	</pluginRepositories>

	<build>
		<directory>${tooling.build.root}/${project.artifactId}</directory>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-dependency-plugin</artifactId>
					<version>${maven-dependency-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>exec-maven-plugin</artifactId>
					<version>${exec-maven-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>${maven-compiler-plugin.version}</version>
					<configuration>
						<failOnWarning>true</failOnWarning>
						<showWarnings>true</showWarnings>
						<compilerArgs>
							<arg>-Xlint:all,-exports,-requires-automatic,-module</arg>
						</compilerArgs>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>${maven-surefire-plugin.version}</version>
					<configuration>
						<parallel>methods</parallel>
						<threadCount>${test.thread.count}</threadCount>
						<promoteUserPropertiesToSystemProperties>false</promoteUserPropertiesToSystemProperties>
						<argLine>"-Djava.io.tmpdir=${java.io.tmpdir}" -Djdk.lang.Process.allowAmbiguousCommands=false ${tooling.test.jvm.options}</argLine>
						<!-- Git's detached background maintenance would keep changing a test repository's .git directory
						while the test deletes it. -->
						<environmentVariables>
							<GIT_CONFIG_COUNT>2</GIT_CONFIG_COUNT>
							<GIT_CONFIG_KEY_0>maintenance.auto</GIT_CONFIG_KEY_0>
							<GIT_CONFIG_VALUE_0>false</GIT_CONFIG_VALUE_0>
							<GIT_CONFIG_KEY_1>gc.auto</GIT_CONFIG_KEY_1>
							<GIT_CONFIG_VALUE_1>0</GIT_CONFIG_VALUE_1>
						</environmentVariables>
						<systemPropertyVariables>
							<tooling.build.root>${tooling.build.root}</tooling.build.root>
							<tooling.release.workflow>${tooling.release.workflow}</tooling.release.workflow>
							<tooling.native.bash>${tooling.native.bash}</tooling.native.bash>
						</systemPropertyVariables>
						<properties>
							<property>
								<name>usedefaultlisteners</name>
								<value>false</value>
							</property>
						</properties>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-jar-plugin</artifactId>
					<version>${maven-jar-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-enforcer-plugin</artifactId>
					<version>${maven-enforcer-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-checkstyle-plugin</artifactId>
					<version>${maven-checkstyle-plugin.version}</version>
					<dependencies>
						<dependency>
							<groupId>com.puppycrawl.tools</groupId>
							<artifactId>checkstyle</artifactId>
							<version>${checkstyle.version}</version>
						</dependency>
					</dependencies>
					<configuration>
						<configLocation>${tooling.config.directory}/checkstyle.xml</configLocation>
						<includeTestSourceDirectory>true</includeTestSourceDirectory>
						<excludeGeneratedSources>true</excludeGeneratedSources>
						<failOnViolation>true</failOnViolation>
						<violationSeverity>warning</violationSeverity>
						<consoleOutput>true</consoleOutput>
						<linkXRef>false</linkXRef>
					</configuration>
					<executions>
						<execution>
							<phase>process-test-classes</phase>
							<goals><goal>check</goal></goals>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-antrun-plugin</artifactId>
					<!-- WORKAROUND: https://github.com/apache/maven-pmd-plugin/pull/726
					     Maven PMD 3.28.0 omits the JDK platform classes from PMD's auxiliary classpath.
					     Use PMD's Ant task to provide them explicitly; return to Maven PMD when a
					     released version includes the upstream fix. -->
					<version>${maven-antrun-plugin.version}</version>
					<dependencies>
						<dependency>
							<groupId>net.sourceforge.pmd</groupId>
							<artifactId>pmd-ant</artifactId>
							<version>${pmd.version}</version>
						</dependency>
						<dependency>
							<groupId>net.sourceforge.pmd</groupId>
							<artifactId>pmd-java</artifactId>
							<version>${pmd.version}</version>
						</dependency>
					</dependencies>
					<executions>
						<execution>
							<id>pmd</id>
							<phase>process-test-classes</phase>
							<goals><goal>run</goal></goals>
							<configuration>
								<target>
									<taskdef name="pmd" classname="net.sourceforge.pmd.ant.PMDTask"
										classpathref="maven.plugin.classpath"/>
									<mkdir dir="${project.build.directory}/pmd"/>
									<mkdir dir="${project.build.directory}/reports"/>
									<pmd rulesetfiles="${tooling.config.directory}/pmd.xml" failOnError="true"
										failOnRuleViolation="true" minimumPriority="5" encoding="UTF-8"
										cacheLocation="${project.build.directory}/pmd/pmd.cache">
										<sourceLanguage name="java" version="${maven.compiler.release}"/>
									<auxclasspath>
										<pathelement location="${java.home}/lib/jrt-fs.jar"/>
										<restrict>
											<path refid="maven.test.classpath"/>
											<exists/>
										</restrict>
										</auxclasspath>
										<formatter type="xml" toFile="${project.build.directory}/pmd.xml"/>
										<formatter type="html" toFile="${project.build.directory}/reports/pmd.html"/>
										<formatter type="text" toConsole="true"/>
									<fileset dir="${project.build.sourceDirectory}" includes="**/*.java" erroronmissingdir="false"/>
									<fileset dir="${project.build.testSourceDirectory}" includes="**/*.java" erroronmissingdir="false"/>
									</pmd>
								</target>
							</configuration>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>require-jdk-27</id>
						<goals><goal>enforce</goal></goals>
						<configuration>
							<rules>
								<requireJavaVersion><version>27</version></requireJavaVersion>
								<requireMavenVersion><version>[3.6.3,)</version></requireMavenVersion>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId></plugin>
			<plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId></plugin>
			<plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId></plugin>
		</plugins>
	</build>
</project>
